<div class="d-flex flex-wrap gap-2 mb-3">
    <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="() => workDays = mondayToFriday">Work week: Monday to Friday</Button>
    <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="() => workDays = sundayToThursday">Work week: Sunday to Thursday</Button>
</div>

<Calendar TItem="Appointment"
          AriaLabel="Team week"
          Data="appointments"
          Date="@(new DateOnly(2024, 11, 5))"
          @bind-View="view"
          WorkDays="workDays"
          StartField="a => a.Start"
          EndField="a => a.End"
          TitleField="a => a.Title"
          AllDayField="a => a.IsAllDay"
          ColorField="a => a.Color"
          OnSlotClick="OnSlotClick"
          OnDayClick="OnDayClick"
          OnEventClick="OnEventClick" />

<div class="mt-3">Last click: <b>@lastClick</b></div>

@code {
    private record Appointment(string Title, DateTime Start, DateTime End, bool IsAllDay, CalendarColor Color);

    private static readonly DayOfWeek[] mondayToFriday = { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday };
    private static readonly DayOfWeek[] sundayToThursday = { DayOfWeek.Sunday, DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday };

    private static DateTime At(int day, int hour = 0, int minute = 0) => new(2024, 11, day, hour, minute, 0);

    private readonly List<Appointment> appointments = new()
    {
        // All-day and multi-day events sit in the all-day row.
        new("Trip to London", At(1), At(5), true, CalendarColor.Success),
        new("Stonehenge, Windsor Castle, Oxford", At(5, 8, 45), At(6, 17), false, CalendarColor.Info),

        // Events that overlap in time sit side by side.
        new("Standup", At(5, 9), At(5, 10, 30), false, CalendarColor.Primary),
        new("Design review", At(5, 9, 30), At(5, 11), false, CalendarColor.Warning),
        new("Customer call", At(5, 10), At(5, 10, 30), false, CalendarColor.Danger),

        new("Lunch", At(6, 12), At(6, 13), false, CalendarColor.Secondary),
        new("Planning", At(4, 14), At(4, 16), false, CalendarColor.Primary),

        // An end that is not after its start still shows, one slot tall.
        new("Domain name due", At(7, 12), At(7, 12), false, CalendarColor.Dark)
    };

    private string lastClick = "none";
    private CalendarView view = CalendarView.Week;
    private IReadOnlyList<DayOfWeek> workDays = mondayToFriday;

    private void OnDayClick(CalendarDayClickEventArgs args) => lastClick = $"day {args.Date:yyyy-MM-dd}";

    private void OnEventClick(CalendarEventClickEventArgs<Appointment> args) => lastClick = $"event \"{args.Item.Title}\"";

    // Open your own form here to create an event that starts in the clicked slot.
    private void OnSlotClick(CalendarSlotClickEventArgs args) => lastClick = $"slot {args.Start:yyyy-MM-dd HH:mm} to {args.End:HH:mm}";
}
