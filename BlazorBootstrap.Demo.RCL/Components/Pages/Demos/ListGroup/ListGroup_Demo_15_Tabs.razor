<div class="d-flex flex-wrap gap-2 mb-3">
    <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="@(() => listGroup.ShowTabAsync("billing"))">Show Billing from code</Button>
</div>

<ListGroup @ref="listGroup"
           TItem="string"
           TabMode="true"
           AriaLabel="Settings sections"
           OnShowing="@(e => Log("Showing", e))"
           OnShown="@(e => Log("Shown", e))"
           OnHiding="@(e => Log("Hiding", e))"
           OnHidden="@(e => Log("Hidden", e))">
    <ListGroupTabPane Name="profile" Title="Profile">
        <h5>Profile</h5>
        <p class="mb-0">Your name, photo, and contact details.</p>
    </ListGroupTabPane>
    <ListGroupTabPane Name="notifications">
        <TitleTemplate>Notifications <Badge Color="BadgeColor.Primary" IndicatorType="BadgeIndicatorType.RoundedPill" Class="ms-1">3</Badge></TitleTemplate>
        <ChildContent>
            <h5>Notifications</h5>
            <p class="mb-0">Choose which emails and alerts you get.</p>
        </ChildContent>
    </ListGroupTabPane>
    <ListGroupTabPane Name="billing" Title="Billing">
        <h5>Billing</h5>
        <p class="mb-0">Invoices, payment method, and plan.</p>
    </ListGroupTabPane>
    <ListGroupTabPane Name="danger" Title="Danger zone" Disabled="true">
        <h5>Danger zone</h5>
    </ListGroupTabPane>
</ListGroup>

<div class="mt-3 small">
    <strong>Events:</strong>
    @if (log.Count == 0)
    {
        <span>none yet; pick a section.</span>
    }
    else
    {
        <ol class="mb-0">
            @foreach (var entry in log)
            {
                <li>@entry</li>
            }
        </ol>
    }
</div>

@code {
    private ListGroup<string> listGroup = default!;
    private readonly List<string> log = new();

    private void Log(string name, ListGroupTabEventArgs e)
    {
        log.Add($"{name}: active {e.ActiveTabName}, previous {e.PreviousTabName ?? "none"}");

        if (log.Count > 8)
            log.RemoveAt(0);
    }
}
