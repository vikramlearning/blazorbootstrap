@attribute [Route(pageUrl)]
@layout DemosMainLayout

<DemosPageHeadSection PageUrl="@pageUrl"
                      PageTitle="@pageTitle"
                      PageDescription="@pageDescription"
                      MetaTitle="@metaTitle"
                      MetaDescription="@metaDescription"
                      ImageUrl="@imageUrl" />

<DocsLink Href="@DemoRouteConstants.Docs_URL_Grid" />

<Section Size="HeadingSize.H2" Name="Conditional css class for grid row" PageUrl="@pageUrl" Link="conditional-css-class-for-grid-row">
    <div class="mb-3">In the below example, we applied <code>table-danger</code> CSS class to the row where the employee is inactive and the <code>table-success</code> CSS class to the row where the employee designation is Architect.</div>
    <Demo Type="typeof(Grid_Demo_18_Specify_Custom_Row_Class)" Tabs="true" />
</Section>

<Section Size="HeadingSize.H2" Name="Conditional css class for grid column" PageUrl="@pageUrl" Link="conditional-css-class-for-grid-column">
    <div class="mb-3">In the below example, we applied <code>table-danger</code> CSS class to the Active column where the employee is inactive and the <code>table-success</code> CSS class to the Active column where the employee is active.</div>
    <Demo Type="typeof(Grid_Demo_19_Specify_Custom_Column_Class)" Tabs="true" />
</Section>

<Section Size="HeadingSize.H2" Name="Column Class" PageUrl="@pageUrl" Link="colum-class">
    <div class="mb-3">In the following example, the <code>Class</code> parameter is used to apply the CSS class to an entire grid column, including the header.</div>
    <Demo Type="typeof(Grid_Demo_20_Column_Css_Class)" Tabs="true" />
</Section>

<Section Size="HeadingSize.H2" Name="Header row css class" PageUrl="@pageUrl" Link="header-row-css-class">
    <div class="mb-3"></div>
    <Demo Type="typeof(Grid_Demo_27_Header_Row_CSS_Class)" Tabs="true" />
</Section>

<Section Size="HeadingSize.H2" Name="Filters row css class" PageUrl="@pageUrl" Link="filters-row-css-class">
    <div class="mb-3"></div>
    <Demo Type="typeof(Grid_Demo_28_Filters_Row_CSS_Class)" Tabs="true" />
</Section>

@code {
    private const string pageUrl = DemoRouteConstants.Demos_URL_Grid_CustomCSSClass;
    private const string pageTitle = "Blazor Grid - Custom CSS Class";
    private const string pageDescription = "The Blazor Grid component shows tabular data with client-side or server-side paging, sorting and filtering, plus selection, a column chooser, saved settings and CSV export. The examples below cover conditional css class for grid row, conditional css class for grid column, column class, header row css class and filters row css class.";
    private const string metaTitle = "Blazor Grid custom CSS class examples";
    private const string metaDescription = "Live Blazor Grid custom CSS class examples with source code: conditional css class for grid row, conditional css class for grid column and column class.";
    private const string imageUrl = "https://i.imgur.com/kKNgo2I.png";
}
