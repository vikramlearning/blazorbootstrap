@attribute [Route(pageUrl)]
@layout DemosMainLayout

<DemosPageHeadSection PageUrl="@pageUrl"
                      PageTitle="@pageTitle"
                      PageDescription="@pageDescription"
                      MetaTitle="@metaTitle"
                      MetaDescription="@metaDescription"
                      ImageUrl="@imageUrl" />

<DocsLink Href="@DemoRouteConstants.Docs_URL_Grid" />

<Section Size="HeadingSize.H2" Name="Cell formating" PageUrl="@pageUrl" Link="cell-formating">
    <div class="mb-3">To format the cell data, use <code>ToString method and format strings</code>. Refer: <a href="https://docs.microsoft.com/en-us/dotnet/standard/base-types/formatting-types" target="_blank">How to format numbers, dates, enums, and other types in .NET</a></div>
    <Callout Color="CalloutColor.Success"><strong>Example: </strong>@@context.Salary.ToString("N2").</Callout>
    <Demo Type="typeof(Grid_Demo_01_Grid_Cell_Formating)" Tabs="true" />
</Section>

<Section Size="HeadingSize.H2" Name="Cell nowrap" PageUrl="@pageUrl" Link="cell-nowrap">
    <div class="mb-3">To prevent text from wrapping, add <code>TextNoWrap="true"</code> to the GridColumn.</div>
    <Demo Type="typeof(Grid_Demo_02_Grid_Cell_Nowrap)" Tabs="true" />
</Section>

<Section Size="HeadingSize.H2" Name="Empty data" PageUrl="@pageUrl" Link="empty-data">
    <div class="mb-3">If there are no records to display in the Grid, by default, it will display the <strong>No records to display</strong> message. You can change this message by adding the <code>EmptyText</code> parameter to the Grid.</div>
    <Demo Type="typeof(Grid_Demo_03_Empty_Data)" Tabs="true" />
</Section>

<Section Size="HeadingSize.H2" Name="Empty data template" PageUrl="@pageUrl" Link="empty-data-template">
    <div class="mb-3">Set the <code>GridEmptyDataTemplate</code> to customize the message displayed when the grid has no records.</div>
    <Demo Type="typeof(Grid_Demo_04_Empty_Data_Template)" Tabs="true" />
</Section>

<Section Size="HeadingSize.H2" Name="Custom column headers" PageUrl="@pageUrl" Link="custom-column-headers">
    <div class="mb-3">In the below example, we use <code>&lt;HeaderContent&gt;</code> and <code>&lt;ChildContent&gt;</code> tags to define custom column header and cell content. When defining header content, filters and sorting are removed from column.</div>
    <Demo Type="typeof(Grid_Demo_05_Specify_Custom_Column_Header)" Tabs="true" />
</Section>

<Section Size="HeadingSize.H2" Name="Hide columns" PageUrl="@pageUrl" Link="hide-columns">
    <div class="mb-3">Set the <code>IsVisible</code> parameter to <b>false</b> to hide the column.</div>
    <Demo Type="typeof(Grid_Demo_06_Hide_Columns_Dynamically)" Tabs="true" />
</Section>

<Section Size="HeadingSize.H2" Name="Column chooser" PageUrl="@pageUrl" Link="column-chooser">
    <div class="mb-3">
        Let people choose which columns they see and in what order. A <b>Columns</b> button above the grid opens a list with a search box, a checkbox for each column, and move up and move down buttons; columns can also be dragged.
        <br />
        <strong>How to use:</strong>
        <div class="content mb-2">
            <ol>
                <li>Set <code>AllowColumnChooser="true"</code> on the Grid.</li>
                <li>Give each column a <code>PropertyName</code> or <code>HeaderText</code>; the chooser lists the columns by it.</li>
                <li>Set <code>AlwaysVisible="true"</code> on a column people must not hide. The last visible column can never be hidden.</li>
                <li>To keep the choice, handle <code>GridSettingsChanged</code> and return the saved settings from <code>SettingsProvider</code>. <code>GridSettings.ColumnOrder</code> and <code>GridSettings.HiddenColumns</code> hold it. <b>Reset to default</b>, or <code>ResetColumnsAsync()</code>, restores the declared columns.</li>
            </ol>
        </div>
        Change the text with <code>ColumnChooserButtonText</code>, <code>ColumnChooserSearchPlaceholderText</code>, <code>ColumnChooserResetText</code>, and the other <code>ColumnChooser*Text</code> parameters.
    </div>
    <Demo Type="typeof(Grid_Demo_08_Column_Chooser)" Tabs="true" />
</Section>

<Section Size="HeadingSize.H2" Name="Export to CSV" PageUrl="@pageUrl" Link="export-to-csv">
    <div class="mb-3">
        An <b>Export CSV</b> button downloads every row that matches the current filters and sort, across all pages, with the columns people see, in their order.
        <br />
        <strong>How to use:</strong>
        <div class="content mb-2">
            <ol>
                <li>Set <code>AllowExport="true"</code> on the Grid, and optionally <code>ExportFileName</code>.</li>
                <li>Give each exported column a <code>PropertyName</code>; its value is written with the grid's culture. Set <code>Exportable="false"</code> on columns such as actions.</li>
                <li>With a <code>DataProvider</code>, return all matching rows when <code>PageNumber</code> and <code>PageSize</code> are 0. <code>request.ApplyTo(...)</code> already does.</li>
                <li>Call <code>ExportToCsvAsync()</code> to export from your own button.</li>
            </ol>
        </div>
        Text that starts with <code>=</code>, <code>+</code>, <code>-</code>, or <code>@@</code> is written with a leading apostrophe, so spreadsheet apps don't run it as a formula.
    </div>
    <Demo Type="typeof(Grid_Demo_09_Export_To_Csv)" Tabs="true" />
</Section>

<Section Size="HeadingSize.H2" Name="Increase textbox width" PageUrl="@pageUrl" Link="increase-textbox-width">
    <Demo Type="typeof(Grid_Demo_07_Increase_TextBox_Width)" Tabs="true" />
</Section>

@code {
    private const string pageUrl = DemoRouteConstants.Demos_URL_Grid_OtherExamples;
    private const string pageTitle = "Blazor Grid - Other examples";
    private const string pageDescription = "The Blazor Grid component shows tabular data with client-side or server-side paging, sorting and filtering, plus selection, a column chooser, saved settings and CSV export. The examples below cover cell formatting, cell nowrap, empty data, empty data template and custom column headers.";
    private const string metaTitle = "Blazor Grid other examples";
    private const string metaDescription = "Live Blazor Grid other examples with source code: cell formatting, cell nowrap, empty data, empty data template, custom column headers and hide columns.";
    private const string imageUrl = "https://i.imgur.com/kKNgo2I.png";
}
