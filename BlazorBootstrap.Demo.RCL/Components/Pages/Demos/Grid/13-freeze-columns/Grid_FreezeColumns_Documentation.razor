@attribute [Route(pageUrl)]
@layout DemosMainLayout

<DemosPageHeadSection PageUrl="@pageUrl"
                      PageTitle="@pageTitle"
                      PageDescription="@pageDescription"
                      MetaTitle="@metaTitle"
                      MetaDescription="@metaDescription"
                      ImageUrl="@imageUrl" />

<DocsLink Href="@DemoRouteConstants.Docs_URL_Grid" />

<Section Size="HeadingSize.H2" Name="Freeze columns" PageUrl="@pageUrl" Link="freeze-columns">
    <div class="mb-3"></div>
    <Demo Type="typeof(Grid_Demo_33_Freeze_Column_A_Text_Nowrap)" Tabs="true" />
</Section>

<Section Size="HeadingSize.H2" Name="Freeze columns with fixed header" PageUrl="@pageUrl" Link="freeze-columns-with-fixed-header">
    <Demo Type="typeof(Grid_Demo_33_Freeze_Column_B_Fixed_Header)" Tabs="true" />
</Section>

<Section Size="HeadingSize.H2" Name="Freeze columns with fixed header and filters" PageUrl="@pageUrl" Link="freeze-columns-with-fixed-header-and-filters">
    <Demo Type="typeof(Grid_Demo_33_Freeze_Column_C_Fixed_Header_With_Filters)" Tabs="true" />
</Section>

@code {
    private const string pageUrl = DemoRouteConstants.Demos_URL_Grid_FreezeColumns;
    private const string pageTitle = "Blazor Grid - Freeze columns";
    private const string pageDescription = "The Blazor Grid component shows tabular data with client-side or server-side paging, sorting and filtering, plus selection, a column chooser, saved settings and CSV export. The examples below cover freeze columns, freeze columns with fixed header and freeze columns with fixed header and filters.";
    private const string metaTitle = "Blazor Grid freeze columns examples";
    private const string metaDescription = "Live Blazor Grid freeze columns examples with source code: freeze columns, freeze columns with fixed header and freeze columns with fixed header and filters.";
    private const string imageUrl = "https://i.imgur.com/kKNgo2I.png";
}
