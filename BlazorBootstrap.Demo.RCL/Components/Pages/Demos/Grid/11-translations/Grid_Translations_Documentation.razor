@attribute [Route(pageUrl)]
@layout DemosMainLayout

<DemosPageHeadSection PageUrl="@pageUrl"
                      PageTitle="@pageTitle"
                      PageDescription="@pageDescription"
                      MetaTitle="@metaTitle"
                      MetaDescription="@metaDescription"
                      ImageUrl="@imageUrl" />

<DocsLink Href="@DemoRouteConstants.Docs_URL_Grid" />

<Section Size="HeadingSize.H2" Name="Translations" PageUrl="@pageUrl" Link="translations">
    <div class="mb-3">In the example below, you will see translations related to pagination and filters in <b>Dutch</b>.</div>
    <Demo Type="typeof(Grid_Demo_01_Translations)" Tabs="true" />
</Section>

@code {
    private const string pageUrl = DemoRouteConstants.Demos_URL_Grid_Translations;
    private const string pageTitle = "Blazor Grid - Translations";
    private const string pageDescription = "The Blazor Grid component shows tabular data with client-side or server-side paging, sorting and filtering, plus selection, a column chooser, saved settings and CSV export. The example below translates the Grid's own text: filter operators, the enum filter prompt, items per page and the pagination summary.";
    private const string metaTitle = "Blazor Grid translations examples";
    private const string metaDescription = "Live Blazor Grid translation example with source code: translate filter operators, the enum filter prompt, items per page and the pagination summary.";
    private const string imageUrl = "https://i.imgur.com/kKNgo2I.png";
}
