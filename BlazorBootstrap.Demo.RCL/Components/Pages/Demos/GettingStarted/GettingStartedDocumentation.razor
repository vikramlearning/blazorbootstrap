@page "/demos"
@attribute [Route(pageUrl)]
@layout DemosMainLayout

<DemosPageHeadSection PageUrl="@pageUrl"
                      PageTitle="@pageTitle"
                      PageDescription="@pageDescription"
                      MetaTitle="@metaTitle"
                      MetaDescription="@metaDescription"
                      ImageUrl="@imageUrl" />

<Section Size="HeadingSize.H2" Name="Documentation" PageUrl="@pageUrl" Link="documentation">
    <GettingStarted />
</Section>

@code {
    private const string pageUrl = DemoRouteConstants.Demos_URL_GettingStarted;
    private const string pageTitle = "Getting started with Blazor Bootstrap - Blazor Project Setup";
    private const string pageDescription = "Install the Blazor Bootstrap NuGet package, add its CSS and JavaScript references, and register its services to use Bootstrap 5.3 components in Blazor Server, WebAssembly and MAUI Blazor Hybrid apps on .NET 8, 9, 10 and 11.";
    private const string metaTitle = "Get started with Blazor Bootstrap";
    private const string metaDescription = "Install Blazor Bootstrap from NuGet, add its CSS and JavaScript, and set up a Blazor Server, WebAssembly or MAUI app, then try every component live.";
    private const string imageUrl = "https://i.imgur.com/SCbZVd4.jpg"; // TODO: Update image URL

    private string? version;
    [Inject] public IConfiguration Configuration { get; set; } = default!;

    protected override void OnInitialized()
    {
        version = Configuration["version"]; // example: v3.5.0
        base.OnInitialized();
    }
}
