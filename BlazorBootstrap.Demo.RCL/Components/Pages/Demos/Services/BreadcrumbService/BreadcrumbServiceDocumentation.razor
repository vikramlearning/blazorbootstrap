@attribute [Route(pageUrl)]
@layout DemosMainLayout

<DemosPageHeadSection PageUrl="@pageUrl"
                      PageTitle="@pageTitle"
                      PageDescription="@pageDescription"
                      MetaTitle="@metaTitle"
                      MetaDescription="@metaDescription"
                      ImageUrl="@imageUrl" />

<DocsLink Href="@DemoRouteConstants.Docs_URL_BreadcrumbService" />

<div class="mt-3">Use Blazor BreadcrumbService to update the breadcrumb from any page or component in your app.</div>

<Section Size="HeadingSize.H2" Name="How it works" PageUrl="@pageUrl" Link="how-it-works">
    <div class="mb-3">
        <code>BreadcrumbService</code> sends a new list of items to every <code>Breadcrumb</code> component on the page that has no <code>Items</code> set by its parent.
        <br />
        <strong>How to use:</strong>
        <div class="content mb-2">
            <ol>
                <li>Add a <code>Breadcrumb</code> component without the <code>Items</code> parameter, usually in a layout.</li>
                <li>Inject <code>BreadcrumbService</code> in the page or component that knows the current location.</li>
                <li>Call <code>Notify(...)</code> with a <code>List&lt;BreadcrumbItem&gt;</code>. Set <code>IsCurrentPage</code> on the last item.</li>
            </ol>
        </div>
        Use the buttons to send a different trail to the breadcrumb.
    </div>
    <Demo Type="typeof(BreadcrumbService_Demo_01_Update_Breadcrumb_From_Code)" />
</Section>

<Section Size="HeadingSize.H2" Name="How to setup" PageUrl="@pageUrl" Link="how-to-setup">
    <div class="mb-3">1. Add the <code>Breadcrumb</code> component in <code>MainLayout.razor</code> page as shown below.</div>
    <Demo Type="typeof(BreadcrumbService_Demo_02_Setup_Layout)" ShowCodeOnly="true" />

    <div class="mb-3">2. Inject <code>BreadcrumbService</code>, then call the <code>Notify(...)</code> method as shown below.</div>
    <Demo Type="typeof(BreadcrumbService_Demo_03_Setup_Notify)" ShowCodeOnly="true" />
</Section>

@code {
    private const string pageUrl = DemoRouteConstants.Demos_URL_BreadcrumbService;
    private const string pageTitle = "Blazor Breadcrumb Service";
    private const string pageDescription = "Use Blazor Bootstrap breadcrumb service to update the breadcrumb from any page or component in your app. The examples below cover how to setup.";
    private const string metaTitle = "Blazor Breadcrumb Service examples";
    private const string metaDescription = "Live Blazor Breadcrumb Service examples with source code: how to setup.";
    private const string imageUrl = DemoScreenshotSrcConstants.Demos_URL_BreadcrumbService;
}
