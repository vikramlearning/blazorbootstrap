<div class="d-flex flex-wrap gap-2">
    <Popover Placement="PopoverPlacement.Top" Content="Top popover">
        <Button Color="ButtonColor.Secondary">Popover on top</Button>
    </Popover>
    <Popover Placement="PopoverPlacement.Right" Content="Right popover">
        <Button Color="ButtonColor.Secondary">Popover on right</Button>
    </Popover>
    <Popover Placement="PopoverPlacement.Bottom" Content="Bottom popover">
        <Button Color="ButtonColor.Secondary">Popover on bottom</Button>
    </Popover>
    <Popover Placement="PopoverPlacement.Left" Content="Left popover">
        <Button Color="ButtonColor.Secondary">Popover on left</Button>
    </Popover>
    <Popover Placement="PopoverPlacement.Auto" Content="This side had the most room.">
        <Button Color="ButtonColor.Secondary">Auto placement</Button>
    </Popover>
</div>
