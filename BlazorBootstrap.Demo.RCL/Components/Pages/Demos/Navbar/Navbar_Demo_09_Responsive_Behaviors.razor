<Navbar BackgroundColor="BackgroundColor.BodyTertiary" BrandInCollapse="true" AriaLabel="Navbar with a hidden brand" Class="mb-3">
    <Brand>
        <NavbarBrand Href="@DemoRouteConstants.Demos_URL_Navbar">Hidden brand</NavbarBrand>
    </Brand>
    <ChildContent>
        <NavbarNav Class="me-auto mb-2 mb-lg-0">
            <NavbarItem Href="@DemoRouteConstants.Demos_URL_Navbar" Match="NavLinkMatch.All">Home</NavbarItem>
            <NavbarItem Href="@DemoRouteConstants.Demos_URL_Buttons">Buttons</NavbarItem>
        </NavbarNav>
    </ChildContent>
</Navbar>

