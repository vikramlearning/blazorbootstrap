<Navbar BackgroundColor="BackgroundColor.BodyTertiary" AriaLabel="Navbar with a search form" ExpandBreakpoint="NavbarExpand.Always" Class="mb-3">
    <form class="d-flex" role="search" @onsubmit="Search">
        <TextInput @bind-Value="query" Class="me-2" Placeholder="Search" aria-label="Search" />
        <Button Type="ButtonType.Submit" Color="ButtonColor.Success" Outline="true">Search</Button>
    </form>
</Navbar>

<Navbar BackgroundColor="BackgroundColor.BodyTertiary" AriaLabel="Navbar with an input group" ExpandBreakpoint="NavbarExpand.Always" Class="mb-3">
    <form class="container-fluid px-0" @onsubmit:preventDefault>
        <InputGroup>
            <InputGroupText Id="navbar-username-addon">@@</InputGroupText>
            <TextInput @bind-Value="username" Placeholder="Username" aria-label="Username" aria-describedby="navbar-username-addon" />
        </InputGroup>
    </form>
</Navbar>

<Navbar BackgroundColor="BackgroundColor.BodyTertiary" AriaLabel="Navbar with buttons" ExpandBreakpoint="NavbarExpand.Always">
    <div class="d-flex gap-2">
        <Button Color="ButtonColor.Success" Outline="true">Main button</Button>
        <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small">Smaller button</Button>
    </div>
</Navbar>

<div class="mt-3">@status</div>

@code {
    private string? query;
    private string? username;
    private string? status;

    private void Search() => status = string.IsNullOrWhiteSpace(query) ? "Type something to search." : $"Searching for \"{query}\".";
}
