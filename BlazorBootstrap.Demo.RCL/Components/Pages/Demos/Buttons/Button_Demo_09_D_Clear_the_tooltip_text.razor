<div class="mb-3">
    <Button Color="ButtonColor.Primary" TooltipTitle="@text" TooltipPlacement="TooltipPlacement.Top"> Tooltip Top </Button>
</div>

<Button Type="ButtonType.Button" Color="ButtonColor.Primary" @onclick="SetTooltip">Set Tooltip</Button>
<Button Type="ButtonType.Button" Color="ButtonColor.Secondary" @onclick="ClearTooltip">Clear Tooltip</Button>

@code {
    private string? text = "Tooltip text";

    private void SetTooltip() => text = $"Updated {DateTime.Now.ToLongTimeString()}";

    private void ClearTooltip() => text = string.Empty;
}
