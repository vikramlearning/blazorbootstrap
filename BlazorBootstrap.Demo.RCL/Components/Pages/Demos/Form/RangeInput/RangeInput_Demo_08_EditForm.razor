@using System.ComponentModel.DataAnnotations

<EditForm Model="@employee" OnValidSubmit="HandleOnValidSubmit">
    <DataAnnotationsValidator />

    <div class="form-group row mb-3">
        <label class="col-md-2 col-form-label">Name: <span class="text-danger">*</span></label>
        <div class="col-md-10">
            <TextInput @bind-Value="@employee.Name" Placeholder="Enter name" />
            <ValidationMessage For="@(() => employee.Name)" />
        </div>
    </div>

    <div class="form-group row mb-3">
        <label class="col-md-2 col-form-label">Experience:</label>
        <div class="col-md-10 d-flex flex-row align-items-center">
            <RangeInput TValue="int" Value="@employee.Experience" ValueChanged="OnExperienceChanged" Min="0" Max="40" />
            <Badge Color="BadgeColor.Primary" Class="ms-2" VisuallyHiddenText="experience">@employee.Experience</Badge>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <Button Type="ButtonType.Submit" Color="ButtonColor.Success" Class="float-end">Submit</Button>
        </div>
    </div>
</EditForm>

<div class="mt-3">@submitMessage</div>

@code {
    private Employee employee = new();
    private string? submitMessage;

    private void OnExperienceChanged(int value)
    {
        employee.Experience = value;
        submitMessage = null;
    }

    private void HandleOnValidSubmit()
    {
        submitMessage = $"Submitted: {employee.Name} ({employee.Experience} years)";
    }

    public class Employee
    {
        [Required(ErrorMessage = "Name required.")]
        public string? Name { get; set; }

        public int Experience { get; set; } = 5;
    }
}
