@page "/"
@layout EmptyLayout
@inherits BlazorBootstrapComponentBase
@using BlazorBootstrap.Demo.RCL.Components.Pages.Showcase.Shared
@using BlazorBootstrap.Demo.RCL.Services.Showcase

<PageTitle>Blazor Bootstrap Components Examples & Demos | Blazor Bootstrap</PageTitle>

<PageMetaTags PageUrl="@pageUrl" Title="@title" Description="@description" ImageUrl="@imageUrl" />

<section class="bd-masthead bd-home pb-4" id="content" aria-labelledby="home-title">
    <div class="container-xxl bd-gutter">
        <div class="col-md-8 mx-auto text-center">
            <img src="images/logo/logo.svg" width="184" height="165" alt="Blazor Bootstrap" class="bb-site-brand d-block mx-auto mb-3">
            <a class="bd-home-notice d-inline-flex flex-column flex-lg-row justify-content-center align-items-center gap-2 mb-4 lh-sm text-decoration-none"
               href="@releaseNotesUrl" target="_blank" rel="noopener">
                <strong class="d-inline-block p-2 rounded-3 masthead-notice">New in @version</strong>
                <span class="text-body">@releaseShortDescription</span>
            </a>
            <h1 class="mb-3 fw-semibold" id="home-title">Build fast, responsive sites with Blazor Bootstrap</h1>
            <p class="lead mb-4">
                High-performance, lightweight, and responsive Blazor Bootstrap components in a single package from the developers for the developers.
            </p>
            <div class="d-flex flex-column flex-sm-row justify-content-center gap-2 mb-4">
                <a class="btn btn-primary btn-lg px-4" href="@GettingStartedUrl">Get started</a>
                <a class="btn btn-lg px-4 bd-home-browse" href="#components">Browse components</a>
            </div>
            <div class="bd-home-install d-inline-flex align-items-center gap-2 ps-3 pe-1 py-1 rounded-3 mw-100">
                <code class="text-body text-wrap text-break">@InstallCommand</code>
                <button type="button" class="btn btn-sm bd-home-copy" aria-label="Copy install command" @onclick="CopyInstallCommandAsync">
                    <Icon Name="@(copyStatus == CopiedText ? IconName.Check2 : IconName.Clipboard)" aria-hidden="true" />
                </button>
                <span class="visually-hidden" role="status">@copyStatus</span>
            </div>
            <p class="mt-3 mb-0">Currently <strong>@version</strong></p>
            @if (stats.Count > 0)
            {
                <dl class="bd-home-stats d-flex flex-wrap justify-content-center gap-3 mt-4 mb-0">
                    @foreach (var stat in stats)
                    {
                        <div class="position-relative d-flex flex-column-reverse px-3 py-2 rounded-3">
                            <dt class="small fw-normal text-body-secondary">
                                @if (stat.Url is null)
                                {
                                    @stat.Label
                                }
                                else
                                {
                                    @* The stretched link makes the whole box clickable; its name stays the stat label. *@
                                    <a class="stretched-link text-reset" href="@stat.Url">@stat.Label</a>
                                }
                            </dt>
                            <dd class="fs-4 fw-semibold mb-0">@stat.Value</dd>
                        </div>
                    }
                </dl>
            }
            <aside class="bd-home-ad mt-4" aria-label="Advertisement">
                <CarbonAds Class="bd-home-ad-slot d-flex justify-content-center align-items-start" />
            </aside>
        </div>
    </div>
</section>

@if (ShowcaseCatalog.IsPublished)
{
<section class="container bd-gutter bd-home mb-5" aria-labelledby="home-showcase-heading">
    <div class="col-lg-7 mb-4 mx-auto text-md-center">
        <h2 class="mb-3 fw-semibold lh-sm" id="home-showcase-heading">Showcase <Badge Color="BadgeColor.Success">New</Badge></h2>
        <p class="text-muted mb-0">See what you can build: @ShowcaseCatalog.Sites.Count complete, interactive sample websites made only with Blazor Bootstrap components.</p>
    </div>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3">
        @foreach (var site in ShowcaseCatalog.Sites.Take(4))
        {
            <div class="col">
                <a class="card h-100 text-decoration-none overflow-hidden" href="@site.Url">
                    <ShowcaseShot Site="site" />
                    <span class="card-body">
                        <span class="d-block fw-semibold text-body">@site.Name</span>
                        <small class="text-muted">@site.Tagline</small>
                    </span>
                </a>
            </div>
        }
    </div>
    <div class="text-md-center mt-4">
        <a class="btn btn-primary" href="@DemoRouteConstants.Showcase_URL_Prefix">Explore the Showcase <Icon Name="IconName.ArrowRight" class="ms-1" aria-hidden="true" /></a>
    </div>
</section>
}

<section class="container bd-gutter bd-home mb-5" id="components" aria-labelledby="components-heading">
    <div class="col-lg-7 mb-4 mx-auto text-md-center">
        <h2 class="mb-3 fw-semibold lh-sm" id="components-heading">Components</h2>
        <p class="text-body-secondary mb-0">Every Blazor Bootstrap component, grouped by category. Each card opens its demo.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <label class="form-label fw-semibold" for="home-filter">Filter components</label>
            <input type="search" id="home-filter" class="form-control" autocomplete="off" aria-describedby="home-filter-status"
                   @bind="filterText" @bind:event="oninput" />
            <p class="small text-body-secondary mt-2 mb-0" id="home-filter-status" role="status">@FilterStatusText</p>
        </div>
    </div>

    @foreach (var category in ShownCategories)
    {
        <h3 class="h5 fw-semibold mt-5 mb-3">@category.Name</h3>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
            @foreach (var item in category.Items)
            {
                <div class="col">
                    <div class="card h-100 bd-home-card">
                        <div class="card-body d-flex align-items-start gap-3">
                            <Icon Name="@item.Icon" class="fs-4 text-primary flex-shrink-0" aria-hidden="true" />
                            <div>
                                <a class="stretched-link fw-semibold text-decoration-none" href="@item.Href">
                                    @item.Name
                                    @* The explicit space keeps the link's accessible name "Avatar New", not "AvatarNew". *@
                                    @if (item.Badge == HomeCatalogBadge.New)
                                    {
                                        @(" ")<Badge Color="BadgeColor.Danger">New</Badge>
                                    }
                                    else if (item.Badge == HomeCatalogBadge.Updated)
                                    {
                                        @(" ")<Badge Color="BadgeColor.Success">Updated</Badge>
                                    }
                                </a>
                                <p class="small text-body-secondary mt-1 mb-0">@item.Description</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>
