@* The task form in a dialog, for a new task (from a project board) and for "Edit details" (on the task page). The page that
   opens it gets the outcome in OnClosed once the dialog is hidden, announces it, and moves focus back. *@
<Modal @ref="modal" IsVerticallyCentered="true" IsScrollable="true" ShowCloseButton="false" aria-labelledby="tb-editor-title"
       OnShown="OnShownAsync" OnHidden="OnHiddenAsync">
    <HeaderTemplate>
        <h2 class="modal-title h5 tb-editor-title" id="tb-editor-title">@DialogTitle</h2>
    </HeaderTemplate>
    <BodyTemplate>
        @{
            var project = State.FindProject(projectId);
            var members = Members(project);
            var current = State.FindPerson(string.IsNullOrEmpty(form.AssigneeId) ? null : form.AssigneeId);
        }

        @if (open && project is not null)
        {
            <EditForm id="tb-editor-form" EditContext="editContext" OnSubmit="SaveAsync" FormName="pb-task" novalidate>
                <DataAnnotationsValidator />
                <ShowcaseFormErrors ShowSummary="true" />
                <div class="mb-3">
                    <label class="form-label fw-semibold" for="tb-editor-name">Title</label>
                    <InputText @ref="titleInput" id="tb-editor-name" class="form-control" @bind-Value="form.Title" maxlength="@PbState.MaxTaskTitleLength" autocomplete="off"
                               aria-describedby="tb-editor-name-help" />
                    <div class="form-text" id="tb-editor-name-help">Required. Up to @PbState.MaxTaskTitleLength characters (@((form.Title ?? string.Empty).Length) now).</div>
                    <ValidationMessage For="() => form.Title" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="tb-editor-description">Description <span class="fw-normal text-body-secondary">(optional)</span></label>
                    <InputTextArea id="tb-editor-description" class="form-control" rows="4" @bind-Value="form.Description" maxlength="@PbState.MaxDescriptionLength"
                                   aria-describedby="tb-editor-description-help" />
                    <div class="form-text" id="tb-editor-description-help">Plain text, up to @PbState.MaxDescriptionLength characters. Line breaks are kept.</div>
                    <ValidationMessage For="() => form.Description" />
                </div>

                <div class="row g-3 mb-1">
                    @if (taskId == 0)
                    {
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold" for="tb-editor-column">Column</label>
                            <InputSelect id="tb-editor-column" class="form-select" @bind-Value="form.Status">
                                @foreach (var option in Enum.GetValues<PbTaskStatus>())
                                {
                                    <option value="@option" @key="option">@PbDisplay.StatusLabel(option)</option>
                                }
                            </InputSelect>
                        </div>
                    }
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold" for="tb-editor-assignee">Assignee</label>
                        <InputSelect id="tb-editor-assignee" class="form-select" @bind-Value="form.AssigneeId" aria-describedby="tb-editor-assignee-help">
                            <option value="">Unassigned</option>
                            @if (current is not null && members.All(person => person.Id != current.Id))
                            {
                                <option value="@current.Id">@current.Name (not on this project)</option>
                            }
                            @foreach (var person in members)
                            {
                                <option value="@person.Id" @key="person.Id">@person.Name@(person.Id == State.CurrentPerson?.Id ? " (you)" : null)</option>
                            }
                        </InputSelect>
                        <div class="form-text" id="tb-editor-assignee-help">People on @project.Key only. Someone else who can sign in is told.</div>
                        <ValidationMessage For="() => form.AssigneeId" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold" for="tb-editor-priority">Priority</label>
                        <InputSelect id="tb-editor-priority" class="form-select" @bind-Value="form.Priority">
                            @foreach (var option in Enum.GetValues<PbTaskPriority>())
                            {
                                <option value="@option" @key="option">@option</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold" for="tb-editor-due">Due date <span class="fw-normal text-body-secondary">(optional)</span></label>
                        <InputDate TValue="DateTime?" id="tb-editor-due" class="form-control" @bind-Value="form.DueDate"
                                   min="@project.StartDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" max="@project.DueDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                                   ParsingErrorMessage="Enter the due date as a full date, like 2026-12-03, or leave it empty." aria-describedby="tb-editor-due-help" />
                        <div class="form-text" id="tb-editor-due-help">Within @project.Key's dates, @PbDisplay.Date(project.StartDate) to @PbDisplay.Date(project.DueDate). Leave empty for no due date.</div>
                        <ValidationMessage For="() => form.DueDate" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold" for="tb-editor-estimate">Estimate in hours</label>
                        <InputNumber TValue="int?" id="tb-editor-estimate" class="form-control" @bind-Value="form.EstimateHours" inputmode="numeric" min="0" max="@PbState.MaxEstimateHours" step="1"
                                     ParsingErrorMessage="Enter the estimate as whole hours, like 8, or leave it empty." aria-describedby="tb-editor-estimate-help" />
                        <div class="form-text" id="tb-editor-estimate-help">Whole hours from 0 to @PbState.MaxEstimateHours. 0 or empty: no estimate.</div>
                        <ValidationMessage For="() => form.EstimateHours" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold" for="tb-editor-milestone">Milestone</label>
                        <InputSelect TValue="int?" id="tb-editor-milestone" class="form-select" @bind-Value="form.MilestoneId">
                            <option value="">None</option>
                            @foreach (var milestone in project.Milestones)
                            {
                                <option value="@milestone.Id" @key="milestone.Id">@milestone.Title (@PbDisplay.Date(milestone.Due))</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => form.MilestoneId" />
                    </div>
                </div>
            </EditForm>
        }
        else if (open)
        {
            <p class="mb-0">@(taskId == 0 ? "This project was deleted, so it can't take new tasks." : "This task or its project was deleted, so there's nothing to edit.")</p>
        }

        @* Always rendered, so a refusal from the board's state is announced; a counter makes a repeat announce again. *@
        <p class="tb-form-error small mt-3 mb-0" role="alert">@formError</p>
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-outline-secondary" @onclick="CancelAsync">Cancel</button>
        @if (State.FindProject(projectId) is not null)
        {
            <button type="submit" form="tb-editor-form" class="btn btn-primary" disabled="@saving">
                <Icon Name="@(taskId == 0 ? IconName.PlusLg : IconName.Check2)" class="me-1" aria-hidden="true" />@(taskId == 0 ? "Create task" : "Save changes")
            </button>
        }
    </FooterTemplate>
</Modal>
