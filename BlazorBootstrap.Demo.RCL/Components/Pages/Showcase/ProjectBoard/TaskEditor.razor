@* The task form in a dialog, for a new task (from a project board) and for "Edit details" (on the task page). The page that
   opens it gets the outcome in OnClosed once the dialog is hidden, announces it, and moves focus back. *@
<Modal @ref="modal" IsVerticallyCentered="true" IsScrollable="true" ShowCloseButton="false" aria-labelledby="tb-editor-title"
       OnShown="OnShownAsync" OnHidden="OnHiddenAsync">
    <HeaderTemplate>
        <h2 class="modal-title h5 tb-editor-title" id="tb-editor-title">@DialogTitle</h2>
    </HeaderTemplate>
    <BodyTemplate>
        @{
            var project = State.FindProject(projectId);
            var members = Members(project);
            var current = State.FindPerson(assigneeId.Length == 0 ? null : assigneeId);
        }

        @* Always rendered, so a refusal from the board's state is announced. *@
        <p class="tb-editor-status fw-semibold text-danger-emphasis" role="status" tabindex="-1" @ref="formStatus">@formError</p>

        @if (open && project is not null)
        {
            <form id="tb-editor-form" @onsubmit="SaveAsync" novalidate aria-labelledby="tb-editor-title">
                <div class="mb-3">
                    <label class="form-label fw-semibold" for="tb-editor-name">Title</label>
                    <input id="tb-editor-name" class="@InputClass("form-control", titleError)" @bind="title" @bind:event="oninput" @ref="titleInput"
                           maxlength="@PbState.MaxTaskTitleLength" autocomplete="off" aria-required="true"
                           aria-invalid="@(titleError is null ? null : "true")" aria-describedby="tb-editor-name-help tb-editor-name-error" />
                    <div class="form-text" id="tb-editor-name-help">Required. Up to @PbState.MaxTaskTitleLength characters (@title.Length now).</div>
                    <div class="invalid-feedback d-block" id="tb-editor-name-error">@titleError</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="tb-editor-description">Description <span class="fw-normal text-body-secondary">(optional)</span></label>
                    <textarea id="tb-editor-description" class="@InputClass("form-control", descriptionError)" rows="4" @bind="description" @ref="descriptionInput"
                              maxlength="@PbState.MaxDescriptionLength" aria-invalid="@(descriptionError is null ? null : "true")"
                              aria-describedby="tb-editor-description-help tb-editor-description-error"></textarea>
                    <div class="form-text" id="tb-editor-description-help">Plain text, up to @PbState.MaxDescriptionLength characters. Line breaks are kept.</div>
                    <div class="invalid-feedback d-block" id="tb-editor-description-error">@descriptionError</div>
                </div>

                <div class="row g-3 mb-3">
                    @if (taskId == 0)
                    {
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold" for="tb-editor-column">Column</label>
                            <select id="tb-editor-column" class="form-select" @bind="status">
                                @foreach (var option in Enum.GetValues<PbTaskStatus>())
                                {
                                    <option value="@option" @key="option">@PbDisplay.StatusLabel(option)</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold" for="tb-editor-assignee">Assignee</label>
                        <select id="tb-editor-assignee" class="@InputClass("form-select", assigneeError)" @bind="assigneeId" @ref="assigneeInput"
                                aria-invalid="@(assigneeError is null ? null : "true")" aria-describedby="tb-editor-assignee-help tb-editor-assignee-error">
                            <option value="">Unassigned</option>
                            @if (current is not null && members.All(person => person.Id != current.Id))
                            {
                                <option value="@current.Id">@current.Name (not on this project)</option>
                            }
                            @foreach (var person in members)
                            {
                                <option value="@person.Id" @key="person.Id">@person.Name@(person.Id == State.CurrentPerson?.Id ? " (you)" : null)</option>
                            }
                        </select>
                        <div class="form-text" id="tb-editor-assignee-help">People on @project.Key only.</div>
                        <div class="invalid-feedback d-block" id="tb-editor-assignee-error">@assigneeError</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold" for="tb-editor-priority">Priority</label>
                        <select id="tb-editor-priority" class="form-select" @bind="priority">
                            @foreach (var option in Enum.GetValues<PbTaskPriority>())
                            {
                                <option value="@option" @key="option">@option</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold" for="tb-editor-due">Due date <span class="fw-normal text-body-secondary">(optional)</span></label>
                        <input id="tb-editor-due" type="date" class="@InputClass("form-control", dueError)" value="@dueText" @onchange="args => dueText = args.Value?.ToString() ?? string.Empty" @ref="dueInput"
                               min="@MinDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" max="@MaxDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                               aria-invalid="@(dueError is null ? null : "true")" aria-describedby="tb-editor-due-help tb-editor-due-error" />
                        <div class="form-text" id="tb-editor-due-help">Leave empty for no due date.</div>
                        <div class="invalid-feedback d-block" id="tb-editor-due-error">@dueError</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold" for="tb-editor-estimate">Estimate in hours</label>
                        <input id="tb-editor-estimate" type="number" inputmode="numeric" class="@InputClass("form-control", estimateError)" @bind="estimateText" @ref="estimateInput"
                               min="0" max="@PbState.MaxEstimateHours" step="1" aria-invalid="@(estimateError is null ? null : "true")"
                               aria-describedby="tb-editor-estimate-help tb-editor-estimate-error" />
                        <div class="form-text" id="tb-editor-estimate-help">Whole hours from 0 to @PbState.MaxEstimateHours. 0 or empty: no estimate.</div>
                        <div class="invalid-feedback d-block" id="tb-editor-estimate-error">@estimateError</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold" for="tb-editor-milestone">Milestone</label>
                        <select id="tb-editor-milestone" class="@InputClass("form-select", milestoneError)" @bind="milestoneText" @ref="milestoneInput"
                                aria-invalid="@(milestoneError is null ? null : "true")" aria-describedby="tb-editor-milestone-error">
                            <option value="">None</option>
                            @foreach (var milestone in project.Milestones)
                            {
                                <option value="@milestone.Id" @key="milestone.Id">@milestone.Title (@PbDisplay.Date(milestone.Due))</option>
                            }
                        </select>
                        <div class="invalid-feedback d-block" id="tb-editor-milestone-error">@milestoneError</div>
                    </div>
                </div>
            </form>
        }
        else if (open)
        {
            <p class="mb-0">@(taskId == 0 ? "This project was deleted, so it can't take new tasks." : "This task or its project was deleted, so there's nothing to edit.")</p>
        }
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-outline-secondary" @onclick="CancelAsync">Cancel</button>
        @if (State.FindProject(projectId) is not null)
        {
            <button type="submit" form="tb-editor-form" class="btn btn-primary" disabled="@saving">
                <Icon Name="@(taskId == 0 ? IconName.PlusLg : IconName.Check2)" class="me-1" aria-hidden="true" />@(taskId == 0 ? "Create task" : "Save changes")
            </button>
        }
    </FooterTemplate>
</Modal>
