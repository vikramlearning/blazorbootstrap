@page "/showcase/project-board/clients/new"
@page "/showcase/project-board/clients/{Id:int}/edit"
@layout PbWorkLayout

@{
    var client = Client;
}

<PageTitle>@(Id is null ? "New client" : client is null ? "Client not found" : $"Edit {client.Name}") · @PbSeedData.ProductName</PageTitle>

<div class="container-fluid px-lg-4">
    <PbRoleGuard Role="@PbSeedData.AccountManagerRole">
        @if (leaving)
        {
            @* The client was just deleted and the list is loading: no not-found flash in between. *@
            <p class="visually-hidden" role="status">The client is deleted. Going back to the client list.</p>
        }
        else if (Id is not null && client is null)
        {
            <PbNotFound Message="This client was deleted, or the link is wrong. Open it from the client list." />
        }
        else
        {
            var owners = State.AccountManagers;

            <nav aria-label="Breadcrumb" class="mb-2">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="@DealDisplay.ClientsUrl">Clients</a></li>
                    @if (client is not null)
                    {
                        <li class="breadcrumb-item pb-cledit-crumb"><a href="@PbDisplay.ClientUrl(client.Id)">@client.Name</a></li>
                    }
                    <li class="breadcrumb-item active" aria-current="page">@(client is null ? "New client" : "Edit")</li>
                </ol>
            </nav>

            <h1 class="tb-title mb-1">@(client is null ? "New client" : $"Edit {client.Name}")</h1>
            <p class="tb-lead">
                @(client is null
                    ? "Add a company you work with. You can add its contacts, deals, and notes on its page next."
                    : "Change the client's details, who owns the relationship, or how and when it is billed.")
            </p>

            @* Always rendered and focusable, so a save is announced and focus has somewhere to go when it fails. *@
            <p class="fw-semibold pb-cledit-status @(statusIsError ? "text-danger-emphasis" : null)" role="status" tabindex="-1" @ref="statusRegion">@statusMessage</p>

            <div class="row g-4">
                <div class="col-xl-8">
                    <EditForm EditContext="editContext" OnSubmit="SaveAsync" FormName="pb-client" novalidate>
                        <DataAnnotationsValidator />
                        <ShowcaseFormErrors ShowSummary="true" />

                        <section class="tb-panel mb-4" aria-labelledby="pb-cledit-form-title">
                            <h2 class="tb-section-title" id="pb-cledit-form-title">Client details</h2>
                            <div class="mb-3">
                                <label class="form-label fw-semibold" for="pb-cledit-name">Name</label>
                                <InputText id="pb-cledit-name" class="form-control" @bind-Value="form.Name" maxlength="@PbState.MaxClientNameLength" autocomplete="off"
                                           aria-describedby="pb-cledit-name-help" />
                                <ShowcaseUniqueCheck @ref="nameCheck" For="() => form.Name" IsTakenAsync="IsNameTakenAsync" TakenMessage="NameTakenMessage" />
                                <div class="form-text d-flex flex-wrap justify-content-between gap-2 mt-0" id="pb-cledit-name-help">
                                    <span>The company's name. Each client's name is different.</span>
                                    <span class="text-nowrap">@DealDisplay.CounterText(form.Name, PbState.MaxClientNameLength)</span>
                                </div>
                                <ValidationMessage For="() => form.Name" />
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-sm-6">
                                    <label class="form-label fw-semibold" for="pb-cledit-industry">Industry</label>
                                    <InputText id="pb-cledit-industry" class="form-control" @bind-Value="form.Industry" maxlength="@PbState.MaxContactFieldLength" autocomplete="off"
                                               aria-describedby="pb-cledit-industry-help" />
                                    <div class="form-text" id="pb-cledit-industry-help">Like Retail or Healthcare. Up to @PbState.MaxContactFieldLength characters.</div>
                                    <ValidationMessage For="() => form.Industry" />
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label fw-semibold" for="pb-cledit-website">Website <span class="fw-normal text-body-secondary">(optional)</span></label>
                                    <InputText id="pb-cledit-website" class="form-control" @bind-Value="form.Website" maxlength="@PbState.MaxWebsiteLength" autocomplete="off" spellcheck="false"
                                               autocapitalize="none" aria-describedby="pb-cledit-website-help" />
                                    <div class="form-text" id="pb-cledit-website-help">A domain like example.com. It's shown as text, not as a link.</div>
                                    <ValidationMessage For="() => form.Website" />
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <label class="form-label fw-semibold" for="pb-cledit-owner">Owner</label>
                                    <InputSelect id="pb-cledit-owner" class="form-select" @bind-Value="form.OwnerId" aria-describedby="pb-cledit-owner-help">
                                        @if (owners.All(person => person.Id != form.OwnerId))
                                        {
                                            <option value="">Choose an account manager</option>
                                        }
                                        @foreach (var owner in owners)
                                        {
                                            <option value="@owner.Id" @key="owner.Id">@owner.Name@(owner.Id == State.CurrentPerson?.Id ? " (you)" : null)</option>
                                        }
                                    </InputSelect>
                                    <div class="form-text" id="pb-cledit-owner-help">The account manager who looks after the relationship. Someone else who can sign in is told.</div>
                                    <ValidationMessage For="() => form.OwnerId" />
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label fw-semibold" for="pb-cledit-phone">Phone <span class="fw-normal text-body-secondary">(optional)</span></label>
                                    <InputText id="pb-cledit-phone" type="tel" class="form-control" @bind-Value="form.Phone" maxlength="@PbState.MaxPhoneLength" autocomplete="off"
                                               aria-describedby="pb-cledit-phone-help" />
                                    <div class="form-text" id="pb-cledit-phone-help">The main number, like +1 555 0100: digits, spaces, and + - ( ) .</div>
                                    <ValidationMessage For="() => form.Phone" />
                                </div>
                            </div>
                        </section>

                        <section class="tb-panel mb-3" aria-labelledby="pb-cledit-billing-title">
                            <h2 class="tb-section-title" id="pb-cledit-billing-title">Billing and contract</h2>
                            <p class="small text-body-secondary">Where the client's invoices go and in which currency, and the dates of the current contract.</p>
                            <div class="row g-3 mb-3">
                                <div class="col-sm-5 col-md-4">
                                    <label class="form-label fw-semibold" for="pb-cledit-currency">Billing currency</label>
                                    <InputSelect id="pb-cledit-currency" class="form-select" @bind-Value="form.BillingCurrency" aria-describedby="pb-cledit-currency-help">
                                        @if (!PbSeedData.Currencies.Contains(form.BillingCurrency))
                                        {
                                            <option value="">Choose a currency</option>
                                        }
                                        @foreach (var currency in PbSeedData.Currencies)
                                        {
                                            <option value="@currency" @key="currency">@currency · @CurrencyName(currency)</option>
                                        }
                                    </InputSelect>
                                    <div class="form-text" id="pb-cledit-currency-help">Project budgets are in this currency.</div>
                                    <ValidationMessage For="() => form.BillingCurrency" />
                                </div>
                                <div class="col-sm-7 col-md-8">
                                    <label class="form-label fw-semibold" for="pb-cledit-billing">Billing email <span class="fw-normal text-body-secondary">(optional)</span></label>
                                    <InputText id="pb-cledit-billing" inputmode="email" autocapitalize="none" spellcheck="false" class="form-control" @bind-Value="form.BillingEmail"
                                               maxlength="@ShowcaseIdentity.MaxEmailLength" autocomplete="off" aria-describedby="pb-cledit-billing-help" />
                                    <div class="form-text" id="pb-cledit-billing-help">Where invoices go, like accounts@example.com. Demo only: nothing is sent.</div>
                                    <ValidationMessage For="() => form.BillingEmail" />
                                </div>
                            </div>
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <label class="form-label fw-semibold" for="pb-cledit-start">Contract start <span class="fw-normal text-body-secondary">(optional)</span></label>
                                    <InputDate TValue="DateTime?" id="pb-cledit-start" class="form-control" @bind-Value="form.ContractStart" min="@DateValue(MinDate)" max="@DateValue(MaxDate)"
                                               ParsingErrorMessage="Enter the contract start as a full date, like 2026-12-01." />
                                    <ValidationMessage For="() => form.ContractStart" />
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label fw-semibold" for="pb-cledit-end">Contract end <span class="fw-normal text-body-secondary">(optional)</span></label>
                                    <InputDate TValue="DateTime?" id="pb-cledit-end" class="form-control" @bind-Value="form.ContractEnd" min="@DateValue(form.ContractStart ?? MinDate)" max="@DateValue(MaxDate)"
                                               ParsingErrorMessage="Enter the contract end as a full date, like 2027-11-30." aria-describedby="pb-cledit-end-help" />
                                    <div class="form-text" id="pb-cledit-end-help">On or after the start. Leave empty for a contract that runs until cancelled.</div>
                                    <ValidationMessage For="() => form.ContractEnd" />
                                </div>
                            </div>
                        </section>

                        @* Always rendered, so a new error is announced; a counter makes a repeat announce again. *@
                        <p class="tb-form-error mb-3" role="alert">@errorMessage</p>

                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <Button Type="ButtonType.Submit" Color="ButtonColor.Primary" Disabled="busy">
                                <Icon Name="@(client is null ? IconName.PlusLg : IconName.CheckLg)" class="me-1" aria-hidden="true" />@(client is null ? "Add client" : "Save changes")
                            </Button>
                            <a class="btn btn-link" href="@(client is null ? DealDisplay.ClientsUrl : PbDisplay.ClientUrl(client.Id))">Cancel</a>
                        </div>
                    </EditForm>
                </div>

                @if (client is not null)
                {
                    var blockers = Blockers(client);
                    <div class="col-xl-4">
                        <section class="tb-panel" aria-labelledby="pb-cledit-delete-title">
                            <h2 class="tb-section-title" id="pb-cledit-delete-title">Delete client</h2>
                            <p class="small">
                                @(blockers.Count == 0
                                    ? $"{DeleteConsequence(client)} This can't be undone."
                                    : $"{client.Name} has projects or deals, so it can't be deleted. Delete says which.")
                            </p>
                            <Button @ref="deleteButton" Color="ButtonColor.Danger" Outline="true" @onclick="OpenDeleteAsync">
                                <Icon Name="IconName.Trash3" class="me-1" aria-hidden="true" />Delete<span class="visually-hidden">&#32;@client.Name</span>
                            </Button>
                        </section>
                    </div>

                    <Modal @ref="deleteModal" IsVerticallyCentered="true" IsScrollable="true" ShowCloseButton="false" aria-labelledby="pb-cledit-dialog-title" OnHidden="OnDeleteHidden">
                        <HeaderTemplate>
                            <h2 class="modal-title h5 pb-cledit-dialog-title" id="pb-cledit-dialog-title">@(blockers.Count == 0 ? $"Delete {client.Name}?" : $"{client.Name} can't be deleted")</h2>
                        </HeaderTemplate>
                        <BodyTemplate>
                            @if (blockers.Count > 0)
                            {
                                <p>A client with projects or deals keeps its history. It still has:</p>
                                <ul class="pb-cledit-blockers">
                                    @foreach (var project in State.Projects.Where(project => project.ClientId == client.Id))
                                    {
                                        <li @key="@($"p-{project.Id}")">Project <a href="@PbDisplay.ProjectUrl(project.Id)">@project.Key · @project.Name</a> (@PbDisplay.ProjectStatusLabel(project.Status).ToLowerInvariant())</li>
                                    }
                                    @foreach (var deal in State.DealsOf(client.Id))
                                    {
                                        <li @key="@($"d-{deal.Id}")">Deal “@deal.Title” (@PbDisplay.StageLabel(deal.Stage).ToLowerInvariant(), @PbDisplay.Money(deal.Value))</li>
                                    }
                                </ul>
                                <p class="mb-0">A project manager can delete its projects, and you can delete its deals on the <a href="@DealDisplay.PipelineUrl">deal pipeline</a> (a won deal only once its project is gone).</p>
                            }
                            else
                            {
                                <p class="mb-0">@DeleteConsequence(client) This can't be undone.</p>
                            }
                        </BodyTemplate>
                        <FooterTemplate>
                            <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => deleteModal.HideAsync()">@(blockers.Count == 0 ? "Cancel" : "Close")</Button>
                            @if (blockers.Count == 0)
                            {
                                <Button Color="ButtonColor.Danger" @onclick="ConfirmDeleteAsync"><Icon Name="IconName.Trash3" class="me-1" aria-hidden="true" />Delete client</Button>
                            }
                        </FooterTemplate>
                    </Modal>
                }
            </div>
        }
    </PbRoleGuard>
</div>
