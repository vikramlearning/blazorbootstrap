@* The deal form of the pipeline and the client page, in a dialog: client, title, value, expected close date, and (for a new
   deal) its stage. The page opens it with OpenNewAsync or OpenEditAsync and hears back in OnClosed once the dialog is
   hidden, so it can announce the outcome and move focus back. *@
<Modal @ref="modal" IsVerticallyCentered="true" IsScrollable="true" ShowCloseButton="false" aria-labelledby="pb-deal-editor-title" OnShown="OnShownAsync" OnHidden="OnHiddenAsync">
    <HeaderTemplate>
        <h2 class="modal-title h5 pb-deal-editor-title" id="pb-deal-editor-title">@DialogTitle</h2>
    </HeaderTemplate>
    <BodyTemplate>
        @{
            var clients = State.Clients;
            var existing = dealId == 0 ? null : State.FindDeal(dealId);
        }
        <EditForm id="pb-deal-editor-form" EditContext="editContext" OnSubmit="SaveAsync" FormName="pb-deal" novalidate>
            <DataAnnotationsValidator />
            <ShowcaseFormErrors ShowSummary="true" />
            <p class="small text-body-secondary" id="pb-deal-editor-help">
                @(dealId == 0
                    ? "A new deal is owned by you. Move it along the pipeline as it progresses."
                    : $"Only open deals can be edited. It's in {PbDisplay.StageLabel(existing?.Stage ?? PbDealStage.Lead)}; its stage changes on the pipeline board.")
            </p>

            <div class="mb-3">
                <label class="form-label fw-semibold" for="pb-deal-editor-client">Client</label>
                <InputSelect @ref="clientInput" TValue="int" id="pb-deal-editor-client" class="form-select" @bind-Value="form.ClientId">
                    <option value="0">Choose a client</option>
                    @foreach (var client in clients)
                    {
                        <option value="@client.Id" @key="client.Id">@client.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => form.ClientId" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold" for="pb-deal-editor-title-input">Title</label>
                <InputText @ref="titleInput" id="pb-deal-editor-title-input" class="form-control" @bind-Value="form.Title" maxlength="@PbState.MaxDealTitleLength" autocomplete="off"
                           aria-describedby="pb-deal-editor-title-help" />
                <div class="form-text d-flex flex-wrap justify-content-between gap-2" id="pb-deal-editor-title-help">
                    <span>What the client is buying, like "Spring campaign site".</span>
                    <span class="text-nowrap">@DealDisplay.CounterText(form.Title ?? string.Empty, PbState.MaxDealTitleLength)</span>
                </div>
                <ValidationMessage For="() => form.Title" />
            </div>

            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="form-label fw-semibold" for="pb-deal-editor-value">Value (dollars)</label>
                    <InputNumber TValue="int?" id="pb-deal-editor-value" class="form-control" @bind-Value="form.Value" inputmode="numeric" step="1" min="1" max="@PbState.MaxDealValue"
                                 ParsingErrorMessage="Enter the value as a whole number of dollars, without a dollar sign or decimals." aria-describedby="pb-deal-editor-value-help" />
                    <div class="form-text" id="pb-deal-editor-value-help">Whole dollars, from 1 to @PbDisplay.Money(PbState.MaxDealValue).</div>
                    <ValidationMessage For="() => form.Value" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label fw-semibold" for="pb-deal-editor-close">Expected close date</label>
                    <InputDate TValue="DateTime?" id="pb-deal-editor-close" class="form-control" @bind-Value="form.CloseDate" min="@DealDisplay.ToDateInput(State.Clock.Today)"
                               max="@DealDisplay.ToDateInput(MaxDate)" ParsingErrorMessage="Enter the expected close date as a full date." aria-describedby="pb-deal-editor-close-help" />
                    <div class="form-text" id="pb-deal-editor-close-help">Today or later: when you expect it to be won or lost. The forecast counts it in that month.</div>
                    <ValidationMessage For="() => form.CloseDate" />
                </div>
                @if (dealId == 0)
                {
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold" for="pb-deal-editor-stage">Stage</label>
                        <InputSelect TValue="PbDealStage?" id="pb-deal-editor-stage" class="form-select" @bind-Value="form.Stage" aria-describedby="pb-deal-editor-stage-help">
                            <option value="">Choose a stage</option>
                            @foreach (var stage in DealDisplay.OpenStages)
                            {
                                <option value="@stage" @key="stage">@PbDisplay.StageLabel(stage) (@DealDisplay.Percent(PbState.Probability(stage)) chance)</option>
                            }
                        </InputSelect>
                        <div class="form-text" id="pb-deal-editor-stage-help">An open stage. Won and Lost are set on the pipeline, where Won creates the project.</div>
                        <ValidationMessage For="() => form.Stage" />
                    </div>
                }
            </div>
        </EditForm>

        @* Always rendered, so a refusal from the board is announced inside the dialog; a counter makes a repeat announce again. *@
        <p class="tb-form-error small mt-3 mb-0" role="alert">@formMessage</p>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Outline="true" @onclick="CancelAsync">Cancel</Button>
        <button type="submit" form="pb-deal-editor-form" class="btn btn-primary">
            <Icon Name="@(dealId == 0 ? IconName.PlusLg : IconName.CheckLg)" class="me-1" aria-hidden="true" />@(dealId == 0 ? "Add deal" : "Save deal")
        </button>
    </FooterTemplate>
</Modal>
