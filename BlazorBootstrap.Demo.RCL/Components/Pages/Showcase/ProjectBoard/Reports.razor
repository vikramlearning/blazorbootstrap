@page "/showcase/project-board/reports"
@layout PbWorkLayout

<PageTitle>Reports · @PbSeedData.ProductName</PageTitle>

<div class="container-fluid px-lg-4">
    <PbRoleGuard Role="@PbSeedData.ProjectManagerRole">
        @{
            var today = State.Clock.Today;
            var tasks = State.AllTasks;
            var weeks = State.CompletedPerWeek(ThroughputWeeks);
            var overdue = tasks.Where(task => PbDisplay.IsOverdue(task, today)).OrderBy(task => task.DueDate).ThenBy(task => task.Id).ToList();
            var openByStatus = openStatuses.Select(status => (Status: status, Count: tasks.Count(task => task.Status == status))).ToList();
        }

        <div class="mb-4">
            <h1 class="tb-title">Reports</h1>
            <p class="tb-lead mb-0">How delivery is going across @PbSeedData.AgencyName's projects: open and overdue work, tasks finished each week, and each project's progress.</p>
        </div>

        <section aria-label="Totals" class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4">
            @foreach (var kpi in Kpis(tasks, weeks, overdue.Count, today))
            {
                <div class="col" @key="kpi.Label">
                    <div class="tb-card tb-rp-kpi h-100">
                        <span class="tb-rp-kpi-label">@kpi.Label</span>
                        <span class="tb-rp-kpi-value">@kpi.Value</span>
                        <span class="small text-body-secondary">@kpi.Note</span>
                    </div>
                </div>
            }
        </section>

        <div class="row g-3 mb-4">
            <div class="col-xxl-8">
                <section class="tb-panel h-100" aria-labelledby="tb-rp-throughput-title">
                    <h2 class="tb-section-title mb-1" id="tb-rp-throughput-title">Tasks done per week</h2>
                    <p class="small text-body-secondary">The last @ThroughputWeeks weeks, Monday to Sunday, this week last (so far)</p>
                    <ReportsChart AriaLabel="@($"Bar chart of tasks done per week, the last {ThroughputWeeks} weeks. Summary and data table follow.")"
                                  Labels="weeks.Select(week => ShortDate(week.WeekStart)).ToList()"
                                  Series="ThroughputSeries(weeks)"
                                  Height="280" />
                    <p class="small mt-3 mb-2">@ThroughputSummary(weeks)</p>
                    <details class="tb-rp-details">
                        <summary>Tasks done per week as a table</summary>
                        <Table Data="weeks" Class="table-sm mb-0" Responsive="true" TableContainerClass="mt-2" RowKeySelector="week => week.WeekStart"
                               Caption="Tasks done and their estimated hours per week, oldest first" VisuallyHiddenCaption="true">
                            <TableColumn HeaderText="Week of" IsRowHeader="true" ColumnClass="@(_ => "fw-semibold text-nowrap")" Context="week">@PbDisplay.Date(week.WeekStart)@(week.WeekStart == PbState.WeekStart(today) ? " (this week)" : null)</TableColumn>
                            <TableColumn HeaderText="Tasks done" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End" ColumnClass="@(_ => "tb-mono")" Context="week">@week.Tasks</TableColumn>
                            <TableColumn HeaderText="Hours done" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End" ColumnClass="@(_ => "tb-mono")" Context="week">@week.Hours h</TableColumn>
                        </Table>
                    </details>
                </section>
            </div>
            <div class="col-xxl-4">
                <section class="tb-panel h-100" aria-labelledby="tb-rp-status-title">
                    <h2 class="tb-section-title mb-1" id="tb-rp-status-title">Open tasks by status</h2>
                    <p class="small text-body-secondary">Every project, tasks not done yet</p>
                    @if (openByStatus.Sum(item => item.Count) == 0)
                    {
                        <p class="text-body-secondary mb-0">There are no open tasks.</p>
                    }
                    else
                    {
                        <ReportsChart Kind="ReportsChartKind.Doughnut"
                                      AriaLabel="Doughnut chart of open tasks by status. Summary and data table follow."
                                      Labels="openByStatus.Select(item => PbDisplay.StatusLabel(item.Status)).ToList()"
                                      Series="StatusSeries(openByStatus)"
                                      Height="280" />
                        <p class="small mt-3 mb-2">@StatusSummary(openByStatus)</p>
                        <details class="tb-rp-details">
                            <summary>Open tasks by status as a table</summary>
                            <Table Data="openByStatus" Class="table-sm mb-0" Responsive="true" TableContainerClass="mt-2" RowKeySelector="item => item.Status"
                                   Caption="Open tasks by status, in board order" VisuallyHiddenCaption="true">
                                <TableColumn HeaderText="Status" IsRowHeader="true" ColumnClass="@(_ => "fw-semibold")" Context="item">@PbDisplay.StatusLabel(item.Status)</TableColumn>
                                <TableColumn HeaderText="Tasks" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End" ColumnClass="@(_ => "tb-mono")" Context="item">@item.Count</TableColumn>
                                <TableColumn HeaderText="Share" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End" ColumnClass="@(_ => "tb-mono")" Context="item">@Share(item.Count, openByStatus.Sum(other => other.Count))</TableColumn>
                            </Table>
                        </details>
                    }
                </section>
            </div>
        </div>

        <section class="tb-panel mb-4" aria-labelledby="tb-rp-projects-title">
            <h2 class="tb-section-title" id="tb-rp-projects-title">Progress by project</h2>
            @if (State.Projects.Count == 0)
            {
                <p class="text-body-secondary mb-0">There are no projects yet.</p>
            }
            else
            {
                <Table Data="State.Projects" Class="align-middle mb-0 tb-rp-table" Responsive="true" RowKeySelector="project => project.Id" CaptionClass="tb-rp-caption"
                       Caption="Each project's tasks and estimated hours done, overdue tasks, and next milestone: active first, then planned, on hold, and completed.">
                    <TableColumn HeaderText="Project" IsRowHeader="true" ColumnClass="@(_ => "tb-rp-name")" Context="project">
                        <a href="@PbDisplay.ProjectUrl(project.Id)"><span class="tb-key me-1">@project.Key</span>@project.Name</a>
                    </TableColumn>
                    <TableColumn HeaderText="Status" Context="project"><Badge Color="@ManageProjects.StatusBadge(project.Status)">@PbDisplay.ProjectStatusLabel(project.Status)</Badge></TableColumn>
                    <TableColumn HeaderText="Tasks done" ColumnClass="@(_ => "tb-rp-progress")" Context="project">
                        @{
                            var progress = State.ProjectProgress(project.Id);
                            var percent = ManageProjects.Percent(progress.Done, progress.Total);
                        }
                        <Progress Height="6" Class="mb-1">
                            <ProgressBar Width="percent" Color="ProgressColor.Success"
                                         aria-label="@($"{project.Name}, tasks done")" aria-valuenow="@Math.Round(percent)" aria-valuemin="0" aria-valuemax="100"
                                         aria-valuetext="@ManageProjects.ProgressText(progress.Done, progress.Total)" />
                        </Progress>
                        <span class="small text-nowrap">@ManageProjects.ProgressText(progress.Done, progress.Total)</span>
                    </TableColumn>
                    <TableColumn HeaderText="Hours done" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End" ColumnClass="@(_ => "text-nowrap tb-mono")" Context="project">
                        @{
                            var projectTasks = State.TasksOf(project.Id);
                        }
                        @projectTasks.Where(task => task.Status == PbTaskStatus.Done).Sum(task => task.EstimateHours) of @projectTasks.Sum(task => task.EstimateHours) h
                    </TableColumn>
                    <TableColumn HeaderText="Overdue" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End" ColumnClass="@(project => LateCount(project) > 0 ? "text-nowrap text-danger-emphasis fw-semibold" : "text-nowrap")" Context="project">@(LateCount(project) == 0 ? "None" : LateCount(project).ToString(CultureInfo.InvariantCulture))</TableColumn>
                    <TableColumn HeaderText="Next milestone" ColumnClass="@(_ => "tb-rp-next")" Context="project">@NextMilestoneText(project, today)</TableColumn>
                </Table>
            }
        </section>

        <section class="tb-panel" aria-labelledby="tb-rp-overdue-title">
            <h2 class="tb-section-title" id="tb-rp-overdue-title">Overdue tasks (@overdue.Count)</h2>
            @if (overdue.Count == 0)
            {
                <p class="text-body-secondary mb-0">Nothing is overdue. Every open task is due today or later, or has no due date.</p>
            }
            else
            {
                <Table Data="overdue" Class="align-middle mb-0 tb-rp-table" Responsive="true" RowKeySelector="task => task.Id" CaptionClass="tb-rp-caption"
                       Caption="Open tasks past their due date, the longest overdue first">
                    <TableColumn HeaderText="Key" ColumnClass="@(_ => "text-nowrap")" Context="task"><span class="tb-key">@State.TaskKey(task)</span></TableColumn>
                    <TableColumn HeaderText="Task" IsRowHeader="true" ColumnClass="@(_ => "tb-rp-name")" Context="task"><a href="@PbDisplay.TaskUrl(task.Id)">@task.Title</a></TableColumn>
                    <TableColumn HeaderText="Project" ColumnClass="@(_ => "tb-rp-project")" Context="task">@(State.FindProject(task.ProjectId)?.Name ?? "Unknown project")</TableColumn>
                    <TableColumn HeaderText="Assignee" ColumnClass="@(_ => "text-nowrap")" Context="task">@(State.FindPerson(task.AssigneeId)?.Name ?? "Unassigned")</TableColumn>
                    <TableColumn HeaderText="Overdue by" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End" ColumnClass="@(_ => "text-nowrap fw-semibold text-danger-emphasis")" Context="task">@PbDisplay.Plural((today - task.DueDate!.Value.Date).Days, "day")</TableColumn>
                </Table>
            }
        </section>
    </PbRoleGuard>
</div>
