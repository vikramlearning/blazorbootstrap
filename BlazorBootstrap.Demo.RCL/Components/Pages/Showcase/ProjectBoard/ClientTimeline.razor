@* The activity section of the client page: a form to log a note, call, email, or meeting, and the client's timeline,
   newest first. People delete their own entries; entries Tandem recorded stay. *@
@{
    var entries = State.ActivitiesOf(ClientId);
    var deals = State.DealsOf(ClientId);
    var me = State.CurrentPerson?.Id;
}
<section class="tb-panel" aria-labelledby="pb-cltl-title">
    <h2 class="tb-section-title" id="pb-cltl-title">Activity timeline</h2>

    <form class="pb-cltl-form mb-4" @onsubmit="Log" novalidate aria-labelledby="pb-cltl-form-title">
        <h3 class="h6 fw-bold" id="pb-cltl-form-title">Log activity</h3>
        <div class="row g-3">
            <div class="col-sm-6">
                <label class="form-label fw-semibold" for="pb-cltl-kind">Kind</label>
                <select id="pb-cltl-kind" class="form-select" @bind="kind">
                    @foreach (var option in DealDisplay.LoggableKinds)
                    {
                        <option value="@option" @key="option">@DealDisplay.KindLabel(option)</option>
                    }
                </select>
            </div>
            <div class="col-sm-6">
                <label class="form-label fw-semibold" for="pb-cltl-deal">About a deal <span class="fw-normal text-body-secondary">(optional)</span></label>
                <select id="pb-cltl-deal" class="form-select @(dealError is null ? null : "is-invalid")" @bind="dealId" @ref="dealInput"
                        aria-invalid="@(dealError is null ? null : "true")" aria-describedby="pb-cltl-deal-error">
                    <option value="0">No deal</option>
                    @foreach (var deal in deals)
                    {
                        <option value="@deal.Id" @key="deal.Id">@deal.Title (@PbDisplay.StageLabel(deal.Stage).ToLowerInvariant())</option>
                    }
                </select>
                <div class="invalid-feedback d-block" id="pb-cltl-deal-error">@dealError</div>
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold" for="pb-cltl-text">What happened</label>
                <textarea id="pb-cltl-text" class="form-control @(textError is null ? null : "is-invalid")" rows="3" @bind="text" @bind:event="oninput" @ref="textInput"
                          maxlength="@PbState.MaxActivityLength" aria-required="true" aria-invalid="@(textError is null ? null : "true")"
                          aria-describedby="pb-cltl-text-help pb-cltl-text-error"></textarea>
                <div class="form-text d-flex flex-wrap justify-content-between gap-2" id="pb-cltl-text-help">
                    <span>Plain text; line breaks are kept. Your team sees it on this page and in Activity.</span>
                    <span class="text-nowrap">@DealDisplay.CounterText(text, PbState.MaxActivityLength)</span>
                </div>
                <div class="invalid-feedback d-block" id="pb-cltl-text-error">@textError</div>
            </div>
        </div>
        <Button Type="ButtonType.Submit" Color="ButtonColor.Primary" Class="mt-3">
            <Icon Name="IconName.PlusLg" class="me-1" aria-hidden="true" />Log activity
        </Button>
    </form>

    @* Always rendered and focusable, so logging and deleting are announced and focus has somewhere to go. *@
    <p class="fw-semibold pb-cltl-status @(statusIsError ? "text-danger-emphasis" : null)" role="status" tabindex="-1" @ref="statusRegion">@statusMessage</p>

    @if (entries.Count == 0)
    {
        <p class="text-body-secondary mb-0">Nothing logged yet. Log a call, email, meeting, or note above.</p>
    }
    else
    {
        <h3 class="visually-hidden" id="pb-cltl-list-title">Entries, newest first</h3>
        <ol class="list-unstyled pb-cltl-list mb-0" aria-labelledby="pb-cltl-list-title">
            @foreach (var entry in entries)
            {
                var canDelete = !DealDisplay.IsSystem(entry.Kind) && entry.AuthorId == me;
                var activityId = entry.Id;
                <li @key="entry.Id">
                    <ActivityEntry Activity="entry">
                        @if (canDelete)
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger" @ref="deleteButtons[activityId]" @onclick="() => OpenDeleteAsync(activityId)">
                                <Icon Name="IconName.Trash3" class="me-1" aria-hidden="true" />Delete<span class="visually-hidden"> this @DealDisplay.KindLabel(entry.Kind).ToLowerInvariant() from @PbDisplay.Ago(entry.At, State.Clock.Now)</span>
                            </button>
                        }
                    </ActivityEntry>
                </li>
            }
        </ol>
    }
</section>

<Modal @ref="deleteModal" IsVerticallyCentered="true" ShowCloseButton="false" aria-labelledby="pb-cltl-dialog-title" OnHidden="OnDeleteHidden">
    <HeaderTemplate>
        <h2 class="modal-title h5" id="pb-cltl-dialog-title">Delete this entry?</h2>
    </HeaderTemplate>
    <BodyTemplate>
        @if (State.Activities.FirstOrDefault(item => item.Id == deleteId) is { } target)
        {
            <p class="mb-2">Your @DealDisplay.KindLabel(target.Kind).ToLowerInvariant() from @DealDisplay.FullTime(target.At) leaves the timeline for everyone. This can't be undone.</p>
            <p class="tb-plain small text-body-secondary mb-0 pb-cltl-quote">@target.Text</p>
        }
        else
        {
            <p class="mb-0">That entry was already deleted.</p>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => deleteModal.HideAsync()">Cancel</Button>
        <Button Color="ButtonColor.Danger" @onclick="ConfirmDeleteAsync"><Icon Name="IconName.Trash3" class="me-1" aria-hidden="true" />Delete entry</Button>
    </FooterTemplate>
</Modal>
