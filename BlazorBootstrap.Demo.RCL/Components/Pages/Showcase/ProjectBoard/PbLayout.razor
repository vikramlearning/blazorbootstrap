@inherits LayoutComponentBase
@implements IDisposable

@* The public side: the start page and sign-in. Signed-in people work in PbWorkLayout. *@
<ShowcaseSessionHost State="State" SiteBase="@Base" SiteName="@PbSeedData.ProductName">
<PbFrame>
    <Header>
    <Navbar Class="tb-header"
            Placement="NavbarPlacement.StickyTop"
            Container="NavbarContainer.Fluid"
            AriaLabel="@PbSeedData.ProductName"
            TogglerAriaLabel="Menu">
        <Brand>
            <NavbarBrand Href="@Base" Class="tb-brand">
                <span class="tb-brand-mark" aria-hidden="true"><Icon Name="IconName.Kanban" /></span>
                <span>@PbSeedData.ProductName</span>
            </NavbarBrand>
            @if (State.Identity.IsSignedIn)
            {
                <ShowcaseAccountMenu SiteBase="@Base" SignInPath="@SignInPath" Class="ms-auto me-2 order-lg-last" />
            }
            else
            {
                <a class="btn btn-sm btn-outline-secondary ms-auto me-2 order-lg-last" href="@SignInPath">Sign in</a>
            }
        </Brand>
        <ChildContent>
            <NavbarNav Class="me-auto ms-lg-4 mb-3 mb-lg-0">
                <NavbarItem Href="@Base" Match="NavLinkMatch.All">Home</NavbarItem>
                @if (State.CurrentPerson is not null)
                {
                    <NavbarItem Href="@($"{Base}/my-tasks")">Open the app</NavbarItem>
                }
            </NavbarNav>
        </ChildContent>
    </Navbar>
    </Header>
    <ChildContent>
        @Body
    </ChildContent>
</PbFrame>
</ShowcaseSessionHost>

@code {
    /// <summary>Base route of the project and client board site.</summary>
    public const string Base = DemoRouteConstants.Showcase_URL_ProjectBoard;

    /// <summary>Route of the sign-in page.</summary>
    public const string SignInPath = Base + "/sign-in";

    [Inject] private PbState State { get; set; } = default!;

    /// <summary>Stops listening to state changes.</summary>
    public void Dispose() => State.Changed -= OnStateChanged;

    protected override void OnInitialized() => State.Changed += OnStateChanged;

    private void OnStateChanged() => InvokeAsync(StateHasChanged);
}
