@* The rows of one group on My tasks: key, title and project links, status and priority in words, due date in words,
   checklist progress, and Mark done or Reopen. *@
@{
    var today = State.Clock.Today;
}

<ul class="list-unstyled tb-mytasks-list mb-0">
    @foreach (var task in Tasks)
    {
        var key = State.TaskKey(task);
        var project = State.FindProject(task.ProjectId);
        var overdue = PbDisplay.IsOverdue(task, today);
        var checkedCount = task.Checklist.Count(item => item.Done);
        var isDone = task.Status == PbTaskStatus.Done;
        <li class="tb-card-item tb-mytask" @key="@($"{GroupId}-{task.Id}")">
            <div class="tb-mytask-main">
                <span class="tb-key">@key</span>
                <a class="tb-mytask-title" href="@PbDisplay.TaskUrl(task.Id)"><span class="visually-hidden">@key, </span>@task.Title</a>
                <span class="small text-body-secondary">
                    @if (project is not null)
                    {
                        <a class="tb-mytask-project" href="@PbDisplay.ProjectUrl(project.Id)">@project.Name</a>
                    }
                    · @PbDisplay.StatusLabel(task.Status)
                </span>
            </div>
            <ul class="tb-mytask-meta list-unstyled">
                <li><span class="@($"badge text-bg-{PbDisplay.PriorityColor(task.Priority)}")">@task.Priority<span class="visually-hidden"> priority</span></span></li>
                <li class="@(overdue ? "tb-mytask-overdue" : null)">
                    @if (overdue)
                    {
                        <Icon Name="IconName.ExclamationTriangleFill" class="me-1" aria-hidden="true" />
                    }
                    @(isDone && task.CompletedAt is { } completed ? $"Done {completed.ToString("MMM d", CultureInfo.InvariantCulture)}" : PbDisplay.Due(task.DueDate, today))
                </li>
                @if (task.Checklist.Count > 0)
                {
                    <li>Checklist @checkedCount of @task.Checklist.Count done</li>
                }
            </ul>
            <div class="tb-mytask-action">
                <button type="button" class="@(isDone ? "btn btn-sm btn-outline-secondary" : "btn btn-sm btn-outline-success")" @onclick="() => OnToggleDone.InvokeAsync(task)">
                    <Icon Name="@(isDone ? IconName.ArrowCounterclockwise : IconName.Check2)" class="me-1" aria-hidden="true" />@(isDone ? "Reopen" : "Mark done")<span class="visually-hidden"> @key</span>
                </button>
            </div>
        </li>
    }
</ul>
