@page "/showcase/project-board/manage/projects"
@layout PbWorkLayout

<PageTitle>Manage projects · @PbSeedData.ProductName</PageTitle>

<div class="container-fluid px-lg-4">
    <PbRoleGuard Role="@PbSeedData.ProjectManagerRole">
        @{
            var all = State.Projects;
            var fresh = NewFromDeals(State);
            var managers = State.ProjectManagers;
        }

        <div class="tb-mp-head mb-3">
            <div>
                <h1 class="tb-title">Manage projects</h1>
                <p class="tb-lead mb-0">
                    Every project at @PbSeedData.AgencyName: its client, dates, project manager, team, budget, and progress. Won deals arrive here as planned projects.
                    Open a project to edit it and its milestones, or select several to change their status or project manager together.
                </p>
            </div>
            <Button Type="ButtonType.Link" To="@NewUrl" Color="ButtonColor.Primary"><Icon Name="IconName.PlusLg" class="me-1" aria-hidden="true" />New project</Button>
        </div>

        @if (fresh.Count > 0)
        {
            <section class="tb-mp-callout mb-4" aria-labelledby="tb-mp-fresh-title">
                <div class="d-flex align-items-start gap-3">
                    <span class="tb-icon flex-shrink-0" aria-hidden="true"><Icon Name="IconName.Stars" /></span>
                    <div class="min-w-0 flex-grow-1">
                        <h2 class="tb-section-title mb-1" id="tb-mp-fresh-title">New from a won deal: plan the team and milestones</h2>
                        <p class="small mb-2">
                            @(fresh.Count == 1 ? "An account manager won this deal, so its project is waiting for you." : $"An account manager won these {fresh.Count} deals, so their projects are waiting for you.")
                            They're planned, with nobody on the team yet.
                        </p>
                        <ul class="list-unstyled d-grid gap-2 mb-0">
                            @foreach (var project in fresh)
                            {
                                var deal = State.FindDeal(project.FromDealId);
                                <li class="tb-mp-fresh-item" @key="project.Id">
                                    <div class="min-w-0">
                                        <span class="tb-key me-1">@project.Key</span><span class="fw-semibold tb-mp-wrap">@project.Name</span>
                                        <span class="d-block small text-body-secondary tb-mp-wrap">
                                            @(ClientName(State, project.ClientId))@(deal is null ? null : $" · from the deal “{deal.Title}” ({PbDisplay.Money(deal.Value)})") · starts @PbDisplay.Date(project.StartDate)
                                        </span>
                                    </div>
                                    <a class="btn btn-sm btn-primary flex-shrink-0" href="@EditUrl(project.Id)">Plan it<span class="visually-hidden">: @project.Name</span></a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </section>
        }

        <section class="tb-panel mb-3" aria-labelledby="tb-mp-filters-title">
            <h2 class="tb-section-title" id="tb-mp-filters-title">Filter projects</h2>
            <div class="tb-list-filters" role="search" aria-labelledby="tb-mp-filters-title">
                <div class="tb-list-search">
                    <label class="form-label small fw-semibold" for="tb-mp-search">Search</label>
                    @* Filters on every keystroke; the bound value changes only on change, so a render during typing never writes an older value back. *@
                    <input id="tb-mp-search" type="search" class="form-control" value="@searchBoxValue" placeholder="Key, name, or client" autocomplete="off" maxlength="120"
                           @oninput="OnSearchInputAsync" @onchange="OnSearchChanged" />
                </div>
                <div>
                    <label class="form-label small fw-semibold" for="tb-mp-status-filter">Status</label>
                    <select id="tb-mp-status-filter" class="form-select" @bind="statusFilter" @bind:after="FiltersChangedAsync">
                        <option value="">All statuses (@Count(StatusCount(null)))</option>
                        @foreach (var status in Enum.GetValues<PbProjectStatus>())
                        {
                            <option value="@status" @key="status">@PbDisplay.ProjectStatusLabel(status) (@Count(StatusCount(status)))</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label small fw-semibold" for="tb-mp-manager-filter">Project manager</label>
                    <select id="tb-mp-manager-filter" class="form-select" @bind="managerFilter" @bind:after="FiltersChangedAsync">
                        <option value="">Anyone</option>
                        @foreach (var manager in managers)
                        {
                            <option value="@manager.Id" @key="manager.Id">@manager.Name@(manager.Id == State.CurrentPerson?.Id ? " (you)" : null)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="tb-list-meta">
                <p class="small text-body-secondary mb-0" aria-live="polite" tabindex="-1" @ref="countRegion">Showing @Count(Shown.Count) of @Count(all.Count) projects.</p>
                @if (IsFiltered)
                {
                    <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ClearFiltersAsync">Show every project</Button>
                }
                @* Back to the saved view's defaults: active first, then planned, on hold, and completed, by due date; 25 a page; every column in its place. *@
                <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ResetViewAsync">Reset view</Button>
            </div>
        </section>

        @* Always rendered and focusable, so a bulk change or a deletion is announced and focus has somewhere to go when the bulk bar closes or a row is gone. *@
        <p class="tb-list-status mb-2 @(statusIsError ? "text-danger-emphasis" : null)" role="status" tabindex="-1" @ref="statusRegion">@statusMessage</p>
        <p class="tb-list-error mb-2" role="alert">@bulkError</p>

        @if (selected.Count > 0)
        {
            <section class="tb-bulk" aria-labelledby="tb-mp-bulk-count">
                <h2 class="tb-bulk-count" id="tb-mp-bulk-count">@(selected.Count == 1 ? "1 project selected" : $"{Count(selected.Count)} projects selected")</h2>
                <div class="tb-bulk-field">
                    <label class="form-label small fw-semibold" for="tb-mp-bulk-status">Status</label>
                    <select id="tb-mp-bulk-status" class="form-select form-select-sm" @bind="bulkStatus" aria-describedby="tb-mp-bulk-status-help">
                        <option value="">No change</option>
                        @foreach (var status in Enum.GetValues<PbProjectStatus>())
                        {
                            <option value="@status" @key="status">@PbDisplay.ProjectStatusLabel(status)</option>
                        }
                    </select>
                    <span class="form-text d-block" id="tb-mp-bulk-status-help">A completed project's tasks become read-only; set it back to Active to change them again.</span>
                </div>
                <div class="tb-bulk-field">
                    <label class="form-label small fw-semibold" for="tb-mp-bulk-manager">Project manager</label>
                    <select id="tb-mp-bulk-manager" class="form-select form-select-sm" @bind="bulkManager" aria-describedby="tb-mp-bulk-manager-help">
                        <option value="">No change</option>
                        @foreach (var manager in managers)
                        {
                            <option value="@manager.Id" @key="manager.Id">@manager.Name@(manager.Id == State.CurrentPerson?.Id ? " (you)" : null)</option>
                        }
                    </select>
                    <span class="form-text d-block" id="tb-mp-bulk-manager-help">A project manager who can sign in is told about projects handed to them and status changes.</span>
                </div>
                <div class="tb-bulk-actions">
                    <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="ApplyBulkAsync">Apply<span class="visually-hidden">&#32;to the selected projects</span></Button>
                    <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="ClearSelectionAsync">Clear selection</Button>
                </div>
            </section>
        }

        <section class="tb-panel" aria-label="Project list">
            <ShowcaseDataState Status="@(viewLoaded ? ShowcaseDataStatus.Ready : ShowcaseDataStatus.Loading)"
                               IsEmpty="@(all.Count == 0)"
                               EmptyIcon="IconName.Folder2Open"
                               EmptyTitle="No projects yet"
                               EmptyText="Create the first project, or win a deal in the pipeline: it arrives here as a planned project."
                               LoadingText="Loading projects…"
                               OnRetry="RefreshGridAsync">
                <EmptyActions>
                    <Button Type="ButtonType.Link" To="@NewUrl" Color="ButtonColor.Primary" Size="ButtonSize.Small">New project</Button>
                </EmptyActions>
                <ChildContent>
                    <Grid @ref="grid"
                          @key="gridVersion"
                          TItem="ProjectRow"
                          Class="table table-hover align-middle tb-table-wide sc-grid-row-links"
                          GridContainerClass="tb-grid border rounded-3"
                          DataProvider="ProvideProjectsAsync"
                          SettingsProvider="view.GetSettingsAsync"
                          GridSettingsChanged="SaveSettingsAsync"
                          AllowPaging="true"
                          PageSize="@pageSize"
                          PageSizeSelectorVisible="true"
                          PageSizeSelectorItems="@(new[] { 10, 25, 50, 100 })"
                          PaginationItemsTextFormat="{0}–{1} of {2} projects"
                          AllowSorting="true"
                          AllowSelection="true"
                          SelectionMode="GridSelectionMode.Multiple"
                          RowSelectionLabel="@(row => $"Select {row.Key} {row.Name}")"
                          SelectAllRowsText="Select all shown projects"
                          SelectedItemsChanged="OnSelectionChanged"
                          RowClass="RowClass"
                          AllowColumnChooser="true"
                          AllowExport="true"
                          ExportFileName="project-board-manage-projects"
                          Responsive="true"
                          EmptyText="No projects match these filters. Clear a filter, or search for part of a key or name."
                          aria-label="Projects">
                        <GridColumns>
                            <GridColumn TItem="ProjectRow" HeaderText="Key" PropertyName="Key" SortString="key" SortKeySelector="row => row.Key"
                                        IsDefaultSortColumn="@view.IsSortColumn("key")" SortDirection="@view.DirectionFor("key")" TextNoWrap="true">
                                <span class="tb-key">@context.Key</span>
                            </GridColumn>
                            <GridColumn TItem="ProjectRow" HeaderText="Project" PropertyName="Name" SortString="name" SortKeySelector="row => row.Name"
                                        IsDefaultSortColumn="@view.IsSortColumn("name")" SortDirection="@view.DirectionFor("name")" AlwaysVisible="true">
                                @* The stretched link makes the whole row open the project's editor; the checkbox and the buttons stay above it. *@
                                <a class="tb-row-link stretched-link" href="@EditUrl(context.Id)">@context.Name</a>
                                @if (context.IsFresh)
                                {
                                    <span class="d-block small"><Icon Name="IconName.Stars" class="me-1" aria-hidden="true" />New from a won deal: needs a team</span>
                                }
                            </GridColumn>
                            <GridColumn TItem="ProjectRow" HeaderText="Client" PropertyName="Client" SortString="client" SortKeySelector="row => row.Client"
                                        IsDefaultSortColumn="@view.IsSortColumn("client")" SortDirection="@view.DirectionFor("client")">
                                @context.Client
                            </GridColumn>
                            <GridColumn TItem="ProjectRow" HeaderText="Status" PropertyName="Status" SortString="status" SortKeySelector="row => row.StatusOrder"
                                        IsDefaultSortColumn="@view.IsSortColumn("status")" SortDirection="@view.DirectionFor("status")" TextNoWrap="true">
                                <Badge Color="@StatusBadge(context.StatusValue)">@context.Status</Badge>
                            </GridColumn>
                            <GridColumn TItem="ProjectRow" HeaderText="Project manager" PropertyName="Manager" SortString="manager" SortKeySelector="row => row.Manager"
                                        IsDefaultSortColumn="@view.IsSortColumn("manager")" SortDirection="@view.DirectionFor("manager")" TextNoWrap="true">
                                @context.Manager@(context.ManagerId == State.CurrentPerson?.Id ? " (you)" : null)
                            </GridColumn>
                            <GridColumn TItem="ProjectRow" HeaderText="Start" PropertyName="StartText" SortString="start" SortKeySelector="row => row.Start"
                                        IsDefaultSortColumn="@view.IsSortColumn("start")" SortDirection="@view.DirectionFor("start")" TextNoWrap="true">
                                @context.StartText
                            </GridColumn>
                            <GridColumn TItem="ProjectRow" HeaderText="Due" PropertyName="DueText" SortString="due" SortKeySelector="row => row.Due"
                                        IsDefaultSortColumn="@view.IsSortColumn("due")" SortDirection="@view.DirectionFor("due")" TextNoWrap="true">
                                @context.DueText
                            </GridColumn>
                            <GridColumn TItem="ProjectRow" HeaderText="Team" PropertyName="Team" SortString="team" SortKeySelector="row => row.Team"
                                        IsDefaultSortColumn="@view.IsSortColumn("team")" SortDirection="@view.DirectionFor("team")" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End">
                                @(context.Team == 0 ? "None" : context.Team.ToString(CultureInfo.InvariantCulture))
                            </GridColumn>
                            <GridColumn TItem="ProjectRow" HeaderText="Budget" PropertyName="BudgetText" SortString="budget" SortKeySelector="row => row.BudgetHours"
                                        IsDefaultSortColumn="@view.IsSortColumn("budget")" SortDirection="@view.DirectionFor("budget")" TextNoWrap="true">
                                @context.BudgetText
                            </GridColumn>
                            <GridColumn TItem="ProjectRow" HeaderText="Progress" PropertyName="ProgressText" SortString="progress" SortKeySelector="row => row.Percent"
                                        IsDefaultSortColumn="@view.IsSortColumn("progress")" SortDirection="@view.DirectionFor("progress")">
                                <div class="tb-mp-progress">
                                    <Progress Height="6" Class="mb-1">
                                        <ProgressBar Width="@context.Percent" Color="ProgressColor.Success"
                                                     aria-label="@($"{context.Name}, tasks done")" aria-valuenow="@Math.Round(context.Percent)" aria-valuemin="0" aria-valuemax="100"
                                                     aria-valuetext="@context.ProgressText" />
                                    </Progress>
                                    <span class="small text-nowrap">@context.ProgressText</span>
                                </div>
                            </GridColumn>
                            <GridColumn TItem="ProjectRow" HeaderText="Actions" Sortable="false" Exportable="false" TextNoWrap="true">
                                @{
                                    var projectId = context.Id;
                                }
                                <div class="d-flex flex-nowrap gap-1 justify-content-end">
                                    <a class="btn btn-sm btn-outline-secondary text-nowrap" href="@PbDisplay.ProjectUrl(projectId)">Open board<span class="visually-hidden">: @context.Name</span></a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @ref="deleteButtons[projectId]" @onclick="() => OpenDeleteAsync(projectId)">
                                        Delete<span class="visually-hidden">&#32;@context.Name</span>
                                    </button>
                                </div>
                            </GridColumn>
                        </GridColumns>
                    </Grid>
                </ChildContent>
            </ShowcaseDataState>
        </section>

        <Modal @ref="dialogModal" IsVerticallyCentered="true" ShowCloseButton="false" aria-labelledby="tb-mp-dialog-title" OnHidden="OnDialogHidden">
            <HeaderTemplate>
                <h2 class="modal-title h5 tb-mp-wrap" id="tb-mp-dialog-title">@(DialogProject is { } target ? $"Delete {target.Key} · {target.Name}?" : "Delete this project?")</h2>
            </HeaderTemplate>
            <BodyTemplate>
                @if (DialogProject is { } target)
                {
                    <p>@DeleteConsequence(target)</p>
                    <p class="mb-0">This can't be undone.</p>
                }
                else
                {
                    <p class="mb-0">This project was already deleted.</p>
                }
            </BodyTemplate>
            <FooterTemplate>
                <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => dialogModal.HideAsync()">Cancel</Button>
                @if (DialogProject is not null)
                {
                    <Button Color="ButtonColor.Danger" @onclick="ConfirmDeleteAsync"><Icon Name="IconName.Trash3" class="me-1" aria-hidden="true" />Delete project</Button>
                }
            </FooterTemplate>
        </Modal>
    </PbRoleGuard>
</div>
