@page "/showcase/project-board/profile"
@layout PbWorkLayout

<PageTitle>Profile · @PbSeedData.ProductName</PageTitle>

@* The person's name, email, and password; then their work: title, capacity, projects, and task counts. *@
<div class="container-fluid px-lg-4">
    <h1 class="tb-title mb-1">Profile</h1>
    <p class="tb-lead mb-4">
        Your name, email, and password for this demo. Teammates see your name and initials on the boards, on the tasks
        assigned to you, and next to your comments.
    </p>

    <ShowcaseAccountProfile />

    @{
        var person = State.CurrentPerson;
    }

    @if (person is not null)
    {
        <section class="tb-panel mt-4" aria-labelledby="tb-profile-details-title">
            <h2 class="tb-section-title" id="tb-profile-details-title">Work details</h2>
            <p class="small text-body-secondary">Your job title shows next to your name on project teams; your weekly capacity sets how full the workload view says you are.</p>
            <EditForm EditContext="editContext" OnSubmit="SaveWork" FormName="pb-profile-work" novalidate>
                <DataAnnotationsValidator />
                <ShowcaseFormErrors ShowSummary="true" />
                <div class="row g-3 mb-3">
                    <div class="col-sm-7 col-lg-5">
                        <label class="form-label fw-semibold" for="tb-profile-title">Job title</label>
                        <InputText id="tb-profile-title" class="form-control" @bind-Value="form.Title" maxlength="@PbState.MaxContactFieldLength" autocomplete="organization-title" />
                        <ValidationMessage For="() => form.Title" />
                    </div>
                    <div class="col-sm-5 col-lg-3">
                        <label class="form-label fw-semibold" for="tb-profile-capacity">Weekly capacity in hours</label>
                        <InputNumber TValue="int?" id="tb-profile-capacity" class="form-control" @bind-Value="form.CapacityHours" inputmode="numeric" step="1" min="0" max="@PbState.MaxCapacityHours"
                                     ParsingErrorMessage="Enter your weekly capacity as whole hours, like 32." aria-describedby="tb-profile-capacity-help" />
                        <div class="form-text" id="tb-profile-capacity-help">0 to @PbState.MaxCapacityHours hours a week.</div>
                        <ValidationMessage For="() => form.CapacityHours" />
                    </div>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-3">
                    <Button Type="ButtonType.Submit" Color="ButtonColor.Primary">Save work details</Button>
                    @* Always rendered, so the outcome is announced; a counter makes a repeat announce again. *@
                    <span class="small fw-semibold @(workIsError ? "text-danger-emphasis" : null)" role="status">@workStatus</span>
                </div>
            </EditForm>
        </section>
    }

    <section class="tb-panel mt-4" aria-labelledby="tb-profile-work-title">
        <h2 class="tb-section-title" id="tb-profile-work-title">Your work</h2>
        @if (person is null)
        {
            <p class="mb-0">Sign in to see your work.</p>
        }
        else
        {
            var today = State.Clock.Today;
            var allProjects = State.Projects.Where(project => project.MemberIds.Contains(person.Id)).ToList();
            var projects = allProjects.Where(project => project.Status != PbProjectStatus.Completed).ToList();
            var completed = allProjects.Count - projects.Count;
            var open = State.AllTasks.Where(task => task.AssigneeId == person.Id && task.Status != PbTaskStatus.Done).ToList();
            var overdue = open.Count(task => PbDisplay.IsOverdue(task, today));
            var sunday = PbState.WeekStart(today).AddDays(6);
            var thisWeek = open.Where(task => task.DueDate is { } due && due.Date <= sunday).ToList();
            var hours = thisWeek.Sum(task => task.EstimateHours);

            <dl class="tb-profile-facts">
                <div>
                    <dt>Title</dt>
                    <dd>@person.Title</dd>
                </div>
                <div>
                    <dt>Weekly capacity</dt>
                    <dd>@TaskCard.HoursText(person.CapacityHours)</dd>
                </div>
                <div>
                    <dt>Open tasks</dt>
                    <dd><a href="@($"{PbLayout.Base}/my-tasks")">@TaskCard.Plural(open.Count, "open task")</a></dd>
                </div>
                <div>
                    <dt>Overdue</dt>
                    <dd class="@(overdue > 0 ? "tb-profile-overdue" : null)">
                        @if (overdue > 0)
                        {
                            <Icon Name="IconName.ExclamationTriangleFill" class="me-1" aria-hidden="true" />
                        }
                        @(overdue == 0 ? "None" : TaskCard.Plural(overdue, "task"))
                    </dd>
                </div>
                <div>
                    <dt>Due by Sunday</dt>
                    <dd>@TaskCard.Plural(thisWeek.Count, "task"), @TaskCard.HoursText(hours) estimated of your @person.CapacityHours</dd>
                </div>
            </dl>

            <h3 class="h6 fw-bold mt-4">Projects you're on</h3>
            @if (completed > 0)
            {
                <p class="small text-body-secondary">The ones still running. You were also on @TaskCard.Plural(completed, "completed project"); find them on <a href="@($"{PbLayout.Base}/projects")">Project boards</a>.</p>
            }
            @if (projects.Count == 0)
            {
                <p class="mb-0 text-body-secondary">You aren't on a running project team right now. A project manager adds people to projects.</p>
            }
            else
            {
                <ul class="tb-profile-projects mb-0">
                    @foreach (var project in projects)
                    {
                        <li @key="@($"project-{project.Id}")">
                            <a href="@PbDisplay.ProjectUrl(project.Id)">@project.Name</a>
                            <span class="text-body-secondary small"> (@project.Key, @PbDisplay.ProjectStatusLabel(project.Status).ToLowerInvariant())</span>
                        </li>
                    }
                </ul>
            }
        }
    </section>
</div>
