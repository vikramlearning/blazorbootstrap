@page "/showcase/project-board/clients/{Id:int}"
@layout PbWorkLayout

@{
    var client = State.FindClient(Id);
}

<PageTitle>@(client?.Name ?? "Client not found") · @PbSeedData.ProductName</PageTitle>

<div class="container-fluid px-lg-4">
    <PbRoleGuard Role="@PbSeedData.AccountManagerRole">
        @if (client is null)
        {
            <PbNotFound Message="This client was deleted, or the link is wrong. Open it from the client list." />
        }
        else
        {
            var owner = State.FindPerson(client.OwnerId);
            var deals = State.DealsOf(client.Id);
            var open = deals.Where(DealDisplay.IsOpen).ToList();
            var projects = State.Projects.Where(project => project.ClientId == client.Id).ToList();

            <nav aria-label="Breadcrumb" class="mb-2">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="@DealDisplay.ClientsUrl">Clients</a></li>
                    <li class="breadcrumb-item active pb-cldet-crumb" aria-current="page">@client.Name</li>
                </ol>
            </nav>

            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                <div class="pb-cldet-head">
                    <h1 class="tb-title">@client.Name</h1>
                    <dl class="pb-cldet-facts mt-2 mb-0">
                        <div><dt>Industry</dt><dd>@client.Industry</dd></div>
                        <div><dt>Website</dt><dd class="pb-cldet-website">@(string.IsNullOrEmpty(client.Website) ? "None" : client.Website)</dd></div>
                        <div><dt>Owner</dt><dd>@(owner?.Name ?? "Nobody")@(owner is not null && owner.Id == State.CurrentPerson?.Id ? " (you)" : null)</dd></div>
                        <div><dt>Phone</dt><dd>@(string.IsNullOrEmpty(client.Phone) ? "None" : client.Phone)</dd></div>
                        <div><dt>Client since</dt><dd>@PbDisplay.Date(client.CreatedAt)</dd></div>
                        <div><dt>Billing</dt><dd class="pb-cldet-website">@client.BillingCurrency@(string.IsNullOrEmpty(client.BillingEmail) ? null : $" · {client.BillingEmail}")</dd></div>
                        <div><dt>Contract</dt><dd>@(client.ContractStart is { } contractStart ? client.ContractEnd is { } contractEnd ? $"{PbDisplay.Date(contractStart)} to {PbDisplay.Date(contractEnd)}" : $"From {PbDisplay.Date(contractStart)}, no end date" : "None")</dd></div>
                        <div><dt>Open pipeline</dt><dd>@(open.Count == 0 ? "No open deals" : $"{DealDisplay.Plural(open.Count, "deal")}, {PbDisplay.Money(open.Sum(deal => (long)deal.Value))}")</dd></div>
                    </dl>
                </div>
                <a class="btn btn-outline-primary" href="@DealDisplay.ClientEditUrl(client.Id)">
                    <Icon Name="IconName.Pencil" class="me-1" aria-hidden="true" />Edit client<span class="visually-hidden">&#32;@client.Name</span>
                </a>
            </div>

            @* Always rendered, so the outcome of the client form is announced here. *@
            <p class="fw-semibold pb-cldet-status" role="status">@pageMessage</p>

            <div class="row g-4">
                <div class="col-xl-7 d-grid gap-4 align-content-start pb-cldet-main">
                    <ClientContacts ClientId="client.Id" />

                    <section class="tb-panel" aria-labelledby="pb-cldet-deals-title">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <h2 class="tb-section-title mb-0" id="pb-cldet-deals-title">Deals <span class="text-body-secondary fw-normal">(@deals.Count)</span></h2>
                            <div class="d-flex flex-wrap align-items-center gap-3">
                                @* Back to the saved view's defaults: open deals first by close date, 5 a page, every column in its place. *@
                                <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ResetDealViewAsync">Reset view<span class="visually-hidden">&#32;of the deals</span></Button>
                                <button type="button" class="btn btn-sm btn-outline-primary" @ref="newDealButton" @onclick="OpenNewDealAsync">
                                    <Icon Name="IconName.PlusLg" class="me-1" aria-hidden="true" />New deal
                                </button>
                            </div>
                        </div>

                        <p class="fw-semibold pb-cldet-status @(dealStatusIsError ? "text-danger-emphasis" : null)" role="status" tabindex="-1" @ref="dealStatusRegion">@dealMessage</p>

                        <ShowcaseDataState Status="@(viewLoaded ? ShowcaseDataStatus.Ready : ShowcaseDataStatus.Loading)"
                                           IsEmpty="@(deals.Count == 0)"
                                           EmptyIcon="IconName.Funnel"
                                           EmptyTitle="No deals yet"
                                           EmptyText="@($"No deals with {client.Name} yet. Add one with New deal; it starts as a lead on the pipeline.")"
                                           LoadingText="Loading deals…"
                                           LoadingRows="3"
                                           OnRetry="RefreshDealsAsync">
                            <ChildContent>
                                <Grid @ref="dealGrid"
                                      @key="@($"{client.Id}-{dealGridVersion}")"
                                      TItem="DealRow"
                                      Class="table table-hover align-middle tb-table-mid sc-grid-row-links"
                                      GridContainerClass="tb-grid border rounded-3"
                                      DataProvider="ProvideDealsAsync"
                                      SettingsProvider="dealView.GetSettingsAsync"
                                      GridSettingsChanged="SaveDealSettingsAsync"
                                      AllowPaging="true"
                                      PageSize="@dealPageSize"
                                      PageSizeSelectorVisible="true"
                                      PageSizeSelectorItems="@(new[] { 5, 10, 25 })"
                                      PaginationItemsTextFormat="{0}–{1} of {2} deals"
                                      AllowSorting="true"
                                      AllowColumnChooser="true"
                                      AllowExport="true"
                                      ExportFileName="project-board-client-deals"
                                      Responsive="true"
                                      EmptyText="No deals."
                                      aria-label="@($"Deals with {client.Name}")">
                                    <GridColumns>
                                        <GridColumn TItem="DealRow" HeaderText="Deal" PropertyName="Title" SortString="title" SortKeySelector="row => row.Title"
                                                    IsDefaultSortColumn="@dealView.IsSortColumn("title")" SortDirection="@dealView.DirectionFor("title")" AlwaysVisible="true">
                                            @* The stretched link opens the deal's card on the pipeline from anywhere on the row; Edit stays above it. *@
                                            <a class="tb-row-link stretched-link" href="@($"{DealDisplay.PipelineUrl}#pb-deal-{context.Id}")">@context.Title</a>
                                        </GridColumn>
                                        <GridColumn TItem="DealRow" HeaderText="Stage" PropertyName="Stage" SortString="stage" SortKeySelector="row => row.StageValue"
                                                    IsDefaultSortColumn="@dealView.IsSortColumn("stage")" SortDirection="@dealView.DirectionFor("stage")" TextNoWrap="true">
                                            @context.Stage <span class="small text-body-secondary">(@context.Chance)</span>
                                        </GridColumn>
                                        <GridColumn TItem="DealRow" HeaderText="Value" PropertyName="Value" SortString="value" SortKeySelector="row => row.Value"
                                                    IsDefaultSortColumn="@dealView.IsSortColumn("value")" SortDirection="@dealView.DirectionFor("value")" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End" TextNoWrap="true">
                                            @PbDisplay.Money(context.Value)
                                        </GridColumn>
                                        <GridColumn TItem="DealRow" HeaderText="Close date" PropertyName="CloseText" SortString="close" SortKeySelector="row => row.CloseDate"
                                                    IsDefaultSortColumn="@dealView.IsSortColumn("close")" SortDirection="@dealView.DirectionFor("close")">
                                            <span class="@(context.IsOverdue ? "text-danger-emphasis fw-semibold" : null)">
                                                @if (context.IsOverdue)
                                                {
                                                    <Icon Name="IconName.ExclamationTriangle" class="me-1" aria-hidden="true" />
                                                }
                                                @context.CloseText
                                            </span>
                                        </GridColumn>
                                        <GridColumn TItem="DealRow" HeaderText="Weighted" PropertyName="Weighted" SortString="weighted" SortKeySelector="row => row.Weighted"
                                                    IsDefaultSortColumn="@dealView.IsSortColumn("weighted")" SortDirection="@dealView.DirectionFor("weighted")" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End" TextNoWrap="true">
                                            @PbDisplay.Money(context.Weighted)
                                        </GridColumn>
                                        <GridColumn TItem="DealRow" HeaderText="Actions" Sortable="false" Exportable="false" TextNoWrap="true">
                                            @{
                                                var dealId = context.Id;
                                            }
                                            @if (context.IsOpen)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap" @ref="editDealButtons[dealId]" @onclick="() => OpenEditDealAsync(dealId)">
                                                    <Icon Name="IconName.Pencil" class="me-1" aria-hidden="true" />Edit<span class="visually-hidden">&#32;@context.Title</span>
                                                </button>
                                            }
                                            else if (context.ProjectId is { } projectId)
                                            {
                                                <a class="small text-nowrap" href="@PbDisplay.ProjectUrl(projectId)">Project @context.ProjectKey</a>
                                            }
                                            else
                                            {
                                                <span class="small text-body-secondary text-nowrap">Closed</span>
                                            }
                                        </GridColumn>
                                    </GridColumns>
                                </Grid>
                            </ChildContent>
                        </ShowcaseDataState>
                        <p class="small mt-3 mb-0"><a href="@DealDisplay.PipelineUrl">Move deals between stages on the deal pipeline</a></p>
                    </section>

                    <section class="tb-panel" aria-labelledby="pb-cldet-projects-title">
                        <h2 class="tb-section-title" id="pb-cldet-projects-title">Projects</h2>
                        @if (projects.Count == 0)
                        {
                            <p class="text-body-secondary mb-0">No projects for @client.Name yet. Winning a deal creates one for the project managers to plan.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled d-grid gap-3 mb-0">
                                @foreach (var project in projects)
                                {
                                    var (done, total) = State.ProjectProgress(project.Id);
                                    var percent = total == 0 ? 0 : done * 100 / total;
                                    var progressId = $"pb-cldet-progress-{project.Id}";
                                    <li @key="project.Id" class="pb-cldet-project">
                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                                            <a class="fw-semibold pb-cldet-wrap" href="@PbDisplay.ProjectUrl(project.Id)"><span class="tb-key">@project.Key</span> @project.Name</a>
                                            <Badge Color="@ProjectBadge(project.Status)" Class="rounded-pill">@PbDisplay.ProjectStatusLabel(project.Status)</Badge>
                                        </div>
                                        <div class="progress pb-cldet-bar" role="progressbar" aria-labelledby="@progressId" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percent">
                                            <div class="progress-bar" style="width: @(percent)%"></div>
                                        </div>
                                        <p class="small text-body-secondary mt-1 mb-0" id="@progressId">
                                            @(total == 0 ? "No tasks yet" : $"{done} of {DealDisplay.Plural(total, "task")} done ({percent}%)") · due @PbDisplay.Date(project.DueDate)
                                        </p>
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                </div>

                <div class="col-xl-5">
                    <ClientTimeline ClientId="client.Id" />
                </div>
            </div>

            <DealEditor @ref="dealEditor" OnClosed="OnDealEditorClosed" />
        }
    </PbRoleGuard>
</div>
