@page "/showcase/project-board/sign-in"
@layout PbLayout

<PageTitle>Sign in · @PbSeedData.ProductName</PageTitle>

@* A new account joins the team as a member. *@
<div class="container-xl">
    <ShowcaseSignIn SiteBase="@PbLayout.Base" SiteName="@PbSeedData.ProductName" ReturnUrl="@ReturnUrl"
                    RegisterRoleId="@PbSeedData.MemberRole" StartWithRegister="@(Mode == "register")" />
</div>

@code {
    /// <summary>Gets or sets <c>?mode=register</c>, which opens the register form.</summary>
    [SupplyParameterFromQuery(Name = "mode")] public string? Mode { get; set; }

    /// <summary>Gets or sets the page to return to after signing in; only a page inside the site is used.</summary>
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
}
