@page "/showcase/hr-portal/admin/employees/new"
@page "/showcase/hr-portal/admin/employees/{Id:int}/edit"
@layout HrWorkLayout

@{
    var employee = Employee;
}

@if (Id is null || employee is not null || !State.IsHrAdmin)
{
    <PageTitle>@(employee is not null ? (employee.Status == HrEmployeeStatus.Left ? employee.Name : $"Edit {employee.Name}") : Id is null ? "Add employee" : "Person not found") · @HrSeedData.ProductName</PageTitle>
}

<div class="container-fluid px-lg-4">
    <ShowcaseRoleGuard Roles="@HrSeedData.HrAdminRole" SignInPath="@HrLayout.SignInPath">
        @if (Id is not null && employee is null)
        {
            <HrNotFound Message="There's no employee with this ID, or the link is wrong. Open them from Employees." />
        }
        else
        {
            var today = State.Clock.Today;

            <p class="small mb-2">
                <a href="@AdminHelpers.EmployeesUrl"><Icon Name="IconName.ArrowLeft" class="me-1" aria-hidden="true" />Employees</a>
            </p>

            <div class="mb-3">
                <h1 class="hr-title hr-aee-wrap">@(employee is null ? "Add employee" : employee.Status == HrEmployeeStatus.Left ? employee.Name : $"Edit {employee.Name}")</h1>
                <p class="hr-lead mb-0">
                    @(employee is null
                        ? "Add a new hire with their work email. Once they're added, start their onboarding here; they see it when they register with that email."
                        : employee.Status == HrEmployeeStatus.Left
                            ? "This person has left. Their record is kept for headcount analytics and can't be changed."
                            : "Changes show in the directory, the org chart, and their manager's team as soon as you save.")
                </p>
            </div>

            @* Always rendered and focusable, so a save is announced and focus has somewhere to go when it fails. *@
            <p class="fw-semibold hr-aee-status @(statusIsError ? "text-danger-emphasis" : null)" role="status" tabindex="-1" @ref="statusRegion">@statusMessage</p>

            @if (employee is { Status: HrEmployeeStatus.Left })
            {
                var manager = employee.ManagerId is { } leftManagerId ? State.FindEmployee(leftManagerId) : null;
                <section class="hr-panel hr-aee-readonly" aria-labelledby="hr-aee-left-title">
                    <h2 class="hr-section-title" id="hr-aee-left-title">Left on @(employee.EndDate is { } end ? HrDisplay.Date(end) : "an unknown day")</h2>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@employee.Name</dd>
                        <dt class="col-sm-4">Work email</dt>
                        <dd class="col-sm-8 hr-aee-wrap">@employee.Email</dd>
                        <dt class="col-sm-4">Title</dt>
                        <dd class="col-sm-8">@employee.Title</dd>
                        <dt class="col-sm-4">Department</dt>
                        <dd class="col-sm-8">@(State.FindDepartment(employee.DepartmentId)?.Name ?? "No department")</dd>
                        <dt class="col-sm-4">Manager</dt>
                        <dd class="col-sm-8">@(manager?.Name ?? "None (top of the org chart)")</dd>
                        <dt class="col-sm-4">Location</dt>
                        <dd class="col-sm-8">@employee.Location</dd>
                        <dt class="col-sm-4">Worked here</dt>
                        <dd class="col-sm-8">@HrDisplay.Date(employee.StartDate) to @(employee.EndDate is { } last ? HrDisplay.Date(last) : "unknown")</dd>
                        @if (employee.ProbationEndDate is { } probation)
                        {
                            <dt class="col-sm-4">Probation ended</dt>
                            <dd class="col-sm-8">@HrDisplay.Date(probation)</dd>
                        }
                        <dt class="col-sm-4">Phone</dt>
                        <dd class="col-sm-8 mb-0">@(employee.Phone.Length == 0 ? "None" : employee.Phone)</dd>
                    </dl>
                </section>
            }
            else
            {
                <div class="row g-4">
                    <div class="col-xl-7">
                        <section class="hr-panel" aria-labelledby="hr-aee-form-title">
                            <h2 class="hr-section-title" id="hr-aee-form-title">Job details</h2>
                            <EditForm EditContext="editContext" OnSubmit="SaveAsync" FormName="hr-employee" novalidate aria-labelledby="hr-aee-form-title">
                                <DataAnnotationsValidator />
                                <ShowcaseFormErrors ShowSummary="true" />
                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold" for="hr-aee-name">Name</label>
                                        <InputText @ref="nameInput" id="hr-aee-name" class="form-control" @bind-Value="form.Name" maxlength="@HrState.MaxNameLength" autocomplete="off"
                                                   aria-describedby="hr-aee-name-help" />
                                        <div class="form-text" id="hr-aee-name-help">Up to @HrState.MaxNameLength characters.@(employee?.AccountId is not null ? " Once they sign in, their account's name is used." : null)</div>
                                        <ValidationMessage For="() => form.Name" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold" for="hr-aee-email">Work email</label>
                                        <InputText id="hr-aee-email" type="email" inputmode="email" autocapitalize="none" class="form-control" @bind-Value="form.Email"
                                                   maxlength="@AdminHelpers.MaxEmailLength" autocomplete="off" spellcheck="false" aria-describedby="hr-aee-email-help" />
                                        <ShowcaseUniqueCheck @ref="emailCheck" For="() => form.Email" IsTakenAsync="IsEmailTakenAsync" TakenMessage="EmailTakenMessage" />
                                        <div class="form-text mt-0" id="hr-aee-email-help">
                                            @(employee?.AccountId is not null
                                                ? "Their account is linked to this record already. Each person has their own email."
                                                : "The person registers with this email to sign in, and their account links to this record. Each person has their own email.")
                                        </div>
                                        <ValidationMessage For="() => form.Email" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-semibold" for="hr-aee-title">Job title</label>
                                        <InputText id="hr-aee-title" class="form-control" @bind-Value="form.Title" maxlength="@HrState.MaxNameLength" autocomplete="off" />
                                        <ValidationMessage For="() => form.Title" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold" for="hr-aee-department">Department</label>
                                        <InputSelect id="hr-aee-department" class="form-select" @bind-Value="form.DepartmentId">
                                            <option value="">Choose a department</option>
                                            @foreach (var department in State.Departments)
                                            {
                                                <option value="@department.Id" @key="department.Id">@department.Name</option>
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="() => form.DepartmentId" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold" for="hr-aee-location">Location</label>
                                        <InputSelect id="hr-aee-location" class="form-select" @bind-Value="form.Location">
                                            @if (!State.Locations.Contains(form.Location))
                                            {
                                                <option value="">Choose where they work</option>
                                            }
                                            @foreach (var place in State.Locations)
                                            {
                                                <option value="@place" @key="place">@place</option>
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="() => form.Location" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-semibold" for="hr-aee-manager">Manager</label>
                                        <InputSelect id="hr-aee-manager" class="form-select" @bind-Value="form.ManagerValue" aria-describedby="hr-aee-manager-help">
                                            <option value="">No manager (top of the org chart)</option>
                                            @foreach (var person in State.Directory.Where(person => person.Id != employee?.Id))
                                            {
                                                <option value="@person.Id.ToString(CultureInfo.InvariantCulture)" @key="person.Id">@person.Name, @person.Title</option>
                                            }
                                        </InputSelect>
                                        <div class="form-text" id="hr-aee-manager-help">People who work here or are joining. They see this person in their team and approve their leave.</div>
                                        <ValidationMessage For="() => form.ManagerValue" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold" for="hr-aee-start">Start date</label>
                                        <InputDate TValue="DateTime?" id="hr-aee-start" class="form-control" @bind-Value="form.StartDate"
                                                   min="@AdminHelpers.DateValue(AdminHelpers.MinDate)" max="@AdminHelpers.DateValue(AdminHelpers.MaxDate)" aria-describedby="hr-aee-start-help" />
                                        <div class="form-text" id="hr-aee-start-help">@StartHelp(today)</div>
                                        <ValidationMessage For="() => form.StartDate" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold" for="hr-aee-probation">Probation ends <span class="fw-normal text-body-secondary">(optional)</span></label>
                                        <InputDate TValue="DateTime?" id="hr-aee-probation" class="form-control" @bind-Value="form.ProbationEndDate"
                                                   min="@(form.StartDate is { } first ? AdminHelpers.DateValue(first.AddDays(1)) : null)"
                                                   max="@(form.StartDate is { } last ? AdminHelpers.DateValue(last.AddMonths(HrState.MaxProbationMonths)) : null)" aria-describedby="hr-aee-probation-help" />
                                        <div class="form-text" id="hr-aee-probation-help">After the start date, and at most @HrState.MaxProbationMonths months later. Leave it empty for no probation.</div>
                                        <ValidationMessage For="() => form.ProbationEndDate" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold" for="hr-aee-phone">Phone <span class="fw-normal text-body-secondary">(optional)</span></label>
                                        <InputText id="hr-aee-phone" type="tel" class="form-control" @bind-Value="form.Phone" maxlength="@HrState.MaxPhoneLength" autocomplete="off"
                                                   aria-describedby="hr-aee-phone-help" />
                                        <div class="form-text" id="hr-aee-phone-help">Up to @HrState.MaxPhoneLength characters. They can change it on their profile.</div>
                                        <ValidationMessage For="() => form.Phone" />
                                    </div>
                                </div>

                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <Button Type="ButtonType.Submit" Color="ButtonColor.Primary">
                                        <Icon Name="@(employee is null ? IconName.PersonPlus : IconName.CheckLg)" class="me-1" aria-hidden="true" />@(employee is null ? "Add employee" : "Save changes")
                                    </Button>
                                    @if (employee is not null)
                                    {
                                        <a class="btn btn-outline-secondary" href="@HrDisplay.EmployeeUrl(employee.Id)">View profile</a>
                                    }
                                    <a class="btn btn-link" href="@AdminHelpers.EmployeesUrl">@(employee is null ? "Cancel" : "Back to employees")</a>
                                </div>
                            </EditForm>
                        </section>
                    </div>

                    <div class="col-xl-5 d-grid gap-4 align-content-start">
                        <section class="hr-panel @(justCreated ? "hr-aee-next" : null)" aria-labelledby="hr-aee-onb-title">
                            <h2 class="hr-section-title mb-1" id="hr-aee-onb-title">@(justCreated ? "Next: start their onboarding" : "Onboarding")</h2>
                            @if (employee is null)
                            {
                                <p class="small text-body-secondary mb-0">Add the person first; then start their onboarding here from a template.</p>
                            }
                            else if (State.OnboardingOf(employee.Id) is { } plan)
                            {
                                var progress = HrState.Progress(plan);
                                var overdue = plan.Tasks.Count(task => task.DoneAt is null && task.Due < today);
                                <p class="small mb-2">
                                    “@plan.TemplateName”, started @HrDisplay.Date(plan.CreatedAt). @AdminHelpers.ProgressText(progress.Done, progress.Total)@(overdue == 0 ? "." : $", {overdue} overdue.")
                                </p>
                                <Progress Height="6" Class="mb-2">
                                    <ProgressBar Width="@AdminHelpers.Percent(progress.Done, progress.Total)" Color="ProgressColor.Success"
                                                 aria-label="@($"{employee.Name}, onboarding tasks done")" aria-valuenow="@Math.Round(AdminHelpers.Percent(progress.Done, progress.Total))"
                                                 aria-valuemin="0" aria-valuemax="100" aria-valuetext="@AdminHelpers.ProgressText(progress.Done, progress.Total)" />
                                </Progress>
                                <p class="small mb-0"><a href="@AdminHelpers.NewHiresUrl">Follow it on New hires</a></p>
                            }
                            else
                            {
                                var usable = State.Templates.Where(template => template.Tasks.Count > 0).ToList();
                                var chosen = SelectedTemplate;
                                <p class="small text-body-secondary mb-2">
                                    They don't have an onboarding plan yet. Due dates count from their start date, @HrDisplay.Date(employee.StartDate).
                                </p>
                                @if (usable.Count == 0)
                                {
                                    <p class="small mb-0">No template has tasks yet. Add tasks in <a href="@AdminHelpers.TemplatesUrl">Onboarding templates</a> first.</p>
                                }
                                else
                                {
                                    <form @onsubmit="StartOnboarding" novalidate aria-labelledby="hr-aee-onb-title">
                                        <label class="form-label small fw-semibold" for="hr-aee-template">Template</label>
                                        <select id="hr-aee-template" class="form-select mb-1" @bind="templateValue" @ref="templateSelect" aria-describedby="hr-aee-template-help">
                                            @foreach (var template in State.Templates)
                                            {
                                                <option value="@template.Id.ToString(CultureInfo.InvariantCulture)" disabled="@(template.Tasks.Count == 0)" @key="template.Id">@AdminHelpers.TemplateOption(template)</option>
                                            }
                                        </select>
                                        <div class="form-text mb-2" id="hr-aee-template-help">
                                            @(chosen is { Tasks.Count: > 0 } ? AdminHelpers.OwnerSplit(chosen.Tasks.Select(task => task.Owner)) + "." : null)
                                            Their manager follows it on New hires.
                                        </div>
                                        <Button Type="ButtonType.Submit" Color="ButtonColor.Primary" Outline="@(!justCreated)" Size="ButtonSize.Small">
                                            <Icon Name="IconName.ListCheck" class="me-1" aria-hidden="true" />Start onboarding
                                        </Button>
                                    </form>
                                }
                            }
                        </section>

                        <section class="hr-panel" aria-labelledby="hr-aee-account-title">
                            <h2 class="hr-section-title mb-1" id="hr-aee-account-title">Sign-in</h2>
                            <p class="small mb-0">
                                @if (employee is null)
                                {
                                    <span>Once you add them, they register on the @HrSeedData.ProductName sign-in page with their work email, and their account links to this record.</span>
                                }
                                else if (employee.AccountId is not null)
                                {
                                    <span>@employee.Name has a @HrSeedData.ProductName account linked to this record.</span>
                                }
                                else if (employee.InvitePending)
                                {
                                    <span>Not registered yet. When @employee.Name registers with <span class="hr-aee-wrap">@employee.Email</span>, their account links to this record.</span>
                                }
                                else
                                {
                                    <span>@employee.Name has no @HrSeedData.ProductName account in this demo. Only people HR adds here are invited to register.</span>
                                }
                            </p>
                        </section>
                    </div>
                </div>
            }
        }
    </ShowcaseRoleGuard>
</div>
