@page "/showcase/hr-portal/admin/onboarding-templates"
@layout HrWorkLayout

<PageTitle>Onboarding templates · @HrSeedData.ProductName</PageTitle>

<div class="container-fluid px-lg-4">
    <ShowcaseRoleGuard Roles="@HrSeedData.HrAdminRole" SignInPath="@HrLayout.SignInPath">
        @{
            var templates = State.Templates;
        }

        <div class="mb-3">
            <h1 class="hr-title">Onboarding templates</h1>
            <p class="hr-lead mb-0">
                Reusable checklists for new hires. Starting someone's onboarding copies a template's tasks, with due dates counted from
                their start date; later changes to a template don't change plans already started.
            </p>
        </div>

        @* Always rendered and focusable; filled after the page renders when a template was just deleted on its own page. *@
        <p class="fw-semibold hr-at-status @(statusIsError ? "text-danger-emphasis" : null)" role="status" tabindex="-1" @ref="statusRegion">@statusMessage</p>

        <div class="hr-at-grid">
            <section class="hr-panel" aria-labelledby="hr-at-table-title">
                <div class="d-flex flex-wrap align-items-baseline justify-content-between column-gap-3 row-gap-1 mb-2">
                    <h2 class="hr-section-title mb-0" id="hr-at-table-title">Templates (@templates.Count)</h2>
                    @* Back to the saved view's defaults: by name, every column in its place. *@
                    <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ResetViewAsync">Reset view</Button>
                </div>
                <p class="small text-body-secondary">Every onboarding template, by name, with the plans started from one with the same name. A row opens the template.</p>
                <ShowcaseDataState Status="@(viewLoaded ? ShowcaseDataStatus.Ready : ShowcaseDataStatus.Loading)"
                                   IsEmpty="@(templates.Count == 0)"
                                   EmptyIcon="IconName.CardChecklist"
                                   EmptyTitle="No templates yet"
                                   EmptyText="Create a template with the form beside this list to start onboarding new hires."
                                   LoadingText="Loading templates…"
                                   OnRetry="RefreshGridAsync">
                    <ChildContent>
                        <Grid @ref="grid"
                              @key="gridVersion"
                              TItem="TemplateRow"
                              Class="table table-hover sc-grid-row-links hr-at-table"
                              GridContainerClass="hr-grid"
                              DataProvider="ProvideTemplatesAsync"
                              SettingsProvider="view.GetSettingsAsync"
                              GridSettingsChanged="view.SaveSettingsAsync"
                              AllowSorting="true"
                              AllowColumnChooser="true"
                              AllowExport="true"
                              ExportFileName="hr-onboarding-templates"
                              Responsive="true"
                              EmptyText="No templates yet."
                              aria-label="Onboarding templates">
                            <GridColumns>
                                <GridColumn TItem="TemplateRow" HeaderText="Template" PropertyName="Name" SortString="name" SortKeySelector="row => row.Name"
                                            IsDefaultSortColumn="@view.IsSortColumn("name")" SortDirection="@view.DirectionFor("name")" AlwaysVisible="true" Class="hr-at-name">
                                    @* The stretched link makes the whole row open the template; the people links stay above it. *@
                                    <a class="hr-grid-link stretched-link" href="@AdminHelpers.TemplateUrl(context.Id)">@context.Name</a>
                                    @if (context.Description.Length > 0)
                                    {
                                        <span class="d-block small fw-normal text-body-secondary">@context.Description</span>
                                    }
                                </GridColumn>
                                <GridColumn TItem="TemplateRow" HeaderText="Tasks" PropertyName="Tasks" SortString="tasks" SortKeySelector="row => row.TaskCount"
                                            IsDefaultSortColumn="@view.IsSortColumn("tasks")" SortDirection="@view.DirectionFor("tasks")" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End">
                                    <span class="hr-mono">@context.Tasks</span>
                                </GridColumn>
                                <GridColumn TItem="TemplateRow" HeaderText="Plans started from it" PropertyName="Plans" SortString="plans" SortKeySelector="row => row.People.Count"
                                            IsDefaultSortColumn="@view.IsSortColumn("plans")" SortDirection="@view.DirectionFor("plans")" Class="hr-at-plans">
                                    @if (context.People.Count == 0)
                                    {
                                        <span class="text-body-secondary">None</span>
                                    }
                                    else
                                    {
                                        <span class="d-block">@HrDisplay.Plural(context.People.Count, "plan")</span>
                                        <span class="d-block small">
                                            @for (var index = 0; index < context.People.Count; index++)
                                            {
                                                var person = context.People[index];
                                                @(index == 0 ? null : ", ")
                                                @if (person.Id is { } personId)
                                                {
                                                    <a href="@HrDisplay.EmployeeUrl(personId)">@person.Name</a>
                                                }
                                                else
                                                {
                                                    <span>@person.Name</span>
                                                }
                                            }
                                        </span>
                                    }
                                </GridColumn>
                            </GridColumns>
                        </Grid>
                    </ChildContent>
                </ShowcaseDataState>
            </section>

            <section class="hr-panel" aria-labelledby="hr-at-new-title">
                <h2 class="hr-section-title" id="hr-at-new-title">New template</h2>
                @if (templates.Count >= HrState.MaxTemplates)
                {
                    <p class="small text-body-secondary mb-0">There are @HrState.MaxTemplates templates, the most the portal keeps. Delete one to create another.</p>
                }
                else
                {
                    <EditForm EditContext="editContext" OnSubmit="CreateAsync" FormName="hr-new-template" novalidate aria-labelledby="hr-at-new-title">
                        <DataAnnotationsValidator />
                        <ShowcaseFormErrors ShowSummary="true" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="hr-at-name">Name</label>
                            <InputText id="hr-at-name" class="form-control" @bind-Value="form.Name" maxlength="@HrState.MaxNameLength" autocomplete="off"
                                       aria-describedby="hr-at-name-help" />
                            <ShowcaseUniqueCheck @ref="nameCheck" For="() => form.Name" IsTakenAsync="IsNameTakenAsync"
                                                 TakenMessage="@(value => $"Another template is already called {value}. Choose another name.")" />
                            <div class="form-text mt-0" id="hr-at-name-help">Like “Sales new hire”. Unique, up to @HrState.MaxNameLength characters.</div>
                            <ValidationMessage For="() => form.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="hr-at-description">Description <span class="fw-normal text-body-secondary">(optional)</span></label>
                            <InputTextArea id="hr-at-description" class="form-control" rows="3" @bind-Value="form.Description" @oninput="OnDescriptionInput"
                                           aria-describedby="hr-at-description-help" />
                            <div class="form-text" id="hr-at-description-help">
                                Who it's for. <span class="@(descriptionText.Trim().Length > HrState.MaxDescriptionLength ? "text-danger-emphasis" : null)">@AdminHelpers.Counter(descriptionText, HrState.MaxDescriptionLength)</span>
                            </div>
                            <ValidationMessage For="() => form.Description" />
                        </div>
                        <p class="small text-body-secondary">You add its tasks on the next page.</p>
                        <Button Type="ButtonType.Submit" Color="ButtonColor.Primary"><Icon Name="IconName.PlusLg" class="me-1" aria-hidden="true" />Create template</Button>
                    </EditForm>
                }
            </section>
        </div>
    </ShowcaseRoleGuard>
</div>
