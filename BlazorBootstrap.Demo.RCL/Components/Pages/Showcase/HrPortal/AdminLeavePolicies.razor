@page "/showcase/hr-portal/admin/leave-policies"
@layout HrWorkLayout

<PageTitle>Leave policies · @HrSeedData.ProductName</PageTitle>

<div class="container-fluid px-lg-4">
    <ShowcaseRoleGuard Roles="@HrSeedData.HrAdminRole" SignInPath="@HrLayout.SignInPath">
        @{
            var policies = State.AllPolicies;
            var year = State.Clock.Today.Year;
            var offerTurnOff = turnOffOfferId == 0 ? null : State.FindPolicy(turnOffOfferId);
        }

        <div class="hr-alp-head mb-3">
            <div>
                <h1 class="hr-title">Leave policies</h1>
                <p class="hr-lead mb-0">
                    The types of leave people can request, how many days each gives a year, and how much notice it needs. Balances follow
                    a change at once, for everyone.
                </p>
            </div>
            <button type="button" class="btn btn-primary" @ref="addButton" @onclick="AddAsync" disabled="@(policies.Count >= HrState.MaxPolicies)">
                <Icon Name="IconName.PlusLg" class="me-1" aria-hidden="true" />Add leave type
            </button>
        </div>

        @if (policies.Count >= HrState.MaxPolicies)
        {
            <p class="small text-body-secondary">There are @HrState.MaxPolicies leave types, the most the portal keeps. Delete one you don't use to add another.</p>
        }

        @* Always rendered and focusable, so an outcome is announced and focus has somewhere to go once a dialog closes. *@
        <p class="fw-semibold hr-alp-status @(statusIsError ? "text-danger-emphasis" : null)" role="status" tabindex="-1" @ref="statusRegion">@statusMessage</p>

        @if (offerTurnOff is { IsActive: true })
        {
            <div class="hr-alp-offer mb-3">
                <span class="small">Turning “@offerTurnOff.Name” off stops new requests; existing requests and this year's balances keep it.</span>
                <button type="button" class="btn btn-sm btn-primary flex-shrink-0" @onclick="() => TurnOff(offerTurnOff.Id)">Turn off @offerTurnOff.Name</button>
            </div>
        }

        <section class="hr-panel" aria-labelledby="hr-alp-table-title">
            <div class="d-flex flex-wrap align-items-baseline justify-content-between column-gap-3 row-gap-1 mb-2">
                <h2 class="hr-section-title mb-0" id="hr-alp-table-title">Leave types (@policies.Count)</h2>
                @* Back to the saved view's defaults: the order they were added, every column in its place. *@
                <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ResetViewAsync">Reset view</Button>
            </div>
            <p class="small text-body-secondary">
                Every leave type, offered or turned off. Requests and days used count @year so far: requests not cancelled, and approved days across the company.
            </p>
            <ShowcaseDataState Status="@(viewLoaded ? ShowcaseDataStatus.Ready : ShowcaseDataStatus.Loading)"
                               IsEmpty="@(policies.Count == 0)"
                               EmptyIcon="IconName.Sliders"
                               EmptyTitle="No leave types yet"
                               EmptyText="Add a leave type, so people can request time off."
                               LoadingText="Loading leave policies…"
                               OnRetry="RefreshGridAsync">
                <EmptyActions>
                    <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="AddAsync">Add leave type</Button>
                </EmptyActions>
                <ChildContent>
                    <Grid @ref="grid"
                          @key="gridVersion"
                          TItem="PolicyRow"
                          Class="table table-hover sc-grid-row-links hr-alp-table"
                          GridContainerClass="hr-grid"
                          DataProvider="ProvidePoliciesAsync"
                          SettingsProvider="view.GetSettingsAsync"
                          GridSettingsChanged="view.SaveSettingsAsync"
                          AllowSorting="true"
                          AllowColumnChooser="true"
                          AllowExport="true"
                          ExportFileName="hr-leave-policies"
                          Responsive="true"
                          EmptyText="No leave types yet."
                          aria-label="Leave types">
                        <GridColumns>
                            <GridColumn TItem="PolicyRow" HeaderText="Leave type" PropertyName="Name" SortString="name" SortKeySelector="row => row.Name"
                                        IsDefaultSortColumn="@view.IsSortColumn("name")" SortDirection="@view.DirectionFor("name")" AlwaysVisible="true" Class="hr-alp-name">
                                @* A policy has no page of its own: the name opens the editor, and its stretched area makes the whole row do so. *@
                                <button type="button" class="btn btn-link p-0 hr-grid-link stretched-link" @onclick="() => EditAsync(context.Id)">@context.Name</button>
                                @if (context.Description.Length > 0)
                                {
                                    <span class="d-block small fw-normal text-body-secondary">@context.Description</span>
                                }
                            </GridColumn>
                            <GridColumn TItem="PolicyRow" HeaderText="Days a year" PropertyName="DaysAYear" SortString="days" SortKeySelector="row => row.DaysSort"
                                        IsDefaultSortColumn="@view.IsSortColumn("days")" SortDirection="@view.DirectionFor("days")" TextNoWrap="true">
                                @context.DaysAYear
                            </GridColumn>
                            <GridColumn TItem="PolicyRow" HeaderText="Minimum notice" PropertyName="Notice" SortString="notice" SortKeySelector="row => row.NoticeDays"
                                        IsDefaultSortColumn="@view.IsSortColumn("notice")" SortDirection="@view.DirectionFor("notice")" TextNoWrap="true">
                                @context.Notice
                            </GridColumn>
                            <GridColumn TItem="PolicyRow" HeaderText="Offered" PropertyName="Offered" SortString="offered" SortKeySelector="row => row.Offered"
                                        IsDefaultSortColumn="@view.IsSortColumn("offered")" SortDirection="@view.DirectionFor("offered")" TextNoWrap="true">
                                <Badge Color="@(context.IsActive ? BadgeColor.Success : BadgeColor.Secondary)">@context.Offered</Badge>
                            </GridColumn>
                            <GridColumn TItem="PolicyRow" HeaderText="@($"Requests in {year}")" PropertyName="Requests" SortString="requests" SortKeySelector="row => row.Requests"
                                        IsDefaultSortColumn="@view.IsSortColumn("requests")" SortDirection="@view.DirectionFor("requests")" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End">
                                <span class="hr-mono">@context.Requests.ToString(CultureInfo.InvariantCulture)</span>
                            </GridColumn>
                            <GridColumn TItem="PolicyRow" HeaderText="@($"Days used in {year}")" PropertyName="DaysUsed" SortString="used" SortKeySelector="row => row.DaysUsed"
                                        IsDefaultSortColumn="@view.IsSortColumn("used")" SortDirection="@view.DirectionFor("used")" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End">
                                <span class="hr-mono">@context.DaysUsed.ToString(CultureInfo.InvariantCulture)</span>
                            </GridColumn>
                            <GridColumn TItem="PolicyRow" HeaderText="Actions" Sortable="false" Exportable="false">
                                @{
                                    var policyId = context.Id;
                                    var editKey = "edit-" + policyId.ToString(CultureInfo.InvariantCulture);
                                    var deleteKey = "delete-" + policyId.ToString(CultureInfo.InvariantCulture);
                                }
                                <div class="d-flex flex-nowrap gap-1 justify-content-end">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @ref="rowButtons[editKey]" @onclick="() => EditAsync(policyId)">
                                        Edit<span class="visually-hidden">&#32;@context.Name</span>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @ref="rowButtons[deleteKey]" @onclick="() => OpenDeleteAsync(policyId)">
                                        Delete<span class="visually-hidden">&#32;@context.Name</span>
                                    </button>
                                </div>
                            </GridColumn>
                        </GridColumns>
                    </Grid>
                </ChildContent>
            </ShowcaseDataState>
        </section>

        <Modal @ref="editorModal" IsVerticallyCentered="true" IsScrollable="true" ShowCloseButton="false" aria-labelledby="hr-alp-editor-title"
               OnShown="OnEditorShownAsync" OnHidden="OnEditorHidden">
            <HeaderTemplate>
                <h2 class="modal-title h5 hr-alp-wrap" id="hr-alp-editor-title">@(Editing is { } editing ? $"Edit “{editing.Name}”" : "Add a leave type")</h2>
            </HeaderTemplate>
            <BodyTemplate>
                <EditForm id="hr-alp-form" EditContext="editContext" OnSubmit="SaveAsync" FormName="hr-leave-policy" novalidate>
                    <DataAnnotationsValidator />
                    <ShowcaseFormErrors ShowSummary="true" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="hr-alp-name">Name</label>
                        <InputText @ref="nameInput" id="hr-alp-name" class="form-control" @bind-Value="form.Name"
                                   maxlength="@HrState.MaxNameLength" autocomplete="off" aria-describedby="hr-alp-name-help" />
                        <ShowcaseUniqueCheck @ref="nameCheck" For="() => form.Name" IsTakenAsync="IsNameTakenAsync"
                                             TakenMessage="@(value => $"Another leave type is already called {value}. Choose another name.")" />
                        <div class="form-text mt-0" id="hr-alp-name-help">Like “Vacation”. Unique, up to @HrState.MaxNameLength characters.</div>
                        <ValidationMessage For="() => form.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="hr-alp-description">Description <span class="fw-normal text-body-secondary">(optional)</span></label>
                        <InputTextArea id="hr-alp-description" class="form-control" rows="2" @bind-Value="form.Description" @oninput="OnDescriptionInput"
                                       aria-describedby="hr-alp-description-help" />
                        <div class="form-text" id="hr-alp-description-help">
                            Shown to people when they request leave. <span class="@(descriptionText.Trim().Length > HrState.MaxDescriptionLength ? "text-danger-emphasis" : null)">@AdminHelpers.Counter(descriptionText, HrState.MaxDescriptionLength)</span>
                        </div>
                        <ValidationMessage For="() => form.Description" />
                    </div>

                    <div class="form-check mb-2">
                        <InputCheckbox class="form-check-input" id="hr-alp-unlimited" @bind-Value="form.IsUnlimited" aria-describedby="hr-alp-unlimited-help" />
                        <label class="form-check-label fw-semibold" for="hr-alp-unlimited">No yearly limit</label>
                        <div class="form-text mt-0" id="hr-alp-unlimited-help">Like sick leave: use is tracked, but there's no balance to run out of.</div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold" for="hr-alp-days">Days a year</label>
                            <InputNumber TValue="int?" id="hr-alp-days" class="form-control" @bind-Value="form.AnnualDays" min="1" max="@HrState.MaxAnnualDays" step="1"
                                         inputmode="numeric" disabled="@form.IsUnlimited" aria-describedby="hr-alp-days-help" />
                            <div class="form-text" id="hr-alp-days-help">
                                @(form.IsUnlimited ? "Not used: this type has no yearly limit." : $"1 to {HrState.MaxAnnualDays}, per calendar year.")
                                @(Editing is { IsUnlimited: false } current && !form.IsUnlimited && form.AnnualDays is { } newDays && newDays != current.AnnualDays
                                    ? $" Saving changes everyone's {current.Name} balance from {HrDisplay.Days(current.AnnualDays)} to {HrDisplay.Days(newDays)} at once."
                                    : null)
                            </div>
                            <ValidationMessage For="() => form.AnnualDays" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold" for="hr-alp-notice">Minimum notice, in days</label>
                            <InputNumber TValue="int?" id="hr-alp-notice" class="form-control" @bind-Value="form.MinNoticeDays" min="0" max="@HrState.MaxNoticeDays" step="1"
                                         inputmode="numeric" aria-describedby="hr-alp-notice-help" />
                            <div class="form-text" id="hr-alp-notice-help">
                                0 to @HrState.MaxNoticeDays: how many days ahead a request must start; 0 for none.@(form.IsUnlimited ? " Types with no yearly limit can also be recorded up to 30 days back." : null)
                            </div>
                            <ValidationMessage For="() => form.MinNoticeDays" />
                        </div>
                    </div>

                    <div class="form-check mb-3">
                        <InputCheckbox class="form-check-input" id="hr-alp-active" @bind-Value="form.IsActive" aria-describedby="hr-alp-active-help" />
                        <label class="form-check-label fw-semibold" for="hr-alp-active">Offered for new requests</label>
                        <div class="form-text mt-0" id="hr-alp-active-help">Turned off, nobody can request it; existing requests and this year's balances keep it.</div>
                    </div>

                    <p class="small text-body-secondary mb-0">Balances update at once for everyone when you save.</p>
                </EditForm>
                <p class="hr-live-error mt-3 mb-0" role="alert">@formError</p>
            </BodyTemplate>
            <FooterTemplate>
                <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => editorModal.HideAsync()">Cancel</Button>
                <Button Type="ButtonType.Submit" Color="ButtonColor.Primary" form="hr-alp-form">@(Editing is null ? "Add leave type" : "Save changes")</Button>
            </FooterTemplate>
        </Modal>

        <Modal @ref="deleteModal" IsVerticallyCentered="true" ShowCloseButton="false" aria-labelledby="hr-alp-dialog-title" OnHidden="OnDeleteHidden">
            <HeaderTemplate>
                <h2 class="modal-title h5 hr-alp-wrap" id="hr-alp-dialog-title">
                    @(DialogPolicy is { } target ? (UsesOf(target.Id) > 0 ? $"“{target.Name}” can't be deleted" : $"Delete “{target.Name}”?") : "Delete this leave type?")
                </h2>
            </HeaderTemplate>
            <BodyTemplate>
                @if (DialogPolicy is { } target)
                {
                    var uses = UsesOf(target.Id);
                    @if (uses > 0)
                    {
                        <p class="mb-0">
                            @HrDisplay.Plural(uses, "request uses", "requests use") it, so it can't be deleted.
                            @(target.IsActive
                                ? "Turn it off instead: nobody can request it any more, and existing requests and this year's balances keep it."
                                : "It's already turned off, so nobody can request it.")
                        </p>
                    }
                    else
                    {
                        <p>No request uses it. It leaves the list of leave types and everyone's balances.</p>
                        <p class="mb-0">This can't be undone.</p>
                    }
                }
                else
                {
                    <p class="mb-0">This leave type was already deleted.</p>
                }
            </BodyTemplate>
            <FooterTemplate>
                <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => deleteModal.HideAsync()">Cancel</Button>
                @if (DialogPolicy is { } target)
                {
                    @if (UsesOf(target.Id) == 0)
                    {
                        <Button Color="ButtonColor.Danger" @onclick="() => ConfirmAsync(PendingAction.Delete)"><Icon Name="IconName.Trash3" class="me-1" aria-hidden="true" />Delete leave type</Button>
                    }
                    else if (target.IsActive)
                    {
                        <Button Color="ButtonColor.Primary" @onclick="() => ConfirmAsync(PendingAction.TurnOff)">Turn it off</Button>
                    }
                }
            </FooterTemplate>
        </Modal>
    </ShowcaseRoleGuard>
</div>
