@* A chart of Teamhaven's headcount analytics. It is its own component so it starts drawing when it appears: the page's
   content sits inside the sign-in and role guards, which show it only after the tab's data is restored. *@
<div class="hr-ac" role="img" aria-label="@AriaLabel">
    @if (Kind == AdminChartKind.Doughnut)
    {
        <DoughnutChart @ref="doughnut" Height="@Height" HeightUnit="Unit.Px" Width="100" WidthUnit="Unit.Percentage" />
    }
    else
    {
        <BarChart @ref="bar" Height="@Height" HeightUnit="Unit.Px" Width="100" WidthUnit="Unit.Percentage" />
    }
</div>
