@page "/showcase/hr-portal/team"
@layout HrWorkLayout

<PageTitle>@(State.IsHrAdmin ? "Teams" : "My team") · @HrSeedData.ProductName</PageTitle>

@* A manager's direct reports with who's away, waiting requests, vacation left, and onboarding; HR picks any manager's team. *@
<div class="container-fluid px-lg-4">
    <ShowcaseRoleGuard Roles="@($"{HrSeedData.ManagerRole},{HrSeedData.HrAdminRole}")" SignInPath="@HrLayout.SignInPath">
        @if (State.CurrentEmployee is { } me)
        {
            var today = State.Clock.Today;
            var managers = State.IsHrAdmin ? Managers() : Array.Empty<HrEmployee>();
            var lead = TeamLead(me, managers);

            if (lead is null)
            {
                <HrNotFound Message="That person isn't in the directory, or the link is wrong. Pick a manager from the Teams page." />
            }
            else
            {
                var isMine = lead.Id == me.Id;
                var reports = State.DirectReports(lead.Id);
                var away = AwaySoon(reports, today, AwayListDays);

                <h1 class="hr-title mb-1">@(isMine ? "My team" : "Teams")</h1>
                <p class="hr-lead mb-3">
                    @(isMine ? "The people who report to you" : "Any manager's direct reports"): who's away, leave waiting for a decision, vacation left,
                    and onboarding. Open someone's profile for their contact details.
                </p>

                @if (isMine)
                {
                    <HrReviewTodo Class="hr-panel mb-4" HideWhenEmpty="true" />
                }

                @* Always rendered and focusable, so a reset view is announced and focus has somewhere to go. *@
                <p class="hr-live-status" role="status" tabindex="-1" @ref="statusRegion">@statusMessage</p>

                @if (State.IsHrAdmin)
                {
                    <div class="hr-panel mb-4 hr-team-picker">
                        <div class="hr-team-picker-field">
                            <label class="form-label fw-semibold" for="hr-team-manager">Manager</label>
                            <select id="hr-team-manager" class="form-select" value="@lead.Id" @onchange="OnManagerChanged" aria-describedby="hr-team-manager-help">
                                @if (managers.All(item => item.Id != lead.Id))
                                {
                                    <option value="@lead.Id">@lead.Name</option>
                                }
                                @foreach (var item in managers)
                                {
                                    <option value="@item.Id">@(item.Name)@(item.Id == me.Id ? " (you)" : null)</option>
                                }
                            </select>
                        </div>
                        <p class="small text-body-secondary mb-0" id="hr-team-manager-help">
                            As HR you can see every team. Showing @lead.Name, @lead.Title (@HrDisplay.Plural(reports.Count, "direct report")).
                        </p>
                    </div>
                }

                <section class="hr-panel mb-4" aria-labelledby="hr-team-people-title">
                    <div class="d-flex flex-wrap align-items-baseline justify-content-between column-gap-3 row-gap-1 mb-2">
                        <h2 class="hr-section-title mb-0" id="hr-team-people-title">
                            @(isMine ? "Your direct reports" : $"{lead.Name}'s direct reports") <span class="text-body-secondary fw-normal">(@reports.Count)</span>
                        </h2>
                        @* Back to the saved view's defaults: by name, 10 a page, every column in its place. *@
                        <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ResetViewAsync">Reset view</Button>
                    </div>
                    <ShowcaseDataState Status="@(viewLoaded ? ShowcaseDataStatus.Ready : ShowcaseDataStatus.Loading)"
                                       IsEmpty="@(reports.Count == 0)"
                                       EmptyIcon="IconName.People"
                                       EmptyTitle="@(isMine ? "No one reports to you right now" : $"No one reports to {lead.Name} right now")"
                                       EmptyText="@(State.IsHrAdmin ? "Pick another manager above, or give people a manager in Employees." : "When HR adds someone to your team, they show here.")"
                                       LoadingText="Loading the team…"
                                       OnRetry="RefreshGridAsync">
                        <ChildContent>
                            <Grid @ref="grid"
                                  @key="@($"{gridVersion}-{lead.Id}")"
                                  TItem="TeamRow"
                                  Class="table table-hover sc-grid-row-links"
                                  GridContainerClass="hr-grid"
                                  DataProvider="ProvideTeamAsync"
                                  SettingsProvider="view.GetSettingsAsync"
                                  GridSettingsChanged="SaveSettingsAsync"
                                  AllowPaging="true"
                                  PageSize="@pageSize"
                                  PageSizeSelectorVisible="true"
                                  PageSizeSelectorItems="@(new[] { 10, 25, 50 })"
                                  PaginationItemsTextFormat="{0}–{1} of {2} people"
                                  AllowSorting="true"
                                  AllowColumnChooser="true"
                                  AllowExport="true"
                                  ExportFileName="hr-team"
                                  Responsive="true"
                                  EmptyText="No one reports to this manager."
                                  aria-label="@(isMine ? "Your direct reports" : $"{lead.Name}'s direct reports")">
                                <GridColumns>
                                    <GridColumn TItem="TeamRow" HeaderText="Name" PropertyName="Name" SortString="name" SortKeySelector="row => row.Name"
                                                IsDefaultSortColumn="@view.IsSortColumn("name")" SortDirection="@view.DirectionFor("name")" AlwaysVisible="true">
                                        <span class="d-flex align-items-center gap-2">
                                            <span class="hr-avatar" aria-hidden="true">@context.Initials</span>
                                            @* The stretched link makes the whole row open the person's profile; the row's other links stay above it. *@
                                            <span class="min-w-0 hr-team-wrap"><a class="hr-grid-link stretched-link" href="@HrDisplay.EmployeeUrl(context.Id)">@context.Name</a></span>
                                        </span>
                                    </GridColumn>
                                    <GridColumn TItem="TeamRow" HeaderText="Title" PropertyName="Title" SortString="title" SortKeySelector="row => row.Title"
                                                IsDefaultSortColumn="@view.IsSortColumn("title")" SortDirection="@view.DirectionFor("title")" Class="hr-team-cell">
                                        @context.Title
                                    </GridColumn>
                                    <GridColumn TItem="TeamRow" HeaderText="Status" PropertyName="Status" SortString="status" SortKeySelector="row => row.Status"
                                                IsDefaultSortColumn="@view.IsSortColumn("status")" SortDirection="@view.DirectionFor("status")" TextNoWrap="true">
                                        @context.Status
                                    </GridColumn>
                                    <GridColumn TItem="TeamRow" HeaderText="Away in the next 14 days" PropertyName="Away" SortString="away" SortKeySelector="row => row.AwaySort"
                                                IsDefaultSortColumn="@view.IsSortColumn("away")" SortDirection="@view.DirectionFor("away")" Class="hr-team-cell">
                                        @if (context.AwayNow)
                                        {
                                            <Icon Name="IconName.Airplane" class="me-1" aria-hidden="true" />
                                        }
                                        @context.Away
                                    </GridColumn>
                                    <GridColumn TItem="TeamRow" HeaderText="Leave waiting" PropertyName="Waiting" SortString="waiting" SortKeySelector="row => row.Waiting"
                                                IsDefaultSortColumn="@view.IsSortColumn("waiting")" SortDirection="@view.DirectionFor("waiting")" TextNoWrap="true">
                                        @if (context.Waiting == 0)
                                        {
                                            <span>None</span>
                                        }
                                        else
                                        {
                                            <a href="@($"{HrLayout.Base}/approvals")">@HrDisplay.Plural(context.Waiting, "request")<span class="visually-hidden">&#32;from @context.Name</span></a>
                                        }
                                    </GridColumn>
                                    <GridColumn TItem="TeamRow" HeaderText="@($"Vacation left for {today.Year}")" PropertyName="Vacation" SortString="vacation" SortKeySelector="row => row.VacationLeft"
                                                IsDefaultSortColumn="@view.IsSortColumn("vacation")" SortDirection="@view.DirectionFor("vacation")" TextNoWrap="true">
                                        @context.Vacation
                                    </GridColumn>
                                    <GridColumn TItem="TeamRow" HeaderText="Onboarding" PropertyName="Onboarding" SortString="onboarding" SortKeySelector="row => row.Onboarding"
                                                IsDefaultSortColumn="@view.IsSortColumn("onboarding")" SortDirection="@view.DirectionFor("onboarding")" TextNoWrap="true">
                                        @if (context.HasPlan)
                                        {
                                            <a href="@($"{HrLayout.Base}/team/onboarding")">@context.Onboarding<span class="visually-hidden">&#32;for @context.Name</span></a>
                                        }
                                        else
                                        {
                                            <span class="text-body-secondary">@context.Onboarding</span>
                                        }
                                    </GridColumn>
                                </GridColumns>
                            </Grid>
                        </ChildContent>
                    </ShowcaseDataState>
                </section>

                @* A four-week schedule of the team's approved leave, not a record list, so it stays a plain table. *@
                <section aria-labelledby="hr-team-away-title">
                    <h2 class="hr-section-title" id="hr-team-away-title">Who's away in the next 4 weeks</h2>
                    <p class="text-body-secondary small">
                        Approved leave from @HrDisplay.Date(today) to @HrDisplay.Date(today.AddDays(AwayListDays - 1)). Requests still waiting for a decision
                        aren't included; they're under <a href="@($"{HrLayout.Base}/approvals")">Leave approvals</a>.
                    </p>
                    @if (away.Count == 0)
                    {
                        <div class="hr-panel"><p class="mb-0 text-body-secondary">No one on the team is away in the next 4 weeks.</p></div>
                    }
                    else
                    {
                        <div class="hr-panel p-0">
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0 hr-team-table">
                                    <caption class="visually-hidden">Approved leave on @(isMine ? "your" : $"{lead.Name}'s") team in the next 4 weeks</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col">Person</th>
                                            <th scope="col">Type</th>
                                            <th scope="col">Dates</th>
                                            <th scope="col">Working days</th>
                                            <th scope="col">When</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var (person, request) in away)
                                        {
                                            <tr @key="@($"row-{request.Id}")">
                                                <th scope="row">@person.Name</th>
                                                <td>@(State.FindPolicy(request.PolicyId)?.Name ?? "Leave")</td>
                                                <td class="text-nowrap">@HrDisplay.Range(request.From, request.To)</td>
                                                <td>@request.Days</td>
                                                <td class="text-nowrap">@WhenText(request, today)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </section>
            }
        }
    </ShowcaseRoleGuard>
</div>
