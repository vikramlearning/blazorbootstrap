@page "/showcase/hr-portal/admin/employees"
@layout HrWorkLayout

<PageTitle>Employees · @HrSeedData.ProductName</PageTitle>

<div class="container-fluid px-lg-4">
    <ShowcaseRoleGuard Roles="@HrSeedData.HrAdminRole" SignInPath="@HrLayout.SignInPath">
        @{
            var today = State.Clock.Today;
            var all = State.AllEmployees;
            var narrowed = Narrowed(all);
            var shownCount = narrowed.Count(employee => Matches(employee, statusFilter, today));
            var me = State.CurrentEmployee;
        }

        <div class="hr-ae-head mb-3">
            <div>
                <h1 class="hr-title">Employees</h1>
                <p class="hr-lead mb-0">
                    Everyone at @HrSeedData.CompanyName, including people joining soon and those who left. Add a new hire and start
                    their onboarding, open someone's record to edit their job details, or mark someone as left.
                </p>
            </div>
            <Button Type="ButtonType.Link" To="@AdminHelpers.NewEmployeeUrl" Color="ButtonColor.Primary"><Icon Name="IconName.PersonPlus" class="me-1" aria-hidden="true" />Add employee</Button>
        </div>

        <HrReviewTodo Class="hr-panel mb-3" HideWhenEmpty="true" MaxShown="3" />

        @* Always rendered and focusable, so an outcome is announced and focus has somewhere to go once a dialog closes. *@
        <p class="fw-semibold hr-ae-status @(statusIsError ? "text-danger-emphasis" : null)" role="status" tabindex="-1" @ref="statusRegion">@statusMessage</p>

        @if (BlockedPerson is { } blocked)
        {
            var reports = State.DirectReports(blocked.Id);
            var isMe = me?.Id == blocked.Id;
            <section class="hr-ae-blocked mb-4" aria-labelledby="hr-ae-blocked-title">
                <h2 class="hr-section-title h6 mb-1 hr-ae-wrap" id="hr-ae-blocked-title">Before @blocked.Name can be marked as left</h2>
                @if (isMe)
                {
                    <p class="small mb-2">You can't mark yourself as left. Another HR admin has to do it.</p>
                }
                else if (reports.Count > 0)
                {
                    <p class="small mb-2">
                        @HrDisplay.Plural(reports.Count, "person still reports", "people still report") to them. Give each a new manager, then mark @blocked.Name as left.
                    </p>
                    <ul class="list-unstyled d-grid gap-2 mb-2">
                        @foreach (var report in reports)
                        {
                            <li class="hr-ae-report" @key="report.Id">
                                <span class="min-w-0">
                                    <a class="fw-semibold hr-ae-wrap" href="@HrDisplay.EmployeeUrl(report.Id)">@report.Name</a>
                                    <span class="d-block small text-body-secondary hr-ae-wrap">@report.Title · @AdminHelpers.StatusText(report, today)</span>
                                </span>
                                <a class="btn btn-sm btn-outline-secondary flex-shrink-0" href="@AdminHelpers.EditEmployeeUrl(report.Id)">Change manager<span class="visually-hidden">: @report.Name</span></a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="small mb-2">Nobody reports to @blocked.Name any more, so you can mark them as left now.</p>
                }
                <div class="d-flex flex-wrap gap-2">
                    @if (!isMe && reports.Count == 0 && blocked.Status != HrEmployeeStatus.Left)
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => OpenLeftAsync(blocked.Id)">Mark @blocked.Name as left</button>
                    }
                    <button type="button" class="btn btn-sm btn-link" @onclick="DismissBlocked">Dismiss</button>
                </div>
            </section>
        }

        <div class="hr-panel">
            <div class="hr-ae-filters mb-3" role="search" aria-label="Filter employees">
                <div class="hr-ae-filter-status" role="group" aria-label="Filter by status">
                    @foreach (var option in FilterOptions)
                    {
                        var pressed = statusFilter == option.Filter;
                        var count = narrowed.Count(employee => Matches(employee, option.Filter, today));
                        <button type="button" class="btn btn-sm @(pressed ? "btn-primary" : "btn-outline-secondary")" aria-pressed="@(pressed ? "true" : "false")"
                                @onclick="() => SetStatusFilterAsync(option.Filter)" @key="option.Text">
                            @option.Text <span class="hr-ae-count">(@count)</span>
                        </button>
                    }
                </div>
                <div class="hr-ae-field">
                    <label class="form-label small fw-semibold mb-1" for="hr-ae-department">Department</label>
                    <select id="hr-ae-department" class="form-select form-select-sm" value="@departmentId" @onchange="OnDepartmentChangedAsync">
                        <option value="">All departments</option>
                        @foreach (var department in State.Departments)
                        {
                            <option value="@department.Id" @key="department.Id">@department.Name</option>
                        }
                    </select>
                </div>
                <div class="hr-ae-field">
                    <label class="form-label small fw-semibold mb-1" for="hr-ae-search">Search</label>
                    <input id="hr-ae-search" type="search" class="form-control form-control-sm" value="@search" @oninput="OnSearchInputAsync" autocomplete="off"
                           maxlength="@HrState.MaxNameLength" placeholder="Name, email, or title" aria-describedby="hr-ae-shown" />
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center column-gap-3 row-gap-1 mb-2">
                <p class="small text-body-secondary mb-0" id="hr-ae-shown" role="status" tabindex="-1" @ref="countRegion">@ShownText(shownCount, all.Count)</p>
                @* Back to the saved view's defaults: by name, first page, 25 a page, every column in its place. *@
                <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ResetViewAsync">Reset view</Button>
            </div>

            <ShowcaseDataState Status="@(viewLoaded ? ShowcaseDataStatus.Ready : ShowcaseDataStatus.Loading)"
                               IsEmpty="@(all.Count == 0)"
                               EmptyIcon="IconName.People"
                               EmptyTitle="No employees yet"
                               EmptyText="Add your first employee; they show in the directory and the org chart at once."
                               LoadingText="Loading employees…"
                               OnRetry="RefreshGridAsync">
                <EmptyActions>
                    <Button Type="ButtonType.Link" To="@AdminHelpers.NewEmployeeUrl" Color="ButtonColor.Primary" Size="ButtonSize.Small">Add employee</Button>
                </EmptyActions>
                <ChildContent>
                    @* With no column sorted, the rows stay by name. *@
                    <Grid @ref="grid"
                          @key="gridVersion"
                          TItem="EmployeeRow"
                          Class="table table-hover sc-grid-row-links hr-ae-table"
                          GridContainerClass="hr-grid"
                          DataProvider="ProvideEmployeesAsync"
                          SettingsProvider="view.GetSettingsAsync"
                          GridSettingsChanged="SaveSettingsAsync"
                          AllowPaging="true"
                          PageSize="@pageSize"
                          PageSizeSelectorVisible="true"
                          PageSizeSelectorItems="@(new[] { 10, 25, 50, 100 })"
                          PaginationItemsTextFormat="{0}–{1} of {2} people"
                          AllowSorting="true"
                          RowClass="RowClass"
                          AllowColumnChooser="true"
                          AllowExport="true"
                          ExportFileName="hr-employees"
                          Responsive="true"
                          EmptyText="Nobody matches these filters. Try another status, department, or search."
                          aria-label="Employees">
                        <GridColumns>
                            <GridColumn TItem="EmployeeRow" HeaderText="Name" PropertyName="Name" SortString="name" SortKeySelector="row => row.Name"
                                        IsDefaultSortColumn="@view.IsSortColumn("name")" SortDirection="@view.DirectionFor("name")" AlwaysVisible="true" Class="hr-ae-name">
                                <span class="d-flex align-items-center gap-2">
                                    <span class="hr-avatar" aria-hidden="true">@context.Initials</span>
                                    @* The stretched link makes the whole row open the person's record; the row's buttons stay above it. *@
                                    <span class="min-w-0"><a class="hr-grid-link stretched-link" href="@AdminHelpers.EditEmployeeUrl(context.Id)">@context.Name</a>@(context.IsMe ? " (you)" : null)</span>
                                </span>
                            </GridColumn>
                            <GridColumn TItem="EmployeeRow" HeaderText="Work email" PropertyName="Email" SortString="email" SortKeySelector="row => row.Email"
                                        IsDefaultSortColumn="@view.IsSortColumn("email")" SortDirection="@view.DirectionFor("email")" Class="hr-ae-email">
                                <span class="small">@context.Email</span>
                            </GridColumn>
                            <GridColumn TItem="EmployeeRow" HeaderText="Title" PropertyName="Title" SortString="title" SortKeySelector="row => row.Title"
                                        IsDefaultSortColumn="@view.IsSortColumn("title")" SortDirection="@view.DirectionFor("title")" Class="hr-ae-title">
                                @context.Title
                            </GridColumn>
                            <GridColumn TItem="EmployeeRow" HeaderText="Department" PropertyName="Department" SortString="department" SortKeySelector="row => row.Department"
                                        IsDefaultSortColumn="@view.IsSortColumn("department")" SortDirection="@view.DirectionFor("department")" Class="hr-ae-dept">
                                @context.Department
                            </GridColumn>
                            <GridColumn TItem="EmployeeRow" HeaderText="Manager" PropertyName="Manager" SortString="manager" SortKeySelector="row => row.Manager"
                                        IsDefaultSortColumn="@view.IsSortColumn("manager")" SortDirection="@view.DirectionFor("manager")" Class="hr-ae-manager">
                                @if (context.ManagerId is null)
                                {
                                    <span class="text-body-secondary">None (top of the org chart)</span>
                                }
                                else
                                {
                                    @context.Manager
                                }
                            </GridColumn>
                            <GridColumn TItem="EmployeeRow" HeaderText="Location" PropertyName="Location" SortString="location" SortKeySelector="row => row.Location"
                                        IsDefaultSortColumn="@view.IsSortColumn("location")" SortDirection="@view.DirectionFor("location")" TextNoWrap="true">
                                @context.Location
                            </GridColumn>
                            <GridColumn TItem="EmployeeRow" HeaderText="Start date" PropertyName="Start" SortString="start" SortKeySelector="row => row.StartDate"
                                        IsDefaultSortColumn="@view.IsSortColumn("start")" SortDirection="@view.DirectionFor("start")" TextNoWrap="true">
                                @context.Start
                            </GridColumn>
                            <GridColumn TItem="EmployeeRow" HeaderText="Status" PropertyName="Status" SortString="status" SortKeySelector="row => row.Status"
                                        IsDefaultSortColumn="@view.IsSortColumn("status")" SortDirection="@view.DirectionFor("status")" TextNoWrap="true">
                                <Badge Color="@StatusBadge(context.StatusKind)">@context.Status</Badge>
                            </GridColumn>
                            <GridColumn TItem="EmployeeRow" HeaderText="Onboarding" PropertyName="Onboarding" SortString="onboarding" SortKeySelector="row => row.OnboardingShare"
                                        IsDefaultSortColumn="@view.IsSortColumn("onboarding")" SortDirection="@view.DirectionFor("onboarding")" Class="hr-ae-progress">
                                @if (context.OnboardingTotal == 0)
                                {
                                    <span class="text-body-secondary">None</span>
                                }
                                else
                                {
                                    <Progress Height="6" Class="mb-1">
                                        <ProgressBar Width="@AdminHelpers.Percent(context.OnboardingDone, context.OnboardingTotal)" Color="ProgressColor.Success"
                                                     aria-label="@($"{context.Name}, onboarding tasks done")" aria-valuenow="@Math.Round(AdminHelpers.Percent(context.OnboardingDone, context.OnboardingTotal))"
                                                     aria-valuemin="0" aria-valuemax="100" aria-valuetext="@context.Onboarding" />
                                    </Progress>
                                    <span class="small d-block">@context.Onboarding</span>
                                    @if (context.Overdue > 0)
                                    {
                                        <span class="small d-block text-danger-emphasis"><Icon Name="IconName.ExclamationTriangle" class="me-1" aria-hidden="true" />@context.Overdue overdue</span>
                                    }
                                }
                            </GridColumn>
                            <GridColumn TItem="EmployeeRow" HeaderText="Actions" Sortable="false" Exportable="false">
                                @if (context.StatusKind != HrEmployeeStatus.Left)
                                {
                                    var employeeId = context.Id;
                                    var onboardingKey = "onb-" + employeeId.ToString(CultureInfo.InvariantCulture);
                                    var leftKey = "left-" + employeeId.ToString(CultureInfo.InvariantCulture);
                                    <div class="d-flex flex-nowrap gap-1 justify-content-end">
                                        @if (context.OnboardingTotal == 0)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary text-nowrap" @ref="actionButtons[onboardingKey]" @onclick="() => OpenOnboardingAsync(employeeId)">
                                                Start onboarding<span class="visually-hidden">: @context.Name</span>
                                            </button>
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-danger text-nowrap" @ref="actionButtons[leftKey]" @onclick="() => OpenLeftAsync(employeeId)">
                                            Mark as left<span class="visually-hidden">: @context.Name</span>
                                        </button>
                                    </div>
                                }
                            </GridColumn>
                        </GridColumns>
                    </Grid>
                </ChildContent>
            </ShowcaseDataState>
        </div>

        <Modal @ref="onboardingModal" IsVerticallyCentered="true" ShowCloseButton="false" aria-labelledby="hr-ae-onb-title" OnShown="OnOnboardingShown" OnHidden="OnOnboardingHidden">
            <HeaderTemplate>
                <h2 class="modal-title h5 hr-ae-wrap" id="hr-ae-onb-title">@(DialogPerson is { } target ? $"Start onboarding for {target.Name}" : "Start onboarding")</h2>
            </HeaderTemplate>
            <BodyTemplate>
                @{
                    var target = DialogPerson;
                    var usable = State.Templates.Where(template => template.Tasks.Count > 0).ToList();
                    var chosen = SelectedTemplate;
                }
                @if (target is null || target.Status == HrEmployeeStatus.Left)
                {
                    <p class="mb-0">This person has left or was removed, so onboarding can't start.</p>
                }
                else if (State.OnboardingOf(target.Id) is { } existing)
                {
                    <p class="mb-0">@target.Name already has an onboarding plan (“@existing.TemplateName”, @AdminHelpers.ProgressText(HrState.Progress(existing).Done, existing.Tasks.Count)).</p>
                }
                else if (usable.Count == 0)
                {
                    <p class="mb-0">No onboarding template has tasks yet. Add tasks to a template in <a href="@AdminHelpers.TemplatesUrl">Onboarding templates</a> first.</p>
                }
                else
                {
                    <label class="form-label fw-semibold" for="hr-ae-template">Template</label>
                    <select id="hr-ae-template" class="form-select" @bind="templateValue" @ref="templateSelect" aria-describedby="hr-ae-template-help">
                        @foreach (var template in State.Templates)
                        {
                            <option value="@template.Id.ToString(CultureInfo.InvariantCulture)" disabled="@(template.Tasks.Count == 0)" @key="template.Id">@AdminHelpers.TemplateOption(template)</option>
                        }
                    </select>
                    <div class="form-text" id="hr-ae-template-help">
                        @if (chosen is not null && chosen.Tasks.Count > 0)
                        {
                            <span>@AdminHelpers.OwnerSplit(chosen.Tasks.Select(task => task.Owner)).</span>
                        }
                        Due dates count from their start date, @HrDisplay.Date(target.StartDate). Their manager follows the plan on New hires,
                        and @target.Name sees the checklist after registering with @target.Email.
                    </div>
                }
            </BodyTemplate>
            <FooterTemplate>
                <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => onboardingModal.HideAsync()">Cancel</Button>
                @if (DialogPerson is { Status: not HrEmployeeStatus.Left } person && State.OnboardingOf(person.Id) is null && SelectedTemplate is { Tasks.Count: > 0 })
                {
                    <Button Color="ButtonColor.Primary" @onclick="ConfirmOnboardingAsync"><Icon Name="IconName.ListCheck" class="me-1" aria-hidden="true" />Start onboarding</Button>
                }
            </FooterTemplate>
        </Modal>

        <Modal @ref="leftModal" IsVerticallyCentered="true" ShowCloseButton="false" aria-labelledby="hr-ae-left-title" OnShown="OnLeftShown" OnHidden="OnLeftHidden">
            <HeaderTemplate>
                <h2 class="modal-title h5 hr-ae-wrap" id="hr-ae-left-title">@(DialogPerson is { } target ? $"Mark {target.Name} as left?" : "Mark as left?")</h2>
            </HeaderTemplate>
            <BodyTemplate>
                @{
                    var target = DialogPerson;
                }
                @if (target is null || target.Status == HrEmployeeStatus.Left)
                {
                    <p class="mb-0">This person was already marked as left or was removed.</p>
                }
                else
                {
                    var pending = State.LeaveOf(target.Id).Where(request => request.Status == HrLeaveStatus.Pending).ToList();
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="hr-ae-last-day">Last day</label>
                        <input id="hr-ae-last-day" type="date" class="form-control @(lastDayError is null ? null : "is-invalid")" value="@lastDayText"
                               @onchange="args => lastDayText = args.Value as string ?? string.Empty" @ref="lastDayInput"
                               min="@AdminHelpers.DateValue(target.StartDate)" max="@AdminHelpers.DateValue(State.Clock.Today)" aria-required="true"
                               aria-invalid="@(lastDayError is null ? null : "true")" aria-describedby="hr-ae-last-day-help hr-ae-last-day-error" />
                        <div class="form-text" id="hr-ae-last-day-help">Their last working day: today or earlier, and on or after their start date, @HrDisplay.Date(target.StartDate).</div>
                        <div class="invalid-feedback d-block" id="hr-ae-last-day-error">@lastDayError</div>
                    </div>
                    <p class="small">
                        They leave the directory, the org chart, and their team as soon as you confirm, and can't use @HrSeedData.ProductName any more.
                        Their record stays here as “Left” and counts in headcount analytics.
                    </p>
                    <p class="small mb-0">
                        @if (pending.Count == 0)
                        {
                            <span>They have no leave waiting for approval.</span>
                        }
                        else
                        {
                            <span>
                                Their @HrDisplay.Plural(pending.Count, "leave request") waiting for approval
                                (@string.Join("; ", pending.Select(request => HrDisplay.Range(request.From, request.To))))
                                @(pending.Count == 1 ? "is" : "are") cancelled.
                            </span>
                        }
                    </p>
                }
            </BodyTemplate>
            <FooterTemplate>
                <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => leftModal.HideAsync()">Cancel</Button>
                @if (DialogPerson is { Status: not HrEmployeeStatus.Left })
                {
                    <Button Color="ButtonColor.Danger" @onclick="ConfirmLeftAsync"><Icon Name="IconName.BoxArrowRight" class="me-1" aria-hidden="true" />Mark as left</Button>
                }
            </FooterTemplate>
        </Modal>
    </ShowcaseRoleGuard>
</div>
