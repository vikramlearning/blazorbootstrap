@page "/showcase/ai-assistant/profile"
@layout AiLayout

<PageTitle>Profile · @AiSeedData.ProductName</PageTitle>

@* The member's name, email, and password; their chat preferences; and their workspace membership and role. *@
<div class="container-xl">
    <AiMemberGuard>
        @{
            var member = State.CurrentMember;
            var defaultModel = State.FindModel(State.Policy.DefaultModelId);
            var offModel = TurnedOffPreference;
        }

        <h1 class="pa-title mb-1">Profile</h1>
        <p class="pa-lead mb-4">
            Your name, email, and password for this demo, how you like to chat, and your place in the @State.WorkspaceName workspace.
            Admins and the Owner see your name and email in the members list.
        </p>

        <ShowcaseAccountProfile />

        <div class="row g-4 mt-0">
            <div class="col-lg-7">
                <section class="pa-panel h-100" aria-labelledby="pa-profile-prefs-title">
                    <h2 class="pa-section-title" id="pa-profile-prefs-title">Chat preferences</h2>

                    @if (offModel is not null)
                    {
                        <p class="pa-profile-notice">
                            <Icon Name="IconName.InfoCircle" class="me-2" aria-hidden="true" />
                            Your saved default model, @offModel.Name, was turned off by an Admin. New chats start with the workspace default,
                            @(defaultModel?.Name ?? State.Policy.DefaultModelId), until you choose another model and save.
                        </p>
                    }

                    <EditForm EditContext="editContext" OnSubmit="SavePreferences" FormName="pa-preferences" novalidate>
                        <DataAnnotationsValidator />
                        <ShowcaseFormErrors ShowSummary="true" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="pa-profile-model">Default model for new chats</label>
                            <InputSelect id="pa-profile-model" class="form-select" @bind-Value="form.ModelId" aria-describedby="pa-profile-model-help">
                                <option value="">Workspace default (@(defaultModel?.Name ?? State.Policy.DefaultModelId))</option>
                                @foreach (var model in State.EnabledModels)
                                {
                                    <option value="@model.Id" @key="model.Id">@model.Name</option>
                                }
                            </InputSelect>
                            <div class="form-text" id="pa-profile-model-help">
                                <span class="d-block mb-1">You can still change the model in any chat. The models your workspace offers:</span>
                                <ul class="pa-profile-models mb-0">
                                    @foreach (var model in State.EnabledModels)
                                    {
                                        <li @key="@($"help-{model.Id}")">
                                            <strong>@model.Name</strong>@(model.Id == State.Policy.DefaultModelId ? " (workspace default)" : null): @model.Description
                                        </li>
                                    }
                                </ul>
                            </div>
                            <ValidationMessage For="() => form.ModelId" />
                        </div>

                        <div class="form-check mb-1">
                            <InputCheckbox class="form-check-input" id="pa-profile-enter" @bind-Value="form.EnterToSend" aria-describedby="pa-profile-enter-help" />
                            <label class="form-check-label fw-semibold" for="pa-profile-enter">Press Enter to send (Shift+Enter for a new line)</label>
                        </div>
                        <div class="form-text mt-0 mb-3" id="pa-profile-enter-help">
                            @(form.EnterToSend
                                ? "Enter sends your message; Shift+Enter starts a new line."
                                : "Off: Enter starts a new line, and Ctrl+Enter sends your message.")
                        </div>

                        <p class="pa-form-error mb-3" role="alert">@errorMessage</p>
                        <Button Type="ButtonType.Submit" Color="ButtonColor.Primary">Save preferences</Button>
                        @* Always rendered and focusable, so a save is announced. *@
                        <p class="pa-profile-status fw-semibold mt-3 mb-0" role="status" tabindex="-1" @ref="statusRegion">@statusMessage</p>
                    </EditForm>
                </section>
            </div>

            <div class="col-lg-5">
                <section class="pa-panel h-100" aria-labelledby="pa-profile-membership-title">
                    <h2 class="pa-section-title" id="pa-profile-membership-title">Workspace membership</h2>
                    @if (member is not null)
                    {
                        <dl class="pa-profile-facts">
                            <dt>Workspace</dt>
                            <dd>@State.WorkspaceName</dd>
                            <dt>Your role</dt>
                            <dd>
                                @AiDisplay.RoleLabel(member.Role)
                                <span class="d-block small text-body-secondary">@AiDisplay.RoleSummary(member.Role)</span>
                            </dd>
                            <dt>Joined</dt>
                            <dd>@member.JoinedAt.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</dd>
                            <dt>Monthly cap</dt>
                            <dd>@AiDisplay.Tokens(State.CapOf(member)) tokens@(member.MonthlyCap is null ? " (the default)" : " (your own)") · <a href="@($"{AiLayout.Base}/usage")">See your usage</a></dd>
                        </dl>
                    }
                    @if (State.Can(AiPermission.ManageSharedPrompts))
                    {
                        <a class="btn btn-outline-primary" href="@AiDisplay.AdminHomeFor(State)"><Icon Name="IconName.Speedometer2" class="me-2" aria-hidden="true" />Open Workspace admin</a>
                    }
                    else
                    {
                        <p class="small text-body-secondary mb-0">Admins and the Owner (@State.OwnerName) manage members, roles, and settings. Ask one of them if you need a change.</p>
                    }
                </section>
            </div>
        </div>
    </AiMemberGuard>
</div>
