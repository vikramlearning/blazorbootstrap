@page "/showcase/ai-assistant/admin/prompts"
@layout AiAdminLayout

<PageTitle>Shared prompts · @AiSeedData.ProductName</PageTitle>

@* Prompt editors, Admins, and the Owner: the shared prompt library with drafts, in a Grid with publish, unpublish, and delete in bulk. *@
<div class="container-fluid px-lg-4">
    <AiMemberGuard Require="AiPermission.ManageSharedPrompts">
        @{
            var prompts = State.AllSharedPrompts;
            var published = prompts.Count(prompt => prompt.IsPublished);
        }

        <div class="pa-adpr-head mb-3">
            <div>
                <h1 class="pa-title">Shared prompts</h1>
                <p class="pa-lead mb-0">
                    The prompts every member of @State.WorkspaceName sees in their prompt library once published. Drafts stay here until you publish them. Members hear about
                    each prompt you publish; an author hears when someone else edits or deletes theirs.
                </p>
            </div>
            <Button Type="ButtonType.Link" To="@NewUrl" Color="ButtonColor.Primary"><Icon Name="IconName.PlusLg" class="me-1" aria-hidden="true" />New shared prompt</Button>
        </div>

        @* Always rendered and focusable, so a change is announced and focus has somewhere to go when the bulk bar closes. *@
        <p class="pa-list-status mb-2" role="status" tabindex="-1" @ref="statusRegion">@statusMessage</p>
        <p class="pa-list-error mb-2" role="alert">@errorMessage</p>

        <section class="pa-panel mb-3" aria-labelledby="pa-adpr-filters-title">
            <h2 class="pa-section-title" id="pa-adpr-filters-title">Filter shared prompts</h2>
            <div class="pa-list-filters" role="search" aria-labelledby="pa-adpr-filters-title">
                <div class="pa-list-search">
                    <label class="form-label small fw-semibold" for="pa-adpr-search">Search</label>
                    <input id="pa-adpr-search" type="search" class="form-control" value="@searchBoxValue" placeholder="Title, author, or tag" autocomplete="off" maxlength="80"
                           @oninput="OnSearchInputAsync" @onchange="OnSearchChanged" />
                </div>
                <div>
                    <label class="form-label small fw-semibold" for="pa-adpr-status">Status</label>
                    <select id="pa-adpr-status" class="form-select" value="@statusFilter" @onchange="OnStatusFilterChangedAsync">
                        <option value="">All (@prompts.Count)</option>
                        <option value="@PublishedValue">Published (@published)</option>
                        <option value="@DraftValue">Drafts (@(prompts.Count - published))</option>
                    </select>
                </div>
                <div>
                    <label class="form-label small fw-semibold" for="pa-adpr-category">Category</label>
                    <select id="pa-adpr-category" class="form-select" value="@categoryFilter" @onchange="OnCategoryFilterChangedAsync">
                        <option value="">All categories</option>
                        @foreach (var category in Enum.GetValues<AiPromptCategory>())
                        {
                            <option value="@category" @key="category">@category (@prompts.Count(prompt => prompt.Category == category))</option>
                        }
                    </select>
                </div>
            </div>
            <div class="pa-list-meta">
                <p class="small text-body-secondary mb-0" aria-live="polite" tabindex="-1" @ref="countRegion">@CountText(prompts.Count)</p>
                @if (IsFiltered)
                {
                    <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ClearFiltersAsync">Show every shared prompt</Button>
                }
                @* Back to the saved view's defaults: the most recently changed first, 25 a page, every column in its place. *@
                <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ResetViewAsync">Reset view</Button>
            </div>
        </section>

        @if (selected.Count > 0)
        {
            <section class="pa-bulk" aria-labelledby="pa-adpr-bulk-count">
                <h2 class="pa-bulk-count" id="pa-adpr-bulk-count">@(selected.Count == 1 ? "1 prompt selected" : $"{selected.Count} prompts selected")</h2>
                <div class="pa-bulk-actions">
                    <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="() => PublishAsync(true)"><Icon Name="IconName.Megaphone" class="me-1" aria-hidden="true" />Publish</Button>
                    <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="() => PublishAsync(false)"><Icon Name="IconName.EyeSlash" class="me-1" aria-hidden="true" />Unpublish</Button>
                    <Button Color="ButtonColor.Danger" Outline="true" Size="ButtonSize.Small" @onclick="AskDeleteAsync"><Icon Name="IconName.Trash3" class="me-1" aria-hidden="true" />Delete</Button>
                    <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="ClearSelectionAsync">Clear selection</Button>
                </div>
                <p class="form-text w-100 mb-0">Publishing shows the prompts to every member, who hear about it once; unpublishing makes them drafts again. Prompts already that way are left as they are.</p>
            </section>
        }

        <section class="pa-panel" aria-label="Shared prompt list">
            <ShowcaseDataState Status="@(viewLoaded ? ShowcaseDataStatus.Ready : ShowcaseDataStatus.Loading)"
                               IsEmpty="@(prompts.Count == 0)"
                               EmptyIcon="IconName.JournalText"
                               EmptyTitle="There are no shared prompts yet"
                               EmptyText="Write one with New shared prompt; members see it once you publish it."
                               LoadingText="Loading shared prompts…"
                               OnRetry="RefreshGridAsync">
                <ChildContent>
                    <Grid @ref="grid"
                          @key="gridVersion"
                          TItem="PromptRow"
                          Class="table table-hover align-middle pa-table-wide sc-grid-row-links"
                          GridContainerClass="pa-grid border rounded-3"
                          DataProvider="ProvidePromptsAsync"
                          SettingsProvider="view.GetSettingsAsync"
                          GridSettingsChanged="SaveSettingsAsync"
                          AllowPaging="true"
                          PageSize="@pageSize"
                          PageSizeSelectorVisible="true"
                          PageSizeSelectorItems="@(new[] { 10, 25, 50, 100 })"
                          PaginationItemsTextFormat="{0}–{1} of {2} prompts"
                          AllowSorting="true"
                          AllowSelection="true"
                          SelectionMode="GridSelectionMode.Multiple"
                          RowSelectionLabel="@(row => $"Select {row.Title}")"
                          SelectAllRowsText="Select all shown prompts"
                          SelectedItemsChanged="OnSelectionChanged"
                          RowClass="RowClass"
                          AllowColumnChooser="true"
                          AllowExport="true"
                          ExportFileName="ai-shared-prompts"
                          Responsive="true"
                          EmptyText="No shared prompts match. Choose All, or clear the search."
                          aria-label="Shared prompts">
                        <GridColumns>
                            <GridColumn TItem="PromptRow" HeaderText="Title" PropertyName="Title" SortString="title" SortKeySelector="row => row.Title"
                                        IsDefaultSortColumn="@view.IsSortColumn("title")" SortDirection="@view.DirectionFor("title")" AlwaysVisible="true">
                                @* The stretched link makes the whole row open the prompt's editor; the checkbox stays above it. *@
                                <a class="pa-row-link stretched-link" href="@EditUrl(context.Id)">@context.Title</a>
                            </GridColumn>
                            <GridColumn TItem="PromptRow" HeaderText="Status" PropertyName="Status" SortString="status" SortKeySelector="row => row.Status"
                                        IsDefaultSortColumn="@view.IsSortColumn("status")" SortDirection="@view.DirectionFor("status")" TextNoWrap="true">
                                <Badge Color="@(context.IsPublished ? BadgeColor.Success : BadgeColor.Secondary)" Class="rounded-pill">@context.Status</Badge>
                            </GridColumn>
                            <GridColumn TItem="PromptRow" HeaderText="Category" PropertyName="Category" SortString="category" SortKeySelector="row => row.Category"
                                        IsDefaultSortColumn="@view.IsSortColumn("category")" SortDirection="@view.DirectionFor("category")" TextNoWrap="true">
                                @context.Category
                            </GridColumn>
                            <GridColumn TItem="PromptRow" HeaderText="Variables" PropertyName="Variables" SortString="variables" SortKeySelector="row => row.Variables"
                                        IsDefaultSortColumn="@view.IsSortColumn("variables")" SortDirection="@view.DirectionFor("variables")">
                                <span class="pa-mono small">@(context.Variables.Length == 0 ? "None" : context.Variables)</span>
                            </GridColumn>
                            <GridColumn TItem="PromptRow" HeaderText="Tags" PropertyName="Tags" SortString="tags" SortKeySelector="row => row.Tags"
                                        IsDefaultSortColumn="@view.IsSortColumn("tags")" SortDirection="@view.DirectionFor("tags")">
                                <span class="small">@(context.Tags.Length == 0 ? "None" : context.Tags)</span>
                            </GridColumn>
                            <GridColumn TItem="PromptRow" HeaderText="Author" PropertyName="Author" SortString="author" SortKeySelector="row => row.Author"
                                        IsDefaultSortColumn="@view.IsSortColumn("author")" SortDirection="@view.DirectionFor("author")">
                                @context.Author
                            </GridColumn>
                            <GridColumn TItem="PromptRow" HeaderText="Uses" PropertyName="Uses" SortString="uses" SortKeySelector="row => row.Uses"
                                        IsDefaultSortColumn="@view.IsSortColumn("uses")" SortDirection="@view.DirectionFor("uses")" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End">
                                <span class="pa-mono">@context.Uses.ToString("#,0", CultureInfo.InvariantCulture)</span>
                            </GridColumn>
                            <GridColumn TItem="PromptRow" HeaderText="Updated" PropertyName="UpdatedText" SortString="updated" SortKeySelector="row => row.Updated"
                                        IsDefaultSortColumn="@view.IsSortColumn("updated")" SortDirection="@view.DirectionFor("updated")" TextNoWrap="true">
                                @context.UpdatedText
                            </GridColumn>
                        </GridColumns>
                    </Grid>
                </ChildContent>
            </ShowcaseDataState>
            <p class="small text-body-secondary mt-3 mb-0">
                Members can use a shared prompt but not change it. The tab holds at most @AiState.MaxPrompts saved prompts, personal and shared together.
            </p>
        </section>

        <Modal @ref="deleteModal" IsVerticallyCentered="true" ShowCloseButton="false" aria-labelledby="pa-adpr-dialog-title" OnHidden="OnDeleteHiddenAsync">
            <HeaderTemplate>
                <h2 class="modal-title h5" id="pa-adpr-dialog-title">Delete @(selected.Count == 1 ? $"\"{selected[0].Title}\"" : $"{selected.Count} shared prompts")?</h2>
            </HeaderTemplate>
            <BodyTemplate>
                <p class="mb-0">
                    Members will no longer see @(selected.Count == 1 ? "it" : "them") in their prompt library, and the authors hear about it. Conversations that used
                    @(selected.Count == 1 ? "it" : "them") keep their messages. This can't be undone.
                </p>
            </BodyTemplate>
            <FooterTemplate>
                <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => deleteModal.HideAsync()">Cancel</Button>
                <Button Color="ButtonColor.Danger" @onclick="ConfirmDeleteAsync"><Icon Name="IconName.Trash3" class="me-1" aria-hidden="true" />Delete</Button>
            </FooterTemplate>
        </Modal>
    </AiMemberGuard>
</div>
