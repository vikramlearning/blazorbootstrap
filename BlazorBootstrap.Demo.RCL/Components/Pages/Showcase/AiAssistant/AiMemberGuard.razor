@using BlazorBootstrap.Demo.RCL.Components.Pages.Showcase.Shared
@implements IDisposable

@* Signed in (any role), then an active membership, then (when asked) a workspace role with the permission (AC-4). Workspace
   roles live on the membership, not the identity role, so a role changed in this tab applies at once. When access ends
   while the page is open (an admin changed your role, or you handed ownership on), focus moves to the panel's heading so
   the change is announced. *@
<ShowcaseRoleGuard Roles="@AiSeedData.SignedInRoles" SignInPath="@AiLayout.SignInPath">
    @if (State.CurrentMember is null)
    {
        <section class="pa-not-found" aria-labelledby="pa-guard-title">
            <span class="pa-icon fs-4" aria-hidden="true"><Icon Name="IconName.PersonExclamation" /></span>
            <h1 class="pa-title fs-3 mt-3 mb-2" id="pa-guard-title" tabindex="-1" @ref="heading">You're not a member of @State.WorkspaceName</h1>
            <p class="text-body-secondary mb-4">
                Your account is signed in, but the workspace couldn't add it: it's full (@AiState.MaxMembers members and invitations).
                Ask an Admin or the Owner to withdraw an invitation, then sign out and in again.
            </p>
            <a class="btn btn-primary" href="@AiLayout.Base">Back to the start page</a>
        </section>
    }
    else if (State.CurrentMember.Status != AiMemberStatus.Active)
    {
        <section class="pa-not-found" aria-labelledby="pa-guard-title">
            <span class="pa-icon fs-4" aria-hidden="true"><Icon Name="IconName.PersonSlash" /></span>
            <h1 class="pa-title fs-3 mt-3 mb-2" id="pa-guard-title" tabindex="-1" @ref="heading">Your access to @State.WorkspaceName was removed</h1>
            <p class="text-body-secondary mb-4">An Admin or the Owner removed your access. Your conversations are kept; ask them to restore it.</p>
            <a class="btn btn-primary" href="@AiLayout.Base">Back to the start page</a>
        </section>
    }
    else if (Require is { } permission && !State.Can(permission))
    {
        <PageTitle>Not available for your role · @AiSeedData.ProductName</PageTitle>
        <section class="pa-not-found" aria-labelledby="pa-guard-title">
            <span class="pa-icon fs-4" aria-hidden="true"><Icon Name="IconName.ShieldLock" /></span>
            <h1 class="pa-title fs-3 mt-3 mb-2" id="pa-guard-title" tabindex="-1" @ref="heading">This page is for @AiDisplay.RolesWith(permission)</h1>
            <p class="text-body-secondary mb-4">
                You're @RoleWords(State.CurrentMember.Role) of @State.WorkspaceName; this page needs the right to @LowerFirst(AiDisplay.PermissionLabel(permission)).
                @(State.CurrentMember.Role == AiMemberRole.Owner ? null : $"Ask an Admin or {State.OwnerName} (the Owner) if you need it.")
            </p>
            <div class="d-flex justify-content-center flex-wrap gap-2">
                @if (State.Can(AiPermission.ManageSharedPrompts))
                {
                    <a class="btn btn-primary" href="@AiDisplay.AdminHomeFor(State)">Go to your admin pages</a>
                    <a class="btn btn-outline-primary" href="@($"{AiLayout.Base}/chat")">Back to chat</a>
                }
                else
                {
                    <a class="btn btn-primary" href="@($"{AiLayout.Base}/chat")">Back to chat</a>
                }
            </div>
        </section>
    }
    else
    {
        @ChildContent
    }
</ShowcaseRoleGuard>

@code {
    private ElementReference heading;

    private bool wasAllowed;

    /// <summary>Gets or sets the content shown to an active member whose role has <see cref="Require" />.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Gets or sets the permission the content needs (see <see cref="AiState.RoleAllows" />), or <see langword="null" /> for any active member.</summary>
    [Parameter] public AiPermission? Require { get; set; }

    [Inject] private AiState State { get; set; } = default!;

    private bool IsAllowed => State.IsActiveMember && (Require is not { } permission || State.Can(permission));

    /// <summary>Stops listening to state changes.</summary>
    public void Dispose() => State.Changed -= OnStateChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Access ended on this page (not a sign-out: the role guard shows the sign-in prompt then).
        if (wasAllowed && !IsAllowed && State.Identity.IsSignedIn)
            await AiDisplay.FocusAsync(heading);

        wasAllowed = IsAllowed;
    }

    protected override void OnInitialized() => State.Changed += OnStateChanged;

    /// <summary>A fragment for the middle of a sentence: only its first letter in lower case.</summary>
    private static string LowerFirst(string text) => text.Length == 0 ? text : string.Concat(text[..1].ToLowerInvariant(), text.AsSpan(1));

    private static string RoleWords(AiMemberRole role) => role switch
    {
        AiMemberRole.Owner => "the Owner",
        AiMemberRole.Admin => "an Admin",
        AiMemberRole.PromptEditor => "a prompt editor",
        _ => "a member",
    };

    private void OnStateChanged() => InvokeAsync(StateHasChanged);
}
