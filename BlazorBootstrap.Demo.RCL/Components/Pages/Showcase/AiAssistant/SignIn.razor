@page "/showcase/ai-assistant/sign-in"
@layout AiLayout

<PageTitle>Sign in · @AiSeedData.ProductName</PageTitle>

@* A new account joins the workspace as a member (or with the role it was invited with). *@
<div class="container-xl">
    <ShowcaseSignIn SiteBase="@AiLayout.Base" SiteName="@AiSeedData.ProductName" ReturnUrl="@ReturnUrl"
                    RegisterRoleId="@AiSeedData.MemberRole" StartWithRegister="@(Mode == "register")" />
</div>

@code {
    /// <summary>Gets or sets <c>?mode=register</c>, which opens the register form.</summary>
    [SupplyParameterFromQuery(Name = "mode")] public string? Mode { get; set; }

    /// <summary>Gets or sets the page to return to after signing in; only a page inside the site is used.</summary>
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
}
