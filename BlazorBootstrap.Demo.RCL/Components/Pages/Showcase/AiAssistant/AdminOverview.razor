@page "/showcase/ai-assistant/admin"
@layout AiAdminLayout

<PageTitle>Usage analytics · @AiSeedData.ProductName</PageTitle>

@* Admins and the Owner: prompt editors open the back office too, but this page needs the analytics permission. *@
<div class="container-fluid px-lg-4">
    <AiMemberGuard Require="AiPermission.ViewAnalytics">
    @{
        var quota = State.Policy.MonthlyTokenQuota;
        var rows = MemberRows;
        var daily = DailyTotals;
        var byModel = ModelTotals;
        var monthName = State.Clock.Now.ToString("MMMM", CultureInfo.InvariantCulture);
    }

    <div class="pa-adov-head mb-4">
        <h1 class="pa-title">Usage analytics</h1>
        <p class="pa-lead mb-1">How @State.WorkspaceName uses @AiSeedData.ProductName: members, messages, and tokens by model, against each member's monthly cap (by default @AiDisplay.Tokens(quota) tokens) and the workspace's.</p>
        <p class="small text-body-secondary mb-0">Sample figures: the history before today is generated; messages sent in this tab are added to it.</p>
    </div>

    <section aria-label="Totals for @monthName" class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4">
        @foreach (var total in Totals(rows))
        {
            <div class="col" @key="total.Label">
                <div class="pa-card pa-adov-kpi h-100">
                    <span class="pa-adov-kpi-label">@total.Label</span>
                    <span class="pa-adov-kpi-value">@total.Value</span>
                    <span class="small text-body-secondary">@total.Note</span>
                </div>
            </div>
        }
    </section>

    @* Governance at a glance (AC-4, AC-7i): each card says its figure in words and links to its page. *@
    <section class="mb-4" aria-labelledby="pa-adov-governance-title">
        <h2 class="pa-section-title" id="pa-adov-governance-title">Governance</h2>
        <div class="row row-cols-1 row-cols-md-3 g-3">
            @{
                var workspaceSpend = State.WorkspaceSpend;
                var blockedMembers = State.SpendByMember().Values.Count(item => item.Level == AiSpendLevel.Blocked);
                var waitingEvents = State.NewDlpEventCount;
                var retention = State.Policy.RetentionDays;
            }
            <div class="col">
                <a class="pa-card pa-adov-module h-100" href="@($"{AiAdminLayout.Base}/spend")">
                    <span class="pa-icon flex-shrink-0" aria-hidden="true"><Icon Name="IconName.PiggyBank" /></span>
                    <span>
                        <span class="d-block fw-bold">Spend: @workspaceSpend.Percent.ToString("0", CultureInfo.InvariantCulture)% of the workspace cap</span>
                        <span class="d-block small text-body-secondary">
                            @AiDisplay.Tokens(workspaceSpend.Used) of @AiDisplay.Tokens(workspaceSpend.Cap) tokens@(workspaceSpend.Level == AiSpendLevel.Blocked ? ": chat is paused for everyone" : workspaceSpend.Level == AiSpendLevel.Warning ? ": past the 80% warning" : null).
                            @AdminMembers.Plural(blockedMembers, "member is", "members are") blocked by their own cap.
                        </span>
                    </span>
                </a>
            </div>
            <div class="col">
                <a class="pa-card pa-adov-module h-100" href="@($"{AiAdminLayout.Base}/settings")">
                    <span class="pa-icon flex-shrink-0" aria-hidden="true"><Icon Name="IconName.HourglassSplit" /></span>
                    <span>
                        <span class="d-block fw-bold">Retention: @(retention == 0 ? "keep forever" : AdminMembers.Plural(retention, "day"))</span>
                        <span class="d-block small text-body-secondary">
                            @(retention == 0 ? $"Conversations are kept; {AdminMembers.Plural(State.ConversationsOlderThan(90), "conversation is", "conversations are")} older than 90 days." : $"Older conversations are deleted. The workspace holds {AdminMembers.Plural(State.ConversationCount, "conversation")}.")
                            The Owner sets it.
                        </span>
                    </span>
                </a>
            </div>
            <div class="col">
                <a class="pa-card pa-adov-module h-100" href="@($"{AiAdminLayout.Base}/sensitive-data")">
                    <span class="pa-icon flex-shrink-0" aria-hidden="true"><Icon Name="IconName.ShieldExclamation" /></span>
                    <span>
                        <span class="d-block fw-bold">Sensitive data: @(waitingEvents == 0 ? "nothing to review" : $"{AdminMembers.Plural(waitingEvents, "event")} to review")</span>
                        <span class="d-block small text-body-secondary">Messages the policy redacted or blocked, with only the masked match.</span>
                    </span>
                </a>
            </div>
        </div>
    </section>

    <div class="row g-3 mb-4">
        <div class="col-xxl-8">
            <section class="pa-panel h-100" aria-labelledby="pa-adov-daily-title">
                <h2 class="pa-section-title mb-1" id="pa-adov-daily-title">Tokens per day</h2>
                <p class="small text-body-secondary">The whole workspace, the last 30 days, stacked by model</p>
                <div class="pa-adov-chart" role="img" aria-label="Stacked bar chart of workspace tokens per day by model, the last 30 days. Summary and data table follow.">
                    <BarChart @ref="dailyChart" Height="300" HeightUnit="Unit.Px" Width="100" WidthUnit="Unit.Percentage" />
                </div>
                <p class="small mt-3 mb-2">@DailySummary(daily)</p>
                <details class="pa-adov-details">
                    <summary>Tokens per day as a table</summary>
                    <Table Data="daily" Class="table-sm mb-0" Responsive="true" TableContainerClass="mt-2" RowKeySelector="day => day.Date"
                           Caption="Workspace tokens per day by model, the last 30 days, oldest first" VisuallyHiddenCaption="true">
                        <TableColumn HeaderText="Day" IsRowHeader="true" ColumnClass="@(_ => "fw-semibold text-nowrap")" Context="day">@day.Date.ToString("ddd, MMM d", CultureInfo.InvariantCulture)</TableColumn>
                        @foreach (var model in State.Models)
                        {
                            <TableColumn HeaderText="@model.Name" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End" ColumnClass="@(_ => "pa-mono")" Context="day">@AiDisplay.Tokens(day.ByModel.GetValueOrDefault(model.Id))</TableColumn>
                        }
                        <TableColumn HeaderText="Total" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End" ColumnClass="@(_ => "pa-mono fw-semibold")" Context="day">@AiDisplay.Tokens(day.Total)</TableColumn>
                    </Table>
                </details>
            </section>
        </div>
        <div class="col-xxl-4">
            <section class="pa-panel h-100" aria-labelledby="pa-adov-models-title">
                <h2 class="pa-section-title mb-1" id="pa-adov-models-title">Tokens by model</h2>
                <p class="small text-body-secondary">@monthName so far, every member</p>
                <div class="pa-adov-chart" role="img" aria-label="Doughnut chart of this month's tokens by model. Summary and data table follow.">
                    <DoughnutChart @ref="modelsChart" Height="300" HeightUnit="Unit.Px" Width="100" WidthUnit="Unit.Percentage" />
                </div>
                <p class="small mt-3 mb-2">@ModelSummary(byModel)</p>
                <details class="pa-adov-details">
                    <summary>Tokens by model as a table</summary>
                    <Table Data="byModel" Class="table-sm mb-0" Responsive="true" TableContainerClass="mt-2" RowKeySelector="item => item.Model.Id"
                           Caption="@($"Tokens by model in {monthName}, the most used first")" VisuallyHiddenCaption="true">
                        <TableColumn HeaderText="Model" IsRowHeader="true" ColumnClass="@(_ => "fw-semibold")" Context="item">
                            @item.Model.Name
                            @if (!State.Policy.EnabledModelIds.Contains(item.Model.Id))
                            {
                                <span class="d-block small fw-normal text-body-secondary">Turned off</span>
                            }
                        </TableColumn>
                        <TableColumn HeaderText="Tokens" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End" ColumnClass="@(_ => "pa-mono")" Context="item">@AiDisplay.Tokens(item.Tokens)</TableColumn>
                        <TableColumn HeaderText="Share" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End" ColumnClass="@(_ => "pa-mono")" Context="item">@Percent(item.Tokens, byModel.Sum(other => other.Tokens))</TableColumn>
                    </Table>
                </details>
            </section>
        </div>
    </div>

    <section class="pa-panel mb-4" aria-labelledby="pa-adov-top-title">
        <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-2">
            <h2 class="pa-section-title mb-0" id="pa-adov-top-title">Top members this month</h2>
            <a class="small" href="@($"{AiAdminLayout.Base}/members")">Manage members and roles</a>
        </div>
        <ShowcaseDataState IsEmpty="@(rows.Count == 0)" EmptyIcon="IconName.People" EmptyTitle="Nobody has joined the workspace yet"
                           EmptyText="Invite people from Members and roles; their usage shows here once they chat.">
            <Table Data="rows.Take(TopCount)" Class="align-middle mb-0 pa-adov-top" Responsive="true" RowKeySelector="row => row.Member.Email" CaptionClass="pa-adov-caption"
                   Caption="@($"Members by tokens used in {monthName}, the most first (top {Math.Min(TopCount, rows.Count)} of {rows.Count}). Each share is of the member's own cap, or of the default of {AiDisplay.Tokens(quota)} tokens a month.")">
                <TableColumn HeaderText="Name" IsRowHeader="true" ColumnClass="@(_ => "pa-adov-name")" Context="row">
                    @row.Member.Name
                    @if (row.Member.AccountId is not null && row.Member.AccountId == State.Identity.Current?.Id)
                    {
                        <span class="fw-normal text-body-secondary">&#32;(you)</span>
                    }
                </TableColumn>
                <TableColumn HeaderText="Email" ColumnClass="@(_ => "pa-adov-email")" Context="row">@row.Member.Email</TableColumn>
                <TableColumn HeaderText="Messages" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End" ColumnClass="@(_ => "pa-mono")" Context="row">@row.Messages.ToString("#,0", CultureInfo.InvariantCulture)</TableColumn>
                <TableColumn HeaderText="Tokens" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End" ColumnClass="@(_ => "pa-mono")" Context="row">@AiDisplay.Tokens(row.Tokens)</TableColumn>
                <TableColumn HeaderText="Share of cap" HeaderClass="pa-adov-share" Context="row">
                    @{
                        var percent = SharePercent(row.Tokens, State.CapOf(row.Member));
                    }
                    <div class="d-flex align-items-center gap-2">
                        <Progress Height="6" Class="flex-grow-1">
                            <ProgressBar Width="Math.Min(100, percent)" Color="@QuotaColor(percent)"
                                         aria-label="@($"{row.Member.Name}, share of cap")" aria-valuenow="@Math.Round(percent)" aria-valuemin="0" aria-valuemax="100"
                                         aria-valuetext="@QuotaText(percent)" />
                        </Progress>
                        <span class="small text-nowrap">@QuotaText(percent)</span>
                    </div>
                </TableColumn>
                <TableColumn HeaderText="Status" ColumnClass="@(_ => "text-nowrap")" Context="row">@AiDisplay.StatusLabel(row.Member.Status)</TableColumn>
            </Table>
        </ShowcaseDataState>
    </section>

    <section aria-labelledby="pa-adov-more-title">
        <h2 class="pa-section-title" id="pa-adov-more-title">More workspace admin</h2>
        <div class="row row-cols-1 row-cols-md-2 row-cols-xxl-3 g-3">
            @foreach (var module in Modules.Where(module => State.Can(module.Permission)))
            {
                <div class="col" @key="module.Href">
                    <a class="pa-card pa-adov-module h-100" href="@module.Href">
                        <span class="pa-icon flex-shrink-0" aria-hidden="true"><Icon Name="@module.Icon" /></span>
                        <span>
                            <span class="d-block fw-bold">@module.Title</span>
                            <span class="d-block small text-body-secondary">@module.Description</span>
                        </span>
                    </a>
                </div>
            }
        </div>
    </section>
    </AiMemberGuard>
</div>
