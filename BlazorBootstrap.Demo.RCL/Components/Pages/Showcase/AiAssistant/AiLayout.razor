@inherits LayoutComponentBase

@* The members' app. A signed-in active member gets the global search after the links and the notifications beside the
   account menu (not visitors, not on the sign-in page); the "Workspace admin" link shows only to roles with an admin page. *@
<ShowcaseSessionHost State="State" SiteBase="@Base" SiteName="@AiSeedData.ProductName">
<AiFrame>
    <Header>
    <Navbar Class="pa-header"
            Placement="NavbarPlacement.StickyTop"
            Container="NavbarContainer.Fluid"
            AriaLabel="@AiSeedData.ProductName"
            TogglerAriaLabel="Menu">
        <Brand>
            <NavbarBrand Href="@Base" Class="pa-brand">
                <span class="pa-brand-mark" aria-hidden="true"><Icon Name="IconName.Stars" /></span>
                <span>@AiSeedData.ProductName</span>
            </NavbarBrand>
            @if (State.Identity.IsSignedIn)
            {
                <div class="pa-header-tools ms-auto me-2 order-lg-last">
                    @if (State.IsActiveMember && !IsSignInPage)
                    {
                        <ShowcaseNotificationsMenu />
                    }
                    <ShowcaseAccountMenu SiteBase="@Base" SignInPath="@SignInPath" />
                </div>
            }
            else
            {
                <a class="btn btn-sm btn-outline-secondary ms-auto me-2 order-lg-last" href="@SignInPath">Sign in</a>
            }
        </Brand>
        <ChildContent>
            <NavbarNav Class="me-auto ms-lg-4 mb-3 mb-lg-0">
                @if (State.IsActiveMember)
                {
                    <NavbarItem Href="@($"{Base}/chat")">Chat</NavbarItem>
                    <NavbarItem Href="@($"{Base}/prompts")">Prompts</NavbarItem>
                    <NavbarItem Href="@($"{Base}/usage")">Usage</NavbarItem>
                    @if (State.Can(AiPermission.ManageSharedPrompts))
                    {
                        <NavbarItem Href="@AiDisplay.AdminHomeFor(State)">@(State.Can(AiPermission.ManageMembers) ? "Workspace admin" : "Shared prompts")</NavbarItem>
                    }
                }
                else
                {
                    <NavbarItem Href="@Base" Match="NavLinkMatch.All">Home</NavbarItem>
                }
            </NavbarNav>
            @if (State.IsActiveMember && !IsSignInPage)
            {
                <ShowcaseGlobalSearch Class="pa-global-search mb-3 mb-lg-0" Placeholder="@SearchPlaceholder" Label="@SearchLabel" />
            }
        </ChildContent>
    </Navbar>
    </Header>
    <ChildContent>
        @Body
    </ChildContent>
</AiFrame>
</ShowcaseSessionHost>
