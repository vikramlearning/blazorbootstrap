@page "/showcase/ai-assistant/admin/prompts/new"
@page "/showcase/ai-assistant/admin/prompts/{Id:int}/edit"
@layout AiAdminLayout

@* Prompt editors, Admins, and the Owner write and change shared prompts here; the state checks the role again on save. *@
<div class="container-fluid px-lg-4">
    <AiMemberGuard Require="AiPermission.ManageSharedPrompts">
        @{
            var prompt = Prompt;
        }

        @if (Id is not null && prompt is null)
        {
            <AiNotFound />
        }
        else
        {
            <PageTitle>@(prompt is null ? "New shared prompt" : $"Edit {prompt.Title}") · @AiSeedData.ProductName</PageTitle>

            <Breadcrumb Items="BreadcrumbItems" Class="mb-3" />

            <div class="mb-3">
                <h1 class="pa-title">@(prompt is null ? "New shared prompt" : $"Edit \"{prompt.Title}\"")</h1>
                <p class="pa-lead mb-0">
                    @(prompt is null
                        ? "Save it as a draft, or publish it: every member sees a published prompt in their prompt library, and hears about it."
                        : $"{(prompt.IsPublished ? "Published: every member sees it" : "A draft: only prompt editors, Admins, and the Owner see it")}. By {prompt.Author}, used {AdminMembers.Plural(prompt.UseCount, "time")}, last changed {AiDisplay.Ago(prompt.UpdatedAt, State.Clock.Now)}.")
                    @(prompt is { AuthorId: { } authorId } && authorId != State.Identity.Current?.Id ? $" {prompt.Author} hears about your changes." : null)
                </p>
            </div>

            @* Always rendered and focusable, so a save is announced and focus has somewhere to go. *@
            <p class="pa-form-status fw-semibold mb-2" role="status" tabindex="-1" @ref="statusRegion">@statusMessage</p>

            <section class="pa-panel pa-adpe-form" aria-labelledby="pa-adpe-form-title">
                <h2 class="pa-section-title" id="pa-adpe-form-title">Prompt</h2>
                <AiPromptForm Prompt="prompt" Shared="true" FormName="pa-shared-prompt" IdPrefix="pa-adpe" CancelUrl="@AdminPrompts.ListUrl" OnSaved="OnSavedAsync" />
            </section>
        }
    </AiMemberGuard>
</div>
