@* The site's not-found screen, shown by the catch-all route and for unknown conversations and prompts. *@
<PageTitle>Page not found · @AiSeedData.ProductName</PageTitle>

<section class="pa-not-found">
    <span class="pa-icon fs-4" aria-hidden="true"><Icon Name="IconName.SignpostSplit" /></span>
    <h1 class="pa-title fs-3 mt-3 mb-2">We couldn't find that page</h1>
    <p class="text-body-secondary mb-4">The conversation or prompt may have been deleted, or the link is wrong.</p>
    <div class="d-flex justify-content-center flex-wrap gap-2">
        <Button Type="ButtonType.Link" To="@($"{AiLayout.Base}/chat")" Color="ButtonColor.Primary">Start a new chat</Button>
        <Button Type="ButtonType.Link" To="@AiLayout.Base" Color="ButtonColor.Primary" Outline="true">Start page</Button>
    </div>
</section>
