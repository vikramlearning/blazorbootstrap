@inherits LayoutComponentBase

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=DM+Sans:wght@400;500;600;700&display=swap" />
</HeadContent>

@* The retailer's back office (D-031): its own layout with the modules in a sidebar, separate from the storefront. *@
<ShowcaseSessionHost State="State" SiteBase="@EcommerceLayout.Base" SiteName="@EcommerceSeedData.StoreName">
<div class="sc-site sc-ecommerce ea-admin">
    <ShowcaseSiteBar Site="@site" OnThemeChanged="State.SetTheme" />

    <div class="ea-shell">
        @if (State.IsStaff)
        {
            <Sidebar Class="ea-sidebar"
                     Href="@Base"
                     IconName="IconName.Flower2"
                     Title="@EcommerceSeedData.StoreName"
                     BadgeText="Admin"
                     DataProvider="SidebarDataProvider" />
        }

        <div class="ea-main">
            <header class="ea-topbar">
                <span class="ea-topbar-title">Store admin</span>
                <div class="ea-topbar-actions">
                    @* The search and the bell show only to the signed-in retailer; anyone else here sees the guard's screen. *@
                    @if (State.IsStaff)
                    {
                        <ShowcaseGlobalSearch Class="ea-global-search" Placeholder="Search orders, products, customers"
                                              Label="Search customers by name or email, orders by number or customer, returns and purchase orders by number, products by name or SKU, coupons by code, and suppliers by name" />
                        <ShowcaseNotificationsMenu />
                    }
                    <a class="btn btn-sm ea-view-store" href="@EcommerceLayout.Base">
                        <Icon Name="IconName.ShopWindow" class="me-1" aria-hidden="true" />View store
                    </a>
                    <ShowcaseAccountMenu SiteBase="@EcommerceLayout.Base" SignInPath="@EcommerceLayout.SignInPath" />
                </div>
            </header>

            @* The back office shows shoppers' names, emails, and addresses as page text, so the whole content area is masked from
               session recording (Clarity masks inputs by default, not text). *@
            <main class="sc-main ea-content" id="ea-main" data-clarity-mask="true">
                <ShowcaseRoleGuard Roles="@StaffRoles" SignInPath="@EcommerceLayout.SignInPath">
                    @Body
                </ShowcaseRoleGuard>
            </main>

            <div class="ea-ad-row">
                <CarbonAds Class="sc-ad" />
            </div>

            <footer class="ea-footer">
                <span>© 2026 @EcommerceSeedData.StoreName (fictitious). Orders, customers, and figures here are made up and stay in this browser tab.</span>
                <span class="d-none d-lg-inline">Built with Grid, Sidebar, Modal, Charts, Badge, Dropdown, and form inputs.</span>
            </footer>
        </div>
    </div>
</div>
</ShowcaseSessionHost>
