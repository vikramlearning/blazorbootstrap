@page "/showcase/ecommerce/account/wishlist"
@layout EcommerceLayout

<PageTitle>Your wishlist · @EcommerceSeedData.StoreName</PageTitle>

<div class="container-xl pt-4 pb-5">
    <ShowcaseRoleGuard Roles="@EcommerceSeedData.CustomerRole" SignInPath="@EcommerceLayout.SignInPath">
        @if (State.Identity.Current is { } account)
        {
            var entries = Entries(account.Id);

            <EcommerceAccountNav />

            <h1 class="ec-page-title mb-1">Your wishlist</h1>
            <p class="text-body-secondary mb-4">
                @(entries.Count == 1 ? "1 product" : $"{entries.Count} products") saved for later. For a product that's out of stock, ask for a notice when it's back.
            </p>

            @* Always rendered and focusable, so a change is announced and focus has somewhere to go when its row is gone. *@
            <div class="ec-wish-status" role="status" tabindex="-1" @ref="statusRegion">
                @if (statusMessage is not null)
                {
                    <span>@statusMessage</span>
                    @if (showCartLink)
                    {
                        <a class="ms-2" href="@($"{EcommerceLayout.Base}/cart")">View cart</a>
                    }
                }
            </div>

            @if (entries.Count == 0)
            {
                <div class="ec-panel text-center py-5">
                    <span class="ec-empty-icon" aria-hidden="true"><Icon Name="IconName.Heart" /></span>
                    <p class="mt-3 mb-4 text-body-secondary">Your wishlist is empty. Save products you like from their product page to find them here.</p>
                    <a class="btn btn-primary" href="@($"{EcommerceLayout.Base}/products?category=all")">Browse products</a>
                </div>
            }
            else
            {
                <ul class="list-unstyled ec-panel ec-wish-list mb-0" aria-label="Products on your wishlist">
                    @foreach (var (item, product) in entries)
                    {
                        var category = State.FindCategory(product.CategoryId);
                        var stock = StockOf(product);
                        <li class="ec-wish-row" @key="product.Id">
                            <ShowcaseImage Src="@product.ImagePath" Alt="" Width="160" Height="160" Class="ec-thumb"
                                           Accent="@category?.Accent" PlaceholderIcon="@(category?.IconName ?? IconName.Image)" />
                            <div class="ec-wish-body">
                                <h2 class="ec-wish-name">
                                    @if (product.IsArchived)
                                    {
                                        <span>@product.Name</span>
                                    }
                                    else
                                    {
                                        <a class="ec-line-name" href="@($"{EcommerceLayout.Base}/products/{product.Id}")">@product.Name</a>
                                    }
                                </h2>
                                <div class="d-flex flex-wrap align-items-baseline gap-2">
                                    @if (!product.IsArchived)
                                    {
                                        <span class="ec-price">@EcommerceDisplay.Money(product.Price)</span>
                                        @if (product.IsOnSale)
                                        {
                                            <span class="ec-compare"><span class="visually-hidden">was </span>@EcommerceDisplay.Money(product.CompareAtPrice!.Value)</span>
                                        }
                                    }
                                    <span class="@($"ec-stock ec-stock-{stock.Css} small")">
                                        <Icon Name="@stock.Icon" class="me-1" aria-hidden="true" />@stock.Text
                                    </span>
                                </div>
                                <span class="small text-body-secondary">Saved @SavedOn(item)</span>
                            </div>
                            <div class="ec-wish-actions">
                                @if (!product.IsArchived && product.Stock > 0 && product.Colors.Count > 0)
                                {
                                    <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="() => AddToCart(product)">
                                        <Icon Name="IconName.BagPlus" class="me-1" aria-hidden="true" />Add to cart<span class="visually-hidden">: @product.Name</span>
                                    </Button>
                                }
                                else if (!product.IsArchived)
                                {
                                    <Switch Id="@($"ec-wish-notify-{product.Id}")"
                                            Value="item.NotifyWhenInStock"
                                            ValueExpression="() => item.NotifyWhenInStock"
                                            ValueChanged="value => SetNotify(product, value)"
                                            Label="@($"Tell me when {product.Name} is back")" />
                                }
                                <Button Color="ButtonColor.Link" Size="ButtonSize.Small" @onclick="() => RemoveAsync(product)">
                                    <Icon Name="IconName.Trash3" class="me-1" aria-hidden="true" />Remove<span class="visually-hidden">&#32;@product.Name from your wishlist</span>
                                </Button>
                            </div>
                        </li>
                    }
                </ul>
            }
        }
    </ShowcaseRoleGuard>
</div>
