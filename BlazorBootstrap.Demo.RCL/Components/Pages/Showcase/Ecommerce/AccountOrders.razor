@page "/showcase/ecommerce/account/orders"
@layout EcommerceLayout

<PageTitle>Your orders · @EcommerceSeedData.StoreName</PageTitle>

<div class="container-xl pt-4 pb-5">
    <ShowcaseRoleGuard Roles="@EcommerceSeedData.CustomerRole" SignInPath="@EcommerceLayout.SignInPath">
        @if (State.Identity.Current is { } account)
        {
            var orders = State.OrdersFor(account.Id);
            var shown = orders.Where(order => InGroup(order, group)).ToList();

            <EcommerceAccountNav />

            <h1 class="ec-page-title mb-1">Your orders</h1>
            <p class="text-body-secondary mb-4">Every order you've placed, newest first. Cancel one before it's packed, or buy the same items again.</p>

            @* Always rendered and focusable, so a change is announced and focus has somewhere to go when its button is gone. *@
            <div class="ec-orders-status" role="status" tabindex="-1" @ref="statusRegion">
                @if (statusMessage is not null)
                {
                    <span>@statusMessage</span>
                    @if (showCartLink)
                    {
                        <a class="ms-2" href="@($"{EcommerceLayout.Base}/cart")">View cart</a>
                    }
                }
            </div>

            @if (orders.Count == 0)
            {
                <div class="ec-panel text-center py-5">
                    <span class="ec-empty-icon" aria-hidden="true"><Icon Name="IconName.BoxSeam" /></span>
                    <p class="mt-3 mb-4 text-body-secondary">You haven't placed an order yet. Your orders and their status show up here.</p>
                    <a class="btn btn-primary" href="@($"{EcommerceLayout.Base}/products?category=all")">Start shopping</a>
                </div>
            }
            else
            {
                <div class="ec-order-filter mb-3" role="group" aria-label="Show orders">
                    @foreach (var option in groups)
                    {
                        var isSelected = option == group;
                        <Button @ref="filterButtons[option]" Color="ButtonColor.Primary" Outline="!isSelected" Size="ButtonSize.Small" Class="rounded-pill" aria-pressed="@(isSelected ? "true" : "false")" @onclick="() => SelectGroup(option)">
                            @GroupLabel(option) <span class="ec-order-filter-count">(@CountIn(orders, option))</span>
                        </Button>
                    }
                </div>

                @if (shown.Count == 0)
                {
                    <div class="ec-panel text-center py-4">
                        <p class="mb-3 text-body-secondary">@EmptyGroupText(group)</p>
                        <Button Color="ButtonColor.Primary" Outline="true" Size="ButtonSize.Small" @onclick="ShowAllAsync">Show all orders</Button>
                    </div>
                }
                else
                {
                    <ul class="list-unstyled d-grid gap-3 mb-0" aria-label="@($"{GroupLabel(group)} orders")">
                        @foreach (var order in shown)
                        {
                            <li class="ec-panel ec-order" @key="order.Id">
                                <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-2">
                                    <div>
                                        <h2 class="h6 fw-bold mb-1"><a class="ec-line-name" href="@($"{EcommerceLayout.Base}/orders/{order.Id}")">Order #@order.Id</a></h2>
                                        <span class="small text-body-secondary">Placed @EcommerceDisplay.DateTimeShort(order.PlacedOn) · @ItemCountText(order)</span>
                                    </div>
                                    <Badge Color="EcommerceDisplay.StatusColor(order.Status)" Class="rounded-pill">@order.Status</Badge>
                                </div>
                                <p class="small mb-3">@ItemsSummary(order)</p>
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                    <div class="small">
                                        <span class="fw-semibold">Total @EcommerceDisplay.Money(order.Totals.Total)</span>
                                        @if (order.RefundedAmount > 0)
                                        {
                                            <span class="text-body-secondary"> · Refunded @EcommerceDisplay.Money(order.RefundedAmount)</span>
                                        }
                                    </div>
                                    <div class="d-flex flex-wrap gap-2">
                                        <Button Color="ButtonColor.Primary" Outline="true" Size="ButtonSize.Small" @onclick="() => BuyAgain(order)">
                                            <Icon Name="IconName.ArrowRepeat" class="me-1" aria-hidden="true" />Buy again<span class="visually-hidden"> the items of order @order.Id</span>
                                        </Button>
                                        @if (State.CanCustomerCancel(order))
                                        {
                                            <Button @ref="cancelButtons[order.Id]" Color="ButtonColor.Danger" Outline="true" Size="ButtonSize.Small" @onclick="() => AskCancelAsync(order)">
                                                Cancel<span class="visually-hidden"> order @order.Id</span>
                                            </Button>
                                        }
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            }
        }
    </ShowcaseRoleGuard>
</div>

<Modal @ref="cancelModal" IsVerticallyCentered="true" ShowCloseButton="false" aria-labelledby="ec-cancel-order-title" OnHidden="OnCancelHiddenAsync">
    <HeaderTemplate>
        <h2 class="modal-title h5" id="ec-cancel-order-title">Cancel order #@(cancelling?.Id)?</h2>
    </HeaderTemplate>
    <BodyTemplate>
        @if (cancelling is not null)
        {
            <p class="mb-2" data-clarity-mask="true">The order is cancelled before it's packed; items go back into stock and @EcommerceDisplay.Money(cancelling.Totals.Total) is refunded to your card (@cancelling.CardBrand ending @cancelling.CardLast4).</p>
            <p class="small text-body-secondary mb-0">This can't be undone. To get the items later, place a new order.</p>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => cancelModal.HideAsync()">Keep order</Button>
        <Button Color="ButtonColor.Danger" @onclick="ConfirmCancelAsync">Cancel order</Button>
    </FooterTemplate>
</Modal>
