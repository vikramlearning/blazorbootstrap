@page "/showcase/ecommerce/checkout"
@layout EcommerceLayout

<PageTitle>Checkout · @EcommerceSeedData.StoreName</PageTitle>

<div class="container-xl pt-4 pb-5">
    <h1 class="ec-page-title mb-4">Checkout</h1>

    @if (State.IsStaff)
    {
        <EcommerceStaffNotice />
    }
    else if (State.Cart.Count == 0)
    {
        <div class="ec-panel text-center py-5">
            <span class="ec-empty-icon" aria-hidden="true"><Icon Name="IconName.Bag" /></span>
            <p class="mt-3 mb-4">Your cart is empty, so there's nothing to check out yet.</p>
            <Button Type="ButtonType.Link" To="@($"{EcommerceLayout.Base}/products?category=all")" Color="ButtonColor.Primary">Start shopping</Button>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="ec-panel" data-clarity-mask="true">
                    <ShowcaseDemoNotice Class="mb-4" Text="Demo only: nothing you enter here is sent or charged. Use one of the listed test cards; real cards are never accepted." />

                    <EditForm EditContext="editContext" OnValidSubmit="PlaceOrder" FormName="ec-checkout">
                        <ShowcaseFormErrors ShowSummary="true" />
                        <DataAnnotationsValidator />

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <h2 class="h5 fw-bold mb-0">Contact and shipping</h2>
                            <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="FillSample">Fill with sample details</Button>
                        </div>

                        @if (SavedAddresses.Count > 0)
                        {
                            @* Choosing a saved address fills the fields below; editing them afterwards switches to "Use a new address". *@
                            <fieldset class="mb-3">
                                <legend class="form-label fw-semibold fs-6 mb-2">Ship to</legend>
                                <div class="ec-address-options">
                                    @foreach (var address in SavedAddresses)
                                    {
                                        var inputId = $"ec-ship-to-{address.Id}";
                                        <div class="form-check ec-address-option" @key="address.Id">
                                            <input class="form-check-input" type="radio" name="ec-ship-to" id="@inputId"
                                                   checked="@(selectedAddressId == address.Id)" @onchange="() => ChooseAddress(address)" />
                                            <label class="form-check-label" for="@inputId">
                                                <span class="d-block fw-semibold">
                                                    @address.Label
                                                    @if (address.IsDefault)
                                                    {
                                                        <Badge Color="BadgeColor.Secondary" Class="ms-1">Default</Badge>
                                                    }
                                                </span>
                                                <span class="d-block small">@address.Street</span>
                                                <span class="d-block small text-body-secondary">@address.City</span>
                                            </label>
                                        </div>
                                    }
                                    <div class="form-check ec-address-option">
                                        <input class="form-check-input" type="radio" name="ec-ship-to" id="ec-ship-to-new"
                                               checked="@(selectedAddressId is null)" @onchange="UseNewAddress" />
                                        <label class="form-check-label" for="ec-ship-to-new">
                                            <span class="d-block fw-semibold">Use a new address</span>
                                            <span class="d-block small text-body-secondary">Type it in below</span>
                                        </label>
                                    </div>
                                </div>
                            </fieldset>
                        }

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="ec-name">Full name</label>
                                <InputText id="ec-name" class="form-control" @bind-Value="form.FullName" autocomplete="name" />
                                <ValidationMessage For="() => form.FullName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="ec-email">Email</label>
                                <InputText id="ec-email" inputmode="email" autocapitalize="none" spellcheck="false" class="form-control" @bind-Value="form.Email" autocomplete="email" />
                                <ValidationMessage For="() => form.Email" />
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="ec-street">Street address</label>
                                <InputText id="ec-street" class="form-control" @bind-Value="form.Street" autocomplete="address-line1" />
                                <ValidationMessage For="() => form.Street" />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label" for="ec-city">City</label>
                                <InputText id="ec-city" class="form-control" @bind-Value="form.City" autocomplete="address-level2" />
                                <ValidationMessage For="() => form.City" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="ec-postal">Postal code</label>
                                <InputText id="ec-postal" class="form-control" @bind-Value="form.PostalCode" autocomplete="postal-code" />
                                <ValidationMessage For="() => form.PostalCode" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="ec-country">Country</label>
                                <InputSelect id="ec-country" class="form-select" @bind-Value="form.Country" autocomplete="country-name">
                                    @foreach (var country in CountryOptions)
                                    {
                                        <option value="@country">@country</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        @if (Customer is not null && selectedAddressId is null)
                        {
                            <div class="mt-3">
                                @if (SavedAddresses.Count >= MaxSavedAddresses)
                                {
                                    <p class="small text-body-secondary mb-0">
                                        <Icon Name="IconName.InfoCircle" class="me-1" aria-hidden="true" />Your address book is full (@MaxSavedAddresses addresses), so this address can't be saved to it.
                                    </p>
                                }
                                else
                                {
                                    <CheckboxInput Id="ec-save-address" @bind-Value="form.SaveAddress" Label="Save this address to my address book" />
                                    @if (form.SaveAddress)
                                    {
                                        <div class="ec-address-label mt-2">
                                            <label class="form-label" for="ec-address-label">Address label</label>
                                            <TextInput Id="ec-address-label" @bind-Value="form.AddressLabel" MaxLength="30" aria-describedby="ec-address-label-help" />
                                            <div class="form-text" id="ec-address-label-help">For example Home, Work, or Studio.</div>
                                            <ValidationMessage For="() => form.AddressLabel" />
                                        </div>
                                    }
                                }
                            </div>
                        }

                        <h2 class="h5 fw-bold mt-4 mb-3" id="ec-delivery-label">Delivery</h2>
                        <RadioButtonGroup TValue="EcommerceDelivery" @bind-Value="form.Delivery" AriaLabel="Delivery" aria-labelledby="ec-delivery-label" Class="w-100 flex-wrap">
                            <ButtonGroupItem Value="EcommerceDelivery.Standard" Id="ec-delivery-standard" Class="text-start">
                                <span class="d-block fw-semibold">Standard · @StandardPrice</span>
                                <small>@EcommerceDisplay.DeliveryWindow(EcommerceDelivery.Standard)</small>
                            </ButtonGroupItem>
                            <ButtonGroupItem Value="EcommerceDelivery.Express" Id="ec-delivery-express" Class="text-start">
                                <span class="d-block fw-semibold">Express · @EcommerceDisplay.Money(EcommerceSeedData.ExpressShipping)</span>
                                <small>@EcommerceDisplay.DeliveryWindow(EcommerceDelivery.Express)</small>
                            </ButtonGroupItem>
                            <ButtonGroupItem Value="EcommerceDelivery.Local" Id="ec-delivery-local" Class="text-start" Disabled="!IsLocalAvailable"
                                             aria-describedby="@(IsLocalAvailable ? null : "ec-delivery-local-note")">
                                <span class="d-block fw-semibold">Local delivery · @EcommerceDisplay.Money(EcommerceSeedData.LocalDeliveryFee)</span>
                                <small>@(IsLocalAvailable ? EcommerceDisplay.DeliveryWindow(EcommerceDelivery.Local) : "Not available for this address")</small>
                            </ButtonGroupItem>
                        </RadioButtonGroup>
                        @if (!IsLocalAvailable)
                        {
                            <p class="small text-body-secondary mt-2 mb-0" id="ec-delivery-local-note">
                                <Icon Name="IconName.InfoCircle" class="me-1" aria-hidden="true" />@LocalAreaNote
                            </p>
                        }
                        @* Always rendered, so a screen reader announces it when Local delivery is switched back to Standard. *@
                        <p class="small fw-semibold mt-2 mb-0" role="status">@deliveryStatus</p>

                        @if (form.Delivery == EcommerceDelivery.Local)
                        {
                            <div class="ec-local-delivery mt-3">
                                <ShowcaseMapOrPlaceholder Locations="DeliveryLocations" Height="240" Zoom="12" AriaLabel="@DeliveryMapLabel" />
                                <p class="fw-semibold mt-3 mb-0">
                                    <Icon Name="IconName.Clock" class="me-2" aria-hidden="true" />@ArrivalText
                                </p>
                            </div>
                        }

                        <h2 class="h5 fw-bold mt-4 mb-3">Payment</h2>
                        @* Only the published test cards pass; only the brand and last four digits are kept (CR-001-AC-11). *@
                        <ShowcaseCardForm Card="card" Today="State.Clock.Today" IdPrefix="ec" />

                        <div class="ec-payment-error mt-3" role="alert">
                            @if (paymentError is not null)
                            {
                                <Icon Name="IconName.ExclamationTriangleFill" class="me-2" aria-hidden="true" />@paymentError
                            }
                        </div>

                        <Button Type="ButtonType.Submit" Color="ButtonColor.Primary" Size="ButtonSize.Large" Class="w-100 mt-4 rounded-pill" Disabled="placing">
                            Place order · @EcommerceDisplay.Money(Totals.Total)
                        </Button>
                    </EditForm>
                </div>
            </div>

            <div class="col-lg-5">
                <EcommerceOrderSummary Totals="Totals" PromoCode="@State.AppliedPromoCode">
                    <ul class="list-unstyled small mt-3 mb-0">
                        @foreach (var line in State.Cart)
                        {
                            var product = State.FindProduct(line.ProductId)!;
                            <li class="d-flex justify-content-between gap-2 py-1" @key="@($"{line.ProductId}-{line.Color}")">
                                <span>@line.Quantity × @product.Name <span class="text-body-secondary">(@line.Color)</span></span>
                                <span>@EcommerceDisplay.Money(product.Price * line.Quantity)</span>
                            </li>
                        }
                    </ul>
                    <Button Type="ButtonType.Link" To="@($"{EcommerceLayout.Base}/cart")" Color="ButtonColor.Link" Size="ButtonSize.Small" Class="px-0 mt-2">Edit cart</Button>
                </EcommerceOrderSummary>
            </div>
        </div>
    }
</div>
