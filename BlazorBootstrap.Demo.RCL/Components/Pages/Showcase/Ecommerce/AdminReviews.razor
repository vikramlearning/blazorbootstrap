@page "/showcase/ecommerce/admin/reviews"
@layout EcommerceAdminLayout

<PageTitle>Reviews · @EcommerceSeedData.StoreName admin</PageTitle>

<div class="mb-4">
    <h1 class="ea-title">Reviews</h1>
    <p class="ea-lead">@SummaryText</p>
</div>

@* Always rendered and focusable, so a change is announced and focus has somewhere to go when a review leaves the list or the bulk bar closes. *@
<p class="ea-list-status mb-3" role="status" tabindex="-1" @ref="statusRegion">@statusMessage</p>

<section class="ea-panel" aria-labelledby="ea-reviews-title">
    <h2 class="ea-section-title" id="ea-reviews-title">Reviews to moderate</h2>

    <div class="ea-list-filters" role="search" aria-label="Filter reviews">
        <div class="ea-list-search">
            <label class="form-label small fw-semibold" for="ea-review-search">Search</label>
            <InputGroup>
                <InputGroupText><Icon Name="IconName.Search" aria-hidden="true" /></InputGroupText>
                @* TextInput raises ValueChanged on change only; @oninput keeps the filter live while typing. *@
                <TextInput Id="ea-review-search" Value="@searchBoxValue" ValueExpression="() => searchBoxValue" ValueChanged="OnSearchChanged"
                           @oninput="OnSearchInput" Placeholder="Product, title, or author" MaxLength="80" />
            </InputGroup>
        </div>
        <div>
            <label class="form-label small fw-semibold" for="ea-review-status">Status</label>
            <select id="ea-review-status" class="form-select" value="@statusFilter" @onchange="OnStatusFilterChanged">
                <option value="">All</option>
                <option value="@EcommerceReviewStatus.Published">Published</option>
                <option value="@EcommerceReviewStatus.Hidden">Hidden</option>
            </select>
        </div>
        <div>
            <label class="form-label small fw-semibold" for="ea-review-rating">Rating</label>
            <select id="ea-review-rating" class="form-select" value="@ratingFilter" @onchange="OnRatingFilterChanged">
                <option value="0">All</option>
                @for (var stars = 5; stars >= 1; stars--)
                {
                    <option value="@stars">@(stars == 1 ? "1 star" : $"{stars} stars")</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label small fw-semibold" for="ea-review-reply">Reply</label>
            <select id="ea-review-reply" class="form-select" value="@replyFilter" @onchange="OnReplyFilterChanged">
                <option value="">All</option>
                <option value="@NeedsReply">Needs a reply</option>
                <option value="@Replied">Replied</option>
            </select>
        </div>
    </div>
    <div class="ea-list-meta mb-3">
        <p class="small text-body-secondary mb-0" aria-live="polite" tabindex="-1" @ref="countRegion">@MatchText</p>
        @if (IsFiltered)
        {
            <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ClearFiltersAsync">Show every review</Button>
        }
        @* Back to the saved view's defaults: newest first, 25 a page, every column in its place. *@
        <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ResetViewAsync">Reset view</Button>
    </div>

    @if (selected.Count > 0)
    {
        var hidden = selected.Count(row => row.StatusValue == EcommerceReviewStatus.Hidden);

        <section class="ea-bulk" aria-labelledby="ea-reviews-bulk-count">
            <h2 class="ea-bulk-count" id="ea-reviews-bulk-count">@(selected.Count == 1 ? "1 review selected" : $"{EcommerceDisplay.Count(selected.Count)} reviews selected")</h2>
            <div class="ea-bulk-actions">
                @if (hidden > 0)
                {
                    <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="() => SetStatusAsync(EcommerceReviewStatus.Published)">
                        <Icon Name="IconName.Eye" class="me-1" aria-hidden="true" />Publish @EcommerceDisplay.Plural(hidden, "review")
                    </Button>
                }
                @if (selected.Count - hidden > 0)
                {
                    <Button Color="ButtonColor.Danger" Outline="true" Size="ButtonSize.Small" @onclick="() => SetStatusAsync(EcommerceReviewStatus.Hidden)">
                        <Icon Name="IconName.EyeSlash" class="me-1" aria-hidden="true" />Hide @EcommerceDisplay.Plural(selected.Count - hidden, "review")
                    </Button>
                }
                <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="ClearSelectionAsync">Clear selection</Button>
            </div>
            <p class="form-text w-100 mb-0">Hidden reviews leave their product page and its rating, and stay here to publish again. Reviewers aren't told.</p>
        </section>
    }

    <ShowcaseDataState Status="@(viewLoaded ? ShowcaseDataStatus.Ready : ShowcaseDataStatus.Loading)"
                       IsEmpty="@(State.AllReviews.Count == 0)"
                       EmptyIcon="IconName.ChatSquareText"
                       EmptyTitle="No reviews yet"
                       EmptyText="Reviews customers write on product pages appear here to moderate and answer."
                       LoadingText="Loading reviews…"
                       OnRetry="RefreshGridAsync">
        <ChildContent>
            <Grid @ref="grid"
                  @key="gridVersion"
                  TItem="ReviewRow"
                  Class="table table-hover align-middle ea-table-wide sc-grid-row-links"
                  GridContainerClass="ea-grid border rounded-3"
                  DataProvider="ProvideReviewsAsync"
                  SettingsProvider="view.GetSettingsAsync"
                  GridSettingsChanged="SaveSettingsAsync"
                  AllowPaging="true"
                  PageSize="@pageSize"
                  PageSizeSelectorVisible="true"
                  PageSizeSelectorItems="@(new[] { 10, 25, 50, 100 })"
                  PaginationItemsTextFormat="{0}–{1} of {2} reviews"
                  AllowSorting="true"
                  AllowSelection="true"
                  SelectionMode="GridSelectionMode.Multiple"
                  RowSelectionLabel="@(row => $"Select the review “{row.Title}” on {row.Product}")"
                  SelectAllRowsText="Select all shown reviews"
                  SelectedItemsChanged="OnSelectionChanged"
                  RowClass="RowClass"
                  AllowColumnChooser="true"
                  AllowExport="true"
                  ExportFileName="commerce-reviews"
                  Responsive="true"
                  EmptyText="No reviews match these filters. Clear a filter, or search for part of a product, title, or author."
                  aria-label="Reviews">
                <GridColumns>
                    <GridColumn TItem="ReviewRow" HeaderText="Review" PropertyName="Title" SortString="title" SortKeySelector="row => row.Title"
                                IsDefaultSortColumn="@view.IsSortColumn("title")" SortDirection="@view.DirectionFor("title")" AlwaysVisible="true">
                        @* No page of its own: the stretched button opens the review with the store's reply; the row's other buttons stay above it. *@
                        @{
                            var reviewId = context.Id;
                        }
                        <button type="button" class="ea-row-button stretched-link" @ref="replyButtons[reviewId]" @onclick="() => OpenReplyAsync(reviewId)">
                            @context.Title<span class="visually-hidden">: read and reply</span>
                        </button>
                        <span class="d-block small text-body-secondary ea-review-excerpt">@context.Excerpt</span>
                    </GridColumn>
                    <GridColumn TItem="ReviewRow" HeaderText="Product" PropertyName="Product" SortString="product" SortKeySelector="row => row.Product"
                                IsDefaultSortColumn="@view.IsSortColumn("product")" SortDirection="@view.DirectionFor("product")">
                        @if (context.IsLive)
                        {
                            <a href="@($"{EcommerceLayout.Base}/products/{context.ProductId}")">@context.Product</a>
                        }
                        else
                        {
                            <span>@context.Product</span><span class="d-block small text-body-secondary">Not in the store</span>
                        }
                    </GridColumn>
                    <GridColumn TItem="ReviewRow" HeaderText="Rating" PropertyName="Rating" SortString="rating" SortKeySelector="row => row.Rating"
                                IsDefaultSortColumn="@view.IsSortColumn("rating")" SortDirection="@view.DirectionFor("rating")" TextNoWrap="true">
                        <span class="ea-stars small" aria-hidden="true">
                            @foreach (var star in EcommerceDisplay.Stars(context.Rating))
                            {
                                <Icon Name="star" />
                            }
                        </span>
                        <span class="visually-hidden">Rated @context.Rating out of 5</span>
                    </GridColumn>
                    <GridColumn TItem="ReviewRow" HeaderText="Author" PropertyName="Author" SortString="author" SortKeySelector="row => row.Author"
                                IsDefaultSortColumn="@view.IsSortColumn("author")" SortDirection="@view.DirectionFor("author")" TextNoWrap="true">
                        <span data-clarity-mask="true">@context.Author</span>
                    </GridColumn>
                    <GridColumn TItem="ReviewRow" HeaderText="Posted" PropertyName="PostedText" SortString="posted" SortKeySelector="row => row.PostedOn"
                                IsDefaultSortColumn="@view.IsSortColumn("posted")" SortDirection="@view.DirectionFor("posted")" TextNoWrap="true">
                        @EcommerceDisplay.Date(context.PostedOn)
                    </GridColumn>
                    <GridColumn TItem="ReviewRow" HeaderText="Status" PropertyName="Status" SortString="status" SortKeySelector="row => row.StatusValue"
                                IsDefaultSortColumn="@view.IsSortColumn("status")" SortDirection="@view.DirectionFor("status")" TextNoWrap="true">
                        <Badge Color="@(context.StatusValue == EcommerceReviewStatus.Published ? BadgeColor.Success : BadgeColor.Secondary)">@context.Status</Badge>
                    </GridColumn>
                    <GridColumn TItem="ReviewRow" HeaderText="Reply" PropertyName="Reply" SortString="reply" SortKeySelector="row => row.HasReply"
                                IsDefaultSortColumn="@view.IsSortColumn("reply")" SortDirection="@view.DirectionFor("reply")" TextNoWrap="true">
                        @if (context.HasReply)
                        {
                            <span><Icon Name="IconName.ReplyFill" class="me-1" aria-hidden="true" />Replied</span>
                        }
                        else
                        {
                            <span class="text-body-secondary">Needs a reply</span>
                        }
                    </GridColumn>
                    <GridColumn TItem="ReviewRow" HeaderText="Actions" Sortable="false" Exportable="false" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End">
                        <HeaderContent><span class="visually-hidden">Actions</span></HeaderContent>
                        <ChildContent>
                            @{
                                var reviewId = context.Id;
                            }
                            <div class="d-flex flex-nowrap gap-1 justify-content-end">
                                <Button @ref="statusButtons[reviewId]" Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="() => ToggleStatusAsync(reviewId)">
                                    @(context.StatusValue == EcommerceReviewStatus.Published ? "Hide" : "Publish")<span class="visually-hidden">&#32;the review “@context.Title”</span>
                                </Button>
                                @if (context.HasReply)
                                {
                                    <Button @ref="removeButtons[reviewId]" Color="ButtonColor.Danger" Outline="true" Size="ButtonSize.Small" Class="text-nowrap" @onclick="() => AskRemoveReplyAsync(reviewId)">
                                        Remove reply<span class="visually-hidden">&#32;to the review “@context.Title”</span>
                                    </Button>
                                }
                            </div>
                        </ChildContent>
                    </GridColumn>
                </GridColumns>
            </Grid>
        </ChildContent>
    </ShowcaseDataState>
</section>

<Modal @ref="hideModal" IsVerticallyCentered="true" ShowCloseButton="false" aria-labelledby="ea-hide-title" OnHidden="OnHideHidden">
    <HeaderTemplate>
        <h2 class="modal-title h5" id="ea-hide-title">Hide this review?</h2>
    </HeaderTemplate>
    <BodyTemplate>
        @if (Acting is { } acting)
        {
            <p class="mb-2">“@acting.Title” by <span data-clarity-mask="true">@acting.Author</span> leaves the @(State.FindAnyProduct(acting.ProductId)?.Name ?? "product") page and no longer counts toward the product's rating.</p>
            <p class="small text-body-secondary mb-0">The review stays here, and you can publish it again at any time.</p>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => hideModal.HideAsync()">Keep it published</Button>
        <Button Color="ButtonColor.Danger" @onclick="ConfirmHideAsync">Hide review</Button>
    </FooterTemplate>
</Modal>

<Modal @ref="replyModal" IsVerticallyCentered="true" IsScrollable="true" ShowCloseButton="false" aria-labelledby="ea-reply-title" OnHidden="OnReplyHidden">
    <HeaderTemplate>
        <h2 class="modal-title h5" id="ea-reply-title">@(Acting?.Reply is null ? "Reply to this review" : "Edit the store's reply")</h2>
    </HeaderTemplate>
    <BodyTemplate>
        @if (Acting is { } acting)
        {
            <blockquote class="ea-reply-context small mb-3">
                <p class="fw-semibold mb-1">@acting.Title</p>
                <p class="mb-1 ea-review-body">@acting.Body</p>
                <footer class="text-body-secondary">
                    <span data-clarity-mask="true">@acting.Author</span>, rated @acting.Rating out of 5 on @(State.FindAnyProduct(acting.ProductId)?.Name ?? "a removed product"),
                    @EcommerceDisplay.Date(acting.PostedOn) · @acting.Status
                </footer>
            </blockquote>
            <EditForm id="ea-reply-form" EditContext="replyContext" OnValidSubmit="SaveReplyAsync" FormName="ea-reply" novalidate>
                <DataAnnotationsValidator />
                <ShowcaseFormErrors ShowSummary="true" />
                <label class="form-label" for="ea-reply-text">Your reply</label>
                <InputTextArea id="ea-reply-text" class="form-control" @bind-Value="replyForm.Text" rows="5" maxlength="600" aria-describedby="ea-reply-help" />
                <div class="form-text" id="ea-reply-help">2 to 600 characters. Shown publicly under the review on the product page.</div>
                <ValidationMessage For="() => replyForm.Text" />
            </EditForm>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => replyModal.HideAsync()">Cancel</Button>
        <Button Type="ButtonType.Submit" Color="ButtonColor.Primary" form="ea-reply-form">@(Acting?.Reply is null ? "Post reply" : "Save reply")</Button>
    </FooterTemplate>
</Modal>

<Modal @ref="removeModal" IsVerticallyCentered="true" ShowCloseButton="false" aria-labelledby="ea-remove-title" OnHidden="OnRemoveHidden">
    <HeaderTemplate>
        <h2 class="modal-title h5" id="ea-remove-title">Remove the store's reply?</h2>
    </HeaderTemplate>
    <BodyTemplate>
        @if (Acting is { } acting)
        {
            <p class="mb-2">Shoppers no longer see it under “@acting.Title” on the product page. The text is deleted and can't be brought back.</p>
            <p class="small text-body-secondary mb-0">You can write a new reply afterwards.</p>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => removeModal.HideAsync()">Keep reply</Button>
        <Button Color="ButtonColor.Danger" @onclick="ConfirmRemoveReplyAsync">Remove reply</Button>
    </FooterTemplate>
</Modal>
