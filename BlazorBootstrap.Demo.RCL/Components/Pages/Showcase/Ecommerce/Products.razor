@page "/showcase/ecommerce/products"
@layout EcommerceLayout

<PageTitle>@PageHeading · @EcommerceSeedData.StoreName</PageTitle>

<div class="container-xl pt-4 pb-5">
    <Breadcrumb Items="breadcrumbItems" Class="ec-breadcrumb mb-2" />
    <h1 class="ec-page-title mb-4">@PageHeading</h1>

    <div class="row g-4">
        <aside class="col-lg-3" aria-label="Filters">
            @* Below the lg breakpoint the filters fold behind a toggle, so products are not pushed off the first screen. *@
            <Button Color="ButtonColor.Secondary" Outline="true" Class="d-lg-none w-100" @onclick="ToggleFiltersAsync"
                    aria-expanded="@(filtersOpen ? "true" : "false")" aria-controls="ec-filters">
                <Icon Name="IconName.Funnel" class="me-1" aria-hidden="true" />@(filtersOpen ? "Hide filters" : "Show filters")@(ActiveFilterCount > 0 ? $" ({ActiveFilterCount} active)" : "")
            </Button>
            <Collapse @ref="filtersCollapse" id="ec-filters" Class="ec-filters" OnShown="() => filtersOpen = true" OnHidden="() => filtersOpen = false">
            <div class="ec-panel mt-3 mt-lg-0">
                <div class="mb-4">
                    <label class="ec-filter-heading d-block" for="ec-search">Search</label>
                    <InputGroup>
                        <InputGroupText><Icon Name="IconName.Search" aria-hidden="true" /></InputGroupText>
                        @* Bound value changes only on change; @oninput filters live (see the Users screen of the SaaS dashboard). *@
                        <TextInput Id="ec-search" Value="@searchBoxValue" ValueExpression="() => searchBoxValue" ValueChanged="OnSearchChanged"
                                   @oninput="OnSearchInput" Placeholder="Search products" />
                    </InputGroup>
                </div>

                <div class="mb-4">
                    <h2 class="ec-filter-heading" id="ec-category-heading">Category</h2>
                    <ListGroup TItem="EcommerceCategory"
                               Data="State.Categories"
                               SelectionMode="ListGroupSelectionMode.Checkbox"
                               SelectedItems="SelectedCategories"
                               SelectedItemsChanged="OnCategoriesChanged"
                               TextField="category => category.Name"
                               AriaLabel="Category"
                               Flush="true" />
                </div>

                <div class="mb-4">
                    <label class="ec-filter-heading d-block" for="ec-max-price">Max price: <span class="text-body">@EcommerceDisplay.Money(Filter.MaxPrice)</span></label>
                    <RangeInput TValue="int" Id="ec-max-price" Value="Filter.MaxPrice" ValueExpression="() => Filter.MaxPrice" ValueChanged="OnMaxPriceChanged"
                                Min="20" Max="400" Step="10" aria-valuetext="@($"Up to {Filter.MaxPrice} dollars")" />
                    <div class="d-flex justify-content-between small text-body-secondary"><span>$20</span><span>$400</span></div>
                </div>

                <div class="mb-4">
                    <h2 class="ec-filter-heading" id="ec-rating-heading">Customer rating</h2>
                    <RadioButtonGroup TValue="int" Value="Filter.MinRating" ValueExpression="() => Filter.MinRating" ValueChanged="OnMinRatingChanged"
                                      AriaLabel="Minimum customer rating" Size="ButtonGroupSize.Small" Class="flex-wrap">
                        <ButtonGroupItem Value="0" Id="ec-rating-any">Any</ButtonGroupItem>
                        <ButtonGroupItem Value="3" Id="ec-rating-3">3★ &amp; up</ButtonGroupItem>
                        <ButtonGroupItem Value="4" Id="ec-rating-4">4★ &amp; up</ButtonGroupItem>
                    </RadioButtonGroup>
                </div>

                <div class="mb-3">
                    <Switch Value="Filter.OnSaleOnly" ValueExpression="() => Filter.OnSaleOnly" ValueChanged="OnSaleOnlyChanged" Label="On sale only" />
                </div>

                <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" Class="w-100" @onclick="ClearFilters" Disabled="!HasFilters">
                    Clear all filters
                </Button>
            </div>
            </Collapse>
        </aside>

        <section class="col-lg-9" aria-labelledby="ec-results-count">
            <div class="ec-results-bar">
                <p class="mb-0 fw-semibold" id="ec-results-count" aria-live="polite">@ResultsText</p>
                <Dropdown Color="DropdownColor.None">
                    <DropdownToggleButton Class="btn btn-outline-secondary btn-sm" aria-label="@($"Sort products, currently {SortLabel(Filter.Sort)}")">
                        <Icon Name="IconName.SortDown" class="me-1" aria-hidden="true" />Sort: @SortLabel(Filter.Sort)
                    </DropdownToggleButton>
                    <DropdownMenu Position="DropdownMenuPosition.End">
                        @foreach (var sort in Enum.GetValues<EcommerceSort>())
                        {
                            <DropdownItem Active="sort == Filter.Sort" aria-current="@(sort == Filter.Sort ? "true" : null)" @onclick="() => OnSortChanged(sort)">@SortLabel(sort)</DropdownItem>
                        }
                    </DropdownMenu>
                </Dropdown>
            </div>

            @if (PageItems.Count == 0)
            {
                <div class="ec-panel text-center py-5">
                    <span class="ec-empty-icon" aria-hidden="true"><Icon Name="IconName.Search" /></span>
                    <p class="mt-3 mb-3">No products match these filters.</p>
                    <Button Color="ButtonColor.Primary" @onclick="ClearFilters">Clear all filters</Button>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3">
                    @foreach (var product in PageItems)
                    {
                        <div class="col" @key="product.Id"><EcommerceProductCard Product="product" /></div>
                    }
                </div>

                @if (TotalPages > 1)
                {
                    <nav class="mt-4" aria-label="Product pages">
                        <Pagination ActivePageNumber="Filter.Page" TotalPages="TotalPages" PageChanged="OnPageChanged" Alignment="Alignment.Center"
                                    PreviousLinkIcon="IconName.ChevronLeft" NextLinkIcon="IconName.ChevronRight" />
                    </nav>
                }
            }
        </section>
    </div>
</div>
