@page "/showcase/ecommerce/admin/returns"
@layout EcommerceAdminLayout

<PageTitle>Returns · @EcommerceSeedData.StoreName admin</PageTitle>

<div class="mb-4">
    <h1 class="ea-title">Returns</h1>
    <p class="ea-lead">@LeadText</p>
</div>

@* Always rendered and focusable, so a decision is announced and focus has somewhere to go when the bulk bar closes. *@
<p class="ea-list-status mb-3" role="status" tabindex="-1" @ref="statusRegion">@statusMessage</p>
<p class="ea-list-error mb-3" role="alert">@errorMessage</p>

<section class="ea-panel" aria-labelledby="ea-returns-title">
    <h2 class="ea-section-title" id="ea-returns-title">Return requests</h2>

    <div class="ea-list-filters" role="search" aria-label="Filter returns">
        <div class="ea-list-search">
            <label class="form-label small fw-semibold" for="ea-return-search">Search</label>
            <InputGroup>
                <InputGroupText><Icon Name="IconName.Search" aria-hidden="true" /></InputGroupText>
                @* TextInput raises ValueChanged on change only; @oninput keeps the filter live while typing. *@
                <TextInput Id="ea-return-search" Value="@searchBoxValue" ValueExpression="() => searchBoxValue" ValueChanged="OnSearchChanged"
                           @oninput="OnSearchInput" Placeholder="Return or order number, name, or email" MaxLength="80" />
            </InputGroup>
        </div>
        <div>
            <label class="form-label small fw-semibold" for="ea-return-status">Status</label>
            <select id="ea-return-status" class="form-select" value="@statusFilter" @onchange="OnStatusFilterChanged">
                <option value="">All (@State.Returns.Count)</option>
                @foreach (var status in Enum.GetValues<EcommerceReturnStatus>())
                {
                    <option value="@status" @key="status">@StatusLabel(status) (@State.Returns.Count(item => item.Status == status))</option>
                }
            </select>
        </div>
    </div>
    <div class="ea-list-meta mb-3">
        <p class="small text-body-secondary mb-0" aria-live="polite" tabindex="-1" @ref="countRegion">@MatchText</p>
        @if (IsFiltered)
        {
            <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ShowWaitingAsync">Show the waiting returns</Button>
        }
        @* Back to the saved view's defaults: oldest request first, 25 a page, every column in its place. *@
        <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ResetViewAsync">Reset view</Button>
    </div>

    @if (selected.Count > 0)
    {
        var waiting = selected.Count(row => row.StatusValue == EcommerceReturnStatus.Requested);

        <section class="ea-bulk" aria-labelledby="ea-returns-bulk-count">
            <h2 class="ea-bulk-count" id="ea-returns-bulk-count">
                @(selected.Count == 1 ? "1 return selected" : $"{EcommerceDisplay.Count(selected.Count)} returns selected"), @(waiting == selected.Count ? "all waiting" : $"{waiting} waiting for a decision")
            </h2>
            @if (waiting == 0)
            {
                <p class="small mb-0 w-100">These returns are decided already. Select waiting returns to approve or reject them together.</p>
                <div class="ea-bulk-actions">
                    <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="ClearSelectionAsync">Clear selection</Button>
                </div>
            }
            else
            {
                <EditForm EditContext="bulkContext" OnSubmit="ApplyBulkAsync" FormName="ea-returns-bulk" class="ea-bulk-form" novalidate>
                    <DataAnnotationsValidator />
                    <ShowcaseFormErrors ShowSummary="true" />
                    <div class="ea-bulk-field">
                        <label class="form-label small fw-semibold" for="ea-returns-bulk-decision">Decision</label>
                        <InputSelect id="ea-returns-bulk-decision" class="form-select form-select-sm" @bind-Value="bulkForm.Decision" aria-describedby="ea-returns-bulk-decision-help">
                            <option value="">Choose a decision</option>
                            <option value="@ApproveValue">Approve and refund in full</option>
                            <option value="@RejectValue">Reject</option>
                        </InputSelect>
                        <span class="form-text d-block" id="ea-returns-bulk-decision-help">
                            @(bulkForm.Decision == RejectValue
                                ? "Nothing is refunded; the items stay with the customers."
                                : $"Items go back into stock; {EcommerceDisplay.Money(selected.Where(row => row.StatusValue == EcommerceReturnStatus.Requested).Sum(row => row.Amount))} is refunded to the original cards, at most what's left of each order.")
                        </span>
                        <ValidationMessage For="() => bulkForm.Decision" />
                    </div>
                    <div class="ea-bulk-field ea-bulk-wide">
                        <label class="form-label small fw-semibold" for="ea-returns-bulk-note">@(bulkForm.Decision == RejectValue ? "Reason for the customers" : "Note (optional)")</label>
                        <InputTextArea id="ea-returns-bulk-note" class="form-control form-control-sm" rows="2" maxlength="@EcommerceState.MaxDecisionNoteLength" @bind-Value="bulkForm.Note"
                                       aria-describedby="ea-returns-bulk-note-help" />
                        <span class="form-text d-block" id="ea-returns-bulk-note-help">
                            @(bulkForm.Decision == RejectValue ? "Required, 5 to 200 characters. The customers read it." : "Up to 200 characters, kept with each return.")
                        </span>
                        <ValidationMessage For="() => bulkForm.Note" />
                    </div>
                    <div class="ea-bulk-actions">
                        <Button Type="ButtonType.Submit" Color="ButtonColor.Primary" Size="ButtonSize.Small">Apply<span class="visually-hidden">&#32;to the selected returns</span></Button>
                        <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="ClearSelectionAsync">Clear selection</Button>
                    </div>
                </EditForm>
                <p class="form-text w-100 mb-0">Only the waiting returns change; decided ones stay as they are. Each customer hears about their return. To refund less, open a return and decide it on its own.</p>
            }
        </section>
    }

    <ShowcaseDataState Status="@(viewLoaded ? ShowcaseDataStatus.Ready : ShowcaseDataStatus.Loading)"
                       IsEmpty="@(State.Returns.Count == 0)"
                       EmptyIcon="IconName.ArrowCounterclockwise"
                       EmptyTitle="No return requests yet"
                       EmptyText="Customers can ask to return items from a delivered order; their requests appear here."
                       LoadingText="Loading returns…"
                       OnRetry="RefreshGridAsync">
        <ChildContent>
            <Grid @ref="grid"
                  @key="gridVersion"
                  TItem="ReturnRow"
                  Class="table table-hover align-middle ea-table-wide sc-grid-row-links"
                  GridContainerClass="ea-grid border rounded-3"
                  DataProvider="ProvideReturnsAsync"
                  SettingsProvider="view.GetSettingsAsync"
                  GridSettingsChanged="SaveSettingsAsync"
                  AllowPaging="true"
                  PageSize="@pageSize"
                  PageSizeSelectorVisible="true"
                  PageSizeSelectorItems="@(new[] { 10, 25, 50 })"
                  PaginationItemsTextFormat="{0}–{1} of {2} returns"
                  AllowSorting="true"
                  AllowSelection="true"
                  SelectionMode="GridSelectionMode.Multiple"
                  RowSelectionLabel="@(row => $"Select return {row.Number}, {row.Customer}")"
                  SelectAllRowsText="Select all shown returns"
                  SelectedItemsChanged="OnSelectionChanged"
                  RowClass="RowClass"
                  AllowColumnChooser="true"
                  AllowExport="true"
                  ExportFileName="commerce-returns"
                  Responsive="true"
                  EmptyText="@EmptyText"
                  aria-label="Return requests">
                <GridColumns>
                    <GridColumn TItem="ReturnRow" HeaderText="Return" PropertyName="Number" SortString="number" SortKeySelector="row => row.Id"
                                IsDefaultSortColumn="@view.IsSortColumn("number")" SortDirection="@view.DirectionFor("number")" TextNoWrap="true" AlwaysVisible="true">
                        @* The stretched link makes the whole row open the return; the checkbox and the order link stay above it. *@
                        <a class="ea-row-link stretched-link" href="@EcommerceSeedData.AdminReturnPath(context.Id)">@context.Number</a>
                    </GridColumn>
                    <GridColumn TItem="ReturnRow" HeaderText="Order" PropertyName="Order" SortString="order" SortKeySelector="row => row.OrderId"
                                IsDefaultSortColumn="@view.IsSortColumn("order")" SortDirection="@view.DirectionFor("order")" TextNoWrap="true">
                        <a href="@EcommerceSeedData.AdminOrderPath(context.OrderId)">@context.Order</a>
                    </GridColumn>
                    <GridColumn TItem="ReturnRow" HeaderText="Customer" PropertyName="Customer" SortString="customer" SortKeySelector="row => row.Customer"
                                IsDefaultSortColumn="@view.IsSortColumn("customer")" SortDirection="@view.DirectionFor("customer")">
                        <span data-clarity-mask="true">@context.Customer</span>
                    </GridColumn>
                    <GridColumn TItem="ReturnRow" HeaderText="Items" PropertyName="Items" SortString="items" SortKeySelector="row => row.Items"
                                IsDefaultSortColumn="@view.IsSortColumn("items")" SortDirection="@view.DirectionFor("items")" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End">
                        @context.Items
                    </GridColumn>
                    <GridColumn TItem="ReturnRow" HeaderText="Amount" PropertyName="Amount" SortString="amount" SortKeySelector="row => row.Amount"
                                IsDefaultSortColumn="@view.IsSortColumn("amount")" SortDirection="@view.DirectionFor("amount")" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End" TextNoWrap="true">
                        @EcommerceDisplay.Money(context.Amount)
                    </GridColumn>
                    <GridColumn TItem="ReturnRow" HeaderText="Reason" PropertyName="Reason" SortString="reason" SortKeySelector="row => row.Reason"
                                IsDefaultSortColumn="@view.IsSortColumn("reason")" SortDirection="@view.DirectionFor("reason")">
                        <span class="small">@context.Reason</span>
                    </GridColumn>
                    <GridColumn TItem="ReturnRow" HeaderText="Requested" PropertyName="RequestedText" SortString="requested" SortKeySelector="row => row.RequestedOn"
                                IsDefaultSortColumn="@view.IsSortColumn("requested")" SortDirection="@view.DirectionFor("requested")" TextNoWrap="true">
                        @EcommerceDisplay.DateTimeShort(context.RequestedOn)
                    </GridColumn>
                    <GridColumn TItem="ReturnRow" HeaderText="Status" PropertyName="Status" SortString="status" SortKeySelector="row => row.StatusValue"
                                IsDefaultSortColumn="@view.IsSortColumn("status")" SortDirection="@view.DirectionFor("status")" TextNoWrap="true">
                        <Badge Color="@StatusColor(context.StatusValue)">@context.Status</Badge>
                    </GridColumn>
                    <GridColumn TItem="ReturnRow" HeaderText="Refunded" PropertyName="Refunded" SortString="refunded" SortKeySelector="row => row.Refunded"
                                IsDefaultSortColumn="@view.IsSortColumn("refunded")" SortDirection="@view.DirectionFor("refunded")" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End" TextNoWrap="true">
                        @if (context.StatusValue == EcommerceReturnStatus.Approved)
                        {
                            @EcommerceDisplay.Money(context.Refunded)
                        }
                        else
                        {
                            <span class="text-body-secondary" aria-hidden="true">—</span><span class="visually-hidden">None</span>
                        }
                    </GridColumn>
                    <GridColumn TItem="ReturnRow" HeaderText="Decided" PropertyName="DecidedText" SortString="decided" SortKeySelector="row => row.DecidedOn ?? DateTime.MaxValue"
                                IsDefaultSortColumn="@view.IsSortColumn("decided")" SortDirection="@view.DirectionFor("decided")" TextNoWrap="true">
                        @(context.DecidedOn is { } decided ? EcommerceDisplay.DateTimeShort(decided) : "Waiting")
                    </GridColumn>
                </GridColumns>
            </Grid>
        </ChildContent>
    </ShowcaseDataState>
</section>
