@* The site's not-found screen, shown by the catch-all route and for unknown stays. *@
<PageTitle>Page not found · @TravelSeedData.SiteName</PageTitle>

<section class="ds-not-found">
    <span class="ds-icon fs-4" aria-hidden="true"><Icon Name="IconName.SignpostSplit" /></span>
    <h1 class="ds-title fs-3 mt-3 mb-2">We couldn't find that page</h1>
    <p class="text-body-secondary mb-4">The stay may no longer be listed. Your trips are safe.</p>
    <div class="d-flex justify-content-center flex-wrap gap-2">
        <Button Type="ButtonType.Link" To="@TravelLayout.Base" Color="ButtonColor.Primary">Search stays</Button>
        <Button Type="ButtonType.Link" To="@($"{TravelLayout.Base}/trips")" Color="ButtonColor.Primary" Outline="true">Your trips</Button>
    </div>
</section>
