<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:wght@400;500;600;700&display=swap" />
</HeadContent>

@* The frame both Driftwood Stays layouts share: the guest site and the host back office (D-031). Its stylesheet styles the
   pages of both through ::deep. *@
<div class="sc-site sc-travel">
    <ShowcaseSiteBar Site="@site" />

    @Header

    <div class="@(Sidebar is null ? null : "ds-shell")">
        @Sidebar

        <div class="@(Sidebar is null ? null : "ds-shell-main")">
            @* Pages show guests' names, trips, and messages, so the content is masked from session recording. *@
            <main class="sc-main ds-content" id="ds-main" data-clarity-mask="true">
                @ChildContent
            </main>

            <div class="@Container">
                <CarbonAds Class="sc-ad" />
            </div>

            <footer class="ds-footer">
                <div class="@Container d-flex flex-wrap justify-content-between gap-2">
                    <span>© 2026 @TravelSeedData.SiteName (fictitious). The cities are real; every stay, host, review, and booking is made up and stays in this browser tab. Payments use test cards only.</span>
                    <span class="d-none d-lg-inline">Built with GoogleMap, Carousel, DateInput, NumberInput, RangeInput, RatingInput, Sidebar, Charts, and Modal.</span>
                </div>
            </footer>
        </div>
    </div>

    @* Toasts can name guests and stays, so they are masked from session recording like the page content. *@
    <div data-clarity-mask="true">
        <Toasts class="p-3" AutoHide="true" Delay="5000" Placement="ToastsPlacement.BottomRight" />
    </div>
</div>

@code {
    private readonly ShowcaseSite site = ShowcaseCatalog.Get("travel");

    /// <summary>Gets or sets the page content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Gets or sets the header above the page (the guest site's Navbar, or the host's top bar).</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    /// <summary>Gets or sets the sidebar beside the page (the host back office), or <see langword="null" /> for none.</summary>
    [Parameter] public RenderFragment? Sidebar { get; set; }

    private string Container => Sidebar is null ? "container-xl" : "container-fluid px-lg-4";
}
