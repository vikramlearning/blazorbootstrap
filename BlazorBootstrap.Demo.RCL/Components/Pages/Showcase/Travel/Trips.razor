@page "/showcase/travel/trips"
@layout TravelLayout

<PageTitle>Your trips · @TravelSeedData.SiteName</PageTitle>

<div class="container-xl pb-4">
    <ShowcaseRoleGuard Roles="@TravelSeedData.GuestRole" SignInPath="@TravelLayout.SignInPath">
        @{
            var groups = Groups;
        }
        <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
            <div>
                <h1 class="ds-title mb-1">Your trips</h1>
                <p class="ds-lead mb-0">@Summary(groups)</p>
            </div>
            <a class="btn btn-outline-primary" href="@TravelLayout.Base"><Icon Name="IconName.Search" class="me-2" aria-hidden="true" />Find a stay</a>
        </div>

        @* A jump list rather than tabs: every group stays on the page, so nothing is hidden from search or print. *@
        <nav class="ds-trip-jump mb-4" aria-label="Trip groups">
            @foreach (var group in groups)
            {
                <a class="btn btn-sm btn-outline-secondary" href="@($"{TravelLayout.Base}/trips#{group.Id}")">@group.Title <span class="badge text-bg-secondary ms-1">@group.Trips.Count</span></a>
            }
        </nav>

        @foreach (var group in groups)
        {
            <section class="mb-5" aria-labelledby="@group.Id" @key="group.Id">
                <h2 class="ds-section-title" id="@group.Id" tabindex="-1">@group.Title <span class="text-body-secondary fs-6">(@group.Trips.Count)</span></h2>
                @if (group.Trips.Count == 0)
                {
                    <div class="ds-panel ds-trip-empty">
                        <p class="text-body-secondary mb-0">@group.Empty</p>
                    </div>
                }
                else
                {
                    <ul class="row row-cols-1 row-cols-md-2 g-3 list-unstyled mb-0">
                        @foreach (var trip in group.Trips)
                        {
                            var stay = State.FindStay(trip.StayId);
                            if (stay is null)
                                continue;

                            var destination = State.FindDestination(stay.DestinationId);
                            var phase = State.Phase(trip);
                            <li class="col" @key="trip.Reference">
                                <Card Class="ds-card ds-trip h-100">
                                    <div class="ds-trip-layout">
                                        <div class="ds-trip-photo">
                                            <ShowcaseImage Src="@stay.PhotoPath(1)" Alt="" Width="600" Height="600" Accent="@destination.Accent" PlaceholderIcon="IconName.HouseHeart" Class="h-100" />
                                        </div>
                                        <CardBody Class="d-flex flex-column">
                                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                                                <span class="small text-body-secondary">@destination.Name, @destination.Country</span>
                                                <Badge Color="@TravelDisplay.PhaseColor(phase)">@TravelDisplay.PhaseText(phase)</Badge>
                                            </div>
                                            <h3 class="ds-card-title"><a href="@TravelDisplay.TripUrl(trip.Reference)">@stay.Name</a></h3>
                                            <p class="small mb-1">@TravelDisplay.Dates(trip.CheckIn, trip.CheckOut) · @TravelDisplay.Nights(trip.Nights)</p>
                                            <p class="small text-body-secondary mb-2">@TravelDisplay.Guests(trip.Guests) · @trip.Reference</p>
                                            <p class="small fw-semibold mb-3">@MoneyLine(trip, phase)</p>
                                            <div class="mt-auto">
                                                <a class="btn btn-sm btn-outline-primary" href="@TravelDisplay.TripUrl(trip.Reference)">
                                                    View trip<span class="visually-hidden">@($" {trip.Reference} at {stay.Name}")</span>
                                                </a>
                                            </div>
                                        </CardBody>
                                    </div>
                                </Card>
                            </li>
                        }
                    </ul>
                }
            </section>
        }
    </ShowcaseRoleGuard>
</div>
