@page "/showcase/healthcare/lab-reports"
@layout HcLayout

<PageTitle>Lab reports · @HcSeedData.ProductName</PageTitle>

<div class="container-xl hc-labs">
    <ShowcaseRoleGuard Roles="@HcSeedData.PatientRole" SignInPath="@HcLayout.SignInPath">
        @{
            var orders = Orders();
            var released = orders.Count(order => order.Status == HcLabStatus.Released);
        }

        <h1 class="hc-title mb-1">Lab reports</h1>
        <p class="hc-lead mb-2">Your blood test results, once your doctor has reviewed and released them, each with a PDF you can download.</p>
        <p class="small text-body-secondary mb-3">Demo only: the results are made up, and nothing here is medical advice. Ask your doctor what your results mean for you.</p>

        <section class="hc-panel mb-3" aria-labelledby="hc-lr-filters-title">
            <h2 class="hc-section-title" id="hc-lr-filters-title">Show</h2>
            <div class="hc-list-filters" role="search" aria-labelledby="hc-lr-filters-title">
                <div>
                    <label class="form-label small fw-semibold" for="hc-lr-status">Reports</label>
                    <select id="hc-lr-status" class="form-select" value="@readyFilter" @onchange="OnReadyChangedAsync">
                        <option value="">All (@orders.Count)</option>
                        <option value="@ReadyFilter">Ready to view (@released)</option>
                        <option value="@WaitingFilter">Waiting for results (@(orders.Count - released))</option>
                    </select>
                </div>
            </div>
            <div class="hc-list-meta">
                <p class="small text-body-secondary mb-0" aria-live="polite" tabindex="-1" @ref="countRegion">@CountText(orders.Count)</p>
                @* Back to the saved view's defaults: newest first, 10 a page, every column in its place. *@
                <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ResetViewAsync">Reset view</Button>
            </div>
        </section>

        <p class="hc-list-status mb-2" role="status" tabindex="-1" @ref="statusRegion">@statusMessage</p>

        <section class="hc-panel" aria-label="Your lab reports">
            <ShowcaseDataState Status="@(viewLoaded ? ShowcaseDataStatus.Ready : ShowcaseDataStatus.Loading)"
                               IsEmpty="@(orders.Count == 0)"
                               EmptyIcon="IconName.FileEarmarkMedical"
                               EmptyTitle="No lab reports yet"
                               EmptyText="When your doctor orders a test and releases the results, the report appears here."
                               LoadingText="Loading your lab reports…"
                               OnRetry="RefreshGridAsync">
                <ChildContent>
                    <Grid @ref="grid"
                          @key="gridVersion"
                          TItem="ReportRow"
                          Class="table table-hover align-middle hc-table-mid sc-grid-row-links"
                          GridContainerClass="hc-grid border rounded-3"
                          DataProvider="ProvideReportsAsync"
                          SettingsProvider="view.GetSettingsAsync"
                          GridSettingsChanged="SaveSettingsAsync"
                          AllowPaging="true"
                          PageSize="@pageSize"
                          PageSizeSelectorVisible="true"
                          PageSizeSelectorItems="@(new[] { 10, 25, 50 })"
                          PaginationItemsTextFormat="{0}–{1} of {2} reports"
                          AllowSorting="true"
                          AllowColumnChooser="true"
                          AllowExport="true"
                          ExportFileName="clinic-my-lab-reports"
                          Responsive="true"
                          EmptyText="No reports match. Choose All."
                          aria-label="Your lab reports">
                        <GridColumns>
                            <GridColumn TItem="ReportRow" HeaderText="Test" PropertyName="Test" SortString="test" SortKeySelector="row => row.Test"
                                        IsDefaultSortColumn="@view.IsSortColumn("test")" SortDirection="@view.DirectionFor("test")" AlwaysVisible="true">
                                @if (context.IsReady)
                                {
                                    @* The stretched link makes the whole row open the report. *@
                                    <a class="hc-row-link stretched-link" href="@HcDisplay.LabUrl(context.Id)">@context.Test</a>
                                }
                                else
                                {
                                    <span class="fw-semibold">@context.Test</span>
                                }
                            </GridColumn>
                            <GridColumn TItem="ReportRow" HeaderText="Status" PropertyName="Status" SortString="status" SortKeySelector="row => row.IsReady"
                                        IsDefaultSortColumn="@view.IsSortColumn("status")" SortDirection="@view.DirectionFor("status")" TextNoWrap="true">
                                <Icon Name="@(context.IsReady ? IconName.FileEarmarkCheck : IconName.HourglassSplit)" class="me-1" aria-hidden="true" />@context.Status
                            </GridColumn>
                            <GridColumn TItem="ReportRow" HeaderText="Results" PropertyName="Results" SortString="results" SortKeySelector="row => row.OutOfRange"
                                        IsDefaultSortColumn="@view.IsSortColumn("results")" SortDirection="@view.DirectionFor("results")">
                                <span class="@(context.OutOfRange > 0 ? "fw-semibold text-warning-emphasis" : null)">@context.Results</span>
                            </GridColumn>
                            <GridColumn TItem="ReportRow" HeaderText="Ordered" PropertyName="OrderedText" SortString="ordered" SortKeySelector="row => row.Ordered"
                                        IsDefaultSortColumn="@view.IsSortColumn("ordered")" SortDirection="@view.DirectionFor("ordered")" TextNoWrap="true">
                                @context.OrderedText
                            </GridColumn>
                            <GridColumn TItem="ReportRow" HeaderText="Released" PropertyName="ReleasedText" SortString="released" SortKeySelector="row => row.Released ?? DateTime.MaxValue"
                                        IsDefaultSortColumn="@view.IsSortColumn("released")" SortDirection="@view.DirectionFor("released")" TextNoWrap="true">
                                @context.ReleasedText
                            </GridColumn>
                            <GridColumn TItem="ReportRow" HeaderText="Ordered by" PropertyName="Doctor" SortString="doctor" SortKeySelector="row => row.Doctor"
                                        IsDefaultSortColumn="@view.IsSortColumn("doctor")" SortDirection="@view.DirectionFor("doctor")">
                                @context.Doctor
                            </GridColumn>
                        </GridColumns>
                    </Grid>
                </ChildContent>
            </ShowcaseDataState>
        </section>
    </ShowcaseRoleGuard>
</div>
