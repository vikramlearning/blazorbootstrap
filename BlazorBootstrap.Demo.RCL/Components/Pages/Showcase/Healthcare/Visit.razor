@page "/showcase/healthcare/staff/appointments/{Id:int}"
@layout HcStaffLayout

@* One visit for its doctor: the patient's header with allergies, vital signs, notes and the summary for the patient, lab
   orders, prescriptions, Complete visit, and the coding of the completed visit with its insurance claim. Another doctor's
   visit is read-only. *@
<div class="container-fluid px-lg-4">
    <ShowcaseRoleGuard Roles="@HcSeedData.DoctorRole" SignInPath="@HcLayout.SignInPath">
        @if (State.FindAppointment(Id) is not { } appointment)
        {
            <HcNotFound Message="This visit doesn't exist, or the link is wrong." />
        }
        else
        {
            var today = State.Clock.Today;
            var me = State.CurrentDoctor;
            var patient = State.FindPatient(appointment.PatientId);
            var name = patient?.Name ?? "A former patient";
            var doctor = State.FindDoctor(appointment.DoctorId);
            var clinic = State.FindClinic(appointment.ClinicId);
            var own = me is not null && appointment.DoctorId == me.Id;
            var started = appointment.Status is HcAppointmentStatus.InVisit or HcAppointmentStatus.Completed;
            var canEdit = own && started;
            var visitLabs = State.LabOrdersOf(appointment.PatientId).Where(item => item.AppointmentId == appointment.Id).ToList();
            var visitPrescriptions = VisitPrescriptions(appointment);
            var bill = State.BillsOf(appointment.PatientId).FirstOrDefault(item => item.AppointmentId == appointment.Id);
            var claim = State.ClaimOfVisit(appointment.Id);
            var unsaved = canEdit && ((notesForm.Notes ?? string.Empty).Trim() != appointment.Notes || (notesForm.Summary ?? string.Empty).Trim() != appointment.Summary);

            <PageTitle>Visit: @name · @HcSeedData.ProductName</PageTitle>

            <nav aria-label="Breadcrumb">
                <ol class="breadcrumb small mb-2">
                    @if (own)
                    {
                        <li class="breadcrumb-item"><a href="@ScheduleUrl(appointment.Start)">My schedule</a></li>
                    }
                    else
                    {
                        <li class="breadcrumb-item"><a href="@($"{HcStaffLayout.Base}/patients")">Patients</a></li>
                    }
                    @if (patient is not null)
                    {
                        <li class="breadcrumb-item hc-visit-wrap"><a href="@HcDisplay.PatientChartUrl(patient.Id)">@patient.Name</a></li>
                    }
                    <li class="breadcrumb-item active" aria-current="page">Visit @HcDisplay.Day(appointment.Start)</li>
                </ol>
            </nav>

            <p class="small text-body-secondary mb-1">
                Visit · @HcDisplay.DayLong(appointment.Start) at @HcDisplay.Time(appointment.Start) · @HcDisplay.VisitTypeText(appointment.VisitType)@(clinic is null ? null : $" · {clinic.Name}")
            </p>
            <h1 class="hc-title mb-1">@name</h1>
            <p class="mb-3">
                @PatientChart.AgeText(HcDisplay.Age(patient?.DateOfBirth, today))
                @if (patient is not null)
                {
                    <text> · @PatientChart.Mrn(patient) · @(State.FindPayer(patient.InsurancePayerId)?.Name ?? "Self-pay") · </text><a href="@HcDisplay.PatientChartUrl(patient.Id)">Open @patient.Name's chart</a>
                }
            </p>

            @if (patient is not null)
            {
                <PatientChartAllergies Allergies="patient.Allergies" />
            }

            <dl class="hc-visit-facts mt-3">
                <div>
                    <dt>Reason for the visit</dt>
                    <dd class="hc-plain">@appointment.Reason</dd>
                </div>
                <div>
                    <dt>Status</dt>
                    <dd>
                        <span class="@($"badge text-bg-{HcDisplay.StatusColor(appointment.Status)}")">@HcDisplay.StatusLabel(appointment.Status)</span>
                        @if (StatusDetail(appointment) is { } detail)
                        {
                            <span class="d-block small mt-1">@detail</span>
                        }
                    </dd>
                </div>
                <div>
                    <dt>Doctor</dt>
                    <dd>@(doctor?.Name ?? "A former doctor")@(own ? " (you)" : null)</dd>
                </div>
            </dl>

            @if (!own)
            {
                <p class="hc-visit-notice">
                    <Icon Name="IconName.Lock" class="me-2" aria-hidden="true" />
                    This visit belongs to @(doctor?.Name ?? "another doctor"), so it's read-only for you.
                </p>
            }

            @* Always rendered and focusable, so an outcome is announced and focus has somewhere to go. *@
            <p class="fw-semibold hc-visit-status @(statusIsError ? "text-danger-emphasis" : null)" role="status" tabindex="-1" @ref="statusRegion">@statusMessage</p>

            <div class="hc-visit-grid">
                <section class="hc-panel hc-visit-notes" aria-labelledby="hc-visit-notes-title">
                    <h2 class="hc-section-title" id="hc-visit-notes-title">Notes and summary</h2>
                    @if (canEdit)
                    {
                        <EditForm EditContext="notesContext" OnSubmit="SaveNotes" FormName="hc-visit-notes" novalidate>
                            <DataAnnotationsValidator />
                            <ShowcaseFormErrors ShowSummary="true" />
                            <div class="mb-3">
                                <label class="form-label fw-semibold" for="hc-visit-notes">Visit notes (staff only)</label>
                                <InputTextArea id="hc-visit-notes" class="form-control" rows="7" @bind-Value="notesForm.Notes" maxlength="@HcState.MaxNotesLength" aria-describedby="hc-visit-notes-help" />
                                <div class="form-text" id="hc-visit-notes-help">Only staff see these; the patient never does. @((notesForm.Notes ?? string.Empty).Length) of @HcState.MaxNotesLength characters.</div>
                                <ValidationMessage For="() => notesForm.Notes" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold" for="hc-visit-summary">Summary for the patient</label>
                                <InputTextArea id="hc-visit-summary" class="form-control" rows="5" @bind-Value="notesForm.Summary" maxlength="@HcState.MaxSummaryLength" aria-describedby="hc-visit-summary-help" />
                                <div class="form-text" id="hc-visit-summary-help">
                                    @(appointment.Status == HcAppointmentStatus.Completed
                                        ? "The patient already sees this in their records, so a saved change shows to them right away."
                                        : "The patient sees this in their records after you complete the visit. Use plain words.")
                                    @((notesForm.Summary ?? string.Empty).Length) of @HcState.MaxSummaryLength characters.
                                </div>
                                <ValidationMessage For="() => notesForm.Summary" />
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <Button Type="ButtonType.Submit" Color="ButtonColor.Primary"><Icon Name="IconName.Save" class="me-1" aria-hidden="true" />Save notes</Button>
                                <span class="small text-body-secondary">@(unsaved ? "You have unsaved changes." : "Everything is saved.")</span>
                            </div>
                        </EditForm>
                    }
                    else if (own)
                    {
                        @switch (appointment.Status)
                        {
                            case HcAppointmentStatus.CheckedIn:
                                <p>@name is checked in. Start the visit to write notes, take vitals, order labs, and prescribe.</p>
                                <button type="button" class="btn btn-primary" @ref="startButton" @onclick="StartVisit">
                                    <Icon Name="IconName.PlayFill" class="me-1" aria-hidden="true" />Start visit
                                </button>
                                break;

                            case HcAppointmentStatus.Booked:
                                <p class="mb-0">
                                    The patient hasn't been checked in, so the visit can't start yet. The front desk checks patients in when they
                                    arrive, and this page updates when they do.
                                </p>
                                break;

                            case HcAppointmentStatus.Cancelled:
                                <p class="mb-0">This visit was cancelled, so there's nothing to write.</p>
                                break;

                            default:
                                <p class="mb-0">The patient didn't come to this visit, so there's nothing to write.</p>
                                break;
                        }
                    }
                    else
                    {
                        <p class="small fw-semibold mb-1">Visit notes (staff only)</p>
                        <p class="hc-plain">@(appointment.Notes.Length > 0 ? appointment.Notes : "No notes.")</p>
                        <p class="small fw-semibold mb-1">Summary for the patient</p>
                        <p class="hc-plain mb-0">@(appointment.Summary.Length > 0 ? appointment.Summary : "No summary.")</p>
                    }
                </section>

                <section class="hc-panel hc-visit-vitals" aria-labelledby="hc-visit-vitals-title">
                    <h2 class="hc-section-title" id="hc-visit-vitals-title">Vital signs</h2>
                    @if (canEdit)
                    {
                        <EditForm EditContext="vitalsContext" OnSubmit="SaveVitals" FormName="hc-visit-vitals" novalidate>
                            <DataAnnotationsValidator />
                            <ShowcaseFormErrors ShowSummary="true" />
                            <div class="hc-visit-vitals-fields">
                                <div>
                                    <label class="form-label fw-semibold" for="hc-visit-sys">Systolic (mmHg)</label>
                                    <InputNumber TValue="int?" id="hc-visit-sys" class="form-control" @bind-Value="vitalsForm.Systolic" inputmode="numeric" min="60" max="250" step="1"
                                                 ParsingErrorMessage="Enter the systolic pressure as a whole number." aria-describedby="hc-visit-bp-help" />
                                    <ValidationMessage For="() => vitalsForm.Systolic" />
                                </div>
                                <div>
                                    <label class="form-label fw-semibold" for="hc-visit-dia">Diastolic (mmHg)</label>
                                    <InputNumber TValue="int?" id="hc-visit-dia" class="form-control" @bind-Value="vitalsForm.Diastolic" inputmode="numeric" min="30" max="150" step="1"
                                                 ParsingErrorMessage="Enter the diastolic pressure as a whole number." aria-describedby="hc-visit-bp-help" />
                                    <ValidationMessage For="() => vitalsForm.Diastolic" />
                                </div>
                                <div>
                                    <label class="form-label fw-semibold" for="hc-visit-pulse">Pulse (a minute)</label>
                                    <InputNumber TValue="int?" id="hc-visit-pulse" class="form-control" @bind-Value="vitalsForm.Pulse" inputmode="numeric" min="30" max="220" step="1"
                                                 ParsingErrorMessage="Enter the pulse as a whole number." />
                                    <ValidationMessage For="() => vitalsForm.Pulse" />
                                </div>
                                <div>
                                    <label class="form-label fw-semibold" for="hc-visit-temp">Temperature (°C)</label>
                                    <InputNumber TValue="double?" id="hc-visit-temp" class="form-control" @bind-Value="vitalsForm.TemperatureC" inputmode="decimal" min="34" max="42" step="0.1"
                                                 ParsingErrorMessage="Enter the temperature as a number, like 36.8." />
                                    <ValidationMessage For="() => vitalsForm.TemperatureC" />
                                </div>
                                <div>
                                    <label class="form-label fw-semibold" for="hc-visit-weight">Weight (kg)</label>
                                    <InputNumber TValue="double?" id="hc-visit-weight" class="form-control" @bind-Value="vitalsForm.WeightKg" inputmode="decimal" min="1" max="400" step="0.1"
                                                 ParsingErrorMessage="Enter the weight as a number, like 72.5." />
                                    <ValidationMessage For="() => vitalsForm.WeightKg" />
                                </div>
                            </div>
                            <p class="form-text mt-1" id="hc-visit-bp-help">Blood pressure: both values or neither, systolic 60 to 250 above diastolic 30 to 150. Leave out what you didn't measure.</p>
                            <Button Type="ButtonType.Submit" Color="ButtonColor.Primary" Outline="true"><Icon Name="IconName.HeartPulse" class="me-1" aria-hidden="true" />Save vitals</Button>
                        </EditForm>
                    }
                    else if (appointment.Vitals is { } vitals)
                    {
                        <p class="mb-0">@VitalsText(vitals)</p>
                    }
                    else
                    {
                        <p class="text-body-secondary mb-0">No vital signs recorded.</p>
                    }
                </section>

                <section class="hc-panel hc-visit-labs" aria-labelledby="hc-visit-labs-title">
                    <h2 class="hc-section-title" id="hc-visit-labs-title">Lab orders</h2>
                    @if (canEdit)
                    {
                        <EditForm EditContext="labContext" OnSubmit="OrderLab" FormName="hc-visit-lab" class="mb-3" novalidate>
                            <DataAnnotationsValidator />
                            <ShowcaseFormErrors ShowSummary="true" />
                            <label class="form-label fw-semibold" for="hc-visit-panel">Order a lab test</label>
                            <div class="hc-visit-inline">
                                <InputSelect id="hc-visit-panel" class="form-select" @bind-Value="labForm.PanelId" aria-describedby="hc-visit-panel-help">
                                    <option value="">Choose a test</option>
                                    @foreach (var panel in State.LabPanels)
                                    {
                                        <option value="@panel.Id" @key="@($"panel-{panel.Id}")">
                                            @panel.Name: @panel.Description@(visitLabs.Any(item => item.PanelId == panel.Id) ? " (already ordered in this visit)" : null)
                                        </option>
                                    }
                                </InputSelect>
                                <Button Type="ButtonType.Submit" Color="ButtonColor.Primary" Outline="true" Class="text-nowrap">Order test</Button>
                            </div>
                            <div class="form-text" id="hc-visit-panel-help">You enter the results under Lab results. Each test is billed @HcDisplay.Money(HcSeedData.LabFeeCents) when you release it.</div>
                            <ValidationMessage For="() => labForm.PanelId" />
                        </EditForm>
                    }
                    else if (own && !started)
                    {
                        <p class="text-body-secondary">You can order lab tests once the visit starts.</p>
                    }

                    @if (visitLabs.Count == 0)
                    {
                        <p class="text-body-secondary mb-0">No lab tests ordered in this visit.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled hc-visit-items mb-0" aria-label="Lab tests ordered in this visit">
                            @foreach (var order in visitLabs)
                            {
                                var panelName = State.LabPanel(order.PanelId)?.Name ?? order.PanelId;

                                <li @key="@($"lab-{order.Id}")">
                                    <span class="fw-semibold">@panelName</span>
                                    <span class="small">
                                        <span class="@($"badge text-bg-{Labs.StatusColor(order.Status)} me-1")">@Labs.StatusLabel(order.Status)</span>
                                        @if (me is not null && order.DoctorId == me.Id)
                                        {
                                            <a href="@Labs.OrderUrl(order.Id)">@(order.Status == HcLabStatus.Ordered ? "Enter results" : "Open in Lab results")<span class="visually-hidden"> for @panelName</span></a>
                                        }
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </section>

                <section class="hc-panel hc-visit-rx" aria-labelledby="hc-visit-rx-title">
                    <h2 class="hc-section-title" id="hc-visit-rx-title">Prescriptions</h2>
                    @if (canEdit)
                    {
                        <EditForm EditContext="rxContext" OnSubmit="Prescribe" FormName="hc-visit-rx" class="mb-3" novalidate>
                            <DataAnnotationsValidator />
                            <ShowcaseFormErrors ShowSummary="true" />
                            <div class="hc-visit-rx-fields">
                                <div class="hc-visit-rx-wide">
                                    <label class="form-label fw-semibold" for="hc-visit-rx-medication">Medication</label>
                                    <InputText id="hc-visit-rx-medication" class="form-control" @bind-Value="rxForm.Medication" maxlength="@HcState.MaxMedicationLength" autocomplete="off" />
                                    <ValidationMessage For="() => rxForm.Medication" />
                                </div>
                                <div class="hc-visit-rx-wide">
                                    <label class="form-label fw-semibold" for="hc-visit-rx-dose">Dose</label>
                                    <InputText id="hc-visit-rx-dose" class="form-control" @bind-Value="rxForm.Dose" maxlength="@HcState.MaxDoseLength" autocomplete="off" aria-describedby="hc-visit-rx-dose-help" />
                                    <div class="form-text" id="hc-visit-rx-dose-help">Like “10 mg tablet”.</div>
                                    <ValidationMessage For="() => rxForm.Dose" />
                                </div>
                                <div class="hc-visit-rx-full">
                                    <label class="form-label fw-semibold" for="hc-visit-rx-directions">Directions</label>
                                    <InputTextArea id="hc-visit-rx-directions" class="form-control" rows="2" @bind-Value="rxForm.Directions" maxlength="@HcState.MaxDirectionsLength" aria-describedby="hc-visit-rx-directions-help" />
                                    <div class="form-text" id="hc-visit-rx-directions-help">How to take it, in the patient's words. @((rxForm.Directions ?? string.Empty).Length) of @HcState.MaxDirectionsLength characters.</div>
                                    <ValidationMessage For="() => rxForm.Directions" />
                                </div>
                                <div>
                                    <label class="form-label fw-semibold" for="hc-visit-rx-quantity">Quantity</label>
                                    <InputNumber TValue="int?" id="hc-visit-rx-quantity" class="form-control" @bind-Value="rxForm.Quantity" inputmode="numeric" min="1" max="@HcState.MaxQuantity" step="1"
                                                 ParsingErrorMessage="Enter the quantity as a whole number." aria-describedby="hc-visit-rx-quantity-help" />
                                    <div class="form-text" id="hc-visit-rx-quantity-help">1 to @HcState.MaxQuantity per fill.</div>
                                    <ValidationMessage For="() => rxForm.Quantity" />
                                </div>
                                <div>
                                    <label class="form-label fw-semibold" for="hc-visit-rx-days">Days per fill</label>
                                    <InputNumber TValue="int?" id="hc-visit-rx-days" class="form-control" @bind-Value="rxForm.DaysSupply" inputmode="numeric" min="1" max="@HcState.MaxDaysSupply" step="1"
                                                 ParsingErrorMessage="Enter the days as a whole number." aria-describedby="hc-visit-rx-days-help" />
                                    <div class="form-text" id="hc-visit-rx-days-help">1 to @HcState.MaxDaysSupply.</div>
                                    <ValidationMessage For="() => rxForm.DaysSupply" />
                                </div>
                                <div>
                                    <label class="form-label fw-semibold" for="hc-visit-rx-refills">Refills</label>
                                    <InputNumber TValue="int?" id="hc-visit-rx-refills" class="form-control" @bind-Value="rxForm.Refills" inputmode="numeric" min="0" max="@HcState.MaxRefills" step="1"
                                                 ParsingErrorMessage="Enter the refills as a whole number." aria-describedby="hc-visit-rx-refills-help" />
                                    <div class="form-text" id="hc-visit-rx-refills-help">0 to @HcState.MaxRefills; all fills together at most a year.</div>
                                    <ValidationMessage For="() => rxForm.Refills" />
                                </div>
                            </div>
                            <Button Type="ButtonType.Submit" Color="ButtonColor.Primary" Outline="true" Class="mt-1"><Icon Name="IconName.Capsule" class="me-1" aria-hidden="true" />Prescribe</Button>
                        </EditForm>
                    }
                    else if (own && !started)
                    {
                        <p class="text-body-secondary">You can prescribe once the visit starts.</p>
                    }

                    @if (visitPrescriptions.Count == 0)
                    {
                        <p class="text-body-secondary mb-0">Nothing prescribed in this visit.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled hc-visit-items mb-0" aria-label="Prescribed in this visit">
                            @foreach (var prescription in visitPrescriptions)
                            {
                                <li @key="@($"rx-{prescription.Id}")">
                                    <span class="hc-visit-wrap">
                                        <span class="fw-semibold">@prescription.Medication @prescription.Dose</span>
                                        <span class="d-block small hc-plain">@prescription.Directions</span>
                                        <span class="d-block small text-body-secondary">Quantity @prescription.Quantity · @prescription.DaysSupply days · @PatientChart.RefillsText(prescription.Refills)</span>
                                    </span>
                                    <span class="@(prescription.Status == HcPrescriptionStatus.Active ? "badge text-bg-success" : "badge text-bg-secondary")">
                                        @(prescription.Status == HcPrescriptionStatus.Active ? "Active" : "Stopped")
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </section>

                @if (own && started)
                {
                    <section class="hc-panel hc-visit-complete" aria-labelledby="hc-visit-complete-title">
                        <h2 class="hc-section-title" id="hc-visit-complete-title">Complete the visit</h2>
                        @if (appointment.Status == HcAppointmentStatus.InVisit)
                        {
                            <p>
                                Completing shows your summary to @name in their records and bills the visit
                                @(State.FindPayer(patient?.InsurancePayerId) is { } payer
                                    ? $"to {payer.Name} first: code it afterwards, below or by billing, to send the claim."
                                    : $"({HcDisplay.Money(FeeCents(doctor))}, {FeeLabel(doctor)} fee, self-pay).")
                                You can still edit the notes, order labs, and prescribe afterwards.
                            </p>
                            <button type="button" class="btn btn-success" @ref="completeButton" @onclick="OpenCompleteAsync">
                                <Icon Name="IconName.CheckCircle" class="me-1" aria-hidden="true" />Complete visit
                            </button>
                        }
                        else
                        {
                            <p class="mb-1">
                                <Icon Name="IconName.CheckCircleFill" class="me-1 text-success" aria-hidden="true" />@CompletedText(appointment, name)
                            </p>
                            @if (bill is not null)
                            {
                                <p class="mb-0">@BillText(bill)</p>
                            }
                        }
                    </section>
                }

                @if (appointment.Status == HcAppointmentStatus.Completed)
                {
                    <section class="hc-panel hc-visit-coding" aria-labelledby="hc-visit-coding-title">
                        <h2 class="hc-section-title" id="hc-visit-coding-title">Coding and insurance claim</h2>
                        @if (claim is not null)
                        {
                            var lastAnswer = claim.Responses.LastOrDefault();

                            <p class="mb-2">
                                <a href="@ClaimDetail.Url(claim.Id)">@claim.Number</a> to @(State.FindPayer(claim.PayerId)?.Name):
                                <span class="badge text-bg-@ClaimDetail.StatusColor(claim.Status) ms-1">@ClaimDetail.StatusLabel(claim)</span>
                                · billed @HcDisplay.Money(claim.BilledCents)
                            </p>
                            @if (claim.Status == HcClaimStatus.Denied && lastAnswer is not null)
                            {
                                <p class="hc-visit-warning mb-3">
                                    <Icon Name="IconName.ExclamationTriangleFill" class="me-1" aria-hidden="true" />
                                    <strong>Denied:</strong> @ClaimDetail.CodesText(State, lastAnswer.DenialCodes)@(lastAnswer.Remark.Length > 0 ? $" ({lastAnswer.Remark})" : null)
                                    @(HcState.IsFinalDenial(claim) ? " The appeal was denied too, so the codes can't change any more." : " Correct the codes below with a note, and billing resubmits the claim.")
                                </p>
                            }
                        }
                        else if (State.FindPayer(patient?.InsurancePayerId) is null)
                        {
                            <p class="small text-body-secondary">@name pays themselves (self-pay), so coding is for the record: no claim is sent.</p>
                        }
                        else if (appointment.ProcedureCodes.Count == 0)
                        {
                            <p class="small text-body-secondary">Not coded yet: coding it creates the claim to @(State.FindPayer(patient?.InsurancePayerId)?.Name) for billing to submit.</p>
                        }

                        @if (own && (claim is null || claim.Status is HcClaimStatus.Draft or HcClaimStatus.Corrected || (claim.Status == HcClaimStatus.Denied && !HcState.IsFinalDenial(claim))))
                        {
                            <HcCodingForm Appointment="appointment" Claim="claim" IdPrefix="hc-visit-coding" OnSaved="OnCoded" />
                        }
                        else
                        {
                            <p class="mb-0">
                                <span class="fw-semibold">Diagnoses:</span> @(appointment.DiagnosisCodes.Count == 0 ? "none" : ClaimDetail.DiagnosesText(State, appointment.DiagnosisCodes))<br />
                                <span class="fw-semibold">Procedures:</span> @(appointment.ProcedureCodes.Count == 0 ? "none" : string.Join(", ", appointment.ProcedureCodes))
                            </p>
                        }
                    </section>
                }
            </div>

            <Modal @ref="completeModal" IsVerticallyCentered="true" ShowCloseButton="false" aria-labelledby="hc-visit-complete-dialog-title" OnHidden="OnCompleteHiddenAsync">
                <HeaderTemplate>
                    <h2 class="modal-title h5 hc-visit-wrap" id="hc-visit-complete-dialog-title">Complete the visit with @name?</h2>
                </HeaderTemplate>
                <BodyTemplate>
                    <p class="@((notesForm.Summary ?? string.Empty).Trim().Length == 0 ? "mb-2" : "mb-0")">
                        @name sees your summary in their records@(State.FindPayer(patient?.InsurancePayerId) is { } plan ? $", and the visit is billed to {plan.Name} once it's coded." : $", and the visit is billed {HcDisplay.Money(FeeCents(doctor))} ({FeeLabel(doctor)} fee).")
                        @(unsaved ? "Your unsaved notes and summary are saved first." : null)
                    </p>
                    @if ((notesForm.Summary ?? string.Empty).Trim().Length == 0)
                    {
                        <p class="hc-visit-warning mb-0">
                            <Icon Name="IconName.ExclamationTriangleFill" class="me-1" aria-hidden="true" />
                            <strong>The summary for the patient is empty,</strong> so they'll see no summary. Cancel to write one, or complete anyway.
                        </p>
                    }
                </BodyTemplate>
                <FooterTemplate>
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => completeModal.HideAsync()">Cancel</button>
                    <button type="button" class="btn btn-success" @onclick="ConfirmCompleteAsync">Complete visit</button>
                </FooterTemplate>
            </Modal>
        }
    </ShowcaseRoleGuard>
</div>
