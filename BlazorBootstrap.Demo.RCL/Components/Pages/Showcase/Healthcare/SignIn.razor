@page "/showcase/healthcare/sign-in"
@layout HcLayout

<PageTitle>Sign in · @HcSeedData.ProductName</PageTitle>

@* A new account registers as a patient. *@
<div class="container-xl">
    <ShowcaseSignIn SiteBase="@HcLayout.Base" SiteName="@HcSeedData.ProductName" ReturnUrl="@ReturnUrl"
                    RegisterRoleId="@HcSeedData.PatientRole" StartWithRegister="@(Mode == "register")" />
</div>

@code {
    /// <summary>Gets or sets <c>?mode=register</c>, which opens the register form.</summary>
    [SupplyParameterFromQuery(Name = "mode")] public string? Mode { get; set; }

    /// <summary>Gets or sets the page to return to after signing in; only a page inside the site is used.</summary>
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
}
