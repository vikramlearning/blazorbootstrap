@page "/showcase/healthcare/bills"
@layout HcLayout

<PageTitle>Bills · @HcSeedData.ProductName</PageTitle>

<div class="container-xl hc-bills">
    <ShowcaseRoleGuard Roles="@HcSeedData.PatientRole" SignInPath="@HcLayout.SignInPath">
        @{
            var all = All();
            var due = all.Where(bill => bill.Status == HcBillStatus.Due).OrderBy(bill => bill.DueDate).ToList();
            var paid = all.Where(bill => bill.Status == HcBillStatus.Paid).OrderByDescending(bill => bill.PaidAt).ToList();
            var today = State.Clock.Today;
            var overdue = due.Count(bill => IsOverdue(bill, today));
        }

        <h1 class="hc-title mb-1">Bills</h1>
        <p class="hc-lead mb-4">Bills for your visits and lab tests. Pay with a test card; only its brand and last four digits are kept.</p>

        <section class="hc-panel hc-bills-total mb-4" aria-labelledby="hc-bills-total-title">
            <span class="hc-icon flex-shrink-0" aria-hidden="true"><Icon Name="IconName.Receipt" /></span>
            <div>
                <h2 class="small fw-semibold text-body-secondary mb-0" id="hc-bills-total-title">Total due</h2>
                <p class="hc-bills-amount mb-0">@HcDisplay.Money(due.Sum(bill => bill.AmountCents))</p>
                <p class="small mb-0 @(overdue > 0 ? "fw-semibold text-danger-emphasis" : null)">
                    @if (overdue > 0)
                    {
                        <Icon Name="IconName.ExclamationTriangleFill" class="me-1" aria-hidden="true" />
                    }
                    @DueSummary(due.Count, overdue)
                </p>
            </div>
        </section>

        @* Always rendered and focusable: a payment is announced here, and focus lands here once its form is gone. *@
        <div class="hc-bills-status" role="status" tabindex="-1" @ref="statusRegion">
            @if (statusMessage is not null)
            {
                <div class="alert @(statusIsError ? "alert-danger" : "alert-success") mb-4">
                    <Icon Name="@(statusIsError ? IconName.ExclamationTriangleFill : IconName.CheckCircleFill)" class="me-2" aria-hidden="true" />@statusMessage
                </div>
            }
        </div>

        <section class="mb-5" aria-labelledby="hc-bills-due-title">
            <h2 class="hc-section-title" id="hc-bills-due-title">To pay (@due.Count)</h2>
            @if (due.Count == 0)
            {
                <div class="hc-panel">
                    <p class="mb-0">You have no bills to pay.</p>
                </div>
            }
            else
            {
                <ul class="list-unstyled d-grid gap-3 mb-0">
                    @foreach (var bill in due)
                    {
                        var billId = bill.Id;
                        var isOverdue = IsOverdue(bill, today);
                        var amount = HcDisplay.Money(bill.AmountCents);
                        var titleId = $"hc-bills-{bill.Id}-title";
                        var panelId = $"hc-bills-pay-{bill.Id}";
                        var paying = payingId == bill.Id;

                        <li @key="@($"due-{bill.Id}")">
                            <article class="hc-card hc-bills-card" aria-labelledby="@titleId">
                                <div class="hc-bills-row">
                                    <div class="hc-bills-text">
                                        <h3 class="h6 fw-bold mb-1" id="@titleId">@bill.Description</h3>
                                        <p class="small text-body-secondary mb-1">Issued @HcDisplay.Date(bill.CreatedAt) · due by @HcDisplay.Date(bill.DueDate)</p>
                                        @if (isOverdue)
                                        {
                                            <p class="small fw-semibold text-danger-emphasis mb-1"><Icon Name="IconName.ExclamationTriangleFill" class="me-1" aria-hidden="true" />Overdue: it was due by @HcDisplay.Date(bill.DueDate).</p>
                                        }
                                        @if (bill.AppointmentId is { } visitId)
                                        {
                                            <a class="small" href="@HcDisplay.AppointmentUrl(visitId)">See the visit<span class="visually-hidden">: @bill.Description</span></a>
                                        }
                                        else if (bill.LabOrderId is { } labId)
                                        {
                                            <a class="small" href="@HcDisplay.LabUrl(labId)">See the lab report<span class="visually-hidden">: @bill.Description</span></a>
                                        }
                                    </div>
                                    <div class="hc-bills-pay">
                                        <span class="hc-bills-amount-sm">@amount</span>
                                        @if (!paying)
                                        {
                                            <button type="button" class="btn btn-primary btn-sm" @ref="payButtons[billId]" @onclick="() => OpenPay(billId)">
                                                Pay @amount<span class="visually-hidden">: @bill.Description</span>
                                            </button>
                                        }
                                    </div>
                                </div>

                                @if (paying)
                                {
                                    <div class="hc-bills-form mt-3" id="@panelId">
                                        <h4 class="h6 fw-bold" id="hc-bills-pay-title" tabindex="-1" @ref="payHeading">Pay @amount for @bill.Description</h4>
                                        <ShowcaseDemoNotice Class="mb-3" Text="Demo only: use one of the listed test cards; real cards are never accepted and nothing is really charged. Only the card's brand and last four digits are kept." />
                                        <EditForm EditContext="payContext" OnSubmit="Pay" FormName="hc-bills-pay" aria-labelledby="hc-bills-pay-title" novalidate>
                                            <ShowcaseFormErrors FocusFirstInvalid="false" />
                                            @* Only the published test cards pass (D-026). *@
                                            <div id="hc-bills-card-fields">
                                                <ShowcaseCardForm Card="card" Today="State.Clock.Today" IdPrefix="hc-pay" />
                                            </div>
                                            <div class="text-danger-emphasis fw-semibold mt-3" role="alert">
                                                @if (payError is not null)
                                                {
                                                    <Icon Name="IconName.ExclamationTriangleFill" class="me-2" aria-hidden="true" />@payError
                                                }
                                            </div>
                                            <div class="d-flex flex-wrap gap-2 mt-3">
                                                <Button Type="ButtonType.Submit" Color="ButtonColor.Primary">Pay @amount</Button>
                                                <Button Color="ButtonColor.Secondary" Outline="true" @onclick="CancelPay">Cancel</Button>
                                            </div>
                                        </EditForm>
                                    </div>
                                }
                            </article>
                        </li>
                    }
                </ul>
            }
        </section>

        <section aria-labelledby="hc-bills-paid-title">
            <h2 class="hc-section-title" id="hc-bills-paid-title">Paid (@paid.Count)</h2>
            @if (paid.Count == 0)
            {
                <div class="hc-panel">
                    <p class="mb-0">No paid bills yet.</p>
                </div>
            }
            else
            {
                <div class="hc-panel">
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <caption class="visually-hidden">Paid bills, newest payment first</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Bill</th>
                                    <th scope="col" class="text-end">Amount</th>
                                    <th scope="col">Paid on</th>
                                    <th scope="col">Paid with</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bill in paid)
                                {
                                    <tr @key="@($"paid-{bill.Id}")">
                                        <th scope="row" class="fw-normal hc-bills-desc">@bill.Description</th>
                                        <td class="text-end text-nowrap">@HcDisplay.Money(bill.AmountCents)</td>
                                        <td class="text-nowrap">@HcDisplay.Date(bill.PaidAt ?? bill.CreatedAt)</td>
                                        <td class="text-nowrap">@CardText(bill)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </section>
    </ShowcaseRoleGuard>
</div>
