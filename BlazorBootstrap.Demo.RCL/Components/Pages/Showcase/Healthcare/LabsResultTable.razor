@* A lab order's entered values: one row per analyte with the value, the reference range, and the flag in words (an arrow
   and color only repeat it), then the comment for the patient. *@
@if (Order.Values.Count != Panel.Analytes.Count)
{
    <p class="text-body-secondary mb-0">No results entered yet.</p>
}
else
{
    @* The host is rendered by this component, so its scoped caption style reaches the caption that Table renders. *@
    <div class="hc-lrt">
        <Table Data="@(Panel.Analytes.Select((analyte, index) => (Index: index, Analyte: analyte, Value: Order.Values[index], Flag: HcState.Flag(analyte, Order.Values[index]))))"
               Class="table-sm align-middle mb-2 hc-lrt-table" Responsive="true" RowKeySelector="@(row => $"row-{row.Index}")" Caption="@Caption">
            <TableColumn HeaderText="Test" IsRowHeader="true" ColumnClass="@(_ => "fw-normal")" Context="row">@row.Analyte.Name</TableColumn>
            <TableColumn HeaderText="Result" ColumnClass="@(_ => "text-nowrap fw-semibold")" Context="row">@HcDisplay.Number(row.Value) @row.Analyte.Unit</TableColumn>
            <TableColumn HeaderText="Reference range" ColumnClass="@(_ => "text-nowrap")" Context="row">@Labs.RangeText(row.Analyte)</TableColumn>
            <TableColumn HeaderText="Flag" ColumnClass="@(row => row.Flag == "Normal" ? "text-nowrap" : "text-nowrap fw-semibold text-danger-emphasis")" Context="row">
                @if (row.Flag == "High")
                {
                    <Icon Name="IconName.ArrowUp" class="me-1" aria-hidden="true" />
                }
                else if (row.Flag == "Low")
                {
                    <Icon Name="IconName.ArrowDown" class="me-1" aria-hidden="true" />
                }
                @row.Flag
            </TableColumn>
        </Table>
    </div>
    @if (Order.Comment.Length > 0)
    {
        <p class="small fw-semibold mb-1">Comment for the patient</p>
        <p class="hc-plain mb-0">@Order.Comment</p>
    }
}
