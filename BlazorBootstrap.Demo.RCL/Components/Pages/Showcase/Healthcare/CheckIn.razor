@page "/showcase/healthcare/staff/check-in"
@layout HcStaffLayout
@implements IDisposable

<PageTitle>Check-in · @HcSeedData.ProductName</PageTitle>

<ShowcaseRoleGuard Roles="@HcSeedData.FrontDeskRole" SignInPath="@HcLayout.SignInPath">
    @{
        var today = State.Clock.Today;
        var all = TodayAppointments();
    }

    <div class="container-fluid px-lg-4">
        <h1 class="hc-title mb-1">Check-in</h1>
        <p class="hc-lead mb-3">
            Today's arrivals at every clinic, @HcDisplay.DayLong(today). Check patients in as they arrive: they go to the waiting room, and the doctor sees them as
            “Checked in” right away. Select several to check them in, or mark those who didn't come as no-shows, together.
        </p>

        <ul class="hc-ci-counts list-unstyled" aria-label="Today's appointments by status">
            @foreach (var count in Counts(all))
            {
                <li class="hc-ci-count" @key="count.Label">
                    <span class="hc-ci-count-number">@count.Number</span>
                    <span class="hc-ci-count-label">@count.Label</span>
                </li>
            }
        </ul>

        <section class="hc-panel mb-3" aria-labelledby="hc-ci-filters-title">
            <h2 class="hc-section-title" id="hc-ci-filters-title">Filter today's arrivals</h2>
            <div class="hc-list-filters" role="search" aria-labelledby="hc-ci-filters-title">
                <div class="hc-list-search">
                    <label class="form-label small fw-semibold" for="hc-ci-search">Patient</label>
                    @* Filters on every keystroke; the bound value changes only on change, so a render during typing never writes an older value back. *@
                    <input id="hc-ci-search" type="search" class="form-control" autocomplete="off" maxlength="60" value="@searchBoxValue" placeholder="Name or record number"
                           @oninput="OnSearchInputAsync" @onchange="OnSearchChanged" />
                </div>
                <div>
                    <label class="form-label small fw-semibold" for="hc-ci-clinic">Clinic</label>
                    <select id="hc-ci-clinic" class="form-select" value="@clinicFilter" @onchange="OnClinicChangedAsync">
                        <option value="">All clinics (@all.Count)</option>
                        @foreach (var clinic in State.Clinics)
                        {
                            <option value="@clinic.Id" @key="clinic.Id">@clinic.Name (@all.Count(item => item.ClinicId == clinic.Id))</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label small fw-semibold" for="hc-ci-state">Status</label>
                    <select id="hc-ci-state" class="form-select" value="@statusFilter" @onchange="OnStatusFilterChangedAsync">
                        <option value="">Every status</option>
                        <option value="@WaitingFilter">Not arrived yet (@all.Count(item => item.Status == HcAppointmentStatus.Booked))</option>
                        <option value="@HereFilter">In the waiting room (@all.Count(item => item.Status == HcAppointmentStatus.CheckedIn))</option>
                        <option value="@SeenFilter">With the doctor or done (@all.Count(item => item.Status is HcAppointmentStatus.InVisit or HcAppointmentStatus.Completed))</option>
                        <option value="@ClosedFilter">No-show or cancelled (@all.Count(item => item.Status is HcAppointmentStatus.NoShow or HcAppointmentStatus.Cancelled))</option>
                    </select>
                </div>
            </div>
            <div class="hc-list-meta">
                <p class="small text-body-secondary mb-0" aria-live="polite" tabindex="-1" @ref="countRegion">@SummaryText(Shown.Count, all.Count)</p>
                @if (IsFiltered)
                {
                    <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ClearFiltersAsync">Show every arrival</Button>
                }
                @* Back to the saved view's defaults: by time, 25 a page, every column in its place. *@
                <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ResetViewAsync">Reset view</Button>
            </div>
        </section>

        @* Always rendered and focusable, so every check-in and no-show is announced and focus has somewhere to go when the pressed button disappears. *@
        <p class="hc-list-status mb-2 @(statusIsError ? "text-danger-emphasis" : null)" role="status" tabindex="-1" @ref="statusRegion">@statusMessage</p>

        @if (selected.Count > 0)
        {
            var arriving = selected.Count(row => row.StatusValue == HcAppointmentStatus.Booked);
            var late = selected.Count(row => row.CanNoShow);

            <section class="hc-bulk" aria-labelledby="hc-ci-bulk-count">
                <h2 class="hc-bulk-count" id="hc-ci-bulk-count">
                    @(selected.Count == 1 ? "1 appointment selected" : $"{selected.Count} appointments selected"): @arriving not arrived yet, @late past their time
                </h2>
                <div class="hc-bulk-actions">
                    <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" Disabled="@(arriving == 0)" @onclick="BulkCheckInAsync">
                        <Icon Name="IconName.PersonCheck" class="me-1" aria-hidden="true" />Check in<span class="visually-hidden">&#32;the selected patients</span>
                    </Button>
                    <Button Color="ButtonColor.Danger" Outline="true" Size="ButtonSize.Small" Disabled="@(late == 0)" @onclick="AskBulkNoShowAsync">
                        <Icon Name="IconName.PersonX" class="me-1" aria-hidden="true" />Mark as no-shows…<span class="visually-hidden">&#32;the selected patients past their time</span>
                    </Button>
                    <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="ClearSelectionAsync">Clear selection</Button>
                </div>
                <p class="form-text w-100 mb-0">Only patients not checked in yet change; no-shows only for appointments whose time has passed. Each doctor sees their patients arrive.</p>
            </section>
        }

        <section class="hc-panel" aria-label="Today's arrivals">
            <ShowcaseDataState Status="@(viewLoaded ? ShowcaseDataStatus.Ready : ShowcaseDataStatus.Loading)"
                               IsEmpty="@(all.Count == 0)"
                               EmptyIcon="IconName.CalendarCheck"
                               EmptyTitle="No appointments today"
                               EmptyText="Nobody is booked at any clinic today. Open the calendar to see another day."
                               LoadingText="Loading today's arrivals…"
                               OnRetry="RefreshGridAsync">
                <EmptyActions>
                    <a class="btn btn-primary btn-sm" href="@($"{HcStaffLayout.Base}/calendar")">Open the calendar</a>
                </EmptyActions>
                <ChildContent>
                    <Grid @ref="grid"
                          @key="gridVersion"
                          TItem="ArrivalRow"
                          Class="table table-hover align-middle hc-table-wide sc-grid-row-links"
                          GridContainerClass="hc-grid border rounded-3"
                          DataProvider="ProvideArrivalsAsync"
                          SettingsProvider="view.GetSettingsAsync"
                          GridSettingsChanged="SaveSettingsAsync"
                          AllowPaging="true"
                          PageSize="@pageSize"
                          PageSizeSelectorVisible="true"
                          PageSizeSelectorItems="@(new[] { 10, 25, 50 })"
                          PaginationItemsTextFormat="{0}–{1} of {2} appointments"
                          AllowSorting="true"
                          AllowSelection="true"
                          SelectionMode="GridSelectionMode.Multiple"
                          RowSelectionLabel="@(row => $"Select {row.Patient} at {row.Time} with {row.Doctor}")"
                          SelectAllRowsText="Select all shown appointments"
                          SelectedItemsChanged="OnSelectionChanged"
                          RowClass="RowClass"
                          AllowColumnChooser="true"
                          AllowExport="true"
                          ExportFileName="clinic-check-in"
                          Responsive="true"
                          EmptyText="No arrivals match. Clear the search, or choose another clinic or status."
                          aria-label="Today's arrivals">
                        <GridColumns>
                            <GridColumn TItem="ArrivalRow" HeaderText="Time" PropertyName="Time" SortString="time" SortKeySelector="row => row.Start"
                                        IsDefaultSortColumn="@view.IsSortColumn("time")" SortDirection="@view.DirectionFor("time")" TextNoWrap="true">
                                <span class="hc-mono">@context.Time</span>
                            </GridColumn>
                            <GridColumn TItem="ArrivalRow" HeaderText="Patient" PropertyName="Patient" SortString="patient" SortKeySelector="row => row.Patient"
                                        IsDefaultSortColumn="@view.IsSortColumn("patient")" SortDirection="@view.DirectionFor("patient")" AlwaysVisible="true">
                                @{
                                    var row = context;
                                }
                                @* No page of its own for the front desk: the stretched button makes the whole row open the arrival's dialog. *@
                                <button type="button" class="hc-row-button stretched-link" @ref="openers[row.Id]" @onclick="() => OpenAsync(row.Id)">@row.Patient</button>
                            </GridColumn>
                            <GridColumn TItem="ArrivalRow" HeaderText="Record number" PropertyName="Mrn" SortString="mrn" SortKeySelector="row => row.Mrn"
                                        IsDefaultSortColumn="@view.IsSortColumn("mrn")" SortDirection="@view.DirectionFor("mrn")" TextNoWrap="true">
                                <span class="hc-mono">@context.Mrn</span>
                            </GridColumn>
                            <GridColumn TItem="ArrivalRow" HeaderText="Doctor" PropertyName="Doctor" SortString="doctor" SortKeySelector="row => row.Doctor"
                                        IsDefaultSortColumn="@view.IsSortColumn("doctor")" SortDirection="@view.DirectionFor("doctor")">
                                @context.Doctor
                            </GridColumn>
                            <GridColumn TItem="ArrivalRow" HeaderText="Clinic" PropertyName="Clinic" SortString="clinic" SortKeySelector="row => row.Clinic"
                                        IsDefaultSortColumn="@view.IsSortColumn("clinic")" SortDirection="@view.DirectionFor("clinic")">
                                @context.Clinic
                            </GridColumn>
                            <GridColumn TItem="ArrivalRow" HeaderText="Reason" PropertyName="Reason" SortString="reason" SortKeySelector="row => row.Reason"
                                        IsDefaultSortColumn="@view.IsSortColumn("reason")" SortDirection="@view.DirectionFor("reason")">
                                <span class="hc-wrap">@context.Reason</span>
                            </GridColumn>
                            <GridColumn TItem="ArrivalRow" HeaderText="Visit" PropertyName="VisitType" SortString="type" SortKeySelector="row => row.VisitType"
                                        IsDefaultSortColumn="@view.IsSortColumn("type")" SortDirection="@view.DirectionFor("type")">
                                @context.VisitType
                            </GridColumn>
                            <GridColumn TItem="ArrivalRow" HeaderText="Status" PropertyName="StatusText" SortString="status" SortKeySelector="row => row.StatusValue"
                                        IsDefaultSortColumn="@view.IsSortColumn("status")" SortDirection="@view.DirectionFor("status")">
                                <span class="badge text-bg-@HcDisplay.StatusColor(context.StatusValue)">@context.Status</span>
                                @if (context.Note.Length > 0)
                                {
                                    <span class="d-block small text-body-secondary">@context.Note</span>
                                }
                                @if (context.Warning.Length > 0)
                                {
                                    <span class="d-block small fw-semibold text-warning-emphasis"><Icon Name="IconName.ExclamationTriangleFill" class="me-1" aria-hidden="true" />@context.Warning</span>
                                }
                            </GridColumn>
                            <GridColumn TItem="ArrivalRow" HeaderText="Action" Sortable="false" Exportable="false" TextNoWrap="true">
                                @{
                                    var row = context;
                                }
                                <div class="d-flex flex-wrap gap-2 justify-content-end">
                                    @if (row.StatusValue == HcAppointmentStatus.Booked)
                                    {
                                        <button type="button" class="btn btn-sm btn-primary" @onclick="() => CheckInOne(row.Id)">
                                            Check in<span class="visually-hidden">&#32;@row.Patient for @row.Time with @row.Doctor</span>
                                        </button>
                                    }
                                    @if (row.CanNoShow)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => AskNoShowAsync(new[] { row.Id })">
                                            No-show<span class="visually-hidden">: @row.Patient at @row.Time</span>
                                        </button>
                                    }
                                </div>
                            </GridColumn>
                        </GridColumns>
                    </Grid>
                </ChildContent>
            </ShowcaseDataState>
        </section>

        <p class="small mt-3 mb-0">To cancel an appointment or see another day, use the <a href="@($"{HcStaffLayout.Base}/calendar")">calendar</a>.</p>
    </div>

    <Modal @ref="detailsModal" IsVerticallyCentered="true" ShowCloseButton="false" aria-labelledby="hc-ci-details-title" OnShown="OnDetailsShownAsync" OnHidden="OnDetailsHidden">
        <HeaderTemplate>
            <h2 class="modal-title h5 hc-wrap" id="hc-ci-details-title">@(Opened is { } shown ? $"{PatientName(shown.PatientId)} at {HcDisplay.Time(shown.Start)}" : "Appointment")</h2>
        </HeaderTemplate>
        <BodyTemplate>
            @if (Opened is not { } appointment)
            {
                <p class="mb-0">This appointment isn't on today's list any more.</p>
            }
            else
            {
                var patient = State.FindPatient(appointment.PatientId);

                <dl class="hc-ci-facts mb-0">
                    <div><dt>Appointment</dt><dd>@appointment.Id.ToString(CultureInfo.InvariantCulture), @HcDisplay.VisitTypeText(appointment.VisitType)</dd></div>
                    <div><dt>Status</dt><dd>@HcDisplay.StatusLabel(appointment.Status)@(appointment.CheckedInAt is { } arrived ? $", arrived {HcDisplay.Time(arrived)}" : null)</dd></div>
                    <div><dt>Doctor</dt><dd>@(State.FindDoctor(appointment.DoctorId)?.Name) at @(State.FindClinic(appointment.ClinicId)?.Name)</dd></div>
                    <div><dt>Reason</dt><dd class="hc-plain">@appointment.Reason</dd></div>
                    <div><dt>Record number</dt><dd class="hc-mono">@(patient?.Mrn)</dd></div>
                    <div><dt>Phone</dt><dd>@(patient?.Phone is { Length: > 0 } phone ? phone : "Not on file")</dd></div>
                    <div><dt>Health plan</dt><dd>@(State.FindPayer(patient?.InsurancePayerId)?.Name ?? "Self-pay")</dd></div>
                </dl>
                @if (patient is not null)
                {
                    <p class="small mt-3 mb-0"><a href="@HcDisplay.PatientDetailsUrl(patient.Id)">Check or update @patient.Name's details</a></p>
                }
            }
        </BodyTemplate>
        <FooterTemplate>
            @if (Opened is { Status: HcAppointmentStatus.Booked } booked)
            {
                <Button Color="ButtonColor.Primary" @onclick="() => CheckInFromDialogAsync(booked.Id)">Check in</Button>
            }
            <button type="button" class="btn btn-outline-secondary" @ref="detailsClose" @onclick="() => detailsModal.HideAsync()">Close</button>
        </FooterTemplate>
    </Modal>

    <Modal @ref="noShowModal" IsVerticallyCentered="true" ShowCloseButton="false" aria-labelledby="hc-ci-dialog-title"
           OnShown="OnNoShowShownAsync" OnHidden="OnNoShowHidden">
        <HeaderTemplate>
            <h2 class="modal-title h5 hc-wrap" id="hc-ci-dialog-title">
                @(noShowIds.Count == 1 && State.FindAppointment(noShowIds[0]) is { } single ? $"Mark {PatientName(single.PatientId)} as a no-show?" : $"Mark {noShowIds.Count} patients as no-shows?")
            </h2>
        </HeaderTemplate>
        <BodyTemplate>
            <p class="mb-0">
                @(noShowIds.Count == 1 ? "The appointment closes" : "Their appointments close") as a no-show and can't be checked in afterwards. If someone turns up later,
                book them a new time.
            </p>
        </BodyTemplate>
        <FooterTemplate>
            <button type="button" class="btn btn-outline-secondary" @ref="dialogDismiss" @onclick="() => noShowModal.HideAsync()">Go back</button>
            <button type="button" class="btn btn-danger" @onclick="ConfirmNoShowAsync" disabled="@pendingNoShow">Mark as no-show@(noShowIds.Count == 1 ? null : "s")</button>
        </FooterTemplate>
    </Modal>
</ShowcaseRoleGuard>
