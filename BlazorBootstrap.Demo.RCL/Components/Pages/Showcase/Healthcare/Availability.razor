@page "/showcase/healthcare/staff/availability"
@layout HcStaffLayout
@implements IDisposable

<PageTitle>Doctors' hours · @HcSeedData.ProductName</PageTitle>

<ShowcaseRoleGuard Roles="@HcSeedData.FrontDeskRole" SignInPath="@HcLayout.SignInPath">
    @{
        var doctor = Doctor;
        var shortName = DoctorProfile.ShortName(doctor);
        var blocks = State.AvailabilityOf(doctor.Id);
        var timeOff = State.TimeOffOf(doctor.Id);
        var rebook = OutsideAppointments(doctor.Id);
        var names = PatientNames();
        var today = State.Clock.Today;
        var freeDays = DoctorProfile.Week.Where(day => blocks.All(block => block.Day != day)).Select(day => day.ToString()).ToList();
    }

    <div class="container-fluid px-lg-4">
        <h1 class="hc-title mb-1">Doctors' hours</h1>
        <p class="hc-lead mb-3">
            Weekly hours decide when patients can book, and time off closes whole days. Appointments already booked stay booked
            when hours change, so the list of appointments to rebook shows who to call.
        </p>

        @* Always rendered and focusable, so an outcome is announced and focus has somewhere to go once a dialog closes. *@
        <p class="fw-semibold hc-av-status @(statusIsError ? "text-danger-emphasis" : null)" role="status" tabindex="-1" @ref="statusRegion">@statusMessage</p>

        <div class="hc-panel mb-4 hc-av-doctor">
            <div class="hc-av-doctor-field">
                <label class="form-label fw-semibold" for="hc-av-doctor">Doctor</label>
                <select id="hc-av-doctor" class="form-select" value="@doctor.Id" @onchange="OnDoctorChanged" aria-describedby="hc-av-doctor-help">
                    @foreach (var item in State.Doctors)
                    {
                        <option value="@item.Id">@item.Name</option>
                    }
                </select>
            </div>
            <p class="small text-body-secondary mb-0" id="hc-av-doctor-help">
                @doctor.Specialty, based at @(State.FindClinic(doctor.ClinicId)?.Name).
                @(doctor.AcceptingNewPatients ? "Accepting new patients." : "Not accepting new patients.")
                <a href="@HcDisplay.DoctorUrl(doctor.Id)">Public profile</a>
            </p>
        </div>

        <section class="mb-5" aria-labelledby="hc-av-rebook-title">
            <h2 class="hc-section-title" id="hc-av-rebook-title">Booked appointments to rebook <span class="hc-av-count">(@rebook.Count)</span></h2>
            @if (rebook.Count == 0)
            {
                <div class="hc-panel">
                    <p class="mb-0">
                        <Icon Name="IconName.CheckCircle" class="me-1 text-success-emphasis" aria-hidden="true" />
                        No booked appointments fall outside @(shortName)'s hours or time off.
                    </p>
                </div>
            }
            else
            {
                <p class="hc-av-warn">
                    <Icon Name="IconName.ExclamationTriangleFill" class="me-2 flex-shrink-0" aria-hidden="true" />
                    <span>
                        @(rebook.Count == 1 ? "This booked appointment is" : $"These {rebook.Count} booked appointments are") outside @(shortName)'s hours or in their
                        time off. Patients can't book those times any more. Call each patient to rebook, then cancel the old appointment on the
                        <a href="@($"{HcStaffLayout.Base}/calendar?doctor={Uri.EscapeDataString(doctor.Id)}")">calendar</a>.
                    </span>
                </p>
                <div class="hc-panel p-0">
                    <Table Data="rebook" Class="table-sm align-middle mb-0 hc-av-table" Responsive="true" RowKeySelector="appointment => appointment.Id"
                           Caption="@($"Booked appointments with {doctor.Name} to rebook")" VisuallyHiddenCaption="true">
                        <TableColumn HeaderText="When" ColumnClass="@(_ => "text-nowrap")" Context="appointment">@HcDisplay.When(appointment.Start)</TableColumn>
                        <TableColumn HeaderText="Patient" IsRowHeader="true" Context="appointment">@(names.TryGetValue(appointment.PatientId, out var patientName) ? patientName : "Unknown patient")</TableColumn>
                        <TableColumn HeaderText="Phone" ColumnClass="@(_ => "text-nowrap")" Context="appointment">@(State.FindPatient(appointment.PatientId)?.Phone is { Length: > 0 } phone ? phone : "Not on file")</TableColumn>
                        <TableColumn HeaderText="Why" Context="appointment">@WhyText(appointment)</TableColumn>
                        <TableColumn HeaderText="What to do" Context="appointment">Call to rebook</TableColumn>
                    </Table>
                </div>
            }
        </section>

        <div class="row g-4">
            <section class="col-xl-7" aria-labelledby="hc-av-hours-title">
                <h2 class="hc-section-title" id="hc-av-hours-title">Weekly hours</h2>
                <div class="hc-panel mb-3">
                    @if (blocks.Count == 0)
                    {
                        <p class="mb-0 text-body-secondary">@shortName has no weekly hours, so patients can't book any times. Add hours below.</p>
                    }
                    else
                    {
                        <Table Data="blocks" Class="table-sm align-middle mb-0 hc-av-table" Responsive="true" RowKeySelector="block => block.Id"
                               RowClass="@(block => editingBlockId == block.Id ? "hc-av-editing" : "")"
                               Caption="@($"{doctor.Name}'s weekly hours")" VisuallyHiddenCaption="true">
                            <TableColumn HeaderText="Day" IsRowHeader="true" Context="block">@block.Day</TableColumn>
                            <TableColumn HeaderText="Hours" ColumnClass="@(_ => "hc-mono text-nowrap")" Context="block">@DoctorProfile.BlockText(block)</TableColumn>
                            <TableColumn HeaderText="Clinic" Context="block">@(State.FindClinic(block.ClinicId)?.Name)</TableColumn>
                            <TableColumn Context="block">
                                <HeaderContent><span class="visually-hidden">Actions</span></HeaderContent>
                                <ChildContent>
                                    @{
                                        var label = BlockLabel(block);
                                        var editKey = $"hours-edit-{block.Id}";
                                        var deleteKey = $"hours-delete-{block.Id}";
                                    }
                                    <div class="d-flex flex-wrap justify-content-end gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-primary" @ref="openers[editKey]" @onclick="() => EditBlock(block)">
                                            Edit<span class="visually-hidden">&#32;@label</span>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" @ref="openers[deleteKey]" @onclick="() => AskDeleteBlockAsync(block, deleteKey)">
                                            Delete<span class="visually-hidden">&#32;@label</span>
                                        </button>
                                    </div>
                                </ChildContent>
                            </TableColumn>
                        </Table>
                        @if (freeDays.Count > 0)
                        {
                            <p class="small text-body-secondary mt-2 mb-0">No hours on @DoctorProfile.JoinAnd(freeDays).</p>
                        }
                    }
                </div>

                <div class="hc-panel">
                    <h3 class="hc-av-form-title" id="hc-av-hours-form-title" tabindex="-1" @ref="hoursFormHeading">@(editingBlockId == 0 ? "Add hours" : $"Edit {editingBlockLabel}")</h3>
                    <EditForm EditContext="hoursContext" OnSubmit="SaveHours" FormName="hc-hours" novalidate aria-labelledby="hc-av-hours-form-title">
                        <DataAnnotationsValidator />
                        <ShowcaseFormErrors ShowSummary="true" />
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold" for="hc-av-day">Day</label>
                                <InputSelect id="hc-av-day" class="form-select" @bind-Value="hoursForm.Day">
                                    @foreach (var day in DoctorProfile.Week)
                                    {
                                        <option value="@day">@day</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => hoursForm.Day" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold" for="hc-av-clinic">Clinic</label>
                                <InputSelect id="hc-av-clinic" class="form-select" @bind-Value="hoursForm.ClinicId" aria-describedby="hc-av-clinic-help">
                                    <option value="">Choose a clinic</option>
                                    @foreach (var clinic in State.Clinics)
                                    {
                                        <option value="@clinic.Id">@clinic.Name</option>
                                    }
                                </InputSelect>
                                <div class="form-text" id="hc-av-clinic-help">@(State.FindClinic(hoursForm.ClinicId) is { } open ? $"Open {open.Hours}." : "Where the doctor sees patients in these hours.")</div>
                                <ValidationMessage For="() => hoursForm.ClinicId" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold" for="hc-av-start">Start</label>
                                <InputSelect TValue="int" id="hc-av-start" class="form-select" @bind-Value="hoursForm.StartMinute" aria-describedby="hc-av-times-help">
                                    @for (var minute = HcState.DayStartMinute; minute < HcState.DayEndMinute; minute += HcState.SlotMinutes)
                                    {
                                        <option value="@minute">@HcDisplay.Minutes(minute)</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => hoursForm.StartMinute" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold" for="hc-av-end">End</label>
                                <InputSelect TValue="int" id="hc-av-end" class="form-select" @bind-Value="hoursForm.EndMinute" aria-describedby="hc-av-times-help">
                                    @for (var minute = HcState.DayStartMinute + HcState.SlotMinutes; minute <= HcState.DayEndMinute; minute += HcState.SlotMinutes)
                                    {
                                        <option value="@minute">@HcDisplay.Minutes(minute)</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => hoursForm.EndMinute" />
                            </div>
                        </div>
                        <p class="form-text mb-2" id="hc-av-times-help">
                            Whole or half hours on a weekday, within the clinic's opening hours, in @HcState.SlotMinutes-minute appointments (a new patient visit takes two). Blocks
                            on the same day can't overlap.
                        </p>
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <button type="submit" class="btn btn-primary">@(editingBlockId == 0 ? "Add hours" : "Save changes")</button>
                            @if (editingBlockId != 0)
                            {
                                <button type="button" class="btn btn-outline-secondary" @onclick="StopEditingBlock">Stop editing</button>
                            }
                        </div>
                    </EditForm>
                </div>
            </section>

            <section class="col-xl-5" aria-labelledby="hc-av-off-title">
                <h2 class="hc-section-title" id="hc-av-off-title">Time off</h2>
                <div class="hc-panel mb-3">
                    @if (timeOff.Count == 0)
                    {
                        <p class="mb-0 text-body-secondary">No time off planned for @shortName.</p>
                    }
                    else
                    {
                        <Table Data="timeOff" Class="table-sm align-middle mb-0 hc-av-table" Responsive="true" RowKeySelector="entry => entry.Id"
                               RowClass="@(entry => editingOffId == entry.Id ? "hc-av-editing" : "")"
                               Caption="@($"{doctor.Name}'s time off")" VisuallyHiddenCaption="true">
                            <TableColumn HeaderText="Days" IsRowHeader="true" Context="entry">
                                <span class="text-nowrap">@DoctorProfile.AwayText(entry)</span>
                                <span class="d-block small fw-normal text-body-secondary">@TimeOffPhase(entry)</span>
                            </TableColumn>
                            <TableColumn HeaderText="Reason" ColumnClass="@(_ => "hc-plain")" Context="entry">@(entry.Reason.Length > 0 ? entry.Reason : "—")</TableColumn>
                            <TableColumn Context="entry">
                                <HeaderContent><span class="visually-hidden">Actions</span></HeaderContent>
                                <ChildContent>
                                    @{
                                        var dates = DoctorProfile.AwayText(entry);
                                        var editKey = $"off-edit-{entry.Id}";
                                        var deleteKey = $"off-delete-{entry.Id}";
                                    }
                                    <div class="d-flex flex-wrap justify-content-end gap-2">
                                        @if (entry.To >= today)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary" @ref="openers[editKey]" @onclick="() => EditTimeOff(entry)">
                                                Edit<span class="visually-hidden"> time off @dates</span>
                                            </button>
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-danger" @ref="openers[deleteKey]" @onclick="() => AskDeleteTimeOffAsync(entry, deleteKey)">
                                            Delete<span class="visually-hidden"> time off @dates</span>
                                        </button>
                                    </div>
                                </ChildContent>
                            </TableColumn>
                        </Table>
                    }
                </div>

                <div class="hc-panel">
                    <h3 class="hc-av-form-title" id="hc-av-off-form-title" tabindex="-1" @ref="offFormHeading">@(editingOffId == 0 ? "Add time off" : $"Edit time off {editingOffLabel}")</h3>
                    <EditForm EditContext="offContext" OnSubmit="SaveTimeOff" FormName="hc-time-off" novalidate aria-labelledby="hc-av-off-form-title">
                        <DataAnnotationsValidator />
                        <ShowcaseFormErrors ShowSummary="true" />
                        <div class="row g-3">
                            <div class="col-sm-6 col-xl-12 col-xxl-6">
                                <label class="form-label fw-semibold" for="hc-av-from">First day away</label>
                                <InputDate TValue="DateTime?" id="hc-av-from" class="form-control" @bind-Value="offForm.From" min="@QueryValue(today)"
                                           ParsingErrorMessage="Enter the first day away as a full date." />
                                <ValidationMessage For="() => offForm.From" />
                            </div>
                            <div class="col-sm-6 col-xl-12 col-xxl-6">
                                <label class="form-label fw-semibold" for="hc-av-to">Last day away</label>
                                <InputDate TValue="DateTime?" id="hc-av-to" class="form-control" @bind-Value="offForm.To" min="@QueryValue(offForm.From ?? today)"
                                           ParsingErrorMessage="Enter the last day away as a full date." aria-describedby="hc-av-to-help" />
                                <div class="form-text" id="hc-av-to-help">Whole days, up to @HcState.MaxTimeOffDays days, ending today or later.</div>
                                <ValidationMessage For="() => offForm.To" />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold" for="hc-av-reason">Reason (optional)</label>
                                <InputText id="hc-av-reason" class="form-control" maxlength="@HcState.MaxReasonLength" autocomplete="off" @bind-Value="offForm.Reason" aria-describedby="hc-av-reason-help" />
                                <div class="form-text" id="hc-av-reason-help">Staff only: patients see the dates, never the reason. @((offForm.Reason ?? string.Empty).Trim().Length) of @HcState.MaxReasonLength characters.</div>
                                <ValidationMessage For="() => offForm.Reason" />
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <button type="submit" class="btn btn-primary">@(editingOffId == 0 ? "Add time off" : "Save changes")</button>
                            @if (editingOffId != 0)
                            {
                                <button type="button" class="btn btn-outline-secondary" @onclick="StopEditingTimeOff">Stop editing</button>
                            }
                        </div>
                    </EditForm>
                </div>
            </section>
        </div>
    </div>

    <Modal @ref="deleteModal" IsVerticallyCentered="true" ShowCloseButton="false" aria-labelledby="hc-av-dialog-title"
           OnShown="OnDialogShownAsync" OnHidden="OnDialogHidden">
        <HeaderTemplate>
            <h2 class="modal-title h5" id="hc-av-dialog-title">@DialogTitle()</h2>
        </HeaderTemplate>
        <BodyTemplate>
            @if (deleteBlock is { } block)
            {
                <p class="mb-0">
                    Patients can no longer book @block.Day times from @DoctorProfile.BlockText(block) with @shortName. Appointments already booked
                    then stay booked and show up under “Booked appointments to rebook”, so you can call those patients.
                </p>
            }
            else if (deleteOff is { } entry)
            {
                <p class="mb-0">
                    @DoctorProfile.AwayText(entry) open for booking again in @(shortName)'s usual hours. The reason is deleted with it.
                </p>
            }
        </BodyTemplate>
        <FooterTemplate>
            <button type="button" class="btn btn-outline-secondary" @ref="dialogDismiss" @onclick="() => deleteModal.HideAsync()">Keep it</button>
            <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteAsync" disabled="@(pendingDelete is not null)">@(deleteBlock is not null ? "Delete these hours" : "Delete the time off")</button>
        </FooterTemplate>
    </Modal>
</ShowcaseRoleGuard>
