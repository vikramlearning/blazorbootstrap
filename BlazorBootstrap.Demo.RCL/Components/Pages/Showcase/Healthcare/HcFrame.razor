@using BlazorBootstrap.Demo.RCL.Services.Showcase

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&family=JetBrains+Mono:wght@400;600&display=swap" />
</HeadContent>

@* The frame both Cedarline layouts share: the patient portal and the staff back office (D-031). Its stylesheet styles the
   pages of both through ::deep. *@
<div class="sc-site sc-health">
    <ShowcaseSiteBar Site="@site" OnThemeChanged="OnThemeChanged" />

    @Header

    <div class="@(Sidebar is null ? null : "hc-shell")">
        @Sidebar

        <div class="@(Sidebar is null ? null : "hc-shell-main")">
            @* Pages show patients' names, health records, and bills, so the content is masked from session recording. *@
            <main class="sc-main hc-content" id="hc-main" data-clarity-mask="true">
                @ChildContent
            </main>

            <div class="@Container">
                <CarbonAds Class="sc-ad" />
            </div>

            <footer class="hc-footer">
                <div class="@Container d-flex flex-wrap justify-content-between gap-2">
                    <span>© 2026 @HcSeedData.ProductName (fictitious). Doctors, patients, and results are made up and stay in this browser tab. Nothing here is medical advice.</span>
                    <span class="d-none d-lg-inline">Built with Grid, PdfViewer, GoogleMap, Sidebar, Tabs, and Modal.</span>
                </div>
            </footer>
        </div>
    </div>
</div>

@code {
    private readonly ShowcaseSite site = ShowcaseCatalog.Get("healthcare");

    /// <summary>Gets or sets the page content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Gets or sets the header above the page (the portal's Navbar, or the staff top bar).</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    /// <summary>Gets or sets the sidebar beside the page (the staff back office), or <see langword="null" /> for none.</summary>
    [Parameter] public RenderFragment? Sidebar { get; set; }

    [Inject] private HcState State { get; set; } = default!;

    private string Container => Sidebar is null ? "container-xl" : "container-fluid px-lg-4";

    private void OnThemeChanged(string themeName) => State.SetTheme(themeName);
}
