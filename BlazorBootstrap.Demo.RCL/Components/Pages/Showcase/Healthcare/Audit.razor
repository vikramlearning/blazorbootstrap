@page "/showcase/healthcare/staff/audit"
@layout HcStaffLayout

<PageTitle>Audit log · @HcSeedData.ProductName</PageTitle>

@* Doctors, the front desk, and billing see it: the staff layout's guard keeps patients out, and the state shows the log to staff only.
   Patients see who looked at their own record under Records instead. *@
<div class="container-fluid px-lg-4">
    <div class="mb-3">
        <h1 class="hc-title mb-1">Audit log</h1>
        <p class="hc-lead mb-0">
            Who did what, and when, newest first: registrations and detail changes, bookings, check-ins, no-shows, and cancellations, visits started and
            completed, vitals and coding, lab orders and results, prescriptions and refill answers, insurance claims (created, submitted, corrected, appealed,
            answered, and closed), bills and payments, doctors' hours and time off, and every look at a patient's chart.
            Notes, results, and chart items are never copied here: entries name what changed, with lengths and counts only.
        </p>
    </div>

    <section class="hc-panel" aria-labelledby="hc-audit-title">
        <h2 class="visually-hidden" id="hc-audit-title">Entries</h2>
        <p class="small text-body-secondary mb-3">
            <Icon Name="IconName.Lock" class="me-1" aria-hidden="true" />Kept for this browser tab. Entries can't be changed or deleted.
        </p>
        <div class="hc-grid">
            <ShowcaseAuditLog ExportFileName="clinic-audit-log" AriaLabel="Audit log of the clinics" />
        </div>
    </section>
</div>
