@page "/showcase/healthcare/book/{DoctorId}"
@layout HcLayout

@if (Doctor is not { } doctor)
{
    <HcNotFound Message="We couldn't find that doctor. They may no longer work at our clinics, or the link is wrong." />
}
else
{
    <PageTitle>Book with @doctor.Name · @HcSeedData.ProductName</PageTitle>

    <div class="container-xl hc-book">
        <Breadcrumb Items="BreadcrumbItems" Class="mb-3" />

        <ShowcaseRoleGuard Roles="@HcSeedData.PatientRole" SignInPath="@HcLayout.SignInPath">
            @{
                var minutes = HcVisitTypes.MinutesOf(form.VisitType);
                var slot = ChosenSlot;
                var clinic = State.FindClinic(slot?.ClinicId ?? doctor.ClinicId);
                var upcoming = UpcomingCount;
                var closedToNew = !doctor.AcceptingNewPatients && !HasSeenDoctor;
            }

            <h1 class="hc-title mb-1">Book a visit with @doctor.Name</h1>
            <p class="hc-lead mb-4">
                Choose the kind of visit and an open time, tell @doctor.Name what it's for, and book. A first visit with a doctor is a new patient visit of
                @HcVisitTypes.NewPatientMinutes minutes; later visits take @HcVisitTypes.StandardMinutes.
            </p>

            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="hc-panel">
                        <ShowcaseDemoNotice Class="mb-4" Text="Demo only: booking is free, nothing is sent to a clinic, and the appointment stays in this browser tab. Nothing here is medical advice; in an emergency, call your local emergency number." />

                        @if (closedToNew)
                        {
                            <div class="alert alert-warning">
                                <p class="fw-semibold mb-1"><Icon Name="IconName.PersonX" class="me-2" aria-hidden="true" />@doctor.Name isn't taking new patients right now.</p>
                                <p class="small mb-0">Only patients @doctor.Name has seen before can book. <a class="alert-link" href="@($"{HcLayout.Base}/doctors")">Find another doctor</a>.</p>
                            </div>
                        }
                        else if (upcoming >= HcState.MaxUpcoming)
                        {
                            <div class="alert alert-warning">
                                <p class="fw-semibold mb-1"><Icon Name="IconName.CalendarX" class="me-2" aria-hidden="true" />You already have @HcState.MaxUpcoming upcoming appointments, the most you can hold.</p>
                                <p class="small mb-0">Cancel one, or book after a visit. <a class="alert-link" href="@($"{HcLayout.Base}/appointments")">See your appointments</a>.</p>
                            </div>
                        }

                        <EditForm EditContext="editContext" OnSubmit="SubmitAsync" FormName="hc-book" novalidate>
                            <DataAnnotationsValidator />
                            <ShowcaseFormErrors ShowSummary="true" />

                            <fieldset class="mb-4">
                                <legend class="hc-section-title mb-2">Kind of visit</legend>
                                <InputRadioGroup @bind-Value="form.VisitType">
                                    <div class="form-check">
                                        <InputRadio class="form-check-input" id="hc-book-type-new" Value="@HcVisitType.NewPatient" aria-describedby="hc-book-type-help" />
                                        <label class="form-check-label" for="hc-book-type-new">@HcDisplay.VisitTypeText(HcVisitType.NewPatient): my first visit with @doctor.Name</label>
                                    </div>
                                    <div class="form-check">
                                        <InputRadio class="form-check-input" id="hc-book-type-standard" Value="@HcVisitType.Standard" aria-describedby="hc-book-type-help" />
                                        <label class="form-check-label" for="hc-book-type-standard">@HcDisplay.VisitTypeText(HcVisitType.Standard): I've seen @doctor.Name before</label>
                                    </div>
                                </InputRadioGroup>
                                <div class="form-text" id="hc-book-type-help">@(HasSeenDoctor ? $"You've seen {doctor.Name} before." : $"You haven't seen {doctor.Name} yet.")</div>
                                <ValidationMessage For="() => form.VisitType" />
                            </fieldset>

                            <section aria-labelledby="hc-book-time-title" class="mb-4">
                                <h2 class="hc-section-title" id="hc-book-time-title" tabindex="-1" @ref="timeHeading">Your time</h2>
                                @if (slot is not null)
                                {
                                    <p class="hc-book-chosen mb-1">
                                        <Icon Name="IconName.CalendarCheck" class="me-2" aria-hidden="true" />@HcDisplay.DayLong(slot.Start) at @HcDisplay.Time(slot.Start)
                                    </p>
                                    <p class="small text-body-secondary mb-2">@minutes minutes at @(clinic?.Name)</p>
                                    <button type="button" class="btn btn-sm btn-outline-primary" aria-expanded="@(pickerOpen ? "true" : "false")" aria-controls="hc-book-picker" @onclick="TogglePicker">
                                        <Icon Name="IconName.Clock" class="me-1" aria-hidden="true" />@(pickerOpen ? "Keep this time" : "Change time")
                                    </button>
                                }
                                else if (form.Start is { } missing)
                                {
                                    <p class="text-warning-emphasis fw-semibold mb-0">
                                        <Icon Name="IconName.ExclamationTriangleFill" class="me-2" aria-hidden="true" />@HcDisplay.When(missing) isn't open for a @minutes-minute visit any more: someone may have just booked it, or it's too soon. Choose another time below.
                                    </p>
                                }
                                else
                                {
                                    <p class="mb-0">You haven't chosen a time yet. Choose a day, then a time below.</p>
                                }

                                @* Always rendered, so picking a time and the free-time check are announced. *@
                                <p class="small fw-semibold text-success-emphasis mt-2 mb-0" role="status">@(checkingTime ? "Checking the time is still free…" : timeMessage)</p>
                                <ValidationMessage For="() => form.Start" />

                                @if (slot is null || pickerOpen)
                                {
                                    <div class="mt-3" id="hc-book-picker">
                                        <SlotPicker DoctorId="@doctor.Id" Selected="slot?.Start" OnSelect="OnPick" IdPrefix="hc-book-sp" Minutes="minutes" />
                                    </div>
                                }
                            </section>

                            <div class="mb-3">
                                <label class="form-label fw-semibold" for="hc-book-reason">Reason for the visit</label>
                                <InputTextArea id="hc-book-reason" class="form-control" rows="3" maxlength="@HcState.MaxReasonLength" @bind-Value="form.Reason"
                                               aria-describedby="hc-book-reason-help hc-book-reason-count" />
                                <div class="d-flex flex-wrap justify-content-between column-gap-3">
                                    <div class="form-text" id="hc-book-reason-help">In a few words, like "Knee pain when climbing stairs". @doctor.Name reads it before the visit.</div>
                                    <div class="form-text" id="hc-book-reason-count">@((form.Reason ?? string.Empty).Trim().Length) of @HcState.MaxReasonLength characters</div>
                                </div>
                                <ValidationMessage For="() => form.Reason" />
                            </div>

                            <fieldset class="mb-3">
                                <legend class="form-label fw-semibold fs-6 mb-1">How you'll pay</legend>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold" for="hc-book-payer">Health plan</label>
                                        <InputSelect id="hc-book-payer" class="form-select" @bind-Value="form.PayerId" aria-describedby="hc-book-payer-help">
                                            <option value="">Self-pay (no health plan)</option>
                                            @foreach (var payer in State.Payers)
                                            {
                                                <option value="@payer.Id" @key="payer.Id">@payer.Name</option>
                                            }
                                        </InputSelect>
                                        <div class="form-text" id="hc-book-payer-help">From your record; a change here is saved to it.</div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold" for="hc-book-member">Member ID</label>
                                        <InputText id="hc-book-member" class="form-control hc-mono" @bind-Value="form.MemberId" maxlength="12" autocomplete="off" autocapitalize="characters" spellcheck="false"
                                                   disabled="@(form.PayerId.Length == 0)" aria-describedby="hc-book-member-help" />
                                        <div class="form-text" id="hc-book-member-help">@(State.FindPayer(form.PayerId) is { } chosenPayer ? $"{chosenPayer.MemberIdPrefix} and nine digits, as on your {chosenPayer.Name} card." : "Not needed for self-pay.")</div>
                                        <ValidationMessage For="() => form.MemberId" />
                                    </div>
                                </div>
                            </fieldset>

                            <div class="mt-3" role="alert">
                                @if (bookError is not null)
                                {
                                    <div class="alert alert-danger mb-0">
                                        <Icon Name="IconName.ExclamationTriangleFill" class="me-2" aria-hidden="true" />@bookError
                                        @if (conflictId is { } otherId)
                                        {
                                            <a class="alert-link ms-1" href="@HcDisplay.AppointmentUrl(otherId)">See that appointment</a>
                                        }
                                    </div>
                                }
                            </div>

                            <Button Type="ButtonType.Submit" Color="ButtonColor.Primary" Size="ButtonSize.Large" Class="w-100 mt-3" Disabled="@(booking || checkingTime)">
                                <Icon Name="IconName.CalendarPlus" class="me-2" aria-hidden="true" />Book appointment
                            </Button>
                            <p class="small text-body-secondary text-center mt-2 mb-0">You can reschedule or cancel online up to 2 hours before the visit.</p>
                        </EditForm>
                    </div>
                </div>

                <div class="col-lg-5">
                    <aside class="hc-panel" aria-labelledby="hc-book-doctor-title">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <HcDoctorAvatar Doctor="doctor" Class="hc-book-avatar" Eager="true" />
                            <div class="hc-book-doctor">
                                <h2 class="h5 fw-bold mb-0" id="hc-book-doctor-title"><a href="@HcDisplay.DoctorUrl(doctor.Id)">@doctor.Name</a></h2>
                                <p class="small text-body-secondary mb-0">@doctor.Specialty</p>
                            </div>
                        </div>
                        @if (!doctor.AcceptingNewPatients)
                        {
                            <p class="small mb-3"><span class="badge text-bg-secondary">Not taking new patients</span></p>
                        }
                        @if (clinic is not null)
                        {
                            <h3 class="h6 fw-bold mb-1">Clinic</h3>
                            <p class="mb-1 fw-semibold">@clinic.Name</p>
                            <p class="small mb-1"><Icon Name="IconName.GeoAlt" class="me-1" aria-hidden="true" />@clinic.Address</p>
                            <p class="small mb-1"><Icon Name="IconName.Telephone" class="me-1" aria-hidden="true" /><a href="@SlotPicker.TelUrl(clinic.Phone)">@clinic.Phone</a></p>
                            <p class="small text-body-secondary mb-3">@clinic.Hours</p>
                            <a class="small" href="@($"{HcLayout.Base}/locations")">Map and directions</a>
                        }
                    </aside>
                </div>
            </div>
        </ShowcaseRoleGuard>
    </div>
}
