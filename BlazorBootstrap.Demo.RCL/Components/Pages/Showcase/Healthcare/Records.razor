@page "/showcase/healthcare/records"
@layout HcLayout

<PageTitle>Records · @HcSeedData.ProductName</PageTitle>

<div class="container-xl hc-records">
    <ShowcaseRoleGuard Roles="@HcSeedData.PatientRole" SignInPath="@HcLayout.SignInPath">
        @if (State.CurrentPatient is { } patient)
        {
            var visits = Visits(patient);

            <h1 class="hc-title mb-1">Your health record</h1>
            <p class="hc-lead mb-2">Visit summaries from your doctors, the conditions, allergies, and vaccinations on your chart, and who at the clinics has looked at your record.</p>
            <p class="small text-body-secondary mb-4">
                @patient.Name · Medical record number <span class="hc-mono">@patient.Mrn</span>@(patient.DateOfBirth is { } dob ? $" · Born {HcDisplay.Date(dob)}" : null).
                Demo only: the people and records are made up, and nothing here is medical advice.
            </p>

            <div class="hc-records-grid">
                <section class="hc-records-main hc-panel" aria-labelledby="hc-records-visits-title">
                    <h2 class="hc-section-title" id="hc-records-visits-title">Visit summaries (@visits.Count)</h2>
                    <div class="hc-list-meta mt-0 mb-2">
                        <p class="small text-body-secondary mb-0">What your doctor wrote for you after each completed visit, newest first. Open a visit for the whole summary.</p>
                        @* Back to the saved view's defaults: newest first, 10 a page, every column in its place. *@
                        <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ResetViewAsync">Reset view<span class="visually-hidden">&#32;of the visit summaries</span></Button>
                    </div>
                    <p class="hc-list-status mb-2" role="status" tabindex="-1" @ref="statusRegion">@statusMessage</p>
                    <ShowcaseDataState Status="@(viewLoaded ? ShowcaseDataStatus.Ready : ShowcaseDataStatus.Loading)"
                                       IsEmpty="@(visits.Count == 0)"
                                       EmptyIcon="IconName.FileEarmarkText"
                                       EmptyTitle="No completed visits yet"
                                       EmptyText="After a visit, the doctor's summary appears here."
                                       LoadingText="Loading your visit summaries…"
                                       OnRetry="RefreshGridAsync">
                        <EmptyActions>
                            <a class="btn btn-primary btn-sm" href="@($"{HcLayout.Base}/doctors")">Find a doctor</a>
                        </EmptyActions>
                        <ChildContent>
                            <Grid @ref="grid"
                                  @key="gridVersion"
                                  TItem="SummaryRow"
                                  Class="table table-hover align-middle hc-table-mid sc-grid-row-links"
                                  GridContainerClass="hc-grid border rounded-3"
                                  DataProvider="ProvideSummariesAsync"
                                  SettingsProvider="view.GetSettingsAsync"
                                  GridSettingsChanged="SaveSettingsAsync"
                                  AllowPaging="true"
                                  PageSize="@pageSize"
                                  PageSizeSelectorVisible="true"
                                  PageSizeSelectorItems="@(new[] { 10, 25, 50 })"
                                  PaginationItemsTextFormat="{0}–{1} of {2} visits"
                                  AllowSorting="true"
                                  AllowColumnChooser="true"
                                  AllowExport="true"
                                  ExportFileName="clinic-my-visit-summaries"
                                  Responsive="true"
                                  EmptyText="No completed visits yet."
                                  aria-label="Visit summaries">
                                <GridColumns>
                                    <GridColumn TItem="SummaryRow" HeaderText="Visit" PropertyName="Title" SortString="date" SortKeySelector="row => row.Start"
                                                IsDefaultSortColumn="@view.IsSortColumn("date")" SortDirection="@view.DirectionFor("date")" AlwaysVisible="true">
                                        @* The stretched link makes the whole row open the visit. *@
                                        <a class="hc-row-link stretched-link" href="@HcDisplay.AppointmentUrl(context.Id)">@context.Title</a>
                                    </GridColumn>
                                    <GridColumn TItem="SummaryRow" HeaderText="Doctor" PropertyName="Doctor" SortString="doctor" SortKeySelector="row => row.Doctor"
                                                IsDefaultSortColumn="@view.IsSortColumn("doctor")" SortDirection="@view.DirectionFor("doctor")">
                                        @context.Doctor
                                    </GridColumn>
                                    <GridColumn TItem="SummaryRow" HeaderText="Clinic" PropertyName="Clinic" SortString="clinic" SortKeySelector="row => row.Clinic"
                                                IsDefaultSortColumn="@view.IsSortColumn("clinic")" SortDirection="@view.DirectionFor("clinic")">
                                        @context.Clinic
                                    </GridColumn>
                                    <GridColumn TItem="SummaryRow" HeaderText="Summary" PropertyName="Summary" SortString="summary" SortKeySelector="row => row.Summary"
                                                IsDefaultSortColumn="@view.IsSortColumn("summary")" SortDirection="@view.DirectionFor("summary")">
                                        <span class="hc-plain hc-wrap small">@context.Summary</span>
                                    </GridColumn>
                                </GridColumns>
                            </Grid>
                        </ChildContent>
                    </ShowcaseDataState>
                </section>

                <div class="hc-records-side">
                    <section class="hc-panel" aria-labelledby="hc-records-conditions-title">
                        <h2 class="hc-section-title" id="hc-records-conditions-title">Conditions</h2>
                        @if (patient.Conditions.Count == 0)
                        {
                            <p class="mb-2">No ongoing conditions on record.</p>
                        }
                        else
                        {
                            <ul class="hc-records-list">
                                @foreach (var condition in patient.Conditions)
                                {
                                    <li>@condition</li>
                                }
                            </ul>
                        }
                        <p class="small text-body-secondary mb-0">Your doctor keeps this list up to date at your visits. If something is missing or wrong, tell your doctor at your next visit.</p>
                    </section>

                    <section class="hc-panel" aria-labelledby="hc-records-allergies-title">
                        <h2 class="hc-section-title" id="hc-records-allergies-title">Allergies</h2>
                        @if (patient.Allergies.Count == 0)
                        {
                            <p class="mb-2">No known allergies on record.</p>
                        }
                        else
                        {
                            <ul class="hc-records-list">
                                @foreach (var allergy in patient.Allergies)
                                {
                                    <li>@allergy</li>
                                }
                            </ul>
                        }
                        <p class="small text-body-secondary mb-0">Your doctor records allergies so they're checked before anything is prescribed. Tell your doctor about any new reaction.</p>
                    </section>

                    <section class="hc-panel" aria-labelledby="hc-records-immunizations-title">
                        <h2 class="hc-section-title" id="hc-records-immunizations-title">Vaccinations</h2>
                        @if (patient.Immunizations.Count == 0)
                        {
                            <p class="mb-2">No vaccinations on record.</p>
                        }
                        else
                        {
                            <Table Data="patient.Immunizations.OrderByDescending(item => item.Date)" Class="table-sm mb-2" Responsive="true"
                                   Caption="Your vaccinations, newest first" VisuallyHiddenCaption="true">
                                <TableColumn HeaderText="Vaccine" IsRowHeader="true" ColumnClass="@(_ => "fw-normal")" Context="shot">@shot.Name</TableColumn>
                                <TableColumn HeaderText="Date given" ColumnClass="@(_ => "text-nowrap")" Context="shot">@HcDisplay.Date(shot.Date)</TableColumn>
                            </Table>
                        }
                        <p class="small text-body-secondary mb-0">Your doctor adds vaccinations given at our clinics. Bring a record of ones given elsewhere to your next visit.</p>
                    </section>
                </div>
            </div>

            <RecordsAccess />
        }
    </ShowcaseRoleGuard>
</div>
