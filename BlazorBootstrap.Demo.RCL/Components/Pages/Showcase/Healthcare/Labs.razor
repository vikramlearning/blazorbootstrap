@page "/showcase/healthcare/staff/labs"
@layout HcStaffLayout

<PageTitle>Lab results · @HcSeedData.ProductName</PageTitle>

@* The signed-in doctor's lab orders in a Grid: the row opens the order to enter results, check, and release them; several
   entered ones can be released together. ?order={id} opens one order (old links). *@
<div class="container-fluid px-lg-4">
    <ShowcaseRoleGuard Roles="@HcSeedData.DoctorRole" SignInPath="@HcLayout.SignInPath">
        @{
            var work = State.MyLabWork;
        }

        <h1 class="hc-title mb-1">Lab results</h1>
        <p class="hc-lead mb-3">
            Tests you ordered. Enter the results, check the flags, then release them: the patient sees nothing until you do, and each released test is billed
            @HcDisplay.Money(HcSeedData.LabFeeCents). Select entered results to release several together.
        </p>

        <section class="hc-panel mb-3" aria-labelledby="hc-labs-filters-title">
            <h2 class="hc-section-title" id="hc-labs-filters-title">Filter lab orders</h2>
            <div class="hc-list-filters" role="search" aria-labelledby="hc-labs-filters-title">
                <div class="hc-list-search">
                    <label class="form-label small fw-semibold" for="hc-labs-search">Search</label>
                    @* Filters on every keystroke; the bound value changes only on change, so a render during typing never writes an older value back. *@
                    <input id="hc-labs-search" type="search" class="form-control" value="@searchBoxValue" placeholder="Patient, record number, test, or order number" autocomplete="off" maxlength="80"
                           @oninput="OnSearchInputAsync" @onchange="OnSearchChanged" />
                </div>
                <div>
                    <label class="form-label small fw-semibold" for="hc-labs-status">Status</label>
                    <select id="hc-labs-status" class="form-select" value="@statusFilter" @onchange="OnStatusFilterChangedAsync">
                        <option value="@ToDoFilter">To do (@work.Count(item => item.Status != HcLabStatus.Released))</option>
                        <option value="@nameof(HcLabStatus.Ordered)">Waiting for results (@work.Count(item => item.Status == HcLabStatus.Ordered))</option>
                        <option value="@nameof(HcLabStatus.Resulted)">Entered, not released (@work.Count(item => item.Status == HcLabStatus.Resulted))</option>
                        <option value="@nameof(HcLabStatus.Released)">Released (@work.Count(item => item.Status == HcLabStatus.Released))</option>
                        <option value="">All (@work.Count)</option>
                    </select>
                </div>
            </div>
            <div class="hc-list-meta">
                <p class="small text-body-secondary mb-0" aria-live="polite" tabindex="-1" @ref="countRegion">@CountText(work.Count)</p>
                @if (IsFiltered)
                {
                    <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ClearFiltersAsync">Show what's to do</Button>
                }
                @* Back to the saved view's defaults: oldest order first, 25 a page, every column in its place. *@
                <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ResetViewAsync">Reset view</Button>
            </div>
        </section>

        @* Always rendered and focusable, so a release is announced and focus has somewhere to go when the bulk bar closes. *@
        <p class="hc-list-status mb-2 @(statusIsError ? "text-danger-emphasis" : null)" role="status" tabindex="-1" @ref="statusRegion">@statusMessage</p>

        @if (selected.Count > 0)
        {
            var entered = selected.Count(row => row.StatusValue == HcLabStatus.Resulted);

            <section class="hc-bulk" aria-labelledby="hc-labs-bulk-count">
                <h2 class="hc-bulk-count" id="hc-labs-bulk-count">
                    @(selected.Count == 1 ? "1 order selected" : $"{selected.Count} orders selected"), @(entered == selected.Count ? "all entered" : $"{entered} entered and not released")
                </h2>
                <div class="hc-bulk-actions">
                    <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" Disabled="@(entered == 0)" @onclick="AskReleaseAsync">
                        <Icon Name="IconName.Send" class="me-1" aria-hidden="true" />Release results…<span class="visually-hidden">&#32;of the selected orders</span>
                    </Button>
                    <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="ClearSelectionAsync">Clear selection</Button>
                </div>
                <p class="form-text w-100 mb-0">Only entered results are released; orders waiting for results, or released already, stay as they are. Open an order to check its flags first.</p>
            </section>
        }

        <section class="hc-panel" aria-label="Lab order list">
            <ShowcaseDataState Status="@(viewLoaded ? ShowcaseDataStatus.Ready : ShowcaseDataStatus.Loading)"
                               IsEmpty="@(work.Count == 0)"
                               EmptyIcon="IconName.Clipboard2Pulse"
                               EmptyTitle="No lab orders yet"
                               EmptyText="Order a test in a visit; it shows here until you release its results."
                               LoadingText="Loading lab orders…"
                               OnRetry="RefreshGridAsync">
                <EmptyActions>
                    <a class="btn btn-primary btn-sm" href="@($"{HcStaffLayout.Base}/schedule")">Open my schedule</a>
                </EmptyActions>
                <ChildContent>
                    <Grid @ref="grid"
                          @key="gridVersion"
                          TItem="OrderRow"
                          Class="table table-hover align-middle hc-table-wide sc-grid-row-links"
                          GridContainerClass="hc-grid border rounded-3"
                          DataProvider="ProvideOrdersAsync"
                          SettingsProvider="view.GetSettingsAsync"
                          GridSettingsChanged="SaveSettingsAsync"
                          AllowPaging="true"
                          PageSize="@pageSize"
                          PageSizeSelectorVisible="true"
                          PageSizeSelectorItems="@(new[] { 10, 25, 50 })"
                          PaginationItemsTextFormat="{0}–{1} of {2} orders"
                          AllowSorting="true"
                          AllowSelection="true"
                          SelectionMode="GridSelectionMode.Multiple"
                          RowSelectionLabel="@(row => $"Select {row.Test} for {row.Patient}")"
                          SelectAllRowsText="Select all shown orders"
                          SelectedItemsChanged="OnSelectionChanged"
                          RowClass="RowClass"
                          AllowColumnChooser="true"
                          AllowExport="true"
                          ExportFileName="clinic-lab-orders"
                          Responsive="true"
                          EmptyText="No orders match. Choose another status, or clear the search."
                          aria-label="Lab orders">
                        <GridColumns>
                            <GridColumn TItem="OrderRow" HeaderText="Test" PropertyName="Test" SortString="test" SortKeySelector="row => row.Test"
                                        IsDefaultSortColumn="@view.IsSortColumn("test")" SortDirection="@view.DirectionFor("test")" AlwaysVisible="true">
                                @* The stretched link makes the whole row open the order; the checkbox stays above it. *@
                                <a class="hc-row-link stretched-link" href="@HcDisplay.LabOrderUrl(context.Id)">@context.Test</a>
                            </GridColumn>
                            <GridColumn TItem="OrderRow" HeaderText="Order" PropertyName="Id" SortString="number" SortKeySelector="row => row.Id"
                                        IsDefaultSortColumn="@view.IsSortColumn("number")" SortDirection="@view.DirectionFor("number")" TextNoWrap="true">
                                <span class="hc-mono">@context.Id</span>
                            </GridColumn>
                            <GridColumn TItem="OrderRow" HeaderText="Patient" PropertyName="Patient" SortString="patient" SortKeySelector="row => row.Patient"
                                        IsDefaultSortColumn="@view.IsSortColumn("patient")" SortDirection="@view.DirectionFor("patient")">
                                @context.Patient
                            </GridColumn>
                            <GridColumn TItem="OrderRow" HeaderText="Record number" PropertyName="Mrn" SortString="mrn" SortKeySelector="row => row.Mrn"
                                        IsDefaultSortColumn="@view.IsSortColumn("mrn")" SortDirection="@view.DirectionFor("mrn")" TextNoWrap="true">
                                <span class="hc-mono">@context.Mrn</span>
                            </GridColumn>
                            <GridColumn TItem="OrderRow" HeaderText="Ordered" PropertyName="OrderedText" SortString="ordered" SortKeySelector="row => row.Ordered"
                                        IsDefaultSortColumn="@view.IsSortColumn("ordered")" SortDirection="@view.DirectionFor("ordered")" TextNoWrap="true">
                                @context.OrderedText
                            </GridColumn>
                            <GridColumn TItem="OrderRow" HeaderText="Status" PropertyName="Status" SortString="status" SortKeySelector="row => row.StatusValue"
                                        IsDefaultSortColumn="@view.IsSortColumn("status")" SortDirection="@view.DirectionFor("status")" TextNoWrap="true">
                                <span class="badge text-bg-@Labs.StatusColor(context.StatusValue)">@context.Status</span>
                            </GridColumn>
                            <GridColumn TItem="OrderRow" HeaderText="Results" PropertyName="Results" SortString="results" SortKeySelector="row => row.OutOfRange"
                                        IsDefaultSortColumn="@view.IsSortColumn("results")" SortDirection="@view.DirectionFor("results")">
                                <span class="@(context.OutOfRange > 0 ? "fw-semibold text-warning-emphasis" : null)">@context.Results</span>
                            </GridColumn>
                            <GridColumn TItem="OrderRow" HeaderText="Entered" PropertyName="EnteredText" SortString="entered" SortKeySelector="row => row.Entered ?? DateTime.MaxValue"
                                        IsDefaultSortColumn="@view.IsSortColumn("entered")" SortDirection="@view.DirectionFor("entered")" TextNoWrap="true">
                                @context.EnteredText
                            </GridColumn>
                            <GridColumn TItem="OrderRow" HeaderText="Released" PropertyName="ReleasedText" SortString="released" SortKeySelector="row => row.Released ?? DateTime.MaxValue"
                                        IsDefaultSortColumn="@view.IsSortColumn("released")" SortDirection="@view.DirectionFor("released")" TextNoWrap="true">
                                @context.ReleasedText
                            </GridColumn>
                        </GridColumns>
                    </Grid>
                </ChildContent>
            </ShowcaseDataState>
        </section>

        <Modal @ref="releaseModal" IsVerticallyCentered="true" ShowCloseButton="false" aria-labelledby="hc-labs-release-title" OnShown="OnReleaseShownAsync" OnHidden="OnReleaseHiddenAsync">
            <HeaderTemplate>
                <h2 class="modal-title h5 hc-wrap" id="hc-labs-release-title">Release @(releaseIds.Count == 1 ? "1 result" : $"{releaseIds.Count} results") to the patients?</h2>
            </HeaderTemplate>
            <BodyTemplate>
                <p class="mb-2">
                    Each patient sees their results and your comment in Lab reports, with a PDF, and is billed @HcDisplay.Money(HcSeedData.LabFeeCents) for the test.
                </p>
                <p class="mb-0">You can't change results after you release them.</p>
            </BodyTemplate>
            <FooterTemplate>
                <button type="button" class="btn btn-outline-secondary" @ref="releaseCancel" @onclick="() => releaseModal.HideAsync()">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="ConfirmReleaseAsync">Release @(releaseIds.Count == 1 ? "it" : "them")</button>
            </FooterTemplate>
        </Modal>
    </ShowcaseRoleGuard>
</div>
