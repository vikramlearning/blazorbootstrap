@page "/showcase/saas/admin/audit"
@layout SaasAdminLayout

<PageTitle>Audit log · @SaasSeedData.ProductName</PageTitle>

@* Operators see it: the console's guard keeps everyone else out, and the state shows the log to operators only. The shared
   log's column filters (Who, Action, Record) replace the page's former action and actor filters. *@
<div class="sd-page-head">
    <div>
        <span class="sc-eyebrow">Audit log</span>
        <h1 class="sd-page-title">Audit log</h1>
        <p class="sd-page-lead">
            Who did what, and when, newest first: Lumora's operators (tenants, plans, leads, invoices, refunds, and payments), automatic billing
            (renewals and failed payments), and customers in their own workspaces (sign-ups, plan and payment changes, team changes, and settings).
            Each record links to its page in the console.
        </p>
    </div>
</div>

<Card Class="sd-card">
    <CardBody Class="p-3 p-lg-4">
        <ShowcaseAuditLog ExportFileName="saas-audit-log" />
    </CardBody>
</Card>
