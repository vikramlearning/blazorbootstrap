@page "/showcase/saas/admin/revenue"
@layout SaasAdminLayout

<PageTitle>Revenue · @SaasSeedData.ProductName</PageTitle>

@{
    var months = CollectedMonths;
    var planMrr = PlanMrr;
    var totalMrr = State.Mrr;
    var statusCounts = StatusCounts;
    var top = TopTenants;
    var trials = Trials;
}

<div class="sd-page-head">
    <div>
        <span class="sc-eyebrow">Revenue</span>
        <h1 class="sd-page-title">Revenue</h1>
        <p class="sd-page-lead">Recurring revenue, collections, and trials, from this tab's tenants and invoices.</p>
        <p class="small text-body-secondary mb-0 mt-1">MRR counts active and past-due tenants on a paid plan; annual plans count at their monthly price. Trials, suspended, and archived tenants count as $0.</p>
    </div>
    <a class="btn btn-primary" href="@($"{SaasAdminLayout.Base}/tenants")">
        <Icon Name="IconName.Buildings" class="me-1" aria-hidden="true" />All tenants
    </a>
</div>

<section aria-label="Key revenue metrics" class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3 mb-4">
    @foreach (var kpi in Kpis)
    {
        <div class="col" @key="kpi.Label">
            <Card Class="sd-card h-100">
                <CardBody Class="p-3 p-lg-4">
                    <div class="sd-kpi-label">
                        <span>@kpi.Label</span>
                        <span class="sd-kpi-icon" aria-hidden="true"><Icon Name="@kpi.IconName" /></span>
                    </div>
                    <span class="sd-kpi-value">@kpi.Value</span>
                    <span class="text-body-secondary small">@kpi.Note</span>
                </CardBody>
            </Card>
        </div>
    }
</section>

<div class="row g-3 mb-4">
    <div class="col-xl-8">
        <Card Class="sd-card h-100">
            <CardHeader>
                <div>
                    <h2 class="sd-card-title">Collected and refunded</h2>
                    <p class="sd-card-sub">Paid invoices by the month they were issued, last 12 months. Refunds count in the month of the invoice they refund.</p>
                </div>
            </CardHeader>
            <CardBody Class="pt-0">
                <div class="sd-chart" role="img" aria-label="@CollectionChartLabel">
                    <BarChart @ref="collectionChart" Height="300" HeightUnit="Unit.Px" Width="100" WidthUnit="Unit.Percentage" />
                </div>
                @* The wrapper hides the table: a hidden table itself can't shrink below its content and would widen the page. *@
                <div class="visually-hidden">
                <Table Data="months" RowKeySelector="month => month.Month" Caption="@($"Money collected and refunded per month, {MonthName(months[0].Month)} to {MonthName(months[^1].Month)}")">
                    <TableColumn HeaderText="Month" IsRowHeader="true" Context="month">@MonthName(month.Month)</TableColumn>
                    <TableColumn HeaderText="Collected" Context="month">@SaasDisplay.MoneyCents(month.Collected)</TableColumn>
                    <TableColumn HeaderText="Refunded" Context="month">@SaasDisplay.MoneyCents(month.Refunded)</TableColumn>
                    <TableColumn HeaderText="Net" Context="month">@SaasDisplay.MoneyCents(month.Collected - month.Refunded)</TableColumn>
                </Table>
                </div>
            </CardBody>
        </Card>
    </div>
    <div class="col-xl-4">
        <Card Class="sd-card h-100">
            <CardHeader>
                <div>
                    <h2 class="sd-card-title">MRR by plan</h2>
                    <p class="sd-card-sub">Share of this month's @SaasDisplay.Money(totalMrr)</p>
                </div>
            </CardHeader>
            <CardBody Class="pt-0">
                <div class="sd-chart" role="img" aria-label="@PlanChartLabel">
                    <DoughnutChart @ref="planChart" Height="300" HeightUnit="Unit.Px" Width="100" WidthUnit="Unit.Percentage" />
                </div>
                @if (totalMrr == 0)
                {
                    <p class="small text-body-secondary mb-0">No tenant pays right now, so there is no MRR to split.</p>
                }
                @* The wrapper hides the table: a hidden table itself can't shrink below its content and would widen the page. *@
                <div class="visually-hidden">
                <Table Data="planMrr" RowKeySelector="entry => entry.Plan.Id" Caption="MRR by plan">
                    <TableColumn HeaderText="Plan" IsRowHeader="true" Context="entry">@entry.Plan.Name</TableColumn>
                    <TableColumn HeaderText="MRR" Context="entry">@SaasDisplay.Money(entry.Mrr)</TableColumn>
                    <TableColumn HeaderText="Share" Context="entry">@(totalMrr == 0 ? "0%" : Percent((double)(entry.Mrr / totalMrr * 100)))</TableColumn>
                    <TableColumn HeaderText="Paying tenants" Context="entry">@Count(entry.Paying)</TableColumn>
                </Table>
                </div>
            </CardBody>
        </Card>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-4">
        <Card Class="sd-card h-100">
            <CardHeader>
                <div>
                    <h2 class="sd-card-title">Tenants by status</h2>
                    <p class="sd-card-sub">@SaasState.Plural(State.Workspaces.Count, "tenant", "tenants") in all</p>
                </div>
            </CardHeader>
            <CardBody Class="pt-0">
                <div class="sd-chart" role="img" aria-label="@StatusChartLabel">
                    <BarChart @ref="statusChart" Height="260" HeightUnit="Unit.Px" Width="100" WidthUnit="Unit.Percentage" />
                </div>
                @* The wrapper hides the table: a hidden table itself can't shrink below its content and would widen the page. *@
                <div class="visually-hidden">
                <Table Data="statusCounts" RowKeySelector="entry => entry.Status" Caption="Tenants by status">
                    <TableColumn HeaderText="Status" IsRowHeader="true" Context="entry">@SaasDisplay.StatusName(entry.Status)</TableColumn>
                    <TableColumn HeaderText="Tenants" Context="entry">@Count(entry.Tenants)</TableColumn>
                    <TableColumn HeaderText="MRR" Context="entry">@SaasDisplay.Money(entry.Mrr)</TableColumn>
                </Table>
                </div>
            </CardBody>
        </Card>
    </div>
    <div class="col-xl-8">
        <Card Class="sd-card h-100">
            <CardHeader>
                <div>
                    <h2 class="sd-card-title">Top @TopCount tenants by MRR</h2>
                    <p class="sd-card-sub">Paying tenants, highest MRR first</p>
                </div>
            </CardHeader>
            <CardBody Class="pt-0">
                @if (top.Count == 0)
                {
                    <p class="small text-body-secondary mb-0">No tenant pays right now.</p>
                }
                else
                {
                    <Table Data="top.Select((workspace, index) => (Workspace: workspace, Rank: index + 1, Mrr: State.MonthlyRevenueFor(workspace)))" Class="align-middle"
                           Responsive="true" TableContainerClass="sd-grid" RowKeySelector="row => row.Workspace.Id"
                           Caption="@($"Top {TopCount} tenants by MRR, highest first")" VisuallyHiddenCaption="true">
                        <TableColumn HeaderText="Rank" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End" ColumnClass="@(_ => "sd-mono")" Context="row">@row.Rank</TableColumn>
                        <TableColumn HeaderText="Tenant" IsRowHeader="true" ColumnClass="@(_ => "fw-normal")" Context="row">
                            <div class="sd-person">
                                <Avatar Name="@row.Workspace.Name" Color="SaasDisplay.AvatarColorFor(row.Workspace.Id)" Size="AvatarSize.Small" />
                                <span class="sd-person-text">
                                    <a class="sd-person-name" href="@($"{SaasAdminLayout.Base}/tenants/{row.Workspace.Id}")">@row.Workspace.Name</a>
                                    <span class="sd-person-email">@(row.Workspace.Period == SaasBillingPeriod.Annual ? "Billed annually" : "Billed monthly")</span>
                                </span>
                            </div>
                        </TableColumn>
                        <TableColumn HeaderText="Plan" Context="row"><Badge Color="SaasDisplay.PlanColor(row.Workspace.PlanId)" Class="rounded-pill">@State.PlanOf(row.Workspace).Name</Badge></TableColumn>
                        <TableColumn HeaderText="Seats" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End" ColumnClass="@(_ => "sd-mono")" Context="row">@Count(row.Workspace.Seats)</TableColumn>
                        <TableColumn HeaderText="Status" Context="row"><Badge Color="SaasDisplay.StatusColor(row.Workspace.Status)" Class="rounded-pill">@SaasDisplay.StatusName(row.Workspace.Status)</Badge></TableColumn>
                        <TableColumn HeaderText="MRR" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End" ColumnClass="@(_ => "text-nowrap sd-mono")" Context="row">@SaasDisplay.Money(row.Mrr)</TableColumn>
                        <TableColumn HeaderText="Share" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End" ColumnClass="@(_ => "text-nowrap sd-mono")" Context="row">@(totalMrr == 0 ? "0%" : Percent((double)(row.Mrr / totalMrr * 100)))</TableColumn>
                    </Table>
                }
            </CardBody>
        </Card>
    </div>
</div>

<Card Class="sd-card">
    <CardHeader>
        <div>
            <h2 class="sd-card-title">Trial funnel</h2>
            <p class="sd-card-sub">Trials running now, and what became of the trials that ended</p>
        </div>
        @if (trials.Running > 0)
        {
            <a class="small fw-semibold" href="@($"{SaasAdminLayout.Base}/tenants?status={SaasWorkspaceStatus.Trial}")">All trials</a>
        }
    </CardHeader>
    <CardBody Class="pt-0">
        <ol class="ar-funnel list-unstyled mb-3">
            <li class="ar-stage">
                <span class="ar-stage-label">Trials running</span>
                <span class="sd-kpi-value">@Count(trials.Running)</span>
                <span class="small text-body-secondary">
                    @(trials.Running == 0 ? "No tenant is on trial right now" : $"{Count(trials.RunningWithCard)} with a card on file, {Count(trials.Running - trials.RunningWithCard)} without")
                </span>
            </li>
            <li class="ar-stage">
                <span class="ar-stage-label">Ending within 7 days</span>
                <span class="sd-kpi-value">@Count(trials.EndingSoon)</span>
                <span class="small text-body-secondary">
                    @if (trials.Soonest is { } soonest)
                    {
                        <text>Soonest: <a href="@($"{SaasAdminLayout.Base}/tenants/{soonest.Id}")">@soonest.Name</a>@(soonest.TrialEndsOn is { } endsOn ? $" on {SaasDisplay.Date(endsOn)}" : string.Empty)</text>
                    }
                    else
                    {
                        <text>None end this week</text>
                    }
                </span>
            </li>
            <li class="ar-stage">
                <span class="ar-stage-label">Trials ended</span>
                <span class="sd-kpi-value">@Count(trials.Ended)</span>
                <span class="small text-body-secondary">@Count(trials.Converted) upgraded early, @Count(trials.RanOut) ran to the end</span>
            </li>
            <li class="ar-stage">
                <span class="ar-stage-label">Paying now</span>
                <span class="sd-kpi-value">@Count(trials.PayingNow)</span>
                <span class="small text-body-secondary">
                    @(trials.Ended == 0 ? "No trial has ended yet" : $"{Percent(trials.PayingNow * 100d / trials.Ended)} of the ended trials")
                </span>
            </li>
        </ol>

        @if (trials.Ended > 0)
        {
            <dl class="row sd-dl small mb-3">
                <dt class="col-sm-5 col-lg-3">Upgraded during the trial</dt>
                <dd class="col-sm-7 col-lg-9">@SaasState.Plural(trials.Converted, "tenant", "tenants") <span class="fw-normal text-body-secondary">(“@ConvertedTitle” in their activity)</span></dd>
                <dt class="col-sm-5 col-lg-3">Ran to the end and billed</dt>
                <dd class="col-sm-7 col-lg-9">@SaasState.Plural(trials.RanOut, "tenant", "tenants") <span class="fw-normal text-body-secondary">(“@EndedTitle” in their activity)</span></dd>
                <dt class="col-sm-5 col-lg-3">Where they are now</dt>
                <dd class="col-sm-7 col-lg-9">
                    @OutcomeText(trials)
                </dd>
            </dl>
        }

        <p class="small text-body-secondary mb-0">
            Ended trials are counted from each tenant's activity: “@ConvertedTitle” when the customer upgraded in Billing during the trial, and “@EndedTitle”
            when the trial ran out and the plan was billed (paid with a card on file, or left open, which makes the tenant past due). Seeded tenants carry no
            trial history, so only trials that end or convert in this tab are counted.
        </p>
    </CardBody>
</Card>
