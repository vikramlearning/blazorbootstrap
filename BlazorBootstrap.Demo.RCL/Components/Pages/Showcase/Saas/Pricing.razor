@page "/showcase/saas/pricing"
@layout SaasLayout
@implements IDisposable
@inject SaasState State

<PageTitle>Pricing · @SaasSeedData.ProductName</PageTitle>

<section class="mk-page-hero">
    <div class="container-xl">
        <span class="sc-eyebrow">Pricing</span>
        <h1 class="mk-section-title">Simple pricing that grows with you</h1>
        <p>Start free, upgrade when your team is ready. Growth comes with a @SaasSeedData.TrialDays-day trial, and no card is needed to start.</p>
        <div class="mk-billing mt-3">
            <span class="@(State.AnnualBilling ? "text-body-secondary" : "fw-semibold")">Monthly</span>
            <Switch Value="State.AnnualBilling" ValueExpression="() => State.AnnualBilling" ValueChanged="OnBillingChanged" Label="Bill annually" />
            <Badge Color="BadgeColor.Success" Class="rounded-pill">Save @DiscountPercent%</Badge>
        </div>
    </div>
</section>

<section class="container-xl pb-5" aria-label="Plans">
    <p class="visually-hidden" role="status">Showing @(State.AnnualBilling ? "annual" : "monthly") prices</p>
    <div class="row row-cols-1 row-cols-lg-3 g-4 pt-3">
        @foreach (var plan in State.Plans)
        {
            var price = SaasPricing.MonthlySeatPrice(plan, Period);
            <div class="col" @key="plan.Id">
                <Card Class="@($"h-100 mk-plan {(plan.IsPopular ? "mk-plan-popular" : string.Empty)}")">
                    @if (plan.IsPopular)
                    {
                        <span class="mk-plan-badge badge rounded-pill text-bg-primary px-3 py-2">Most popular</span>
                    }
                    <CardBody Class="p-4 d-flex flex-column">
                        <h2 class="h4 fw-bold mb-1">@plan.Name</h2>
                        <p class="text-body-secondary">@plan.Description</p>
                        <div class="d-flex align-items-end gap-2 my-3">
                            <span class="mk-plan-price">@SaasDisplay.Money(price)</span>
                            <span class="text-body-secondary pb-1">/ seat / month</span>
                        </div>
                        <p class="small text-body-secondary mb-4">@PriceNote(plan, price)</p>
                        <ul class="list-unstyled mk-plan-list mb-4">
                            @foreach (var highlight in plan.Highlights)
                            {
                                <li><Icon Name="IconName.Check2Circle" aria-hidden="true" />@highlight</li>
                            }
                        </ul>
                        @{
                            var (href, text) = PlanAction(plan);
                        }
                        <a class="btn @(plan.IsPopular ? "btn-primary" : "btn-outline-primary") btn-lg w-100 mt-auto mk-cta-lg" href="@href">
                            @text <span class="visually-hidden">(@plan.Name plan)</span>
                        </a>
                    </CardBody>
                </Card>
            </div>
        }
    </div>

    <div class="text-center mt-5">
        <Button Color="ButtonColor.Secondary" Outline="true" Class="rounded-pill px-4" @onclick="ToggleComparisonAsync"
                aria-expanded="@(comparisonOpen ? "true" : "false")" aria-controls="mk-compare">
            @(comparisonOpen ? "Hide full comparison" : "Compare all features")
            <Icon Name="@(comparisonOpen ? IconName.ChevronUp : IconName.ChevronDown)" class="ms-1" aria-hidden="true" />
        </Button>
    </div>

    <Collapse @ref="comparisonCollapse" id="mk-compare" OnShown="() => comparisonOpen = true" OnHidden="() => comparisonOpen = false">
        @* Rows are features and columns are plans, so the plan columns come from a loop. *@
        <Table Data="comparison" Class="align-middle" Responsive="true" TableContainerClass="mt-4" RowKeySelector="row => row.Feature"
               Caption="Plan comparison" VisuallyHiddenCaption="true">
            <TableColumn HeaderText="Feature" IsRowHeader="true" ColumnClass="@(_ => "fw-medium")" Context="row">@row.Feature</TableColumn>
            @foreach (var plan in State.Plans)
            {
                <TableColumn HeaderText="@plan.Name" Context="row">@CompareValue(row, plan)</TableColumn>
            }
        </Table>
    </Collapse>

    <Callout Color="CalloutColor.Info" Heading="Non-profit or education?" Class="mt-5">
        We offer 50% off any paid plan for registered non-profits and schools. <a href="@ContactPath">Contact sales</a> to have it applied.
    </Callout>
</section>

@code {
    private const string ContactPath = SaasLayout.Base + "/contact";

    // Comparison rows that read the plans' limits, so an operator's change in Plans & prices shows here too.
    private const string DashboardsRow = "Dashboards";

    private const string EventsRow = "Tracked events / month";

    private const string SeatsRow = "Team seats";

    /// <summary>The comparison's rows; the limit rows take their values from the plans, the others from the seed.</summary>
    private static readonly IReadOnlyList<SaasComparisonRow> comparison = SaasSeedData.Comparison();

    private bool comparisonOpen;

    private Collapse comparisonCollapse = default!;

    private static int DiscountPercent => (int)Math.Round(SaasPricing.AnnualDiscount * 100, MidpointRounding.AwayFromZero);

    private SaasBillingPeriod Period => State.AnnualBilling ? SaasBillingPeriod.Annual : SaasBillingPeriod.Monthly;

    protected override void OnInitialized() => State.Changed += OnStateChanged;

    /// <summary>Stops listening to state changes.</summary>
    public void Dispose() => State.Changed -= OnStateChanged;

    private void OnBillingChanged(bool annual) => State.AnnualBilling = annual;

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// Where a plan's button goes: sign-up with the plan chosen, or sales for a plan sold through sales. A signed-in customer
    /// changes plans in Billing, and the operator goes back to the console.
    /// </summary>
    private (string Href, string Text) PlanAction(SaasPlan plan)
    {
        if (!plan.IsSelfServe)
            return (ContactPath, plan.CallToAction);

        if (State.Identity.Current is null)
            return ($"{SaasLayout.Base}/signup?plan={Uri.EscapeDataString(plan.Id)}", plan.CallToAction);

        return State.IsOperator ? (SaasAdminLayout.Base, "Open console") : (SaasState.BillingPath, "Change plan in Billing");
    }

    private string PriceNote(SaasPlan plan, decimal price)
    {
        if (price == 0)
            return plan.SeatLimit > 0
                ? string.Create(CultureInfo.InvariantCulture, $"Free for as long as you like, for up to {plan.SeatLimit} seats.")
                : "Free for as long as you like.";

        return State.AnnualBilling
            ? $"Billed annually ({SaasDisplay.Money(price * 12)} per seat / year)."
            : $"Billed monthly. Switch to annual to save {DiscountPercent}%.";
    }

    /// <summary>
    /// A plan's value in a comparison row: events, dashboards, and seats from the plan's limits (0 is unlimited), the other
    /// rows from the seed's column for the plan.
    /// </summary>
    private static string CompareValue(SaasComparisonRow row, SaasPlan plan) => row.Feature switch
    {
        EventsRow => plan.EventLimit == 0 ? "Unlimited" : SaasDisplay.Events(plan.EventLimit),
        DashboardsRow => plan.DashboardLimit == 0 ? "Unlimited" : plan.DashboardLimit.ToString("#,0", CultureInfo.InvariantCulture),
        SeatsRow => plan.SeatLimit == 0 ? "Unlimited" : plan.SeatLimit.ToString("#,0", CultureInfo.InvariantCulture),
        _ => plan.Id switch
        {
            "starter" => row.Starter,
            "growth" => row.Growth,
            "enterprise" => row.Enterprise,
            _ => "—",
        },
    };

    private async Task ToggleComparisonAsync() => await comparisonCollapse.ToggleAsync();
}
