@* The not-found screen of the workspace and the console, shown by detail routes with an unknown ID. *@
<PageTitle>Page not found · Lumora</PageTitle>

<section class="sd-not-found">
    <span class="sd-kpi-icon fs-3 mb-3" aria-hidden="true"><Icon Name="IconName.SignpostSplit" /></span>
    <h1 class="sd-page-title mb-2">We couldn't find that page</h1>
    <p class="text-body-secondary mb-4">@Message</p>
    <div class="d-flex justify-content-center flex-wrap gap-2">
        <Button Type="ButtonType.Link" To="@BackPath" Color="ButtonColor.Primary">@BackText</Button>
    </div>
</section>

@code {
    /// <summary>Gets or sets where the button goes.</summary>
    [Parameter, EditorRequired] public string BackPath { get; set; } = default!;

    /// <summary>Gets or sets the button text.</summary>
    [Parameter, EditorRequired] public string BackText { get; set; } = default!;

    /// <summary>Gets or sets the explanation under the heading.</summary>
    [Parameter] public string Message { get; set; } = "The link may be old, or what it pointed to no longer exists.";
}
