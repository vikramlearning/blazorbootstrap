@page "/showcase/fintech/payees"
@layout FintechLayout

<PageTitle>Payees · @FintechSeedData.ProductName</PageTitle>

<div class="container-xl">
    <div class="tm-page-head">
        <div>
            <span class="sc-eyebrow">Move money</span>
            <h1 class="tm-title">Payees</h1>
            <p class="tm-lead">People and companies you send money to. Adding or changing one takes a name check and a one-time code.</p>
        </div>
        <a class="btn btn-primary" href="@($"{FintechLayout.Base}/payees/new")"><Icon Name="IconName.PersonPlus" class="me-2" aria-hidden="true" />Add payee</a>
    </div>

    @* Always rendered and focusable, so an action's outcome is announced and focus has somewhere to go. *@
    <p class="tm-py-status" role="status" tabindex="-1" @ref="statusRegion">@statusMessage</p>

    <Card Class="tm-card">
        <CardBody Class="p-3 p-lg-4">
            <div class="tm-list-meta mt-0">
                <p class="small text-body-secondary mb-0">
                    @CountText(State.Payees.Count) A payee added or changed in the last @FintechState.NewPayeeDays days is marked New: transfers of
                    @FintechDisplay.Money(FintechState.HoldNewPayeeAmount) or more to it are held for a check.
                </p>
                <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ResetViewAsync">Reset view</Button>
            </div>

            <ShowcaseDataState Status="@(viewLoaded ? ShowcaseDataStatus.Ready : ShowcaseDataStatus.Loading)"
                               IsEmpty="@(State.Payees.Count == 0)"
                               EmptyIcon="IconName.People"
                               EmptyTitle="No payees yet"
                               EmptyText="Add someone you pay, like a landlord or a friend. We check their name against the account before you send anything."
                               LoadingText="Loading your payees…"
                               LoadingRows="3"
                               OnRetry="RefreshGridAsync">
                <EmptyActions>
                    <a class="btn btn-sm btn-primary" href="@($"{FintechLayout.Base}/payees/new")">Add payee</a>
                </EmptyActions>
                <ChildContent>
                    <Grid @ref="grid"
                          @key="gridVersion"
                          TItem="PayeeRow"
                          Class="table table-hover align-middle tm-table-wide sc-grid-row-links"
                          GridContainerClass="tm-grid border rounded-3"
                          DataProvider="ProvideRowsAsync"
                          SettingsProvider="view.GetSettingsAsync"
                          GridSettingsChanged="SaveSettingsAsync"
                          AllowPaging="true"
                          PageSize="@pageSize"
                          PageSizeSelectorVisible="true"
                          PageSizeSelectorItems="@(new[] { 10, 25, 50 })"
                          PaginationItemsTextFormat="{0}–{1} of {2} payees"
                          AllowSorting="true"
                          AllowColumnChooser="true"
                          AllowExport="true"
                          ExportFileName="banking-payees"
                          Responsive="true"
                          EmptyText="No payees."
                          aria-label="Your payees">
                        <GridColumns>
                            <GridColumn TItem="PayeeRow" HeaderText="Name" PropertyName="Name" SortString="name" SortKeySelector="row => row.Name"
                                        IsDefaultSortColumn="@view.IsSortColumn("name")" SortDirection="@view.DirectionFor("name")" AlwaysVisible="true">
                                @* The stretched link makes the whole row open the payee's details; the row's buttons stay above it. *@
                                <a class="tm-row-link stretched-link" href="@PayeeEdit.EditUrl(context.Id)" aria-label="@($"Edit {context.Name}'s details")">@context.Name</a>
                                @if (context.IsNew)
                                {
                                    <Badge Color="BadgeColor.Warning" Class="rounded-pill ms-1">New</Badge>
                                }
                            </GridColumn>
                            <GridColumn TItem="PayeeRow" HeaderText="Nickname" PropertyName="Nickname" SortString="nickname" SortKeySelector="row => row.Nickname"
                                        IsDefaultSortColumn="@view.IsSortColumn("nickname")" SortDirection="@view.DirectionFor("nickname")">
                                @if (context.Nickname.Length == 0)
                                {
                                    <span class="text-body-secondary">None</span>
                                }
                                else
                                {
                                    @context.Nickname
                                }
                            </GridColumn>
                            <GridColumn TItem="PayeeRow" HeaderText="Bank" PropertyName="Bank" SortString="bank" SortKeySelector="row => row.Bank"
                                        IsDefaultSortColumn="@view.IsSortColumn("bank")" SortDirection="@view.DirectionFor("bank")">
                                <span class="small">@context.Bank</span>
                            </GridColumn>
                            <GridColumn TItem="PayeeRow" HeaderText="Account" PropertyName="Account" Sortable="false" TextNoWrap="true">
                                <span class="tm-mono small">@context.Account</span>
                            </GridColumn>
                            <GridColumn TItem="PayeeRow" HeaderText="Name check" PropertyName="NameCheck" SortString="check" SortKeySelector="row => row.NameCheck"
                                        IsDefaultSortColumn="@view.IsSortColumn("check")" SortDirection="@view.DirectionFor("check")" TextNoWrap="true">
                                <span class="small"><Icon Name="@MatchIcon(context.Match)" class="me-1" aria-hidden="true" />@context.NameCheck</span>
                            </GridColumn>
                            <GridColumn TItem="PayeeRow" HeaderText="Added" PropertyName="Added" SortString="added" SortKeySelector="row => row.Added"
                                        IsDefaultSortColumn="@view.IsSortColumn("added")" SortDirection="@view.DirectionFor("added")" TextNoWrap="true">
                                <span class="small">@context.Added.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</span>
                            </GridColumn>
                            <GridColumn TItem="PayeeRow" HeaderText="Actions" PropertyName="Id" Sortable="false" Exportable="false" TextNoWrap="true">
                                <div class="d-flex flex-wrap gap-2">
                                    <a class="btn btn-primary btn-sm" href="@($"{FintechLayout.Base}/transfer?to={Uri.EscapeDataString(context.Id)}")" aria-label="@($"Pay {context.Name}")">
                                        <Icon Name="IconName.Send" class="me-1" aria-hidden="true" />Pay
                                    </a>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" @ref="renameButtons[context.Id]" @onclick="() => StartRenameAsync(context.Id)"
                                            aria-label="@($"{(context.Nickname.Length == 0 ? "Add a nickname for" : "Change the nickname of")} {context.Name}")">Nickname</button>
                                    <button type="button" class="btn btn-outline-danger btn-sm" @ref="deleteButtons[context.Id]" @onclick="() => AskDeleteAsync(context.Id)"
                                            aria-label="@($"Delete {context.Name}")">Delete</button>
                                </div>
                            </GridColumn>
                        </GridColumns>
                    </Grid>
                </ChildContent>
            </ShowcaseDataState>
        </CardBody>
    </Card>
</div>

@* The nickname dialog needs no one-time code: a nickname doesn't change where money goes. *@
<Modal @ref="renameModal" IsVerticallyCentered="true" ShowCloseButton="false" aria-labelledby="tm-py-rename-title" OnShown="OnRenameShownAsync" OnHidden="OnRenameHiddenAsync">
    <HeaderTemplate>
        <h2 class="modal-title h5" id="tm-py-rename-title">Nickname for @renaming?.Name</h2>
    </HeaderTemplate>
    <BodyTemplate>
        <EditForm id="tm-py-rename-form" EditContext="renameContext" OnSubmit="SaveNicknameAsync" FormName="tm-py-rename" novalidate>
            <DataAnnotationsValidator />
            <ShowcaseFormErrors />
            <label class="form-label fw-semibold" for="tm-py-nickname">Nickname <span class="fw-normal text-body-secondary">(optional)</span></label>
            <InputText id="tm-py-nickname" class="form-control" maxlength="@FintechState.MaxNicknameLength" autocomplete="off" @bind-Value="renameForm.Nickname"
                       @ref="renameInput" aria-describedby="tm-py-nickname-help" />
            <ShowcaseUniqueCheck @ref="nicknameCheck" For="() => renameForm.Nickname" IsTakenAsync="IsNicknameTakenAsync" TakenMessage="NicknameTakenMessage" />
            <div class="form-text mt-0" id="tm-py-nickname-help">Up to @FintechState.MaxNicknameLength characters, like "Landlord", and different from your other payees' nicknames. Leave it empty to remove it. Only you see it.</div>
            <ValidationMessage For="() => renameForm.Nickname" />
        </EditForm>
        <p class="text-danger-emphasis fw-semibold small mt-2 mb-0" role="alert">@renameError</p>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => renameModal.HideAsync()">Cancel</Button>
        <Button Type="ButtonType.Submit" Color="ButtonColor.Primary" form="tm-py-rename-form">Save nickname</Button>
    </FooterTemplate>
</Modal>

@* Outside the list, so the dialog is never removed while it is open. *@
<Modal @ref="deleteModal" IsVerticallyCentered="true" ShowCloseButton="false" aria-labelledby="tm-py-delete-title" OnHidden="OnDeleteHiddenAsync">
    <HeaderTemplate>
        <h2 class="modal-title h5" id="tm-py-delete-title">@(deleteBlocked ? $"{deleting?.Name} can't be deleted yet" : $"Delete {deleting?.Name}?")</h2>
    </HeaderTemplate>
    <BodyTemplate>
        @if (deleting is { } payee)
        {
            @if (deleteBlocked)
            {
                <p class="mb-2">A scheduled transfer, or a transfer held for a check, goes to @payee.Name. Cancel it on the Transfers page, or wait until it's sent; then you can delete the payee.</p>
                <p class="small text-body-secondary mb-0">The payee stays as it is.</p>
            }
            else
            {
                <p class="mb-2">@payee.Name (account @payee.MaskedAccount at @payee.BankName) is removed from your payees. Past transfers stay in your history.</p>
                <p class="small text-body-secondary mb-0">To pay them again, you'll add them again with a name check and a one-time code.</p>
            }
        }
        <p class="text-danger-emphasis fw-semibold small mt-2 mb-0" role="alert">@dialogError</p>
    </BodyTemplate>
    <FooterTemplate>
        @if (deleteBlocked)
        {
            <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => deleteModal.HideAsync()">Close</Button>
            <Button Color="ButtonColor.Primary" @onclick="GoToTransfersAsync">Go to transfers</Button>
        }
        else
        {
            <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => deleteModal.HideAsync()">Keep payee</Button>
            <Button Color="ButtonColor.Danger" @onclick="ConfirmDeleteAsync" Disabled="deleteBusy">Delete payee</Button>
        }
    </FooterTemplate>
</Modal>
