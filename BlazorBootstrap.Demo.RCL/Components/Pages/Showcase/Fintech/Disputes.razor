@page "/showcase/fintech/disputes"
@layout FintechLayout

<PageTitle>Disputes · @FintechSeedData.ProductName</PageTitle>

<div class="container-xl">
    <div class="tm-page-head">
        <div>
            <span class="sc-eyebrow">Disputes</span>
            <h1 class="tm-title">Your disputes</h1>
            <p class="tm-lead">Charges you've asked us to look into, and where each one is.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <Card Class="tm-card">
                <CardHeader>
                    <h2 class="tm-card-title">Disputes</h2>
                    <p class="tm-card-sub mb-0">@CountText</p>
                </CardHeader>
                <CardBody Class="pt-0">
                    <div class="tm-list-meta mt-0">
                        <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ResetViewAsync">Reset view</Button>
                        <span class="tm-list-status" role="status">@statusMessage</span>
                    </div>
                    <ShowcaseDataState Status="@(viewLoaded ? ShowcaseDataStatus.Ready : ShowcaseDataStatus.Loading)"
                                       IsEmpty="@(MyDisputes.Count == 0)"
                                       EmptyIcon="IconName.ShieldCheck"
                                       EmptyTitle="No disputes"
                                       EmptyText="You haven't disputed any charges. If a payment looks wrong, open it from your transactions."
                                       LoadingText="Loading your disputes…"
                                       LoadingRows="3"
                                       OnRetry="RefreshGridAsync">
                        <EmptyActions>
                            <a class="btn btn-sm btn-primary" href="@TransactionsPath">Go to transactions</a>
                        </EmptyActions>
                        <ChildContent>
                            <Grid @ref="grid"
                                  @key="gridVersion"
                                  TItem="DisputeRow"
                                  Class="table table-hover align-middle tm-table-mid sc-grid-row-links"
                                  GridContainerClass="tm-grid border rounded-3"
                                  DataProvider="ProvideRowsAsync"
                                  SettingsProvider="view.GetSettingsAsync"
                                  GridSettingsChanged="SaveSettingsAsync"
                                  AllowPaging="true"
                                  PageSize="@pageSize"
                                  PageSizeSelectorVisible="true"
                                  PageSizeSelectorItems="@(new[] { 10, 25, 50 })"
                                  PaginationItemsTextFormat="{0}–{1} of {2} disputes"
                                  AllowSorting="true"
                                  AllowColumnChooser="true"
                                  AllowExport="true"
                                  ExportFileName="banking-my-disputes"
                                  Responsive="true"
                                  EmptyText="No disputes."
                                  aria-label="Your disputes">
                                <GridColumns>
                                    <GridColumn TItem="DisputeRow" HeaderText="Dispute" PropertyName="Id" SortString="id" SortKeySelector="row => row.Id"
                                                IsDefaultSortColumn="@view.IsSortColumn("id")" SortDirection="@view.DirectionFor("id")" AlwaysVisible="true">
                                        @* The stretched link makes the whole row open the dispute. *@
                                        <a class="tm-row-link stretched-link" href="@DetailPath(context.Id)">Dispute @context.Id: @context.Merchant</a>
                                    </GridColumn>
                                    <GridColumn TItem="DisputeRow" HeaderText="Reason" PropertyName="Reason" SortString="reason" SortKeySelector="row => row.Reason"
                                                IsDefaultSortColumn="@view.IsSortColumn("reason")" SortDirection="@view.DirectionFor("reason")">
                                        <span class="small">@context.Reason</span>
                                    </GridColumn>
                                    <GridColumn TItem="DisputeRow" HeaderText="Opened" PropertyName="Opened" SortString="opened" SortKeySelector="row => row.Opened"
                                                IsDefaultSortColumn="@view.IsSortColumn("opened")" SortDirection="@view.DirectionFor("opened")" TextNoWrap="true">
                                        <span class="small">@DayText(context.Opened)</span>
                                    </GridColumn>
                                    <GridColumn TItem="DisputeRow" HeaderText="Amount" PropertyName="Amount" SortString="amount" SortKeySelector="row => row.Amount"
                                                IsDefaultSortColumn="@view.IsSortColumn("amount")" SortDirection="@view.DirectionFor("amount")" TextAlignment="Alignment.End" TextNoWrap="true">
                                        <span class="tm-mono fw-semibold">@FintechDisplay.Money(context.Amount)</span>
                                    </GridColumn>
                                    <GridColumn TItem="DisputeRow" HeaderText="Status" PropertyName="Status" SortString="status" SortKeySelector="row => row.StatusValue"
                                                IsDefaultSortColumn="@view.IsSortColumn("status")" SortDirection="@view.DirectionFor("status")" TextNoWrap="true">
                                        <Badge Color="StatusColor(context.StatusValue)" Class="rounded-pill">@context.Status</Badge>
                                    </GridColumn>
                                </GridColumns>
                            </Grid>
                        </ChildContent>
                    </ShowcaseDataState>
                </CardBody>
            </Card>
        </div>
        <div class="col-lg-4">
            <section class="tm-panel" aria-labelledby="tm-disputes-how-title">
                <h2 class="tm-section-title" id="tm-disputes-how-title">How disputes work</h2>
                <ol class="tm-disputes-steps small mb-3">
                    <li><strong>Open a dispute</strong> from the payment in your transactions: choose a reason and tell us what happened. Posted card and account payments from the last @FintechState.DisputeDays days can be disputed.</li>
                    <li><strong>We review it</strong> with the merchant. We usually answer within 10 business days, and we'll post updates in your alerts.</li>
                    <li><strong>We decide.</strong> If you're right, we refund the amount to your account. If not, we explain why the charge stands.</li>
                </ol>
                <p class="small text-body-secondary mb-3">Transfers you made can't be disputed: cancel a scheduled transfer from Transfers instead.</p>
                <a class="btn btn-sm btn-outline-primary" href="@TransactionsPath">Find a transaction to dispute</a>
            </section>
        </div>
    </div>
</div>
