@page "/showcase/fintech"
@layout FintechLayout

<PageTitle>Overview · @FintechSeedData.ProductName</PageTitle>

<div class="container-xl">
    <div class="tm-page-head">
        <div>
            <span class="sc-eyebrow">@State.Today.ToString("dddd, MMMM d", CultureInfo.InvariantCulture)</span>
            <h1 class="tm-title">Hi @FirstName, here's your money</h1>
            <p class="tm-lead">Balances, what's coming up, this month's spending, and how your budgets are tracking.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary" href="@AlertsPath">
                <Icon Name="@(State.UnreadNoticeCount > 0 ? IconName.BellFill : IconName.Bell)" class="me-1" aria-hidden="true" />@UnreadText
            </a>
            <Button Type="ButtonType.Link" To="@($"{FintechLayout.Base}/transfer")" Color="ButtonColor.Primary">
                <Icon Name="IconName.ArrowLeftRight" class="me-1" aria-hidden="true" />Move money
            </Button>
        </div>
    </div>

    <section aria-labelledby="tm-accounts-title" class="mb-4">
        <h2 class="visually-hidden" id="tm-accounts-title">Accounts</h2>
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-3">
            <div class="col">
                <Card Class="tm-hero-card h-100">
                    <CardBody Class="p-4">
                        <span class="tm-label">Net worth</span>
                        <span class="tm-amount">@(State.NetWorth < 0 ? "−" : string.Empty)@FintechDisplay.Money(State.NetWorth)</span>
                        <span class="small">@FintechDisplay.SignedMoney(MonthChange) since last month</span>
                    </CardBody>
                </Card>
            </div>
            @foreach (var account in State.Accounts)
            {
                var reserved = State.Reserved(account.Id);
                <div class="col" @key="account.Id">
                    <Card Class="tm-card h-100">
                        <CardBody Class="p-4">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                @* The stretched link makes the whole card open the account; its name is the link text. *@
                                <a class="fw-semibold stretched-link" href="@AccountPath(account.Id)">@account.Name</a>
                                <span class="tm-icon" aria-hidden="true"><Icon Name="@AccountIcon(account.Kind)" /></span>
                            </div>
                            <span class="small text-body-secondary d-block">@FintechDisplay.KindLabel(account.Kind) · @account.MaskedNumber</span>
                            @if (account.Kind == FintechAccountKind.CreditCard)
                            {
                                <span class="tm-label d-block mt-2">Owed</span>
                                <span class="tm-amount">@FintechDisplay.Money(account.Balance)</span>
                                <span class="small d-block">@FintechDisplay.Money(FintechState.CreditAvailable(account)) credit available of @FintechDisplay.Money(account.CreditLimit ?? 0)</span>
                            }
                            else
                            {
                                <span class="tm-label d-block mt-2">Balance</span>
                                <span class="tm-amount">@(account.Balance < 0 ? "−" : string.Empty)@FintechDisplay.Money(account.Balance)</span>
                                <span class="small d-block">@FintechDisplay.Money(State.Available(account)) available</span>
                                @if (reserved > 0)
                                {
                                    <span class="small text-body-secondary d-block">@FintechDisplay.Money(reserved) set aside for scheduled and held transfers</span>
                                }
                            }
                            @if (account.CardFrozen)
                            {
                                <Badge Color="BadgeColor.Warning" Class="mt-2"><Icon Name="IconName.Snow" class="me-1" aria-hidden="true" />Card frozen</Badge>
                            }
                        </CardBody>
                    </Card>
                </div>
            }
        </div>
    </section>

    <div class="row g-3 mb-4">
        <div class="col-lg-7">
            <Card Class="tm-card h-100">
                <CardHeader>
                    <h2 class="tm-card-title">Recent activity</h2>
                    <a class="small fw-semibold" href="@($"{FintechLayout.Base}/transactions")">All transactions</a>
                </CardHeader>
                <CardBody Class="pt-0">
                    <ul class="list-unstyled mb-0">
                        @foreach (var item in State.Transactions.Take(6))
                        {
                            var category = State.FindCategory(item.CategoryId);
                            <li class="tm-row" @key="item.Id">
                                <span class="tm-icon" aria-hidden="true"><Icon Name="@category.IconName" /></span>
                                <span class="tm-row-text">
                                    <a class="tm-row-title" href="@TransactionPath(item.Id)">@item.Description</a>
                                    <span class="tm-row-sub">
                                        @FintechDisplay.Day(item.Date) · @category.Name
                                        @if (item.IsPending)
                                        {
                                            <Badge Color="BadgeColor.Secondary" Class="ms-1">Pending</Badge>
                                        }
                                        @if (item.DisputeId is not null)
                                        {
                                            <Badge Color="BadgeColor.Info" Class="ms-1">Disputed</Badge>
                                        }
                                    </span>
                                </span>
                                <span class="tm-mono fw-semibold text-nowrap @FintechDisplay.AmountClass(item.Amount)">@FintechDisplay.SignedMoney(item.Amount)</span>
                            </li>
                        }
                    </ul>
                </CardBody>
            </Card>
        </div>
        <div class="col-lg-5">
            <Card Class="tm-card h-100">
                <CardHeader>
                    <div>
                        <h2 class="tm-card-title">Coming up</h2>
                        <p class="tm-card-sub">Scheduled transfers and transfers held for a check</p>
                    </div>
                    <a class="small fw-semibold" href="@($"{FintechLayout.Base}/transfers")">All transfers</a>
                </CardHeader>
                <CardBody Class="pt-0">
                    @if (ComingUp.Count == 0)
                    {
                        <p class="small text-body-secondary border-top pt-3 mb-0">Nothing coming up. Transfers you schedule for a later date, and any held for a check, show here.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var transfer in ComingUp)
                            {
                                var held = transfer.Status == FintechTransferStatus.Held;
                                <li class="tm-row" @key="transfer.Reference">
                                    <span class="tm-icon" aria-hidden="true"><Icon Name="@(held ? IconName.ShieldExclamation : IconName.CalendarEvent)" /></span>
                                    <span class="tm-row-text">
                                        <a class="tm-row-title" href="@TransferPath(transfer.Reference)">To @transfer.ToName</a>
                                        <span class="tm-row-sub">
                                            <Badge Color="@(held ? BadgeColor.Warning : BadgeColor.Secondary)" Class="me-1">@(held ? "Held for a check" : "Scheduled")</Badge>
                                            @(held ? "Waiting for our check" : $"Goes on {ShortDay(transfer.Date)}") · from @(State.FindAccount(transfer.FromAccountId)?.Name ?? "your account")
                                        </span>
                                    </span>
                                    <span class="tm-mono fw-semibold text-nowrap tm-out">@FintechDisplay.SignedMoney(-transfer.Amount)</span>
                                </li>
                            }
                        </ul>
                    }
                </CardBody>
            </Card>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-7">
            <Card Class="tm-card h-100">
                <CardHeader>
                    <div>
                        <h2 class="tm-card-title">Net worth</h2>
                        <p class="tm-card-sub">Last 12 months, all accounts combined</p>
                    </div>
                </CardHeader>
                <CardBody Class="pt-0">
                    <div class="tm-chart" role="img" aria-label="@NetWorthChartLabel">
                        <LineChart @ref="netWorthChart" Height="280" HeightUnit="Unit.Px" Width="100" WidthUnit="Unit.Percentage" />
                    </div>
                    @* The wrapper hides the table: a hidden table itself can't shrink below its content and would widen the page. *@
                    <div class="visually-hidden">
                        <Table Data="NetWorthRows" Caption="Net worth at the end of each of the last 12 months">
                            <TableColumn HeaderText="Month" IsRowHeader="true" Context="row">@row.Month</TableColumn>
                            <TableColumn HeaderText="Net worth" Context="row">@(row.Value < 0 ? "−" : string.Empty)@FintechDisplay.Money(row.Value)</TableColumn>
                        </Table>
                    </div>
                </CardBody>
            </Card>
        </div>
        <div class="col-xl-5">
            <Card Class="tm-card h-100">
                <CardHeader>
                    <div>
                        <h2 class="tm-card-title">Spending this month</h2>
                        <p class="tm-card-sub">@FintechDisplay.Money(TotalSpent) across @Spending.Count categories</p>
                    </div>
                </CardHeader>
                <CardBody Class="pt-0">
                    <div class="tm-chart" role="img" aria-label="@SpendingChartLabel">
                        <DoughnutChart @ref="spendingChart" Height="280" HeightUnit="Unit.Px" Width="100" WidthUnit="Unit.Percentage" />
                    </div>
                    <div class="visually-hidden">
                        <Table Data="Spending" Caption="Spending this month by category">
                            <TableColumn HeaderText="Category" IsRowHeader="true" Context="entry">@entry.Category.Name</TableColumn>
                            <TableColumn HeaderText="Spent" Context="entry">@FintechDisplay.Money(entry.Spent)</TableColumn>
                        </Table>
                    </div>
                </CardBody>
            </Card>
        </div>
    </div>

    <Card Class="tm-card">
        <CardHeader>
            <h2 class="tm-card-title">Budgets to watch</h2>
            <a class="small fw-semibold" href="@($"{FintechLayout.Base}/budgets")">All budgets</a>
        </CardHeader>
        <CardBody Class="pt-0">
            @if (!State.Budgets.Any())
            {
                <p class="small text-body-secondary border-top pt-3 mb-0">You have no budgets yet. Add one on the budgets page to track a category each month.</p>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 gx-4">
                    @foreach (var budget in BudgetsToWatch)
                    {
                        var category = State.FindCategory(budget.CategoryId);
                        var spent = State.SpentThisMonth(budget.CategoryId);
                        var percent = (double)(spent / budget.Limit * 100);
                        <div class="col" @key="budget.CategoryId">
                            <div class="py-2 border-top">
                                <div class="tm-meter-label mb-1">
                                    <span class="fw-semibold text-body">@category.Name</span>
                                    <span class="tm-mono">@FintechDisplay.Money(spent) of @FintechDisplay.Money(budget.Limit)</span>
                                </div>
                                <Progress Height="8">
                                    <ProgressBar Width="Math.Min(100, percent)" Color="BudgetColor(percent)"
                                                 aria-label="@($"{category.Name} budget used")" aria-valuenow="@((int)Math.Round(percent))" aria-valuemin="0" aria-valuemax="100"
                                                 aria-valuetext="@($"{FintechDisplay.Money(spent)} of {FintechDisplay.Money(budget.Limit)}{(percent > 100 ? ", over budget" : string.Empty)}")" />
                                </Progress>
                            </div>
                        </div>
                    }
                </div>
            }
        </CardBody>
    </Card>
</div>
