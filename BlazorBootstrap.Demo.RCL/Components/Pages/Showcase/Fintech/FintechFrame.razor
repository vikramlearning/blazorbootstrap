<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600&display=swap" />
</HeadContent>

@* The frame both Tallymint layouts share: the customer bank and the operations back office (D-031). Its stylesheet styles
   the pages of both through ::deep. *@
<div class="sc-site sc-fintech">
    <ShowcaseSiteBar Site="@site" OnThemeChanged="OnThemeChanged" />

    @Header

    <div class="@(Sidebar is null ? null : "tm-shell")">
        @Sidebar

        <div class="@(Sidebar is null ? null : "tm-shell-main")">
            @* Pages show balances, transactions, payees, and customers, so the content is masked from session recording. *@
            <main class="sc-main tm-content" id="tm-main" data-clarity-mask="true">
                @ChildContent
            </main>

            <div class="@Container">
                <CarbonAds Class="sc-ad" />
            </div>

            <footer class="tm-footer">
                <div class="@Container d-flex flex-wrap justify-content-between gap-2">
                    <span>© 2026 @FintechSeedData.ProductName (fictitious). Accounts, people, and amounts are made up and stay in this browser tab; no money moves and no text messages are sent.</span>
                    <span class="d-none d-lg-inline">Built with Navbar, Sidebar, Card, Charts, Progress, CurrencyInput, Modal, and Alert.</span>
                </div>
            </footer>
        </div>
    </div>

    @* Toasts can name payees, customers, and amounts, so they are masked from session recording like the page content. *@
    <div data-clarity-mask="true">
        <Toasts class="p-3" AutoHide="true" Delay="5000" Placement="ToastsPlacement.BottomRight" />
    </div>
</div>

@code {
    private readonly ShowcaseSite site = ShowcaseCatalog.Get("fintech");

    /// <summary>Gets or sets the page content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Gets or sets the header above the page (the bank's Navbar, or the operations top bar).</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    /// <summary>Gets or sets the sidebar beside the page (operations), or <see langword="null" /> for none.</summary>
    [Parameter] public RenderFragment? Sidebar { get; set; }

    private string Container => Sidebar is null ? "container-xl" : "container-fluid px-lg-4";

    [Inject] private FintechState State { get; set; } = default!;

    private void OnThemeChanged(string themeName) => State.SetTheme(themeName);
}
