@page "/showcase/fintech/transactions"
@layout FintechLayout

<PageTitle>Transactions · @FintechSeedData.ProductName</PageTitle>

<div class="container-xl">
    <div class="tm-page-head">
        <div>
            <span class="sc-eyebrow">Transactions</span>
            <h1 class="tm-title">Every payment, in one place</h1>
            <p class="tm-lead">Search and filter the last 90 days across all accounts. Open a transaction to change its category, add a note, or dispute it.</p>
        </div>
        <RadioButtonGroup TValue="FintechPeriod" Value="period" ValueExpression="() => period" ValueChanged="OnPeriodChanged"
                          AriaLabel="Period" Size="ButtonGroupSize.Small">
            <ButtonGroupItem Value="FintechPeriod.Last30Days" Id="tm-period-30">30 days</ButtonGroupItem>
            <ButtonGroupItem Value="FintechPeriod.Last60Days" Id="tm-period-60">60 days</ButtonGroupItem>
            <ButtonGroupItem Value="FintechPeriod.Last90Days" Id="tm-period-90">90 days</ButtonGroupItem>
        </RadioButtonGroup>
    </div>

    <section aria-label="Totals for the current filter" class="row row-cols-1 row-cols-sm-3 g-3 mb-3">
        <div class="col">
            <Card Class="tm-card h-100"><CardBody Class="p-3">
                <span class="tm-label">Money in</span>
                <span class="tm-amount tm-in">@FintechDisplay.SignedMoney(MoneyIn)</span>
            </CardBody></Card>
        </div>
        <div class="col">
            <Card Class="tm-card h-100"><CardBody Class="p-3">
                <span class="tm-label">Money out</span>
                <span class="tm-amount tm-out">@FintechDisplay.SignedMoney(-MoneyOut)</span>
            </CardBody></Card>
        </div>
        <div class="col">
            <Card Class="tm-card h-100"><CardBody Class="p-3">
                <span class="tm-label">Net</span>
                <span class="tm-amount @FintechDisplay.AmountClass(MoneyIn - MoneyOut)">@FintechDisplay.SignedMoney(MoneyIn - MoneyOut)</span>
            </CardBody></Card>
        </div>
    </section>

    <Card Class="tm-card">
        <CardBody Class="p-3 p-lg-4">
            <div class="row g-2 align-items-end mb-3" role="search" aria-label="Filter transactions">
                <div class="col-md-6 col-lg-5">
                    <label class="form-label small fw-semibold" for="tm-search">Search by description</label>
                    <InputGroup>
                        <InputGroupText><Icon Name="IconName.Search" aria-hidden="true" /></InputGroupText>
                        @* The bound value changes only on change; @oninput filters live without writing older text back into the box. *@
                        <TextInput @ref="searchInput" Id="tm-search" Value="@searchBoxValue" ValueExpression="() => searchBoxValue" ValueChanged="OnSearchChanged"
                                   @oninput="OnSearchInput" Placeholder="Merchant or description" />
                    </InputGroup>
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <label class="form-label small fw-semibold" for="tm-account">Account</label>
                    <select id="tm-account" class="form-select" value="@accountFilter" @onchange="OnAccountChanged">
                        <option value="">All accounts</option>
                        @foreach (var account in State.Accounts)
                        {
                            <option value="@account.Id">@account.Name</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <label class="form-label small fw-semibold" for="tm-category">Category</label>
                    <select id="tm-category" class="form-select" value="@categoryFilter" @onchange="OnCategoryChanged">
                        <option value="">All categories</option>
                        @foreach (var category in State.Categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                </div>
                <div class="col-lg-3 d-flex flex-wrap align-items-center gap-2 justify-content-lg-end">
                    @* Polite, so the count is read after typing pauses or a filter changes. *@
                    <span class="small text-body-secondary" role="status">@MatchText</span>
                    @if (HasFilters)
                    {
                        <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ClearFilters">Clear filters</Button>
                    }
                </div>
            </div>

            <div class="table-responsive tm-grid">
                <table class="table table-hover align-middle mb-0">
                    <caption class="caption-top small">@CaptionText</caption>
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Description</th>
                            <th scope="col" class="d-none d-md-table-cell">Category</th>
                            <th scope="col" class="d-none d-lg-table-cell">Account</th>
                            <th scope="col" class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Shown.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-body-secondary py-4 text-center">No transactions match these filters.</td>
                            </tr>
                        }
                        @foreach (var (item, index) in Shown.Select((item, index) => (item, index)))
                        {
                            var category = State.FindCategory(item.CategoryId);
                            var accountName = State.FindAccount(item.AccountId)?.Name;
                            <tr @key="item.Id">
                                <td class="tm-mono small text-nowrap">@FintechDisplay.Day(item.Date)</td>
                                <td class="text-break">
                                    @if (index == firstNewIndex)
                                    {
                                        @* The first row "Show more" added: focus moves here, so keyboard users carry on reading. *@
                                        <a class="fw-semibold" href="@TransactionPath(item.Id)" @ref="firstNewLink">@item.Description</a>
                                    }
                                    else
                                    {
                                        <a class="fw-semibold" href="@TransactionPath(item.Id)">@item.Description</a>
                                    }
                                    @if (item.IsPending)
                                    {
                                        <Badge Color="BadgeColor.Secondary" Class="ms-1">@(DateOnly.FromDateTime(item.Date) > State.Today ? "Scheduled" : "Pending")</Badge>
                                    }
                                    @if (item.DisputeId is not null)
                                    {
                                        <Badge Color="BadgeColor.Info" Class="ms-1">Disputed</Badge>
                                    }
                                    @if (!string.IsNullOrEmpty(item.Note))
                                    {
                                        <span class="d-block small text-body-secondary"><Icon Name="IconName.Sticky" class="me-1" aria-hidden="true" /><span class="visually-hidden">Note: </span>@item.Note</span>
                                    }
                                    @* Below md the category and account columns are hidden, so they show under the description instead. *@
                                    <span class="d-block d-lg-none small text-body-secondary">
                                        <span class="d-md-none">@category.Name · </span>@accountName
                                    </span>
                                </td>
                                <td class="d-none d-md-table-cell text-nowrap small">
                                    <Icon Name="@category.IconName" class="me-1 text-body-secondary" aria-hidden="true" />@category.Name
                                </td>
                                <td class="d-none d-lg-table-cell text-nowrap small">@accountName</td>
                                <td class="text-end text-nowrap">
                                    <span class="tm-mono fw-semibold @FintechDisplay.AmountClass(item.Amount)">@FintechDisplay.SignedMoney(item.Amount)</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (FilteredCount > Shown.Count)
            {
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3">
                    <span class="small text-body-secondary">Showing @Shown.Count of @FilteredCount</span>
                    <Button Color="ButtonColor.Primary" Outline="true" Size="ButtonSize.Small" @onclick="ShowMore">
                        Show @Math.Min(PageSize, FilteredCount - Shown.Count) more
                    </Button>
                </div>
            }
        </CardBody>
    </Card>
</div>
