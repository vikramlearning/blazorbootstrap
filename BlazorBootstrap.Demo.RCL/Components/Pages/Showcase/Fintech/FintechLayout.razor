@inherits LayoutComponentBase

<ShowcaseSessionHost State="State" SiteBase="@Base" SiteName="@FintechSeedData.ProductName">
<FintechFrame>
    <Header>
    <Navbar Class="tm-header"
            Placement="NavbarPlacement.StickyTop"
            Container="NavbarContainer.ExtraLarge"
            AriaLabel="Tallymint"
            TogglerAriaLabel="Menu">
        <Brand>
            <NavbarBrand Href="@Base" Class="tm-brand">
                <span class="tm-brand-mark" aria-hidden="true"><Icon Name="IconName.Coin" /></span>
                <span>@FintechSeedData.ProductName</span>
            </NavbarBrand>
            @if (State.Identity.IsSignedIn)
            {
                <ShowcaseAccountMenu SiteBase="@Base" SignInPath="@SignInPath" Class="ms-auto me-2 order-lg-last"
                                     NoticeCount="@State.UnreadNoticeCount" NoticesPath="@($"{Base}/alerts")" />
            }
            else
            {
                <a class="btn btn-sm btn-outline-secondary ms-auto me-2 order-lg-last" href="@SignInPath">Sign in</a>
            }
        </Brand>
        <ChildContent>
            @if (State.IsVerified)
            {
                <NavbarNav Class="me-auto ms-lg-4 mb-3 mb-lg-0">
                    <NavbarItem Href="@Base" Match="NavLinkMatch.All">Overview</NavbarItem>
                    <NavbarItem Href="@($"{Base}/transactions")">Transactions</NavbarItem>
                    <NavbarItem Href="@($"{Base}/transfers")">Transfers</NavbarItem>
                    <NavbarItem Href="@($"{Base}/payees")">Payees</NavbarItem>
                    <NavbarItem Href="@($"{Base}/budgets")">Budgets</NavbarItem>
                    <NavbarItem Href="@($"{Base}/alerts")">Alerts@(State.UnreadNoticeCount > 0 ? $" ({State.UnreadNoticeCount})" : null)</NavbarItem>
                </NavbarNav>
            }
        </ChildContent>
    </Navbar>

    </Header>
    <ChildContent>
        @if (IsSignInPage)
        {
            @Body
        }
        else
        {
            @* Every page but sign-in is the customer's: a password, then a one-time code (CR-001-AC-15). *@
            <FintechGuard Role="@FintechSeedData.CustomerRole">
                @Body
            </FintechGuard>
        }
    </ChildContent>
</FintechFrame>
</ShowcaseSessionHost>
