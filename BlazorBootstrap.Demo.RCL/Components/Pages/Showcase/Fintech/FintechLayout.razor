@inherits LayoutComponentBase

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600&display=swap" />
</HeadContent>

<ShowcaseSessionHost State="State" SiteBase="@Base" SiteName="@FintechSeedData.ProductName">
<div class="sc-site sc-fintech">
    <ShowcaseSiteBar Site="@site" OnThemeChanged="OnThemeChanged" />

    <Navbar Class="tm-header"
            Placement="NavbarPlacement.StickyTop"
            Container="NavbarContainer.ExtraLarge"
            AriaLabel="Tallymint"
            TogglerAriaLabel="Menu">
        <Brand>
            <NavbarBrand Href="@Base" Class="tm-brand">
                <span class="tm-brand-mark" aria-hidden="true"><Icon Name="IconName.Coin" /></span>
                <span>@FintechSeedData.ProductName</span>
            </NavbarBrand>
            @if (State.Identity.IsSignedIn)
            {
                <ShowcaseAccountMenu SiteBase="@Base" SignInPath="@SignInPath" Class="ms-auto me-2 order-lg-last"
                                     NoticeCount="@State.UnreadNoticeCount" NoticesPath="@($"{Base}/alerts")" />
            }
            else
            {
                <a class="btn btn-sm btn-outline-secondary ms-auto me-2 order-lg-last" href="@SignInPath">Sign in</a>
            }
        </Brand>
        <ChildContent>
            @if (State.IsVerified)
            {
                <NavbarNav Class="me-auto ms-lg-4 mb-3 mb-lg-0">
                    <NavbarItem Href="@Base" Match="NavLinkMatch.All">Overview</NavbarItem>
                    <NavbarItem Href="@($"{Base}/transactions")">Transactions</NavbarItem>
                    <NavbarItem Href="@($"{Base}/transfers")">Transfers</NavbarItem>
                    <NavbarItem Href="@($"{Base}/payees")">Payees</NavbarItem>
                    <NavbarItem Href="@($"{Base}/budgets")">Budgets</NavbarItem>
                    <NavbarItem Href="@($"{Base}/alerts")">Alerts@(State.UnreadNoticeCount > 0 ? $" ({State.UnreadNoticeCount})" : null)</NavbarItem>
                </NavbarNav>
            }
        </ChildContent>
    </Navbar>

    @* Pages show balances, transactions, and payees, so the content is masked from session recording. *@
    <main class="sc-main tm-content" id="tm-main" data-clarity-mask="true">
        @if (IsSignInPage)
        {
            @Body
        }
        else
        {
            @* Every page but sign-in is the customer's: a password, then a one-time code (CR-001-AC-15). *@
            <FintechCustomerGuard>
                @Body
            </FintechCustomerGuard>
        }
    </main>

    <div class="container-xl">
        <CarbonAds Class="sc-ad" />
    </div>

    <footer class="tm-footer">
        <div class="container-xl d-flex flex-wrap justify-content-between gap-2">
            <span>© 2026 @FintechSeedData.ProductName (fictitious). Accounts, people, and amounts are made up and stay in this browser tab; no money moves and no text messages are sent.</span>
            <span class="d-none d-lg-inline">Built with Navbar, Card, Charts, Progress, CurrencyInput, Modal, Tabs, and Alert.</span>
        </div>
    </footer>

    @* Toasts can name payees and amounts, so they are masked from session recording like the page content. *@
    <div data-clarity-mask="true">
        <Toasts class="p-3" AutoHide="true" Delay="5000" Placement="ToastsPlacement.BottomRight" />
    </div>
</div>
</ShowcaseSessionHost>
