@page "/showcase/fintech/transfer"
@layout FintechLayout

<PageTitle>New transfer · @FintechSeedData.ProductName</PageTitle>

<div class="container-xl">
    <div class="tm-page-head">
        <div>
            <span class="sc-eyebrow">Move money · Step 1 of 2</span>
            <h1 class="tm-title">New transfer</h1>
            <p class="tm-lead">Between your accounts or to a payee, today or on a later date. You'll review it before anything moves.</p>
        </div>
        <a class="btn btn-outline-secondary" href="@($"{FintechLayout.Base}/transfers")"><Icon Name="IconName.ArrowLeft" class="me-2" aria-hidden="true" />Transfers</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <EditForm class="tm-panel" EditContext="editContext" OnSubmit="ContinueAsync" FormName="tm-transfer" novalidate aria-label="New transfer">
                <DataAnnotationsValidator />
                <ShowcaseFormErrors ShowSummary="true" />
                <ShowcaseDemoNotice Class="mb-4" Text="Demo only: no money moves. Transfers change this demo's balances in this browser tab." />

                <fieldset class="mb-4">
                    <legend class="form-label fw-semibold fs-6">From</legend>
                    <InputRadioGroup TValue="string" @bind-Value="form.FromId" Name="tm-tf-from">
                        <div class="row row-cols-1 row-cols-sm-2 g-2">
                            @foreach (var account in SourceAccounts)
                            {
                                var inputId = $"tm-tf-from-{account.Id}";
                                var reserved = State.Reserved(account.Id);
                                <div class="col" @key="account.Id"><div class="form-check border rounded-3 p-3 ps-5 h-100">
                                    <InputRadio TValue="string" class="form-check-input" id="@inputId" Value="account.Id" />
                                    <label class="form-check-label w-100" for="@inputId">
                                        <span class="d-block fw-semibold">@account.Name</span>
                                        <span class="d-block small tm-mono">@FintechDisplay.Money(State.Available(account)) available</span>
                                        @if (reserved > 0)
                                        {
                                            <span class="d-block small text-body-secondary">after @FintechDisplay.Money(reserved) set aside for scheduled and held transfers</span>
                                        }
                                    </label>
                                </div></div>
                            }
                        </div>
                    </InputRadioGroup>
                    <ValidationMessage For="() => form.FromId" />
                </fieldset>

                <div class="mb-4">
                    <label class="form-label fw-semibold" for="tm-tf-to">To</label>
                    <InputSelect id="tm-tf-to" class="form-select" @bind-Value="form.ToId" aria-describedby="tm-tf-to-help">
                        <option value="">Choose who to send money to</option>
                        <optgroup label="Your accounts">
                            @foreach (var account in State.Accounts.Where(account => account.Id != form.FromId))
                            {
                                <option value="@account.Id">@account.Name (@account.MaskedNumber)@(account.Kind == FintechAccountKind.CreditCard ? ", a card payment" : string.Empty)</option>
                            }
                        </optgroup>
                        @if (State.Payees.Count > 0)
                        {
                            <optgroup label="Payees">
                                @foreach (var payee in State.Payees)
                                {
                                    <option value="@payee.Id">@PayeeOption(payee)</option>
                                }
                            </optgroup>
                        }
                    </InputSelect>
                    <div class="form-text" id="tm-tf-to-help">
                        @if (SelectedPayee is { } chosen)
                        {
                            <span class="d-block">@chosen.BankName, account @chosen.MaskedAccount. @MatchHint(chosen)</span>
                        }
                        Paying someone new? <a href="@($"{FintechLayout.Base}/payees/new")">Add a payee</a> first.
                    </div>
                    <ValidationMessage For="() => form.ToId" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold" for="tm-tf-amount">Amount</label>
                    <CurrencyInput TValue="decimal?" Id="tm-tf-amount" @bind-Value="form.Amount" Locale="en-US" Placeholder="$0.00"
                                   aria-describedby="tm-tf-amount-help tm-tf-amount-hint" />
                    <div class="form-text" id="tm-tf-amount-help">
                        @if (SelectedSource is { } source)
                        {
                            @($"{source.Name} has {FintechDisplay.Money(State.Available(source))} available. Transfers are up to $50,000.00 each, and payments to payees up to {FintechDisplay.Money(FintechState.DailyPayeeLimit)} a day.")
                        }
                        else
                        {
                            @("Choose an account to send from.")
                        }
                    </div>
                    <ValidationMessage For="() => form.Amount" />
                    @* Live hint: polite, so it's read once the amount or recipient changes, without interrupting. *@
                    <div id="tm-tf-amount-hint" aria-live="polite">
                        @if (HoldHint is { } hold)
                        {
                            <p class="small fw-semibold text-warning-emphasis mb-0 mt-2"><Icon Name="IconName.ShieldExclamation" class="me-2" aria-hidden="true" />@hold</p>
                        }
                    </div>
                </div>

                <fieldset class="mb-4">
                    <legend class="form-label fw-semibold fs-6">When</legend>
                    <InputRadioGroup TValue="bool" @bind-Value="form.IsLater" Name="tm-tf-when">
                        <div class="d-flex flex-wrap column-gap-4 row-gap-2">
                            <div class="form-check">
                                <InputRadio TValue="bool" class="form-check-input" id="tm-tf-when-today" Value="false" />
                                <label class="form-check-label" for="tm-tf-when-today">Today <span class="text-body-secondary">(sent straight away, unless held for a check)</span></label>
                            </div>
                            <div class="form-check">
                                <InputRadio TValue="bool" class="form-check-input" id="tm-tf-when-later" Value="true" />
                                <label class="form-check-label" for="tm-tf-when-later">Later <span class="text-body-secondary">(on a date you choose)</span></label>
                            </div>
                        </div>
                    </InputRadioGroup>
                    @if (form.IsLater)
                    {
                        <div class="mt-3">
                            <label class="form-label" for="tm-tf-date">Date</label>
                            <InputDate TValue="DateOnly?" id="tm-tf-date" class="form-control" @bind-Value="form.LaterDate" min="@IsoDate(State.Today)" max="@IsoDate(LastDate)"
                                       ParsingErrorMessage="Enter the date like 12/01/2026." aria-describedby="tm-tf-date-help" />
                            <div class="form-text" id="tm-tf-date-help">From today up to @Transfers.DateText(LastDate). The money is set aside until then, and you can cancel it before it's sent.</div>
                            <ValidationMessage For="() => form.LaterDate" />
                        </div>
                    }
                </fieldset>

                <div class="mb-2">
                    <label class="form-label fw-semibold" for="tm-tf-note">Note <span class="fw-normal text-body-secondary">(@(NoteRequired ? "required for this payment" : "optional"))</span></label>
                    <InputText id="tm-tf-note" class="form-control" maxlength="@FintechState.MaxTransferNote" @bind-Value="form.Note" placeholder="Rent for December"
                               @oninput="args => noteLength = args.Value?.ToString()?.Length ?? 0" aria-describedby="tm-tf-note-help" />
                    <div class="form-text" id="tm-tf-note-help">
                        Up to @FintechState.MaxTransferNote characters (@noteLength used). It shows on your transactions and the receipt.
                        A payment of @FintechDisplay.Money(FintechState.HoldLargeAmount) or more to a payee needs one, so our check knows what it's for.
                    </div>
                    <ValidationMessage For="() => form.Note" />
                </div>

                <div tabindex="-1" @ref="errorRegion">
                    @if (error is not null)
                    {
                        <Alert Color="AlertColor.Danger" Class="mt-3 mb-0" role="alert">
                            <Icon Name="IconName.ExclamationTriangleFill" class="me-2" aria-hidden="true" />@error
                        </Alert>
                    }
                </div>

                <Button Type="ButtonType.Submit" Color="ButtonColor.Primary" Size="ButtonSize.Large" Class="w-100 mt-4">
                    Continue to review
                </Button>
            </EditForm>
        </div>

        <div class="col-lg-5">
            <section class="tm-panel" aria-labelledby="tm-tf-rules-title">
                <h2 class="tm-section-title" id="tm-tf-rules-title">Before you send</h2>
                <ul class="small d-grid gap-2 ps-3 mb-0">
                    <li><strong>Available</strong> is the balance less money set aside for scheduled transfers and transfers held for a check.</li>
                    <li><strong>Today</strong> sends the money straight away; once sent, it can't be cancelled.</li>
                    <li><strong>Later</strong> schedules it. The money is set aside until the date, and you can cancel it until then.</li>
                    <li>
                        <strong>Checks:</strong> to protect you from scams, we hold a payment to a payee for a routine check when it's
                        @FintechDisplay.Money(FintechState.HoldLargeAmount) or more, or @FintechDisplay.Money(FintechState.HoldNewPayeeAmount) or more to a payee added in
                        the last @FintechState.NewPayeeDays days or whose name couldn't be confirmed. We usually check within one business day.
                    </li>
                    <li><strong>Daily limit:</strong> payments to payees are limited to @FintechDisplay.Money(FintechState.DailyPayeeLimit) a day, counting every transfer dated that day.</li>
                    <li>Moving money between your own accounts is never held.</li>
                </ul>
            </section>
        </div>
    </div>
</div>
