@page "/showcase/fintech/transfer/confirm"
@layout FintechLayout

<PageTitle>Review transfer · @FintechSeedData.ProductName</PageTitle>

<div class="container-xl">
    @if (confirmed)
    {
        @* Confirmed: the receipt opens next; this keeps "Nothing to review" from flashing meanwhile. *@
        <p class="text-body-secondary" role="status">Opening the receipt…</p>
    }
    else if (State.PendingTransfer is not { } draft)
    {
        <section class="tm-not-found" aria-labelledby="tm-tc-none-title">
            <span class="tm-icon fs-4 mb-3" aria-hidden="true"><Icon Name="IconName.ArrowLeftRight" /></span>
            <h1 class="tm-title fs-3 mt-3" id="tm-tc-none-title">Nothing to review</h1>
            <p class="text-body-secondary">There's no transfer waiting for review. It may already be confirmed, or the page was reloaded, which clears an unconfirmed transfer. Nothing was sent.</p>
            <div class="d-flex justify-content-center flex-wrap gap-2">
                <a class="btn btn-primary" href="@($"{FintechLayout.Base}/transfer")">New transfer</a>
                <a class="btn btn-outline-secondary" href="@($"{FintechLayout.Base}/transfers")">Your transfers</a>
            </div>
        </section>
    }
    else
    {
        var source = State.FindAccount(draft.FromAccountId);
        var toAccount = State.FindAccount(draft.ToId);
        var payee = toAccount is null ? State.FindPayee(draft.ToId) : null;
        var hold = Transfer.ExpectedHoldReason(State, draft.ToId, draft.Amount);

        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                <div class="tm-page-head">
                    <div>
                        <span class="sc-eyebrow">Move money · Step 2 of 2</span>
                        <h1 class="tm-title">Review your transfer</h1>
                        <p class="tm-lead">Check the details. Nothing moves until you confirm.</p>
                    </div>
                </div>

                <section class="tm-panel mb-3" aria-labelledby="tm-tc-amount-label">
                    <span class="tm-label" id="tm-tc-amount-label">Amount</span>
                    <span class="tm-amount mb-3">@FintechDisplay.Money(draft.Amount)</span>
                    <dl class="row tm-summary mb-0">
                        <dt class="col-sm-4">From</dt>
                        <dd class="col-sm-8">
                            @(source?.Name ?? "Unknown account")
                            @if (source is not null)
                            {
                                <span class="d-block fw-normal small text-body-secondary">@source.MaskedNumber · @FintechDisplay.Money(State.Available(source)) available now</span>
                            }
                        </dd>
                        <dt class="col-sm-4">To</dt>
                        <dd class="col-sm-8">
                            @State.DestinationName(draft.ToId)
                            @if (toAccount is not null)
                            {
                                <span class="d-block fw-normal small text-body-secondary">Your @FintechDisplay.KindLabel(toAccount.Kind).ToLowerInvariant() account · @toAccount.MaskedNumber</span>
                            }
                            else if (payee is not null)
                            {
                                <span class="d-block fw-normal small text-body-secondary">@(payee.Nickname is { } nickname ? $"\"{nickname}\" · " : string.Empty)@payee.BankName · account @payee.MaskedAccount</span>
                            }
                        </dd>
                        <dt class="col-sm-4">Date</dt>
                        <dd class="col-sm-8">@(draft.Date <= State.Today ? $"Today, {Transfers.DateText(draft.Date)}" : Transfers.DateText(draft.Date))</dd>
                        <dt class="col-sm-4">Note</dt>
                        <dd class="col-sm-8 text-break">@(draft.Note ?? "None")</dd>
                    </dl>
                </section>

                <section class="tm-panel mb-3" aria-labelledby="tm-tc-next-title">
                    <h2 class="tm-section-title d-flex align-items-center gap-2" id="tm-tc-next-title">
                        <Icon Name="@(hold is not null ? IconName.ShieldExclamation : draft.Date > State.Today ? IconName.CalendarEvent : IconName.Send)" aria-hidden="true" />
                        @(hold is not null ? "Held for a check" : draft.Date > State.Today ? $"Scheduled for {Transfers.DateText(draft.Date)}" : "Sent now")
                    </h2>
                    @if (hold is not null)
                    {
                        <p class="mb-2">This payment is held for a routine check before it's sent, because it's @HoldBecause(hold).</p>
                        <p class="small text-body-secondary mb-0">
                            Our team usually checks within one business day@(draft.Date > State.Today ? $", then it goes on {Transfers.DateText(draft.Date)}" : string.Empty).
                            The money is set aside in @(source?.Name ?? "your account") meanwhile, and you can cancel the transfer while it's held. We'll send you an alert either way.
                        </p>
                    }
                    else if (draft.Date > State.Today)
                    {
                        <p class="mb-2">It's sent on @Transfers.DateText(draft.Date). The money is set aside in @(source?.Name ?? "your account") until then, so it can't be spent twice.</p>
                        <p class="small text-body-secondary mb-0">You can cancel it until it's sent. If there isn't enough money on the day, it isn't sent and we'll tell you.</p>
                    }
                    else
                    {
                        <p class="mb-2">The money leaves @(source?.Name ?? "your account") straight away@(toAccount is not null ? $" and arrives in {toAccount.Name} at once" : string.Empty).</p>
                        <p class="small text-body-secondary mb-0">A transfer sent today can't be cancelled.</p>
                    }
                </section>

                <div tabindex="-1" @ref="errorRegion">
                    @if (errorMessage is not null)
                    {
                        <Alert Color="AlertColor.Danger" Class="mb-3" role="alert">
                            <Icon Name="IconName.ExclamationTriangleFill" class="me-2" aria-hidden="true" />@errorMessage
                        </Alert>
                    }
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <Button Color="ButtonColor.Primary" Size="ButtonSize.Large" @onclick="Confirm" Disabled="submitting">
                        <Icon Name="IconName.ShieldCheck" class="me-2" aria-hidden="true" />Confirm transfer
                    </Button>
                    <a class="btn btn-outline-secondary btn-lg" href="@($"{FintechLayout.Base}/transfer")">Edit</a>
                </div>
                <p class="small text-body-secondary mt-3 mb-0">This is a demo: no real money moves.</p>
            </div>
        </div>
    }
</div>
