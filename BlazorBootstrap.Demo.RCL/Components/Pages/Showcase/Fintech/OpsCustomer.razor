@page "/showcase/fintech/ops/customers/{Id}"
@layout FintechOpsLayout

@if (Customer is not { } customer)
{
    <PageTitle>Customer not found · Operations · @FintechSeedData.ProductName</PageTitle>

    <div class="container-fluid px-lg-4">
        <section class="tm-not-found" aria-labelledby="tm-opscustomer-missing-title">
            <span class="tm-icon fs-4" aria-hidden="true"><Icon Name="IconName.People" /></span>
            <h1 class="tm-title fs-3 mt-3 mb-2" id="tm-opscustomer-missing-title">We couldn't find that customer</h1>
            <p class="tm-lead mb-4">There's no customer "@Id". Find them in the customer list.</p>
            <div class="d-flex justify-content-center flex-wrap gap-2">
                <Button Type="ButtonType.Link" To="@CustomersPath" Color="ButtonColor.Primary">All customers</Button>
                <Button Type="ButtonType.Link" To="@FintechOpsLayout.Base" Color="ButtonColor.Primary" Outline="true">Operations overview</Button>
            </div>
        </section>
    </div>
}
else
{
    var isLedger = customer.Id == FintechSeedData.SeededCustomerId;

    <PageTitle>@customer.Name · Operations · @FintechSeedData.ProductName</PageTitle>

    <div class="container-fluid px-lg-4">
        <p class="mb-3">
            <a class="small" href="@CustomersPath"><Icon Name="IconName.ArrowLeft" class="me-1" aria-hidden="true" />All customers</a>
        </p>

        <div class="tm-page-head">
            <div>
                <span class="sc-eyebrow">Customer · @customer.Segment · <span class="tm-mono">@customer.Id</span></span>
                <h1 class="tm-title">@customer.Name</h1>
                <p class="tm-lead">
                    <Badge Color="OpsCustomers.StatusColor(customer.Status)" Class="me-2">@OpsCustomers.StatusText(customer.Status)</Badge>
                    @(customer.Status == FintechCustomerStatus.Watch ? "On watch: check their activity closely before approving anything." : "In good standing.")
                </p>
            </div>
        </div>

        <section class="tm-panel mb-4" aria-labelledby="tm-opscustomer-profile-title">
            <h2 class="tm-section-title" id="tm-opscustomer-profile-title">Profile</h2>
            <dl class="tm-summary tm-opscustomer-profile mb-0">
                <div>
                    <dt>Email</dt>
                    <dd class="text-break">@customer.Email</dd>
                </div>
                <div>
                    <dt>City</dt>
                    <dd>@customer.City</dd>
                </div>
                <div>
                    <dt>Segment</dt>
                    <dd>@customer.Segment</dd>
                </div>
                <div>
                    <dt>Customer since</dt>
                    <dd>@OpsCustomers.SinceText(customer.Since)</dd>
                </div>
                <div>
                    <dt>Status</dt>
                    <dd>@OpsCustomers.StatusText(customer.Status)</dd>
                </div>
                <div>
                    <dt>Accounts</dt>
                    <dd class="tm-mono">@customer.AccountCount</dd>
                </div>
                <div>
                    <dt>Total balance</dt>
                    <dd class="tm-mono">@(customer.TotalBalance < 0 ? "−" : null)@FintechDisplay.Money(customer.TotalBalance)</dd>
                </div>
            </dl>
            @if (!isLedger)
            {
                <p class="small text-body-secondary mt-3 mb-0">Only @FintechSeedData.CustomerName's accounts and transactions are in this demo; for this customer you see their summary, transfers, and disputes.</p>
            }
        </section>

        <div class="row g-4 mb-4">
            <div class="col-xl-7">
                @if (isLedger)
                {
                    @* A short key-value summary of the accounts, so it stays a plain table. *@
                    <section class="tm-panel mb-4" aria-labelledby="tm-opscustomer-accounts-title">
                        <h2 class="tm-section-title" id="tm-opscustomer-accounts-title">Accounts</h2>
                        <Table Data="State.Accounts" Class="align-middle mb-0" Responsive="true" RowKeySelector="account => account.Id"
                               Caption="Balance, what's available after scheduled and held transfers, and the card." CaptionClass="caption-top small">
                            <TableColumn HeaderText="Account" IsRowHeader="true" ColumnClass="@(_ => "fw-normal")" Context="account">
                                <span class="fw-semibold d-block">@account.Name</span>
                                <span class="small text-body-secondary">@FintechDisplay.KindLabel(account.Kind) · @account.MaskedNumber</span>
                            </TableColumn>
                            <TableColumn HeaderText="Balance" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End" ColumnClass="@(_ => "tm-mono text-nowrap")" Context="account">
                                @(account.Balance < 0 ? "−" : null)@FintechDisplay.Money(account.Balance)@(account.Kind == FintechAccountKind.CreditCard && account.Balance < 0 ? " owed" : null)
                            </TableColumn>
                            <TableColumn HeaderText="Available" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End" ColumnClass="@(_ => "tm-mono text-nowrap")" Context="account">
                                @(account.Kind == FintechAccountKind.CreditCard ? $"{FintechDisplay.Money(FintechState.CreditAvailable(account))} credit" : FintechDisplay.Money(State.Available(account)))
                            </TableColumn>
                            <TableColumn HeaderText="Card" ColumnClass="@(_ => "text-nowrap")" Context="account">
                                @if (account.CardLast4 is not { } last4)
                                {
                                    <span class="text-body-secondary">No card</span>
                                }
                                else
                                {
                                    <span class="d-block small">Ending @last4</span>
                                    <Badge Color="@(account.CardFrozen ? BadgeColor.Warning : BadgeColor.Success)">@(account.CardFrozen ? "Frozen" : "Active")</Badge>
                                }
                            </TableColumn>
                        </Table>
                    </section>
                }

                <section class="tm-panel mb-4" aria-labelledby="tm-opscustomer-risk-title">
                    <h2 class="tm-section-title mb-0" id="tm-opscustomer-risk-title">Risk</h2>
                    <p class="small text-body-secondary mb-0">AML alerts and cases on this customer, newest first. Confidential: the customer is never told.</p>
                    @if (CustomerCases.Count == 0 && CustomerAlerts.Count == 0)
                    {
                        <p class="small text-body-secondary mt-3 mb-0">No AML alerts or cases.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mt-2 mb-0">
                            @foreach (var amlCase in CustomerCases)
                            {
                                <li class="tm-row tm-opscustomer-row" @key="@($"case-{amlCase.Id}")">
                                    <span class="tm-icon" aria-hidden="true"><Icon Name="IconName.Folder2Open" /></span>
                                    <span class="tm-row-text">
                                        <a class="tm-row-title" href="@AmlDisplay.CasePath(amlCase.Id)">Case @amlCase.Id</a>
                                        <span class="tm-row-sub">
                                            <Badge Color="AmlDisplay.CaseStatusColor(amlCase.Status)" Class="me-1">@AmlDisplay.CaseStatusText(amlCase.Status)</Badge>
                                            @if (AmlDisplay.IsOverdue(amlCase, State.Today))
                                            {
                                                <Badge Color="BadgeColor.Danger" Class="me-1">Overdue</Badge>
                                            }
                                            @(amlCase.Disposition is { } disposition ? FintechSeedData.DispositionName(disposition) : $"{AmlDisplay.StaffText(amlCase.AssigneeId)} · {AmlDisplay.DueText(amlCase, State.Today)}")
                                        </span>
                                    </span>
                                    <Badge Color="AmlDisplay.RiskColor(amlCase.Priority)">@amlCase.Priority</Badge>
                                </li>
                            }
                            @foreach (var alert in CustomerAlerts.Where(alert => alert.CaseId is null))
                            {
                                <li class="tm-row tm-opscustomer-row" @key="@($"alert-{alert.Id}")">
                                    <span class="tm-icon" aria-hidden="true"><Icon Name="IconName.Radar" /></span>
                                    <span class="tm-row-text">
                                        <a class="tm-row-title" href="@AmlDisplay.AlertPath(alert.Id)">Alert @alert.Id: @FintechSeedData.RuleName(alert.Rule)</a>
                                        <span class="tm-row-sub">
                                            <Badge Color="AmlDisplay.AlertStatusColor(alert.Status)" Class="me-1">@AmlDisplay.AlertStatusText(alert.Status)</Badge>
                                            Raised @Disputes.DayText(alert.CreatedAt)
                                        </span>
                                    </span>
                                    <Badge Color="AmlDisplay.RiskColor(alert.Risk)">@alert.Risk</Badge>
                                </li>
                            }
                        </ul>
                    }
                </section>

                <section class="tm-panel" aria-labelledby="tm-opscustomer-disputes-title">
                    <h2 class="tm-section-title mb-0" id="tm-opscustomer-disputes-title">Disputes</h2>
                    <p class="small text-body-secondary mb-0">Newest first. The full list, with filters, is on the Disputes page.</p>
                    @if (CustomerDisputes.Count == 0)
                    {
                        <p class="small text-body-secondary mt-3 mb-0">No disputes.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mt-2 mb-0">
                            @foreach (var dispute in CustomerDisputes)
                            {
                                <li class="tm-row tm-opscustomer-row" @key="dispute.Id">
                                    <span class="tm-icon" aria-hidden="true"><Icon Name="IconName.Flag" /></span>
                                    <span class="tm-row-text">
                                        <a class="tm-row-title" href="@OpsDisputes.DisputePath(dispute.Id)">Dispute @dispute.Id: @dispute.Merchant</a>
                                        <span class="tm-row-sub">
                                            <Badge Color="Disputes.StatusColor(dispute.Status)" Class="me-1">@Disputes.StatusText(dispute.Status)</Badge>
                                            @if (OpsDisputes.IsOverdue(dispute))
                                            {
                                                <Badge Color="BadgeColor.Danger" Class="me-1">Overdue</Badge>
                                            }
                                            @OpsDisputes.ReasonText(dispute.Reason) · Opened @Disputes.DayText(dispute.CreatedAt)
                                        </span>
                                    </span>
                                    <span class="tm-mono fw-semibold text-nowrap">@FintechDisplay.Money(dispute.Amount)</span>
                                </li>
                            }
                        </ul>
                    }
                </section>
            </div>

            <div class="col-xl-5">
                <section class="tm-panel" aria-labelledby="tm-opscustomer-notes-title">
                    <h2 class="tm-section-title mb-1" id="tm-opscustomer-notes-title">Internal notes</h2>
                    <p class="small text-body-secondary mb-3">For operations only: customers never see these notes. Each note is recorded in the audit log.</p>

                    <EditForm EditContext="noteContext" OnSubmit="AddNote" FormName="tm-opscustomer-note" novalidate>
                        <DataAnnotationsValidator />
                        <ShowcaseFormErrors />
                        <label class="form-label small fw-semibold" for="tm-opscustomer-note">Add a note about @customer.Name</label>
                        <InputTextArea id="tm-opscustomer-note" class="form-control" rows="3" maxlength="@MaxNote" @bind-Value="noteForm.Text"
                                       @oninput="args => noteLength = args.Value?.ToString()?.Length ?? 0" @ref="noteInput" aria-required="true"
                                       aria-describedby="tm-opscustomer-note-count tm-opscustomer-note-status" />
                        <div class="form-text text-end" id="tm-opscustomer-note-count">@noteLength of @MaxNote characters</div>
                        <ValidationMessage For="() => noteForm.Text" />
                        <Button Type="ButtonType.Submit" Color="ButtonColor.Primary" Outline="true" Class="mt-1">Add note</Button>
                    </EditForm>
                    <p class="small fw-semibold mt-2 mb-0 tm-opscustomer-message @(noteIsError ? "text-danger-emphasis" : null)" id="tm-opscustomer-note-status"
                       role="status" tabindex="-1" @ref="noteStatus">@noteMessage</p>

                    @if (Notes.Count == 0)
                    {
                        <p class="small text-body-secondary mt-3 mb-0">No notes about @customer.Name yet.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mt-3 mb-0" aria-label="Notes, newest first">
                            @foreach (var note in Notes)
                            {
                                <li class="tm-opscustomer-note" @key="note.Id">
                                    <p class="tm-opscustomer-text mb-1">@note.Text</p>
                                    <p class="small text-body-secondary mb-0">@note.Author · @Transfers.StampText(note.At)</p>
                                </li>
                            }
                        </ul>
                    }
                </section>
            </div>
        </div>

        <section class="tm-panel mb-4" aria-labelledby="tm-opscustomer-transfers-title">
            <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2">
                <h2 class="tm-section-title mb-0" id="tm-opscustomer-transfers-title">Transfers</h2>
                <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ResetTransfersViewAsync">Reset view<span class="visually-hidden">&#32;of the transfers</span></Button>
            </div>
            <p class="small text-body-secondary">Held and scheduled first, then the most recent. Open one to review it.</p>
            <ShowcaseDataState Status="@(viewsLoaded ? ShowcaseDataStatus.Ready : ShowcaseDataStatus.Loading)"
                               IsEmpty="@(TransferRows.Count == 0)"
                               EmptyIcon="IconName.ArrowLeftRight"
                               EmptyTitle="No transfers"
                               EmptyText="@($"{customer.Name} hasn't sent or scheduled a transfer yet.")"
                               LoadingText="Loading transfers…"
                               LoadingRows="3"
                               OnRetry="RefreshGridsAsync">
                <Grid @ref="transfersGrid"
                      @key="transfersVersion"
                      TItem="TransferRow"
                      Class="table table-hover align-middle tm-table-mid sc-grid-row-links"
                      GridContainerClass="tm-grid border rounded-3"
                      DataProvider="ProvideTransfersAsync"
                      SettingsProvider="transfersView.GetSettingsAsync"
                      GridSettingsChanged="SaveTransfersSettingsAsync"
                      AllowPaging="true"
                      PageSize="@transfersPageSize"
                      PageSizeSelectorVisible="true"
                      PageSizeSelectorItems="@(new[] { 10, 25, 50 })"
                      PaginationItemsTextFormat="{0}–{1} of {2} transfers"
                      AllowSorting="true"
                      AllowColumnChooser="true"
                      AllowExport="true"
                      ExportFileName="@($"banking-customer-transfers-{customer.Id}")"
                      Responsive="true"
                      EmptyText="No transfers."
                      aria-label="@($"Transfers of {customer.Name}")">
                    <GridColumns>
                        <GridColumn TItem="TransferRow" HeaderText="Reference" PropertyName="Reference" SortString="reference" SortKeySelector="row => row.Reference"
                                    IsDefaultSortColumn="@transfersView.IsSortColumn("reference")" SortDirection="@transfersView.DirectionFor("reference")" AlwaysVisible="true" TextNoWrap="true">
                            <a class="tm-row-link tm-mono stretched-link" href="@OpsQueue.TransferUrl(context.Reference)">@context.Reference</a>
                        </GridColumn>
                        <GridColumn TItem="TransferRow" HeaderText="To" PropertyName="To" SortString="to" SortKeySelector="row => row.To"
                                    IsDefaultSortColumn="@transfersView.IsSortColumn("to")" SortDirection="@transfersView.DirectionFor("to")">
                            @context.To
                        </GridColumn>
                        <GridColumn TItem="TransferRow" HeaderText="Amount" PropertyName="Amount" SortString="amount" SortKeySelector="row => row.Amount"
                                    IsDefaultSortColumn="@transfersView.IsSortColumn("amount")" SortDirection="@transfersView.DirectionFor("amount")" TextAlignment="Alignment.End" TextNoWrap="true">
                            <span class="tm-mono fw-semibold">@FintechDisplay.Money(context.Amount)</span>
                        </GridColumn>
                        <GridColumn TItem="TransferRow" HeaderText="Status" PropertyName="Status" SortString="status" SortKeySelector="row => row.Order"
                                    IsDefaultSortColumn="@transfersView.IsSortColumn("status")" SortDirection="@transfersView.DirectionFor("status")" TextNoWrap="true">
                            <Badge Color="Transfers.StatusColor(context.StatusValue)">@context.Status</Badge>
                        </GridColumn>
                        <GridColumn TItem="TransferRow" HeaderText="When" PropertyName="When" SortString="when" SortKeySelector="row => row.WhenAt"
                                    IsDefaultSortColumn="@transfersView.IsSortColumn("when")" SortDirection="@transfersView.DirectionFor("when")">
                            <span class="small">@context.When</span>
                        </GridColumn>
                        <GridColumn TItem="TransferRow" HeaderText="Hold or reject reason" PropertyName="Reason" Sortable="false">
                            <span class="small tm-opscustomer-text">@context.Reason</span>
                        </GridColumn>
                    </GridColumns>
                </Grid>
            </ShowcaseDataState>
        </section>

        @if (isLedger)
        {
            <section class="tm-panel" aria-labelledby="tm-opscustomer-transactions-title">
                <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2">
                    <h2 class="tm-section-title mb-0" id="tm-opscustomer-transactions-title">Transactions</h2>
                    <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ResetTransactionsViewAsync">Reset view<span class="visually-hidden">&#32;of the transactions</span></Button>
                </div>
                <p class="small text-body-secondary">Every account, newest first, over the last 13 months. A disputed payment links to its dispute.</p>
                <ShowcaseDataState Status="@(viewsLoaded ? ShowcaseDataStatus.Ready : ShowcaseDataStatus.Loading)"
                                   IsEmpty="@(TransactionRows.Count == 0)"
                                   EmptyIcon="IconName.Receipt"
                                   EmptyTitle="No transactions"
                                   EmptyText="Payments in and out of the customer's accounts appear here."
                                   LoadingText="Loading transactions…"
                                   LoadingRows="3"
                                   OnRetry="RefreshGridsAsync">
                    <Grid @ref="transactionsGrid"
                          @key="transactionsVersion"
                          TItem="TransactionRow"
                          Class="table table-hover align-middle tm-table-mid sc-grid-row-links"
                          GridContainerClass="tm-grid border rounded-3"
                          DataProvider="ProvideTransactionsAsync"
                          SettingsProvider="transactionsView.GetSettingsAsync"
                          GridSettingsChanged="SaveTransactionsSettingsAsync"
                          AllowPaging="true"
                          PageSize="@transactionsPageSize"
                          PageSizeSelectorVisible="true"
                          PageSizeSelectorItems="@(new[] { 10, 25, 50, 100 })"
                          PaginationItemsTextFormat="{0}–{1} of {2} transactions"
                          AllowSorting="true"
                          AllowFiltering="true"
                          AllowColumnChooser="true"
                          AllowExport="true"
                          ExportFileName="banking-customer-transactions"
                          Responsive="true"
                          EmptyText="No transactions match these filters."
                          aria-label="@($"Transactions of {customer.Name}")">
                        <GridColumns>
                            <GridColumn TItem="TransactionRow" HeaderText="Date" PropertyName="Date" SortString="date" SortKeySelector="row => row.Date" Filterable="false"
                                        IsDefaultSortColumn="@transactionsView.IsSortColumn("date")" SortDirection="@transactionsView.DirectionFor("date")" TextNoWrap="true">
                                <span class="tm-mono small">@FintechDisplay.Day(context.Date)@(context.Date.Year != State.Today.Year ? $", {context.Date.Year.ToString(CultureInfo.InvariantCulture)}" : null)</span>
                            </GridColumn>
                            <GridColumn TItem="TransactionRow" HeaderText="Description" PropertyName="Description" SortString="description" SortKeySelector="row => row.Description"
                                        IsDefaultSortColumn="@transactionsView.IsSortColumn("description")" SortDirection="@transactionsView.DirectionFor("description")" AlwaysVisible="true">
                                @* No customer-side page for operations: a disputed payment's row opens the dispute; the others have no link. *@
                                @if (context.DisputeId is { } disputeId)
                                {
                                    <a class="tm-row-link stretched-link" href="@OpsDisputes.DisputePath(disputeId)">@context.Description</a>
                                    <Badge Color="BadgeColor.Info" Class="ms-1">Dispute @disputeId</Badge>
                                }
                                else
                                {
                                    @context.Description
                                }
                                @if (context.Pending)
                                {
                                    <Badge Color="BadgeColor.Secondary" Class="ms-1">Pending</Badge>
                                }
                            </GridColumn>
                            <GridColumn TItem="TransactionRow" HeaderText="Account" PropertyName="Account" SortString="account" SortKeySelector="row => row.Account" TextNoWrap="true"
                                        IsDefaultSortColumn="@transactionsView.IsSortColumn("account")" SortDirection="@transactionsView.DirectionFor("account")">
                                <span class="small">@context.Account</span>
                            </GridColumn>
                            <GridColumn TItem="TransactionRow" HeaderText="Category" PropertyName="Category" SortString="category" SortKeySelector="row => row.Category" TextNoWrap="true"
                                        IsDefaultSortColumn="@transactionsView.IsSortColumn("category")" SortDirection="@transactionsView.DirectionFor("category")">
                                <span class="small">@context.Category</span>
                            </GridColumn>
                            <GridColumn TItem="TransactionRow" HeaderText="Amount" PropertyName="Amount" SortString="amount" SortKeySelector="row => row.Amount" Filterable="false"
                                        IsDefaultSortColumn="@transactionsView.IsSortColumn("amount")" SortDirection="@transactionsView.DirectionFor("amount")" TextAlignment="Alignment.End" TextNoWrap="true">
                                <span class="tm-mono fw-semibold @FintechDisplay.AmountClass(context.Amount)">@FintechDisplay.SignedMoney(context.Amount)</span>
                            </GridColumn>
                        </GridColumns>
                    </Grid>
                </ShowcaseDataState>
            </section>
        }
        <p class="tm-list-status mt-2" role="status">@viewMessage</p>
    </div>
}
