@inherits LayoutComponentBase

@* The bank operations back office (D-031): its own sidebar with the operations modules, separate from the customer bank. *@
<ShowcaseSessionHost State="State" SiteBase="@FintechLayout.Base" SiteName="@FintechSeedData.ProductName">
    <FintechFrame>
        <Header>
            <div class="tm-ops-bar">
                <span class="tm-ops-bar-title">Banking operations</span>
                <div class="tm-ops-bar-actions">
                    @* The search and the notifications show only once the one-time code is entered. *@
                    <ShowcaseGlobalSearch Class="tm-global-search" Placeholder="Search customers, transfers, disputes, AML" Label="Search customers by name, ID, or email, transfers by reference, and disputes, AML cases, and alerts by number" />
                    <ShowcaseNotificationsMenu />
                    <ShowcaseAccountMenu SiteBase="@FintechLayout.Base" SignInPath="@FintechLayout.SignInPath" />
                </div>
            </div>
        </Header>
        <Sidebar>
            @if (State.IsOps)
            {
                <Sidebar @key="State.Identity.Current?.Id"
                         Class="tm-sidebar"
                         Href="@Base"
                         IconName="IconName.Coin"
                         Title="@FintechSeedData.ProductName"
                         BadgeText="@(State.IsSenior ? "Senior" : "Ops")"
                         DataProvider="SidebarDataProvider" />
            }
        </Sidebar>
        <ChildContent>
            <FintechGuard Role="@StaffRoles">
                @Body
            </FintechGuard>
        </ChildContent>
    </FintechFrame>
</ShowcaseSessionHost>
