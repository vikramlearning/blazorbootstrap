@page "/showcase/fintech/ops/customers"
@layout FintechOpsLayout

<PageTitle>Customers · Operations · @FintechSeedData.ProductName</PageTitle>

<div class="container-fluid px-lg-4">
    <div class="tm-page-head">
        <div>
            <h1 class="tm-title">Customers</h1>
            <p class="tm-lead">Everyone who banks with us, their standing, and what's waiting on operations for each.</p>
        </div>
    </div>

    <Card Class="tm-card">
        <CardBody Class="p-3 p-lg-4">
            <div class="row g-2 align-items-end mb-3" role="search" aria-label="Filter customers">
                <div class="col-md-6 col-lg-5">
                    <label class="form-label small fw-semibold" for="tm-opscustomers-search">Search by name, email, or city</label>
                    <input type="search" id="tm-opscustomers-search" class="form-control" maxlength="100" autocomplete="off"
                           placeholder="For example, Lena or Denver" @bind="search" @bind:event="oninput" />
                </div>
                <div class="col-sm-6 col-md-3 col-lg-2">
                    <label class="form-label small fw-semibold" for="tm-opscustomers-status">Status</label>
                    <select id="tm-opscustomers-status" class="form-select" value="@statusFilter" @onchange="OnStatusChanged">
                        <option value="">All statuses</option>
                        <option value="@nameof(FintechCustomerStatus.Active)">@StatusText(FintechCustomerStatus.Active)</option>
                        <option value="@nameof(FintechCustomerStatus.Watch)">@StatusText(FintechCustomerStatus.Watch)</option>
                    </select>
                </div>
                <div class="col-md-3 col-lg-5 d-flex flex-wrap align-items-center gap-2 justify-content-md-end">
                    @* Polite, so the count is read after typing pauses or the filter changes. *@
                    <span class="small text-body-secondary" role="status">@MatchText</span>
                    @if (HasFilters)
                    {
                        <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ClearFilters">Clear filters</Button>
                    }
                </div>
            </div>

            <div class="table-responsive tm-grid">
                <table class="table table-hover align-middle mb-0">
                    <caption class="caption-top small">Customers by name. Open items are held transfers and open disputes.</caption>
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">City</th>
                            <th scope="col">Segment</th>
                            <th scope="col">Customer since</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end">Accounts</th>
                            <th scope="col" class="text-end">Total balance</th>
                            <th scope="col" class="text-end">Open items</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Shown.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="text-body-secondary py-4 text-center">No customers match these filters.</td>
                            </tr>
                        }
                        @foreach (var customer in Shown)
                        {
                            var open = OpenItems(customer.Id);
                            <tr @key="customer.Id">
                                <td class="text-nowrap"><a class="fw-semibold" href="@CustomerPath(customer.Id)">@customer.Name</a></td>
                                <td class="text-break small">@customer.Email</td>
                                <td>@customer.City</td>
                                <td>@customer.Segment</td>
                                <td class="tm-mono small text-nowrap">@SinceText(customer.Since)</td>
                                <td><Badge Color="StatusColor(customer.Status)" Class="text-nowrap">@StatusText(customer.Status)</Badge></td>
                                <td class="tm-mono text-end">@customer.AccountCount</td>
                                <td class="tm-mono text-end text-nowrap">@(customer.TotalBalance < 0 ? "−" : null)@FintechDisplay.Money(customer.TotalBalance)</td>
                                <td class="text-end text-nowrap">
                                    @if (open.Total == 0)
                                    {
                                        <span class="text-body-secondary">None</span>
                                    }
                                    else
                                    {
                                        <span class="fw-semibold">@open.Total</span>
                                        <span class="d-block small text-body-secondary">@OpenItemsText(open)</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </CardBody>
    </Card>
</div>
