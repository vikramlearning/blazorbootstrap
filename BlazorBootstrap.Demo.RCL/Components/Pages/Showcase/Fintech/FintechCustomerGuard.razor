@* The customer guard: a signed-in customer who hasn't entered the one-time code yet gets the code step instead of the page. *@
<ShowcaseRoleGuard Roles="@FintechSeedData.CustomerRole" SignInPath="@FintechLayout.SignInPath">
    @if (State.IsVerified)
    {
        @ChildContent
    }
    else
    {
        <div class="container-xl">
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">
                    <FintechCodeStep Purpose="FintechCodePurpose.SignIn"
                                     Title="Enter your one-time code"
                                     Lead="For your security, signing in takes your password and a code we text to your phone."
                                     SubmitText="Verify and continue"
                                     Submit="State.VerifySignIn" />
                    <p class="small text-body-secondary text-center mt-3 mb-0">Not you? Sign out from the account menu.</p>
                </div>
            </div>
        </div>
    }
</ShowcaseRoleGuard>

@code {
    /// <summary>Gets or sets the page shown once the code is entered.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Inject] private FintechState State { get; set; } = default!;
}
