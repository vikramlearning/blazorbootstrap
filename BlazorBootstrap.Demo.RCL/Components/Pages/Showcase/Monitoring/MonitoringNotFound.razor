@* The site's not-found screen, shown by the catch-all route and for unknown services. *@
<PageTitle>Page not found · @MonitoringSeedData.ProductName</PageTitle>

<section class="mw-not-found">
    <span class="mw-icon fs-4" aria-hidden="true"><Icon Name="IconName.SignpostSplit" /></span>
    <h1 class="mw-title fs-3 mt-3 mb-2">We couldn't find that page</h1>
    <p class="text-body-secondary mb-4">The service may have been renamed or removed from monitoring.</p>
    <div class="d-flex justify-content-center flex-wrap gap-2">
        <Button Type="ButtonType.Link" To="@MonitoringLayout.Base" Color="ButtonColor.Primary">Back to the overview</Button>
        <Button Type="ButtonType.Link" To="@($"{MonitoringLayout.Base}/incidents")" Color="ButtonColor.Primary" Outline="true">Incidents</Button>
    </div>
</section>
