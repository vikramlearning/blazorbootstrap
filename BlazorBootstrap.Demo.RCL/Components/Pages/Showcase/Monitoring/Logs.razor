@page "/showcase/monitoring/console/logs"
@layout ConsoleLayout

<PageTitle>Logs and traces · @MonitoringSeedData.ProductName</PageTitle>

<div class="container-fluid px-lg-4">
    <div class="mw-page-head">
        <div>
            <h1 class="mw-title">Logs and traces</h1>
            <p class="mw-lead">A live tail of every service, newest first. Open a trace ID to see the request's path through the services.</p>
        </div>
        <LivePauseButton />
    </div>

    @* Always rendered and polite: it speaks when filters change, when lines arrive after a pause, or when lines are loaded on request; never on each tick. *@
    <div class="visually-hidden" role="status">@statusMessage</div>

    <Card Class="mw-card">
        <CardBody Class="p-3 p-lg-4">
            <div class="row g-2 align-items-end mb-3" role="search" aria-label="Filter logs">
                <div class="col-md-5">
                    <label class="form-label small fw-semibold" for="mw-log-search">Search</label>
                    <input id="mw-log-search" type="search" class="form-control" placeholder="Message or trace ID" autocomplete="off"
                           value="@search" @oninput="OnSearchInput" @ref="searchInput" aria-describedby="mw-log-search-help" />
                    <span class="form-text" id="mw-log-search-help">Matches part of a message or a trace ID.</span>
                </div>
                <div class="col-sm-6 col-md-4">
                    <label class="form-label small fw-semibold" for="mw-log-service">Service</label>
                    <select id="mw-log-service" class="form-select" value="@serviceFilter" @onchange="OnServiceChanged">
                        <option value="">All services</option>
                        @foreach (var service in State.Services)
                        {
                            <option value="@service.Id">@service.Name</option>
                        }
                    </select>
                </div>
                <div class="col-sm-6 col-md-3">
                    <label class="form-label small fw-semibold" for="mw-log-level">Level</label>
                    <select id="mw-log-level" class="form-select" value="@levelFilter" @onchange="OnLevelChanged">
                        <option value="">All levels</option>
                        @foreach (var level in Enum.GetValues<MonitoringLogLevel>())
                        {
                            <option value="@level">@LevelLabel(level)</option>
                        }
                    </select>
                </div>
            </div>

            <div class="lg-toolbar">
                @* Not a live region: the count changes with every tick. *@
                <p class="small text-body-secondary mb-0">@CountText</p>
                @if (HasFilters)
                {
                    <button type="button" class="btn btn-link btn-sm p-0" @onclick="ClearFilters">Clear filters</button>
                }
            </div>

            @if (State.IsPaused)
            {
                <div class="lg-paused" id="mw-log-paused">
                    <Icon Name="IconName.PauseCircle" class="flex-shrink-0" aria-hidden="true" />
                    <span class="flex-grow-1">Live updates are paused. The log stops at <span class="mw-mono">@MonitoringDisplay.Time(State.CurrentTime)</span>; new lines wait until you resume.</span>
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="LoadNewLines">Load new lines now</button>
                </div>
            }

            @if (Filtered.Count == 0)
            {
                <p class="lg-empty">No log lines match these filters. Try another service or level, or clear the search.</p>
            }
            else
            {
                <div class="table-responsive mw-grid">
                    <table class="table table-hover lg-table">
                        <caption class="visually-hidden">Log lines, newest first</caption>
                        <thead>
                            <tr>
                                <th scope="col">Time</th>
                                <th scope="col">Level</th>
                                <th scope="col">Service</th>
                                <th scope="col">Message</th>
                                <th scope="col">Trace</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Filtered.Take(shownCount))
                            {
                                <tr @key="entry.Id">
                                    <td class="text-nowrap"><span class="mw-mono">@MonitoringDisplay.Time(entry.Time)</span></td>
                                    <td class="text-nowrap">
                                        <Badge Color="@MonitoringDisplay.LevelColor(entry.Level)"><Icon Name="@LevelIcon(entry.Level)" class="me-1" aria-hidden="true" />@LevelLabel(entry.Level)</Badge>
                                    </td>
                                    <td class="text-nowrap">@(State.FindService(entry.ServiceId)?.Name ?? entry.ServiceId)</td>
                                    <td class="lg-message"><span class="mw-mono">@entry.Message</span></td>
                                    <td class="text-nowrap"><a class="mw-mono small" href="@MonitoringDisplay.TraceUrl(entry.TraceId)">@entry.TraceId</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Filtered.Count > shownCount)
                {
                    <div class="text-center mt-3">
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ShowMore">
                            Show @Math.Min(PageSize, Filtered.Count - shownCount) more lines
                        </button>
                    </div>
                }
            }
        </CardBody>
    </Card>
</div>
