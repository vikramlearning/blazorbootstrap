@inherits LayoutComponentBase

@* The public status page: what customers see. Engineers sign in to the console from here. *@
<ShowcaseSessionHost State="State" SiteBase="@Base" SiteName="@MonitoringSeedData.StatusPageName">
<MonitoringFrame>
    <Header>
    @if (State.IsEngineer)
    {
        @* An engineer sees the status page as customers do, with a way back to the console (D-032). *@
        <div class="mw-viewing-bar">
            <div class="container-xl d-flex flex-wrap align-items-center justify-content-between gap-2">
                <span><Icon Name="IconName.Eye" class="me-2" aria-hidden="true" />Viewing the public status page as @State.Identity.Current!.Name (Engineer)</span>
                <a href="@ConsoleLayout.Base"><Icon Name="IconName.ArrowLeft" class="me-1" aria-hidden="true" />Back to the console</a>
            </div>
        </div>
    }
    <Navbar Class="mw-header"
            Placement="NavbarPlacement.StickyTop"
            Container="NavbarContainer.ExtraLarge"
            AriaLabel="@MonitoringSeedData.StatusPageName"
            TogglerAriaLabel="Menu">
        <Brand>
            <NavbarBrand Href="@Base" Class="mw-brand">
                <span class="mw-brand-mark" aria-hidden="true"><Icon Name="IconName.Activity" /></span>
                <span>@MonitoringSeedData.StatusPageName</span>
            </NavbarBrand>
            @if (State.Identity.IsSignedIn)
            {
                <ShowcaseAccountMenu SiteBase="@Base" SignInPath="@SignInPath" Class="ms-auto me-2 order-lg-last"
                                     NoticeCount="@State.UnreadCount" NoticesPath="@($"{ConsoleLayout.Base}/notifications")" />
            }
            else
            {
                <a class="btn btn-sm btn-outline-secondary ms-auto me-2 order-lg-last" href="@SignInPath">Engineer sign-in</a>
            }
        </Brand>
        <ChildContent>
            <NavbarNav Class="me-auto ms-lg-4 mb-3 mb-lg-0">
                <NavbarItem Href="@Base" Match="NavLinkMatch.All">Status</NavbarItem>
                <NavbarItem Href="@($"{Base}/history")">Incident history</NavbarItem>
                <NavbarItem Href="@($"{Base}/subscribe")">Subscribe to updates</NavbarItem>
                @if (State.IsEngineer)
                {
                    <NavbarItem Href="@ConsoleLayout.Base">Console</NavbarItem>
                }
            </NavbarNav>
        </ChildContent>
    </Navbar>
    </Header>
    <ChildContent>
        @Body
    </ChildContent>
</MonitoringFrame>
</ShowcaseSessionHost>
