@page "/showcase/monitoring/console/on-call"
@layout ConsoleLayout

<PageTitle>On-call · @MonitoringSeedData.ProductName</PageTitle>

<div class="container-fluid px-lg-4">
    <div class="mw-page-head">
        <div>
            <h1 class="mw-title">On-call</h1>
            <p class="mw-lead">Who gets paged for alerts. Each week runs from Monday 09:00 to the next Monday 09:00; take a shift to cover for a teammate.</p>
        </div>
    </div>

    @* Always rendered and focusable, so a result is announced and focus has somewhere to go once a dialog closes. *@
    <div class="oc-status" role="status" tabindex="-1" @ref="statusRegion">
        @if (statusMessage is not null)
        {
            <Alert Color="@statusColor" Class="mb-4"><p class="mb-0 fw-semibold">@statusMessage</p></Alert>
        }
    </div>

    @{
        var weeks = State.Shifts(0, Weeks);
        var now = weeks.FirstOrDefault();
    }

    <div class="row g-4 mb-4">
        <div class="col-lg-7">
            <section class="h-100" aria-labelledby="oc-now-title">
                <Card Class="mw-card h-100">
                    <CardHeader>
                        <h2 class="mw-card-title" id="oc-now-title">On call now</h2>
                        @if (now is not null)
                        {
                            <span class="small text-body-secondary">until @WeekDay(now.End)</span>
                        }
                    </CardHeader>
                    <CardBody>
                        @if (now is null)
                        {
                            <p class="mb-0 text-body-secondary">The rotation has no shift for this week.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var role in Enum.GetValues<MonitoringOnCallRole>())
                                {
                                    var holderId = Holder(now, role);
                                    var holder = State.FindEngineer(holderId);
                                    var taken = Override(now, role);
                                    <li class="mw-row" @key="role">
                                        <span class="oc-avatar" aria-hidden="true">@(holder?.Initials ?? "?")</span>
                                        <span class="flex-grow-1">
                                            <span class="mw-label d-block">@RoleLabel(role)</span>
                                            <span class="fw-semibold">@Name(holderId)@(holderId == MyId ? " (you)" : null)</span>
                                            @if (taken is not null)
                                            {
                                                <span class="d-block small text-body-secondary">Covering for @Name(taken.OriginalId)</span>
                                            }
                                            <span class="d-block small text-body-secondary">@RoleHelp(role)</span>
                                            @foreach (var paged in State.PagesWaitingFor(holderId))
                                            {
                                                var last = paged.Paging!.Pages.Last(page => page.EngineerId == holderId);
                                                <span class="d-block small fw-semibold" @key="paged.Id">
                                                    <Icon Name="IconName.Megaphone" class="me-1" aria-hidden="true" />Paged for <a href="@MonitoringDisplay.IncidentUrl(paged.Id)">#@paged.Id @paged.Title</a>
                                                    (step @last.Step, @MonitoringDisplay.Ago(last.At, State.Clock.Now)), waiting for acknowledgement
                                                </span>
                                            }
                                        </span>
                                    </li>
                                }
                            </ul>
                        }
                    </CardBody>
                </Card>
            </section>
        </div>
        <div class="col-lg-5">
            <section class="h-100" aria-labelledby="oc-policy-title">
                <Card Class="mw-card h-100">
                    <CardHeader><h2 class="mw-card-title" id="oc-policy-title">Escalation policies</h2></CardHeader>
                    <CardBody>
                        @{
                            var active = State.Policies.Where(policy => policy.IsActive).OrderBy(policy => policy.IsDefault).ToList();
                        }
                        @if (active.Count == 0)
                        {
                            <p class="mb-0">No escalation policy is on: an alert notifies the on-call engineers, but nobody is paged or escalated.</p>
                        }
                        else
                        {
                            <p class="small mb-2">An alert pages the <strong>primary on call</strong> first; if nobody acknowledges in time, the <strong>secondary</strong> is paged, then whoever the policy names.</p>
                            <ul class="oc-policy mb-0">
                                @foreach (var policy in active)
                                {
                                    <li @key="policy.Id">
                                        <strong>@policy.Name</strong>
                                        <span class="d-block small text-body-secondary">@State.CoverageText(policy) · @State.StepsText(policy)</span>
                                    </li>
                                }
                            </ul>
                        }
                        <p class="small text-body-secondary mt-3 mb-0">
                            How each page reaches you is set in <a href="@($"{ConsoleLayout.Base}/notifications")">Notifications</a>.
                            @if (State.IsAdmin)
                            {
                                <a href="@($"{ConsoleLayout.AdminBase}/escalation")">Manage escalation policies</a>
                            }
                        </p>
                    </CardBody>
                </Card>
            </section>
        </div>
    </div>

    <section aria-labelledby="oc-weeks-title">
        <Card Class="mw-card">
            <CardHeader>
                <h2 class="mw-card-title" id="oc-weeks-title">The next @Weeks weeks</h2>
                <span class="small text-body-secondary">You can take a position nobody has taken over yet, and remove your own overrides until their week ends.</span>
            </CardHeader>
            <CardBody Class="pt-2">
                <Table Data="weeks" Class="oc-table" Responsive="true" TableContainerClass="mw-grid" RowKeySelector="shift => shift.Start"
                       Caption="@($"On-call rotation for the next {Weeks} weeks: the primary and secondary of each week, with overrides")" VisuallyHiddenCaption="true">
                    <TableColumn HeaderText="Week" IsRowHeader="true" ColumnClass="@(_ => "text-nowrap")" Context="shift">
                        <span class="d-block">@WeekText(shift)</span>
                        @if (shift == now)
                        {
                            <Badge Color="BadgeColor.Primary" Class="mt-1">This week</Badge>
                        }
                    </TableColumn>
                    @foreach (var role in Enum.GetValues<MonitoringOnCallRole>())
                    {
                        <TableColumn HeaderText="@RoleLabel(role)" Context="shift">
                            @{
                                var holderId = Holder(shift, role);
                                var otherId = Holder(shift, Other(role));
                                var taken = Override(shift, role);
                                var key = CellKey(shift, role);
                            }
                            <span class="fw-semibold">@Name(holderId)@(holderId == MyId ? " (you)" : null)</span>
                            @if (taken is not null)
                            {
                                <span class="d-block small">@Name(taken.EngineerId), covering for @Name(taken.OriginalId)</span>
                                @if (taken.Reason.Length > 0)
                                {
                                    <span class="d-block small text-body-secondary oc-reason">Reason: @taken.Reason</span>
                                }
                            }

                            @if (taken is not null && taken.AccountId == MyId)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger mt-2" @ref="openers[key]" @onclick="() => AskRemoveAsync(shift, role, taken, key)">
                                    Remove my override<span class="visually-hidden">: @RoleLabel(role).ToLowerInvariant(), @WeekText(shift)</span>
                                </button>
                            }
                            else if (holderId == MyId)
                            {
                                <span class="d-block small text-body-secondary">You're on call</span>
                            }
                            else if (otherId == MyId)
                            {
                                <span class="d-block small text-body-secondary">You're @RoleLabel(Other(role)).ToLowerInvariant() this week</span>
                            }
                            else if (taken is null)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary mt-2" @ref="openers[key]" @onclick="() => AskTakeAsync(shift, role, key)">
                                    Take this shift<span class="visually-hidden">: @RoleLabel(role).ToLowerInvariant(), @WeekText(shift)</span>
                                </button>
                            }
                        </TableColumn>
                    }
                </Table>
            </CardBody>
        </Card>
    </section>
</div>

<Modal @ref="takeModal" IsVerticallyCentered="true" IsScrollable="true" ShowCloseButton="false" aria-labelledby="oc-take-title"
       OnShown="OnTakeShownAsync" OnHidden="OnDialogHiddenAsync">
    <HeaderTemplate>
        <h2 class="modal-title h5" id="oc-take-title">Take the @RoleLabel(pendingRole).ToLowerInvariant() shift for @WeekText(pendingStart)?</h2>
    </HeaderTemplate>
    <BodyTemplate>
        <p class="mb-2">
            From @WeekDay(pendingStart) to @WeekDay(pendingStart.AddDays(7)), you're @(pendingRole == MonitoringOnCallRole.Primary ? "paged first for every alert" : "paged when the primary doesn't acknowledge in time")
            instead of @pendingHolderName.
        </p>
        <p class="small text-body-secondary mb-3">You can remove your override later, until the week ends.</p>
        <label class="form-label fw-semibold" for="oc-take-reason">Reason (optional)</label>
        <textarea id="oc-take-reason" class="form-control @(reasonError is null ? null : "is-invalid")" rows="3" maxlength="@MonitoringState.MaxReasonLength"
                  @bind="reason" @bind:event="oninput" @ref="reasonInput" aria-invalid="@(reasonError is null ? null : "true")"
                  aria-describedby="oc-take-reason-help oc-take-reason-count oc-take-reason-error"></textarea>
        <div class="d-flex flex-wrap justify-content-between gap-2 form-text">
            <span id="oc-take-reason-help">Shown next to the shift for the rest of the team, for example "Swapping with Marcus for his holiday".</span>
            <span id="oc-take-reason-count">@reason.Length of @MonitoringState.MaxReasonLength characters</span>
        </div>
        <p class="text-danger-emphasis fw-semibold small mt-2 mb-0" id="oc-take-reason-error">@reasonError</p>
        <p class="text-danger-emphasis fw-semibold small mt-2 mb-0" role="alert">@dialogError</p>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => takeModal.HideAsync()">Cancel</Button>
        <Button Color="ButtonColor.Primary" @onclick="ConfirmTakeAsync" Disabled="busy">Take the @RoleLabel(pendingRole).ToLowerInvariant() shift</Button>
    </FooterTemplate>
</Modal>

<Modal @ref="removeModal" IsVerticallyCentered="true" IsScrollable="true" ShowCloseButton="false" aria-labelledby="oc-remove-title"
       OnShown="OnRemoveShownAsync" OnHidden="OnDialogHiddenAsync">
    <HeaderTemplate>
        <h2 class="modal-title h5" id="oc-remove-title">Remove your override for @WeekText(pendingStart)?</h2>
    </HeaderTemplate>
    <BodyTemplate>
        <p class="mb-0">@pendingHolderName goes back to being @RoleLabel(pendingRole).ToLowerInvariant() on call from @WeekDay(pendingStart) to @WeekDay(pendingStart.AddDays(7)), and you're off that shift.</p>
        <p class="text-danger-emphasis fw-semibold small mt-2 mb-0" role="alert">@dialogError</p>
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-outline-secondary" @ref="removeCancelButton" @onclick="() => removeModal.HideAsync()">Cancel</button>
        <Button Color="ButtonColor.Danger" @onclick="ConfirmRemoveAsync" Disabled="busy">Remove my override</Button>
    </FooterTemplate>
</Modal>
