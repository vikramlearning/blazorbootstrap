@using BlazorBootstrap.Demo.RCL.Models.Showcase
@using BlazorBootstrap.Demo.RCL.Services.Showcase

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" />
</HeadContent>

@* The frame both Stackwatch layouts share: the public status page and the engineers' console (D-031). The site bar's
   theme changes feed the chart colors. Its stylesheet styles the pages of both through ::deep. *@
<div class="sc-site sc-monitoring">
    <ShowcaseSiteBar Site="@site" OnThemeChanged="OnThemeChanged" />

    @Header

    <div class="@(Sidebar is null ? null : "mw-shell")">
        @Sidebar

        <div class="@(Sidebar is null ? null : "mw-shell-main")">
            @* Pages show engineers' names, subscribers' email addresses, and log lines, so the content is masked from session recording. *@
            <main class="sc-main mw-content" id="mw-main" data-clarity-mask="true">
                @ChildContent
            </main>

            <div class="container-fluid px-lg-4">
                <CarbonAds Class="sc-ad" />
            </div>

            <footer class="mw-footer">
                <div class="container-fluid px-lg-4 d-flex flex-wrap justify-content-between gap-2">
                    <span>© 2026 @MonitoringSeedData.ProductName (fictitious). Services, incidents, metrics, and people are simulated in this browser tab; no email is sent.</span>
                    <span class="d-none d-lg-inline">Built with Grid, Charts, Sidebar, Progress, Alert, Callout, Modal, Tooltip, and Toasts.</span>
                </div>
            </footer>
        </div>
    </div>

    @* Toasts can name engineers and incidents, so they are masked from session recording like the page content. *@
    <div data-clarity-mask="true">
        <Toasts class="p-3" AutoHide="true" Delay="5000" Placement="ToastsPlacement.BottomRight" />
    </div>
</div>

@code {
    private readonly ShowcaseSite site = ShowcaseCatalog.Get("monitoring");

    /// <summary>Gets or sets the page content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Gets or sets the header above the page (the status page's Navbar, or the console's top bar).</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    /// <summary>Gets or sets the sidebar beside the page (the console), or <see langword="null" /> for none.</summary>
    [Parameter] public RenderFragment? Sidebar { get; set; }

    [Inject] private MonitoringState State { get; set; } = default!;

    private void OnThemeChanged(string themeName) => State.SetTheme(themeName);
}
