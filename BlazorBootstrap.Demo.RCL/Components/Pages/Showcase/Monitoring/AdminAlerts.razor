@page "/showcase/monitoring/console/admin/alerts"
@layout ConsoleLayout

<PageTitle>Alert rules and drills · @MonitoringSeedData.ProductName</PageTitle>

<div class="container-fluid px-lg-4">
    <ShowcaseRoleGuard Roles="@MonitoringSeedData.AdminRole" SignInPath="@MonitoringLayout.SignInPath">
        <div class="mw-page-head">
            <div>
                <h1 class="mw-title">Alert rules and drills</h1>
                <p class="mw-lead">
                    Rules check every sample (every @MonitoringSeedData.TickSeconds seconds) while live updates run. A drill injects a failure so you can
                    watch a rule fire, open an incident, and, for rules that post on the status page, go public. Last sample
                    <span class="mw-mono">@MonitoringDisplay.Time(State.CurrentTime)</span>.
                </p>
            </div>
            <LivePauseButton />
        </div>

        @if (State.IsPaused)
        {
            <p class="mw-al-paused d-flex align-items-start gap-2">
                <Icon Name="IconName.PauseCircle" class="mt-1" aria-hidden="true" />
                <span>Live updates are paused, so rules aren't checked and drills can't fire. Times and values are as of the last sample. Resume live updates to let drills run their course.</span>
            </p>
        }

        @* Always rendered and focusable, so outcomes and alerts that fire are announced once, and focus has somewhere to go when the pressed button is gone. *@
        <div class="mw-al-status @(statusIsError ? "text-danger-emphasis" : null)" role="status" tabindex="-1" @ref="statusRegion">
            @foreach (var note in statusNotes)
            {
                <p class="mb-1">
                    <span class="fw-semibold">@note.Text</span>
                    @if (note.IncidentId is { } noteIncident)
                    {
                        <a class="ms-1" href="@MonitoringDisplay.IncidentUrl(noteIncident)">Open incident #@noteIncident</a>
                        @if (note.IsPublic)
                        {
                            <span aria-hidden="true"> · </span><a href="@MonitoringDisplay.PublicIncidentUrl(noteIncident)">See it on the status page</a>
                        }
                    }
                </p>
            }
        </div>

        @* Failure drills *@
        <Card Class="mw-card mb-4">
            <CardHeader>
                <h2 class="mw-card-title" id="mw-al-drill-title">Failure drills</h2>
                <span class="small text-body-secondary">Inject a failure and check that the right rule fires</span>
            </CardHeader>
            <CardBody>
                <EditForm EditContext="drillContext" OnSubmit="SubmitDrillAsync" FormName="mw-drill" novalidate aria-labelledby="mw-al-drill-title">
                    <DataAnnotationsValidator />
                    <ShowcaseFormErrors ShowSummary="true" />
                    <div class="row g-3">
                        <div class="col-md-6 col-xl-4">
                            <label class="form-label fw-semibold" for="mw-al-drill-service">Service</label>
                            <InputSelect id="mw-al-drill-service" class="form-select" @bind-Value="drillForm.ServiceId">
                                <option value="">Choose a service</option>
                                @foreach (var service in State.Services)
                                {
                                    <option value="@service.Id">@service.Name@(State.ActiveFault(service.Id) is not null ? " (drill running)" : null)</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => drillForm.ServiceId" />

                            <label class="form-label fw-semibold mt-3" for="mw-al-drill-length">Length</label>
                            <InputSelect id="mw-al-drill-length" class="form-select" @bind-Value="drillForm.Seconds" aria-describedby="mw-al-drill-length-help">
                                @foreach (var seconds in DrillLengths)
                                {
                                    <option value="@seconds">@LengthLabel(seconds)</option>
                                }
                            </InputSelect>
                            <div class="form-text" id="mw-al-drill-length-help">The metrics return to normal when it ends, or when you stop it.</div>
                        </div>

                        <fieldset class="col-md-6 col-xl-4">
                            <legend class="form-label fw-semibold fs-6">Impact</legend>
                            <InputRadioGroup @bind-Value="drillForm.Impact" Name="mw-al-drill-impact">
                                @foreach (var impact in Enum.GetValues<MonitoringImpact>())
                                {
                                    var inputId = $"mw-al-drill-impact-{impact}";
                                    <div class="form-check mb-2">
                                        <InputRadio class="form-check-input" id="@inputId" Value="impact" aria-describedby="@($"{inputId}-help")" />
                                        <label class="form-check-label fw-semibold" for="@inputId">@MonitoringDisplay.ImpactLabel(impact)</label>
                                        <div class="form-text mt-0" id="@($"{inputId}-help")">@Incidents.ImpactHelp(impact)</div>
                                    </div>
                                }
                            </InputRadioGroup>
                        </fieldset>

                        <div class="col-xl-4">
                            <h3 class="mw-label mb-2" id="mw-al-preview-title">What this drill would do</h3>
                            <section class="mw-al-preview" aria-labelledby="mw-al-preview-title">
                                @if (State.FindService(drillForm.ServiceId) is not { } drillService)
                                {
                                    <p class="small text-body-secondary mb-0">Choose a service to see which rules watch it and whether they would post on the status page.</p>
                                }
                                else
                                {
                                    var watching = State.Rules.Where(rule => rule.ServiceId == drillService.Id).ToList();
                                    var enabled = watching.Where(rule => rule.IsEnabled).ToList();
                                    var blockedBy = State.ActiveIncident(drillService.Id);
                                    var maintenance = State.ActiveMaintenance(drillService.Id);

                                    @if (State.ActiveFault(drillService.Id) is { } runningFault)
                                    {
                                        <p class="mw-al-warning small">
                                            <Icon Name="IconName.ExclamationTriangleFill" class="me-1" aria-hidden="true" /><strong>A drill is already running on @drillService.Name</strong>
                                            (ends @MonitoringDisplay.Time(runningFault.End)). Stop it below before starting another.
                                        </p>
                                    }
                                    @if (blockedBy is not null)
                                    {
                                        <p class="mw-al-warning small">
                                            <Icon Name="IconName.ExclamationTriangleFill" class="me-1" aria-hidden="true" /><strong>No rule will fire:</strong>
                                            @drillService.Name already has active incident <a href="@MonitoringDisplay.IncidentUrl(blockedBy.Id)">#@blockedBy.Id</a> (@blockedBy.Severity).
                                            The drill still bends the metrics. Resolve the incident first to test the rules.
                                        </p>
                                    }
                                    @if (maintenance is not null)
                                    {
                                        <p class="mw-al-warning small">
                                            <Icon Name="IconName.Tools" class="me-1" aria-hidden="true" /><strong>Alerts are silenced:</strong>
                                            "@maintenance.Title" is running on @drillService.Name until @MonitoringDisplay.Stamp(maintenance.End), so no rule fires.
                                        </p>
                                    }

                                    @if (enabled.Count == 0)
                                    {
                                        <p class="small mb-0">
                                            No enabled rule watches @drillService.Name@(watching.Count > 0 ? $" ({watching.Count} disabled)" : null), so this drill won't open an incident.
                                            Add or turn on a rule below first.
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="small mb-1">@(enabled.Count == 1 ? "1 enabled rule watches" : $"{enabled.Count} enabled rules watch") @drillService.Name:</p>
                                        <ul class="mw-al-outlook small">
                                            @foreach (var rule in enabled)
                                            {
                                                <li @key="rule.Id">
                                                    <span class="fw-semibold mw-al-text">@rule.Name</span>
                                                    <span class="d-block text-body-secondary">@Condition(rule) · @(rule.AutoPublish ? "Posts on the status page" : "Engineers only")</span>
                                                    <span class="d-block">@Outlook(rule, drillService, drillForm.Impact, drillForm.Seconds, blockedBy is not null || maintenance is not null)</span>
                                                </li>
                                            }
                                        </ul>
                                        @if (watching.Count > enabled.Count)
                                        {
                                            <p class="small text-body-secondary mb-0">@(watching.Count - enabled.Count) disabled @(watching.Count - enabled.Count == 1 ? "rule doesn't" : "rules don't") fire.</p>
                                        }
                                    }
                                }
                            </section>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                        <Button @ref="startDrillButton" Type="ButtonType.Submit" Color="ButtonColor.Warning">
                            <Icon Name="IconName.LightningCharge" class="me-1" aria-hidden="true" />Start drill
                        </Button>
                        <span class="small text-body-secondary">Rules only fire while live updates run on a console page.</span>
                    </div>
                </EditForm>

                @* Running and recent drills stay plain tables: a handful of short-lived rows with a live countdown, not a record list to page or export. *@
                <h3 class="h6 fw-bold mt-4 mb-2" id="mw-al-running-title">Running drills</h3>
                @if (RunningFaults.Count == 0)
                {
                    <p class="small text-body-secondary mb-0">No drills are running.</p>
                }
                else
                {
                    <Table Data="RunningFaults" Class="mw-al-drill-table mb-0" Responsive="true" TableContainerClass="mw-grid border rounded-3" RowKeySelector="fault => fault.Id"
                           Caption="Running drills, newest first. Time left is as of the last sample." VisuallyHiddenCaption="true">
                        <TableColumn HeaderText="Service" IsRowHeader="true" Context="fault"><a href="@MonitoringDisplay.ServiceUrl(fault.ServiceId)">@ServiceName(fault.ServiceId)</a></TableColumn>
                        <TableColumn HeaderText="Impact" Context="fault">@MonitoringDisplay.ImpactLabel(fault.Impact)</TableColumn>
                        <TableColumn HeaderText="Started" ColumnClass="@(_ => "text-nowrap")" Context="fault"><span class="mw-mono">@MonitoringDisplay.Time(fault.Start)</span><span class="d-block small text-body-secondary">by @fault.CreatedBy</span></TableColumn>
                        <TableColumn HeaderText="Time left" ColumnClass="@(_ => "text-nowrap")" Context="fault">@Left(fault.End - State.Clock.Now)<span class="d-block small text-body-secondary">ends <span class="mw-mono">@MonitoringDisplay.Time(fault.End)</span></span></TableColumn>
                        <TableColumn HeaderText="Incident opened" Context="fault">
                                @if (DrillIncident(fault) is { } opened)
                                {
                                    <a href="@MonitoringDisplay.IncidentUrl(opened.Id)">#@opened.Id</a>@(opened.IsPublished ? " (on the status page)" : null)
                                }
                                else
                                {
                                    <span class="text-body-secondary">None yet</span>
                                }
                        </TableColumn>
                        <TableColumn TextAlignment="Alignment.End" Context="fault">
                            <HeaderContent><span class="visually-hidden">Actions</span></HeaderContent>
                            <ChildContent>
                                <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="() => StopDrill(fault)">
                                    <Icon Name="IconName.StopFill" class="me-1" aria-hidden="true" />Stop<span class="visually-hidden"> the drill on @ServiceName(fault.ServiceId)</span>
                                </Button>
                            </ChildContent>
                        </TableColumn>
                    </Table>
                }

                <h3 class="h6 fw-bold mt-4 mb-2">Recent drills</h3>
                @if (PastFaults.Count == 0)
                {
                    <p class="small text-body-secondary mb-0">No drills have finished yet in this tab.</p>
                }
                else
                {
                    <Table Data="PastFaults" Class="mw-al-drill-table mb-0" Responsive="true" TableContainerClass="mw-grid border rounded-3" RowKeySelector="fault => fault.Id"
                           Caption="@($"The last {PastFaults.Count} finished drills, newest first.")" VisuallyHiddenCaption="true">
                        <TableColumn HeaderText="Service" IsRowHeader="true" Context="fault"><a href="@MonitoringDisplay.ServiceUrl(fault.ServiceId)">@ServiceName(fault.ServiceId)</a></TableColumn>
                        <TableColumn HeaderText="Impact" Context="fault">@MonitoringDisplay.ImpactLabel(fault.Impact)</TableColumn>
                        <TableColumn HeaderText="Started" ColumnClass="@(_ => "text-nowrap")" Context="fault"><span class="mw-mono">@MonitoringDisplay.Stamp(fault.Start)</span><span class="d-block small text-body-secondary">by @fault.CreatedBy</span></TableColumn>
                        <TableColumn HeaderText="Ran for" ColumnClass="@(_ => "text-nowrap")" Context="fault">@LengthLabel((int)Math.Round((fault.End - fault.Start).TotalSeconds))</TableColumn>
                        <TableColumn HeaderText="Incident opened" Context="fault">
                                @if (DrillIncident(fault) is { } opened)
                                {
                                    <a href="@MonitoringDisplay.IncidentUrl(opened.Id)">#@opened.Id</a>@(opened.IsPublished ? " (on the status page)" : null)
                                }
                                else
                                {
                                    <span class="text-body-secondary">None</span>
                                }
                        </TableColumn>
                    </Table>
                }
            </CardBody>
        </Card>

        @* Alert rules *@
        <div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-2">
            <div>
                <h2 class="h5 fw-bold mb-1" id="mw-al-rules-title">Alert rules</h2>
                <p class="small text-body-secondary mb-0" tabindex="-1" @ref="rulesCountRegion">
                    @State.Rules.Count of @MonitoringState.MaxRules rules. A rule opens an incident when its metric stays above the threshold for the whole duration,
                    unless the service already has an active incident or is in maintenance.
                </p>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-3">
                @* Back to the saved view's defaults: rule number order and every column in its place. *@
                <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ResetViewAsync">Reset view</Button>
                <Button @ref="newRuleButton" Color="ButtonColor.Primary" @onclick="OpenNewRuleAsync">
                    <Icon Name="IconName.PlusCircle" class="me-1" aria-hidden="true" />New rule
                </Button>
            </div>
        </div>

        <Card Class="mw-card mb-4">
            <CardBody Class="p-3 p-lg-4">
                <ShowcaseDataState Status="@(viewLoaded ? ShowcaseDataStatus.Ready : ShowcaseDataStatus.Loading)"
                                   IsEmpty="@(State.Rules.Count == 0)"
                                   EmptyIcon="IconName.BellSlash"
                                   EmptyTitle="No alert rules"
                                   EmptyText="Nothing opens incidents on its own until you add one."
                                   LoadingText="Loading alert rules…"
                                   OnRetry="RefreshGridAsync">
                    <EmptyActions>
                        <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="OpenNewRuleAsync">New rule</Button>
                    </EmptyActions>
                    <ChildContent>
                        <Grid @ref="grid"
                              @key="gridVersion"
                              TItem="MonitoringAlertRule"
                              Class="table table-hover mw-al-rules-table sc-grid-row-links"
                              GridContainerClass="mw-grid"
                              DataProvider="ProvideRulesAsync"
                              SettingsProvider="view.GetSettingsAsync"
                              GridSettingsChanged="view.SaveSettingsAsync"
                              AllowSorting="true"
                              AllowColumnChooser="true"
                              AllowExport="true"
                              ExportFileName="monitoring-alert-rules"
                              Responsive="true"
                              EmptyText="No alert rules."
                              aria-label="Alert rules, with current values from the last sample">
                            <GridColumns>
                                <GridColumn TItem="MonitoringAlertRule" HeaderText="Rule" PropertyName="Name" SortString="name" SortKeySelector="rule => rule.Name"
                                            IsDefaultSortColumn="@view.IsSortColumn("name")" SortDirection="@view.DirectionFor("name")" AlwaysVisible="true">
                                    @* A rule has no page of its own: the name opens the editor, and its stretched area makes the whole row do so. *@
                                    <button type="button" class="btn btn-link p-0 text-start mw-al-name stretched-link" @onclick="() => OpenEditRuleAsync(context)">@context.Name</button>
                                </GridColumn>
                                <GridColumn TItem="MonitoringAlertRule" HeaderText="Service" PropertyName="ServiceId" SortString="service" SortKeySelector="rule => ServiceName(rule.ServiceId)"
                                            IsDefaultSortColumn="@view.IsSortColumn("service")" SortDirection="@view.DirectionFor("service")" TextNoWrap="true">
                                    @if (State.FindService(context.ServiceId) is { } service)
                                    {
                                        <a href="@MonitoringDisplay.ServiceUrl(service.Id)">@service.Name</a>
                                    }
                                    else
                                    {
                                        @context.ServiceId
                                    }
                                </GridColumn>
                                <GridColumn TItem="MonitoringAlertRule" HeaderText="Metric" PropertyName="Metric" SortString="metric" SortKeySelector="rule => rule.Metric"
                                            IsDefaultSortColumn="@view.IsSortColumn("metric")" SortDirection="@view.DirectionFor("metric")" TextNoWrap="true">
                                    @MonitoringDisplay.MetricLabel(context.Metric)
                                </GridColumn>
                                <GridColumn TItem="MonitoringAlertRule" HeaderText="Above" PropertyName="Threshold" SortString="threshold" SortKeySelector="rule => rule.Threshold"
                                            IsDefaultSortColumn="@view.IsSortColumn("threshold")" SortDirection="@view.DirectionFor("threshold")" TextNoWrap="true">
                                    <span class="mw-mono">@MonitoringDisplay.MetricValue(context.Metric, context.Threshold)</span>
                                </GridColumn>
                                <GridColumn TItem="MonitoringAlertRule" HeaderText="For (s)" PropertyName="ForSeconds" SortString="duration" SortKeySelector="rule => rule.ForSeconds"
                                            IsDefaultSortColumn="@view.IsSortColumn("duration")" SortDirection="@view.DirectionFor("duration")" TextNoWrap="true">
                                    <span class="mw-mono">@context.ForSeconds s</span>
                                </GridColumn>
                                <GridColumn TItem="MonitoringAlertRule" HeaderText="Severity" PropertyName="Severity" SortString="severity" SortKeySelector="rule => rule.Severity"
                                            IsDefaultSortColumn="@view.IsSortColumn("severity")" SortDirection="@view.DirectionFor("severity")" TextNoWrap="true">
                                    <Badge Color="@MonitoringDisplay.SeverityColor(context.Severity)">@context.Severity</Badge>
                                </GridColumn>
                                <GridColumn TItem="MonitoringAlertRule" HeaderText="Enabled" PropertyName="IsEnabled" SortString="enabled" SortKeySelector="rule => rule.IsEnabled"
                                            IsDefaultSortColumn="@view.IsSortColumn("enabled")" SortDirection="@view.DirectionFor("enabled")">
                                    @if (context.IsEnabled)
                                    {
                                        <span class="d-inline-flex align-items-center gap-1 text-nowrap"><Icon Name="IconName.CheckCircleFill" class="text-success" aria-hidden="true" />Enabled</span>
                                        @if (State.ActiveIncident(context.ServiceId) is { } active)
                                        {
                                            <span class="d-block small text-body-secondary">Waiting: #@active.Id is active</span>
                                        }
                                        else if (State.ActiveMaintenance(context.ServiceId) is not null)
                                        {
                                            <span class="d-block small text-body-secondary">Silenced by maintenance</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="d-inline-flex align-items-center gap-1 text-body-secondary text-nowrap"><Icon Name="IconName.PauseCircle" aria-hidden="true" />Disabled</span>
                                    }
                                </GridColumn>
                                <GridColumn TItem="MonitoringAlertRule" HeaderText="Posts on the status page" PropertyName="AutoPublish" SortString="publish" SortKeySelector="rule => rule.AutoPublish"
                                            IsDefaultSortColumn="@view.IsSortColumn("publish")" SortDirection="@view.DirectionFor("publish")">
                                    @(context.AutoPublish ? "Yes" : "No")
                                </GridColumn>
                                @* Live: it changes with every sample, so it isn't sorted or exported. *@
                                <GridColumn TItem="MonitoringAlertRule" HeaderText="Current value" Sortable="false" Exportable="false" TextNoWrap="true">
                                    @if (State.FindService(context.ServiceId) is { } watched)
                                    {
                                        var current = MonitoringDisplay.MetricOf(context.Metric, State.Latest(watched.Id));
                                        <span class="mw-mono">@MonitoringDisplay.MetricValue(context.Metric, current)</span>
                                        @if (current > context.Threshold)
                                        {
                                            <span class="d-block small fw-semibold text-danger-emphasis"><Icon Name="IconName.ExclamationTriangleFill" class="me-1" aria-hidden="true" />Breaching</span>
                                        }
                                        else
                                        {
                                            <span class="d-block small text-body-secondary">Below the threshold</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary">No data</span>
                                    }
                                </GridColumn>
                                <GridColumn TItem="MonitoringAlertRule" HeaderText="Last fired" PropertyName="LastFiredAt" SortString="fired" SortKeySelector="rule => rule.LastFiredAt ?? DateTime.MinValue"
                                            IsDefaultSortColumn="@view.IsSortColumn("fired")" SortDirection="@view.DirectionFor("fired")" TextNoWrap="true">
                                    @if (context.LastFiredAt is { } firedAt)
                                    {
                                        <span class="mw-mono">@MonitoringDisplay.Stamp(firedAt)</span>
                                        @if (context.LastIncidentId is { } firedId)
                                        {
                                            <span class="d-block small">
                                                @if (State.FindIncident(firedId) is not null)
                                                {
                                                    <a href="@MonitoringDisplay.IncidentUrl(firedId)">Incident #@firedId</a>
                                                }
                                                else
                                                {
                                                    @($"Incident #{firedId} (no longer kept)")
                                                }
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary">Never</span>
                                    }
                                </GridColumn>
                                <GridColumn TItem="MonitoringAlertRule" HeaderText="Actions" Sortable="false" Exportable="false">
                                    <div class="d-flex flex-nowrap gap-1 justify-content-end">
                                        <Button @ref="editButtons[context.Id]" Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="() => OpenEditRuleAsync(context)">
                                            Edit<span class="visually-hidden">&#32;@context.Name</span>
                                        </Button>
                                        <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="() => ToggleRule(context)">
                                            @(context.IsEnabled ? "Disable" : "Enable")<span class="visually-hidden">&#32;@context.Name</span>
                                        </Button>
                                        <Button @ref="deleteButtons[context.Id]" Color="ButtonColor.Danger" Outline="true" Size="ButtonSize.Small" @onclick="() => OpenDeleteRuleAsync(context)">
                                            Delete<span class="visually-hidden">&#32;@context.Name</span>
                                        </Button>
                                    </div>
                                </GridColumn>
                            </GridColumns>
                        </Grid>
                    </ChildContent>
                </ShowcaseDataState>
            </CardBody>
        </Card>

        @* The rule form, for a new rule or an edit. Opened from code, so focus is returned by hand; the heading names it and Cancel closes it. *@
        <Modal @ref="ruleModal" Size="ModalSize.Large" IsScrollable="true" ShowCloseButton="false" aria-labelledby="mw-al-rule-title"
               OnShown="OnRuleShownAsync" OnHidden="OnRuleHidden">
            <HeaderTemplate>
                <h2 class="modal-title h5" id="mw-al-rule-title">@(editingRuleId == 0 ? "New alert rule" : "Edit alert rule")</h2>
            </HeaderTemplate>
            <BodyTemplate>
                <EditForm id="mw-al-rule-form" EditContext="ruleContext" OnSubmit="SubmitRuleAsync" FormName="mw-alert-rule" novalidate>
                    <DataAnnotationsValidator />
                    <ShowcaseFormErrors ShowSummary="true" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="mw-al-rule-name">Name</label>
                        <InputText @ref="ruleNameInput" id="mw-al-rule-name" class="form-control" maxlength="@MonitoringState.MaxRuleNameLength" @bind-Value="ruleForm.Name"
                                   autocomplete="off" aria-describedby="mw-al-rule-name-help" />
                        <ShowcaseUniqueCheck @ref="ruleNameCheck" For="() => ruleForm.Name" IsTakenAsync="IsRuleNameTakenAsync"
                                             TakenMessage="@(value => $"Another rule is already called \"{value}\". Rule names are unique, because they become incident titles.")" />
                        <div class="form-text d-flex flex-wrap justify-content-between gap-2 mt-0" id="mw-al-rule-name-help">
                            <span>Also the title of the incident it opens, like "Payments error rate above 2%".</span>
                            <span class="text-nowrap">Up to @MonitoringState.MaxRuleNameLength characters, unique</span>
                        </div>
                        <ValidationMessage For="() => ruleForm.Name" />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="mw-al-rule-service">Service</label>
                            <InputSelect id="mw-al-rule-service" class="form-select" @bind-Value="ruleForm.ServiceId">
                                <option value="">Choose a service</option>
                                @foreach (var service in State.Services)
                                {
                                    <option value="@service.Id">@service.Name@(service.IsPublic ? null : " (not on the status page)")</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => ruleForm.ServiceId" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="mw-al-rule-metric">Metric</label>
                            <InputSelect id="mw-al-rule-metric" class="form-select" @bind-Value="ruleForm.Metric" @bind-Value:after="OnRuleMetricChanged" aria-describedby="mw-al-rule-metric-help">
                                @foreach (var metric in Enum.GetValues<MonitoringAlertMetric>())
                                {
                                    <option value="@metric">@MonitoringDisplay.MetricLabel(metric)</option>
                                }
                            </InputSelect>
                            <div class="form-text" id="mw-al-rule-metric-help">@MetricHelp(ruleForm.Metric)</div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            @{ var (low, high) = MonitoringState.ThresholdRange(ruleForm.Metric); }
                            <label class="form-label fw-semibold" for="mw-al-rule-threshold">Threshold (@UnitSymbol(ruleForm.Metric))</label>
                            <InputNumber TValue="double?" id="mw-al-rule-threshold" class="form-control" step="any" @bind-Value="ruleForm.Threshold"
                                         min="@low.ToString(CultureInfo.InvariantCulture)" max="@high.ToString(CultureInfo.InvariantCulture)"
                                         ParsingErrorMessage="Enter the threshold as a number." aria-describedby="mw-al-rule-threshold-help" />
                            <div class="form-text" id="mw-al-rule-threshold-help">
                                Fires when the metric is above this. From @low.ToString(CultureInfo.InvariantCulture) to @MonitoringDisplay.Number(high) @UnitWords(ruleForm.Metric), and above the service's normal level.
                                @if (State.FindService(ruleForm.ServiceId) is { } formService)
                                {
                                    @($" {formService.Name} is at {MonitoringDisplay.MetricValue(ruleForm.Metric, MonitoringDisplay.MetricOf(ruleForm.Metric, State.Latest(formService.Id)))} now.")
                                }
                            </div>
                            <ValidationMessage For="() => ruleForm.Threshold" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="mw-al-rule-duration">For at least</label>
                            <InputSelect id="mw-al-rule-duration" class="form-select" @bind-Value="ruleForm.ForSeconds" aria-describedby="mw-al-rule-duration-help">
                                @foreach (var seconds in RuleDurations)
                                {
                                    <option value="@seconds">@seconds seconds</option>
                                }
                            </InputSelect>
                            <div class="form-text" id="mw-al-rule-duration-help">Every sample in this window must be above the threshold. Shorter fires sooner but also on brief spikes.</div>
                            <ValidationMessage For="() => ruleForm.ForSeconds" />
                        </div>
                    </div>

                    <fieldset class="mb-3">
                        <legend class="form-label fw-semibold fs-6">Severity of the incident it opens</legend>
                        <InputRadioGroup @bind-Value="ruleForm.Severity" Name="mw-al-rule-severity">
                            <div class="mw-al-severities">
                                @foreach (var severity in Enum.GetValues<MonitoringSeverity>())
                                {
                                    var inputId = $"mw-al-rule-severity-{severity}";
                                    <div class="form-check">
                                        <InputRadio class="form-check-input" id="@inputId" Value="severity" aria-describedby="@($"{inputId}-help")" />
                                        <label class="form-check-label fw-semibold" for="@inputId">@severity</label>
                                        <div class="form-text mt-0" id="@($"{inputId}-help")">@Incidents.SeverityHelp(severity)</div>
                                    </div>
                                }
                            </div>
                        </InputRadioGroup>
                    </fieldset>

                    <div class="form-check mb-2">
                        <InputCheckbox class="form-check-input" id="mw-al-rule-publish" @bind-Value="ruleForm.AutoPublish" aria-describedby="mw-al-rule-publish-help" />
                        <label class="form-check-label fw-semibold" for="mw-al-rule-publish">Post on the status page automatically</label>
                        <div class="form-text mt-0" id="mw-al-rule-publish-help">
                            When the rule fires, the message below is posted on the public status page as "Investigating" at once, without an engineer
                            checking first, and emailed to @SubscribersText(ruleForm.ServiceId). Only for a service on the status page.
                        </div>
                        <ValidationMessage For="() => ruleForm.AutoPublish" />
                    </div>

                    @if (ruleForm.IsEnabled && WouldFireOnSave)
                    {
                        @* Saving a rule whose metric is already past the threshold isn't a drill: it fires on the next samples. *@
                        <p class="small fw-semibold text-danger-emphasis mb-3" id="mw-al-rule-breach-warning">
                            @(State.FindService(ruleForm.ServiceId)?.Name) is past this threshold right now, so saving opens an incident within seconds@(ruleForm.AutoPublish ? $" and posts the message on the public status page, emailed to {SubscribersText(ruleForm.ServiceId)}" : null).
                        </p>
                    }

                    @if (ruleForm.AutoPublish)
                    {
                        <div class="mb-3 ms-md-4">
                            <label class="form-label fw-semibold" for="mw-al-rule-message">Status page message</label>
                            <InputTextArea id="mw-al-rule-message" class="form-control" rows="3" maxlength="@MonitoringState.MaxUpdateLength"
                                           @bind-Value="ruleForm.PublicMessage" aria-describedby="mw-al-rule-message-help" />
                            <div class="form-text d-flex flex-wrap justify-content-between gap-2" id="mw-al-rule-message-help">
                                <span>Customers read this. Plain words about what they notice, no internal details.</span>
                                <span class="text-nowrap">Up to @MonitoringDisplay.Number(MonitoringState.MaxUpdateLength) characters</span>
                            </div>
                            <ValidationMessage For="() => ruleForm.PublicMessage" />
                        </div>
                    }

                    <div class="form-check">
                        <InputCheckbox class="form-check-input" id="mw-al-rule-enabled" @bind-Value="ruleForm.IsEnabled" aria-describedby="mw-al-rule-enabled-help" />
                        <label class="form-check-label fw-semibold" for="mw-al-rule-enabled">Enabled</label>
                        <div class="form-text mt-0" id="mw-al-rule-enabled-help">A disabled rule is kept but never fires.</div>
                    </div>
                </EditForm>
                <p class="text-danger-emphasis fw-semibold mt-3 mb-0" role="alert">@ruleFormError</p>
            </BodyTemplate>
            <FooterTemplate>
                <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => ruleModal.HideAsync()">Cancel</Button>
                <Button Type="ButtonType.Submit" Color="ButtonColor.Primary" form="mw-al-rule-form">@(editingRuleId == 0 ? "Create rule" : "Save changes")</Button>
            </FooterTemplate>
        </Modal>

        @* Confirmations: deleting a rule, and starting a drill that could go public. *@
        <Modal @ref="confirmModal" IsVerticallyCentered="true" IsScrollable="true" ShowCloseButton="false" aria-labelledby="mw-al-confirm-title"
               OnHidden="OnConfirmHidden">
            <HeaderTemplate>
                <h2 class="modal-title h5" id="mw-al-confirm-title">@ConfirmTitle</h2>
            </HeaderTemplate>
            <BodyTemplate>
                @if (confirm == ConfirmKind.DeleteRule && State.Rules.FirstOrDefault(rule => rule.Id == confirmRuleId) is { } doomed)
                {
                    <p>
                        "<span class="mw-al-text">@doomed.Name</span>" stops watching @ServiceName(doomed.ServiceId) and can't be brought back.
                    </p>
                    <p class="small text-body-secondary mb-0">
                        Incidents it opened stay, with their timelines@(doomed.LastIncidentId is { } doomedIncident ? $" (it last opened #{doomedIncident})" : null).
                        To stop it for a while instead, disable it.
                    </p>
                }
                else if (confirm == ConfirmKind.StartDrill && pendingDrill is { } drill)
                {
                    <p>
                        A drill on @ServiceName(drill.ServiceId) for @LengthLabel(drill.Seconds): @MonitoringDisplay.ImpactLabel(drill.Impact).ToLowerInvariant().
                    </p>
                    @foreach (var rule in PublishingRules(drill.ServiceId))
                    {
                        <p class="fw-semibold">
                            If "<span class="mw-al-text">@rule.Name</span>" fires, it opens a @rule.Severity.ToString().ToLowerInvariant() incident and posts this on the public status page,
                            emailed to @SubscribersText(drill.ServiceId):
                        </p>
                        <blockquote class="mw-al-quote mw-al-text">@rule.PublicMessage</blockquote>
                    }
                    <p class="small text-body-secondary mb-0">
                        In this demo it stays in this tab, but treat it as real: customers would see it. Resolve the incident afterwards with a public "Resolved" update.
                    </p>
                }
            </BodyTemplate>
            <FooterTemplate>
                <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => confirmModal.HideAsync()">Cancel</Button>
                <Button Color="@(confirm == ConfirmKind.DeleteRule ? ButtonColor.Danger : ButtonColor.Warning)" @onclick="ConfirmAsync">@(confirm == ConfirmKind.DeleteRule ? "Delete rule" : "Start drill")</Button>
            </FooterTemplate>
        </Modal>
    </ShowcaseRoleGuard>
</div>
