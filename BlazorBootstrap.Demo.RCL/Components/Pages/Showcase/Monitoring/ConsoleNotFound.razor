@page "/showcase/monitoring/console/{*path}"
@layout ConsoleLayout

<PageTitle>Page not found · @MonitoringSeedData.ProductName</PageTitle>

@* Unknown console pages stay in the console instead of falling to the public status page's not-found page. *@
<div class="container-fluid px-lg-4">
    <section class="mw-not-found" aria-labelledby="mw-console-missing-title">
        <span class="mw-icon fs-4" aria-hidden="true"><Icon Name="IconName.SignpostSplit" /></span>
        <h1 class="mw-title fs-3 mt-3 mb-2" id="mw-console-missing-title">We couldn't find that page</h1>
        <p class="text-body-secondary mb-4">The link may be wrong, or the incident, service, or trace may no longer exist.</p>
        <div class="d-flex justify-content-center flex-wrap gap-2">
            <a class="btn btn-primary" href="@ConsoleLayout.Base">Back to the overview</a>
            <a class="btn btn-outline-primary" href="@($"{ConsoleLayout.Base}/incidents")">Incidents</a>
        </div>
    </section>
</div>

@code {
    /// <summary>Gets or sets the unmatched path.</summary>
    [Parameter] public string? Path { get; set; }
}
