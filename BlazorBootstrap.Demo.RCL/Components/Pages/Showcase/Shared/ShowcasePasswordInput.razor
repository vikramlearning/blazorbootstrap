@inherits InputBase<string?>

@* A password box with a named show/hide toggle. The library's PasswordInput toggle has no accessible name, so the showcase uses this. *@
<div class="input-group">
    <input @attributes="AdditionalAttributes"
           id="@Id"
           type="@(visible ? "text" : "password")"
           class="form-control @CssClass"
           value="@CurrentValueAsString"
           autocomplete="@AutoComplete"
           maxlength="128"
           @onchange="OnChange" />
    <button type="button" class="btn btn-outline-secondary" aria-pressed="@(visible ? "true" : "false")" aria-controls="@Id" @onclick="Toggle">
        <Icon Name="@(visible ? IconName.EyeSlash : IconName.Eye)" aria-hidden="true" /><span class="visually-hidden">Show password</span>
    </button>
</div>
