@using BlazorBootstrap.Demo.RCL.Models.Showcase
@using BlazorBootstrap.Demo.RCL.Services.Showcase

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600;700&family=Source+Sans+3:wght@400;600;700&display=swap" />
</HeadContent>

@* The frame both Quillpath Academy layouts share: the learners' school and the instructor's back office (D-031). Its
   stylesheet styles the pages of both through ::deep. *@
<div class="sc-site sc-learning">
    <ShowcaseSiteBar Site="@site" />

    @Header

    <div class="@(Sidebar is null ? null : "qp-shell")">
        @Sidebar

        <div class="@(Sidebar is null ? null : "qp-shell-main")">
            @* Pages show learners' names, progress, reviews, and questions, so the content is masked from session recording. *@
            <main class="sc-main qp-content" id="qp-main" data-clarity-mask="true">
                @ChildContent
            </main>

            <div class="@Container">
                <CarbonAds Class="sc-ad" />
            </div>

            <footer class="qp-footer">
                <div class="@Container d-flex flex-wrap justify-content-between gap-2">
                    <span>© 2026 @LearningSeedData.SchoolName (fictitious). Courses, people, reviews, and certificates are made up and stay in this browser tab.</span>
                    <span class="d-none d-lg-inline">Built with Card, Accordion, Progress, Markdown, RichTextEditor, PdfViewer, Sidebar, Charts, and Modal.</span>
                </div>
            </footer>
        </div>
    </div>

    @* Toasts can name learners and courses, so they are masked from session recording like the page content. *@
    <div data-clarity-mask="true">
        <Toasts class="p-3" AutoHide="true" Delay="5000" Placement="ToastsPlacement.BottomRight" />
    </div>
</div>

@code {
    private readonly ShowcaseSite site = ShowcaseCatalog.Get("learning");

    /// <summary>Gets or sets the page content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Gets or sets the header above the page (the school's Navbar, or the instructor's top bar).</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    /// <summary>Gets or sets the sidebar beside the page (the instructor's back office), or <see langword="null" /> for none.</summary>
    [Parameter] public RenderFragment? Sidebar { get; set; }

    private string Container => Sidebar is null ? "container-xl" : "container-fluid px-lg-4";
}
