@inherits LayoutComponentBase

<ShowcaseSessionHost State="State" SiteBase="@Base" SiteName="@LearningSeedData.SchoolName">
<LearningFrame>
    <Header>
    @if (State.IsInstructor)
    {
        @* An instructor sees the school as learners do, with a way back to teaching; enrolling is for learners (D-032). *@
        <div class="qp-viewing-bar">
            <div class="container-xl d-flex flex-wrap align-items-center justify-content-between gap-2">
                <span><Icon Name="IconName.Easel" class="me-2" aria-hidden="true" />Viewing the school as @State.Identity.Current!.Name (Instructor)</span>
                <a href="@TeachLayout.Base"><Icon Name="IconName.ArrowLeft" class="me-1" aria-hidden="true" />Back to teaching</a>
            </div>
        </div>
    }
    <Navbar Class="qp-header"
            Placement="NavbarPlacement.StickyTop"
            Container="NavbarContainer.ExtraLarge"
            AriaLabel="Quillpath Academy"
            TogglerAriaLabel="Menu">
        <Brand>
            <NavbarBrand Href="@Base" Class="qp-brand">
                <span class="qp-brand-mark" aria-hidden="true"><Icon Name="IconName.Feather" /></span>
                <span>@LearningSeedData.SchoolName</span>
            </NavbarBrand>
            @if (State.Identity.IsSignedIn)
            {
                <ShowcaseAccountMenu SiteBase="@Base" SignInPath="@SignInPath" Class="ms-auto me-2 order-lg-last"
                                     NoticeCount="@(State.IsInstructor ? State.UnansweredCount : 0)" NoticesPath="@(State.IsInstructor ? $"{TeachLayout.Base}/questions" : null)" />
            }
            else
            {
                <a class="btn btn-sm btn-outline-secondary ms-auto me-2 order-lg-last" href="@SignInPath">Sign in</a>
            }
        </Brand>
        <ChildContent>
            <NavbarNav Class="me-auto ms-lg-4 mb-3 mb-lg-0">
                <NavbarItem Href="@Base" Match="NavLinkMatch.All">Courses</NavbarItem>
                @if (State.IsLearner)
                {
                    <NavbarItem Href="@($"{Base}/progress")">My learning</NavbarItem>
                    <NavbarItem Href="@($"{Base}/certificates")" Match="NavLinkMatch.All">Certificates</NavbarItem>
                }
                @if (State.IsInstructor)
                {
                    <NavbarItem Href="@TeachLayout.Base">Teaching</NavbarItem>
                }
                <NavbarItem Href="@($"{Base}/verify")">Verify a certificate</NavbarItem>
            </NavbarNav>
        </ChildContent>
    </Navbar>
    </Header>
    <ChildContent>
        @Body
    </ChildContent>
</LearningFrame>
</ShowcaseSessionHost>
