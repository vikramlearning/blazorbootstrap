@page "/showcase/learning/courses/{Id:int}"
@layout LearningLayout

@if (Course is null)
{
    <LearningNotFound />
}
else
{
    var reviews = Reviews;
    var average = State.AverageRating(Course.Id);

    <PageTitle>@Course.Title · @LearningSeedData.SchoolName</PageTitle>

    <div class="container-xl pb-4">
        <Breadcrumb Items="BreadcrumbItems" Class="mb-3" />

        <div class="row g-4 g-lg-5 mb-4">
            <div class="col-lg-8">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                    <span class="sc-eyebrow">@Category.Name</span>
                    <Badge Color="@LearningDisplay.LevelColor(Course.Level)" Class="rounded-pill">@Course.Level</Badge>
                    @if (IsEnrolled)
                    {
                        <Badge Color="@(IsComplete ? BadgeColor.Success : BadgeColor.Primary)" Class="rounded-pill">@(IsComplete ? "Completed" : "Enrolled")</Badge>
                    }
                </div>
                <h1 class="qp-title">@Course.Title</h1>
                <p class="qp-lead mb-3">@Course.Subtitle</p>

                <p class="qp-stars small mb-3">
                    @if (reviews.Count > 0)
                    {
                        <span aria-hidden="true" class="me-1">
                            @foreach (var star in LearningDisplay.Stars(average))
                            {
                                <Icon Name="star" />
                            }
                        </span>
                    }
                    <a class="link-body-emphasis" href="@($"{LearningDisplay.CourseUrl(Course.Id)}#qp-reviews")">@AverageText(reviews.Count, average)</a>
                </p>

                <div class="qp-meta mb-4">
                    <span><Icon Name="IconName.PersonVideo3" class="me-1" aria-hidden="true" />@Course.Instructor, @Course.InstructorRole</span>
                    <span><Icon Name="IconName.Clock" class="me-1" aria-hidden="true" />@LearningDisplay.Duration(Course.Minutes)</span>
                    <span><Icon Name="IconName.Journal" class="me-1" aria-hidden="true" />@Course.Modules.Count modules, @Course.Lessons.Count lessons</span>
                </div>

                <p class="mb-0">@Course.Description</p>
            </div>

            <div class="col-lg-4">
                <Card Class="qp-card">
                    <ShowcaseImage Src="@Course.ImagePath" Alt="" Width="800" Height="450" Eager="true"
                                   Accent="@Category.Accent" PlaceholderIcon="@Category.IconName" Caption="@Category.Name" />
                    <CardBody>
                        <h2 class="h6 fw-bold mb-2">@(IsEnrolled ? "Your progress" : "Enroll")</h2>
                        @if (!Session.IsRestored)
                        {
                            <p class="small text-body-secondary mb-0">Loading your progress…</p>
                        }
                        else if (!State.Identity.IsSignedIn)
                        {
                            <p class="small mb-3">
                                Free for members. Sign in to enroll, track your progress, and earn a certificate. The sign-in page has a
                                one-click demo account, or you can create your own.
                            </p>
                            <a class="btn btn-primary w-100 mb-2" href="@SignInUrl(register: false)">
                                <Icon Name="IconName.BoxArrowInRight" class="me-2" aria-hidden="true" />Sign in to enroll
                            </a>
                            <a class="btn btn-outline-primary w-100" href="@SignInUrl(register: true)">Create an account</a>
                        }
                        else if (!State.IsLearner)
                        {
                            <p class="small mb-0">
                                You're signed in as @State.Identity.Current!.Name (@(State.Identity.CurrentRole?.Label ?? "staff")). Only learner accounts
                                enroll in courses.
                            </p>
                        }
                        else if (IsEnrolled)
                        {
                            var percent = State.ProgressPercent(Course.Id);
                            var progressText = $"{State.CompletedCount(Course.Id)} of {Course.Lessons.Count} lessons complete";
                            var certificate = State.CertificateFor(Course.Id);
                            var next = State.NextLesson(Course);
                            <Progress Height="10" Class="mb-1">
                                <ProgressBar Width="percent" Color="@(IsComplete ? ProgressColor.Success : ProgressColor.Primary)"
                                             aria-label="Course progress" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"
                                             aria-valuetext="@progressText" />
                            </Progress>
                            <p class="small text-body-secondary">@progressText (@percent%)</p>

                            @if (IsComplete)
                            {
                                <p class="small fw-semibold mb-2">You finished the course.</p>
                                @if (certificate is not null)
                                {
                                    <a class="btn btn-primary w-100 mb-2" href="@CertificateUrl(certificate.Code)" @ref="primaryAction">
                                        <Icon Name="IconName.Award" class="me-2" aria-hidden="true" />View your certificate
                                    </a>
                                }
                                <a class="btn btn-outline-primary w-100" href="@LearningDisplay.LessonUrl(Course.Id, Course.Lessons[0].Id)">Review the lessons</a>
                            }
                            else if (State.CompletedCount(Course.Id) == 0)
                            {
                                <a class="btn btn-primary w-100" href="@LearningDisplay.LessonUrl(Course.Id, next.Id)" @ref="primaryAction">
                                    <Icon Name="IconName.PlayFill" class="me-2" aria-hidden="true" />Start the first lesson
                                </a>
                                <p class="small text-body-secondary mt-1 mb-0">@next.Title · @LearningDisplay.KindLabel(next.Kind), @next.Minutes min</p>
                            }
                            else
                            {
                                <a class="btn btn-primary w-100" href="@LearningDisplay.LessonUrl(Course.Id, next.Id)" @ref="primaryAction">
                                    <Icon Name="IconName.PlayFill" class="me-2" aria-hidden="true" />Continue: @next.Title
                                </a>
                                @if (certificate is not null)
                                {
                                    <a class="btn btn-outline-primary w-100 mt-2" href="@CertificateUrl(certificate.Code)">
                                        <Icon Name="IconName.Award" class="me-2" aria-hidden="true" />View your certificate
                                    </a>
                                }
                            }

                            <button type="button" class="btn btn-sm btn-outline-danger w-100 mt-3" @ref="unenrollButton" @onclick="AskUnenrollAsync">Unenroll</button>
                        }
                        else
                        {
                            var certificate = State.CertificateFor(Course.Id);
                            @if (Course.IsPublished)
                            {
                                <p class="small mb-3">Free for members. Enroll to open every lesson, take the self-checks, track your progress, and earn a certificate.</p>
                                <button type="button" class="btn btn-primary w-100" @onclick="Enroll">
                                    <Icon Name="IconName.PlusCircle" class="me-2" aria-hidden="true" />Enroll
                                </button>
                            }
                            else
                            {
                                <p class="small mb-0">@Course.Instructor took this course out of the catalog, so it isn't open for new enrollments.</p>
                            }
                            @if (certificate is not null)
                            {
                                <p class="small mt-3 mb-1">You earned this course's certificate before; it's still yours.</p>
                                <a class="btn btn-sm btn-outline-primary w-100" href="@CertificateUrl(certificate.Code)">
                                    <Icon Name="IconName.Award" class="me-2" aria-hidden="true" />View your certificate
                                </a>
                            }
                        }

                        @* Always rendered and focusable, so an outcome is announced and focus has somewhere to go. *@
                        <p class="small fw-semibold mb-0 @(enrollStatus.Message is null ? null : "mt-2") @(enrollStatus.IsError ? "text-danger-emphasis" : null)" role="status" tabindex="-1" @ref="enrollStatusRegion">@enrollStatus.Message</p>

                        <hr />
                        @if (Course.HasHandout)
                        {
                            <p class="small mb-1"><Icon Name="IconName.FileEarmarkPdf" class="me-2" aria-hidden="true" />Course handout (PDF) in every lesson</p>
                        }
                        <p class="small mb-1"><Icon Name="IconName.PatchQuestion" class="me-2" aria-hidden="true" />@QuizCountText</p>
                        <p class="small mb-0"><Icon Name="IconName.Award" class="me-2" aria-hidden="true" />Certificate with a verify code when you finish</p>
                    </CardBody>
                </Card>
            </div>
        </div>

        <div class="row g-4 g-lg-5">
            <div class="col-lg-8">
                <h2 class="qp-section-title">What you'll learn</h2>
                <ul class="list-unstyled mb-4">
                    @foreach (var outcome in Course.Outcomes)
                    {
                        <li class="mb-1"><Icon Name="IconName.Check2" class="me-2 qp-lesson-done" aria-hidden="true" />@outcome</li>
                    }
                </ul>

                <h2 class="qp-section-title" id="qp-curriculum">Curriculum</h2>
                @if (!IsEnrolled)
                {
                    <p class="small text-body-secondary">Enroll to open the lessons.</p>
                }
                @* AlwaysOpen: learners compare modules, so opening one does not close another. *@
                <Accordion AlwaysOpen="true" Class="mb-5">
                    @foreach (var (module, index) in Course.Modules.Select((module, index) => (module, index)))
                    {
                        <AccordionItem @key="module.Title" Name="@($"module-{index + 1}")" Active="index == 0">
                            <TitleTemplate>
                                <span class="d-flex flex-wrap justify-content-between w-100 gap-2 me-2">
                                    <span class="fw-semibold">Module @(index + 1): @module.Title</span>
                                    <span class="small text-body-secondary">
                                        @module.Lessons.Count lessons · @LearningDisplay.Duration(module.Lessons.Sum(lesson => lesson.Minutes))@(IsEnrolled ? $" · {module.Lessons.Count(lesson => State.IsLessonComplete(Course.Id, lesson.Id))} done" : null)
                                    </span>
                                </span>
                            </TitleTemplate>
                            <Content>
                                <ol class="list-unstyled mb-0">
                                    @foreach (var lesson in module.Lessons)
                                    {
                                        var done = State.IsLessonComplete(Course.Id, lesson.Id);
                                        <li class="qp-curriculum-row" @key="lesson.Id">
                                            <Icon Name="@(done ? IconName.CheckCircleFill : LearningDisplay.KindIcon(lesson.Kind))" class="@(done ? "qp-lesson-done" : "text-body-secondary")" aria-hidden="true" />
                                            <span class="flex-grow-1">
                                                @if (IsEnrolled)
                                                {
                                                    <a href="@LearningDisplay.LessonUrl(Course.Id, lesson.Id)">@lesson.Title</a>
                                                }
                                                else
                                                {
                                                    @lesson.Title
                                                }
                                                <span class="d-block small text-body-secondary">@LearningDisplay.KindLabel(lesson.Kind) · @lesson.Minutes min@(IsEnrolled ? (done ? " · Completed" : " · Not done yet") : null)</span>
                                            </span>
                                        </li>
                                    }
                                </ol>
                            </Content>
                        </AccordionItem>
                    }
                </Accordion>
            </div>
        </div>

        <section aria-labelledby="qp-reviews">
            <h2 class="qp-section-title" id="qp-reviews">Reviews</h2>
            <p class="mb-3">@AverageText(reviews.Count, average)</p>

            <div class="row g-4">
                <div class="col-lg-4">
                    <section class="qp-panel" id="your-review" aria-labelledby="qp-your-review-heading">
                        <h3 class="h5 fw-bold" id="qp-your-review-heading" tabindex="-1" @ref="yourReviewHeading">Your review</h3>
                        @if (!Session.IsRestored)
                        {
                            <p class="small text-body-secondary mb-0">Loading…</p>
                        }
                        else if (!State.Identity.IsSignedIn)
                        {
                            <p class="mb-2">Enrolled learners can review this course.</p>
                            <a class="btn btn-outline-primary btn-sm" href="@SignInUrl(register: false)">Sign in to enroll</a>
                        }
                        else if (!State.IsLearner)
                        {
                            <p class="mb-0">Reviews come from learners enrolled in the course.</p>
                        }
                        else
                        {
                            var own = OwnReview;
                            @if (own is not null && !isEditing)
                            {
                                <p class="qp-stars small mb-1">
                                    <span aria-hidden="true" class="me-1">
                                        @foreach (var star in LearningDisplay.Stars(own.Rating))
                                        {
                                            <Icon Name="star" />
                                        }
                                    </span>
                                    <span class="text-body">@RatedText(own.Rating)</span>
                                </p>
                                <p class="text-break mb-1" style="white-space: pre-wrap;">@own.Body</p>
                                <p class="small text-body-secondary mb-3">@DatesText(own)</p>
                                @if (own.HiddenReason is not null)
                                {
                                    <p class="small mb-3"><Icon Name="IconName.EyeSlash" class="me-1" aria-hidden="true" />@Course.Instructor hid your review from the course page (@own.HiddenReason.ToLowerInvariant()). Other learners don't see it, and it doesn't count in the rating.</p>
                                }
                                @if (own.InstructorReply is not null)
                                {
                                    <p class="small mb-3">@Course.Instructor replied; the reply is in the list.</p>
                                }
                                @if (IsEnrolled)
                                {
                                    <div class="d-flex flex-wrap gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-primary" @ref="editButton" @onclick="StartEdit">
                                            <Icon Name="IconName.Pencil" class="me-1" aria-hidden="true" />Edit<span class="visually-hidden"> your review</span>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" @ref="deleteButton" @onclick="AskDeleteReviewAsync">
                                            <Icon Name="IconName.Trash" class="me-1" aria-hidden="true" />Delete<span class="visually-hidden"> your review</span>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <p class="small text-body-secondary mb-2">You're not enrolled now, so you can't edit it. Enroll again to edit it; you can delete it at any time.</p>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @ref="deleteButton" @onclick="AskDeleteReviewAsync">
                                        <Icon Name="IconName.Trash" class="me-1" aria-hidden="true" />Delete<span class="visually-hidden"> your review</span>
                                    </button>
                                }
                            }
                            else if (IsEnrolled)
                            {
                                <p class="small text-body-secondary">@(own is null ? "Tell other learners what you thought. You can edit or delete it later." : "Change your rating or your words. The review shows as edited.")</p>
                                <form @onsubmit="SaveReview" novalidate>
                                    <fieldset class="mb-3" aria-describedby="@(ratingError is null ? null : "qp-review-rating-error")">
                                        <legend class="form-label fs-6 fw-semibold mb-1">Your rating</legend>
                                        @for (var stars = 1; stars <= 5; stars++)
                                        {
                                            var value = stars;
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input @(ratingError is null ? null : "is-invalid")" type="radio" name="qp-review-rating"
                                                       id="@($"qp-review-rating-{value}")" value="@value" checked="@(reviewRating == value)"
                                                       @ref="ratingRadios[value]" @onchange="() => SelectRating(value)" />
                                                <label class="form-check-label" for="@($"qp-review-rating-{value}")">@RatingLabel(value)</label>
                                            </div>
                                        }
                                        <div class="invalid-feedback d-block" id="qp-review-rating-error">@ratingError</div>
                                    </fieldset>

                                    <label class="form-label fw-semibold" for="qp-review-body">Your review</label>
                                    <textarea id="qp-review-body" class="form-control @(bodyError is null ? null : "is-invalid")" rows="5" maxlength="@LearningState.MaxReviewLength"
                                              @bind="reviewBody" @bind:event="oninput" @ref="bodyInput"
                                              aria-invalid="@(bodyError is null ? null : "true")"
                                              aria-describedby="qp-review-body-count@(bodyError is null ? null : " qp-review-body-error")"></textarea>
                                    <div class="form-text text-end" id="qp-review-body-count">@reviewBody.Length of @MaxReviewText characters</div>
                                    <div class="invalid-feedback d-block mb-2" id="qp-review-body-error">@bodyError</div>

                                    <div class="d-flex flex-wrap gap-2">
                                        <Button Type="ButtonType.Submit" Color="ButtonColor.Primary">@(own is null ? "Post review" : "Save changes")</Button>
                                        @if (own is not null)
                                        {
                                            <Button Color="ButtonColor.Secondary" Outline="true" @onclick="CancelEdit">Cancel</Button>
                                        }
                                    </div>
                                </form>
                            }
                            else
                            {
                                <p class="mb-0">Enrolled learners can review this course. Enroll to share what you thought.</p>
                            }
                        }
                        <p class="small fw-semibold mb-0 @(reviewStatus.Message is null ? null : "mt-3") @(reviewStatus.IsError ? "text-danger-emphasis" : null)" role="status" tabindex="-1" @ref="reviewStatusRegion">@reviewStatus.Message</p>
                    </section>
                </div>

                <div class="col-lg-8">
                    @if (reviews.Count == 0)
                    {
                        <p class="text-body-secondary">No one has reviewed this course yet.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var review in reviews)
                            {
                                var mine = IsMine(review);
                                <li class="py-3 border-bottom" @key="review.Id">
                                    <article aria-label="@($"Review by {review.Author}")">
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            <span class="fw-semibold text-break" style="min-width: 0;">@review.Author</span>
                                            @if (mine)
                                            {
                                                <Badge Color="BadgeColor.Secondary">Your review</Badge>
                                            }
                                            <span class="small text-body-secondary">@DatesText(review)</span>
                                        </div>
                                        <p class="qp-stars small mb-1">
                                            <span aria-hidden="true" class="me-1">
                                                @foreach (var star in LearningDisplay.Stars(review.Rating))
                                                {
                                                    <Icon Name="star" />
                                                }
                                            </span>
                                            <span class="text-body">@RatedText(review.Rating)</span>
                                        </p>
                                        <p class="text-break mb-0" style="white-space: pre-wrap;">@review.Body</p>
                                        @if (review.InstructorReply is not null)
                                        {
                                            <div class="mt-2 ps-3 py-2 pe-2 border-start border-3 border-primary-subtle bg-body-tertiary rounded-end">
                                                <p class="small fw-semibold mb-1">Reply from @Course.Instructor, instructor</p>
                                                <p class="text-break small mb-0" style="white-space: pre-wrap;">@review.InstructorReply</p>
                                            </div>
                                        }
                                    </article>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </section>
    </div>

    <Modal @ref="unenrollModal" IsVerticallyCentered="true" ShowCloseButton="false" aria-labelledby="qp-unenroll-title" OnHidden="OnUnenrollHiddenAsync">
        <HeaderTemplate>
            <h2 class="modal-title h5" id="qp-unenroll-title">Unenroll from @Course.Title?</h2>
        </HeaderTemplate>
        <BodyTemplate>
            <p class="mb-2">
                <strong>Removed:</strong> your progress (@State.CompletedCount(Course.Id) of @Course.Lessons.Count lessons complete) and your self-check results for this course.
            </p>
            <p class="mb-2">
                <strong>Kept:</strong> @KeptText.
            </p>
            @if (Course.IsPublished)
            {
                <p class="small text-body-secondary mb-0">You can enroll again at any time; you'd start from the first lesson.</p>
            }
            else
            {
                <p class="small fw-semibold mb-0">@Course.Instructor took this course out of the catalog, so you can't enroll again after leaving@(State.CertificateFor(Course.Id) is null ? ", and the course is gone from your courses" : null).</p>
            }
            <p class="text-danger-emphasis fw-semibold small mt-2 mb-0" role="alert">@unenrollError</p>
        </BodyTemplate>
        <FooterTemplate>
            <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => unenrollModal.HideAsync()">Stay enrolled</Button>
            <Button Color="ButtonColor.Danger" @onclick="ConfirmUnenrollAsync">Unenroll</Button>
        </FooterTemplate>
    </Modal>

    <Modal @ref="deleteModal" IsVerticallyCentered="true" ShowCloseButton="false" aria-labelledby="qp-delete-review-title" OnHidden="OnDeleteHiddenAsync">
        <HeaderTemplate>
            <h2 class="modal-title h5" id="qp-delete-review-title">Delete your review of @Course.Title?</h2>
        </HeaderTemplate>
        <BodyTemplate>
            <p class="mb-2">
                Your rating and text are removed from the course page and from its average@(OwnReview?.InstructorReply is not null ? $", and so is {Course.Instructor}'s reply" : null).
                This can't be undone.
            </p>
            <p class="small text-body-secondary mb-0">You can write a new review while you're enrolled.</p>
            <p class="text-danger-emphasis fw-semibold small mt-2 mb-0" role="alert">@deleteError</p>
        </BodyTemplate>
        <FooterTemplate>
            <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => deleteModal.HideAsync()">Keep review</Button>
            <Button Color="ButtonColor.Danger" @onclick="ConfirmDeleteReviewAsync">Delete review</Button>
        </FooterTemplate>
    </Modal>
}
