@page "/showcase/learning/teach/courses"
@layout TeachLayout

<PageTitle>Courses · Teaching · @LearningSeedData.SchoolName</PageTitle>

@{
    var courses = State.MyCourses;
    var roster = State.Roster;
}

<div class="container-fluid px-lg-4">
    <div class="qp-tc-head mb-3">
        <div>
            <h1 class="qp-title">Courses</h1>
            <p class="qp-lead">
                The courses @(State.Identity.Current?.Name ?? "you") teach, published and draft: edit them, publish them to the catalog, or take them out.
            </p>
        </div>
        <a class="btn btn-primary" href="@TeachCourseEdit.NewUrl"><Icon Name="IconName.PlusLg" class="me-2" aria-hidden="true" />New course</a>
    </div>

    @* Always rendered and focusable, so an action's outcome is announced and focus has somewhere to go. *@
    <p class="qp-tc-status @(status.IsError ? "text-danger-emphasis" : null)" role="status" tabindex="-1" @ref="statusRegion">@status.Message</p>

    @if (courses.Count == 0)
    {
        <section class="qp-panel text-center py-5" aria-labelledby="qp-tc-empty">
            <span class="qp-icon fs-4" aria-hidden="true"><Icon Name="IconName.JournalPlus" /></span>
            <h2 class="h5 fw-bold mt-3" id="qp-tc-empty">No courses yet</h2>
            <p class="text-body-secondary">Start a course: write its details, add modules and lessons, then publish it to the catalog.</p>
            <a class="btn btn-primary" href="@TeachCourseEdit.NewUrl">New course</a>
        </section>
    }
    else
    {
        <p class="small text-body-secondary">@CountText(courses)</p>
        <ul class="qp-tc-list list-unstyled mb-0">
            @foreach (var course in courses)
            {
                var learners = roster.Count(row => row.Course.Id == course.Id);
                var lessons = course.Lessons;
                var published = lessons.Count(lesson => lesson.IsPublished);
                var reviewCount = State.RatingCounts(course.Id).Sum();
                var headingId = FormattableString.Invariant($"qp-tc-title-{course.Id}");
                var deleteNoteId = FormattableString.Invariant($"qp-tc-delete-note-{course.Id}");
                var category = State.FindCategory(course.CategoryId);

                <li @key="course.Id">
                    <article class="qp-panel qp-tc-item" aria-labelledby="@headingId">
                        <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
                            <div class="qp-tc-title-wrap">
                                <h2 class="qp-card-title" id="@headingId"><a href="@TeachCourseEdit.EditUrl(course.Id)">@course.Title</a></h2>
                                <p class="small text-body-secondary mb-0">@category.Name · @course.Level</p>
                            </div>
                            @if (course.IsPublished)
                            {
                                <Badge Color="BadgeColor.Success"><Icon Name="IconName.Globe" class="me-1" aria-hidden="true" />Published</Badge>
                            }
                            else
                            {
                                <Badge Color="BadgeColor.Secondary"><Icon Name="IconName.PencilSquare" class="me-1" aria-hidden="true" />Draft</Badge>
                            }
                        </div>

                        <dl class="qp-tc-facts">
                            <div>
                                <dt>Learners</dt>
                                <dd>@LearnersText(learners)</dd>
                            </div>
                            <div>
                                <dt>Lessons</dt>
                                <dd>@PublishedLessonsText(published, lessons.Count)</dd>
                            </div>
                            <div>
                                <dt>Rating</dt>
                                <dd>
                                    @if (reviewCount == 0)
                                    {
                                        <span class="fw-normal text-body-secondary">No reviews yet</span>
                                    }
                                    else
                                    {
                                        <text><Icon Name="IconName.StarFill" class="qp-stars me-1" aria-hidden="true" />@LearningDisplay.Rating(State.AverageRating(course.Id)) out of 5<span class="fw-normal text-body-secondary"> (@ReviewsText(reviewCount))</span></text>
                                    }
                                </dd>
                            </div>
                        </dl>

                        @if (!course.IsPublished)
                        {
                            <p class="small text-body-secondary mb-2">
                                @(learners > 0
                                    ? "Not in the catalog and closed to new enrollments. Enrolled learners keep their access."
                                    : "Not in the catalog. Only you can open the course page.")
                            </p>
                        }

                        <div class="qp-tc-actions">
                            <a class="btn btn-sm btn-primary" href="@TeachCourseEdit.EditUrl(course.Id)">
                                <Icon Name="IconName.Pencil" class="me-1" aria-hidden="true" />Edit<span class="visually-hidden"> @course.Title</span>
                            </a>
                            <a class="btn btn-sm btn-outline-secondary" href="@LearningDisplay.CourseUrl(course.Id)">
                                <Icon Name="IconName.BoxArrowUpRight" class="me-1" aria-hidden="true" />View in school<span class="visually-hidden">: @course.Title</span>
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @ref="publishButtons[course.Id]" @onclick="() => TogglePublishedAsync(course)">
                                @if (course.IsPublished)
                                {
                                    <text><Icon Name="IconName.EyeSlash" class="me-1" aria-hidden="true" />Unpublish<span class="visually-hidden"> @course.Title</span></text>
                                }
                                else
                                {
                                    <text><Icon Name="IconName.Globe" class="me-1" aria-hidden="true" />Publish<span class="visually-hidden"> @course.Title</span></text>
                                }
                            </button>
                            @if (learners > 0)
                            {
                                @* Explained up front: a course with learners can't be deleted. Still focusable, so the reason is found. *@
                                <button type="button" class="btn btn-sm btn-outline-danger qp-tc-unavailable" aria-disabled="true" aria-describedby="@deleteNoteId"
                                        @onclick="() => ExplainDelete(course, learners)">
                                    <Icon Name="IconName.Trash3" class="me-1" aria-hidden="true" />Delete<span class="visually-hidden"> @course.Title</span>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" @ref="deleteButtons[course.Id]" @onclick="() => AskDeleteAsync(course)">
                                    <Icon Name="IconName.Trash3" class="me-1" aria-hidden="true" />Delete<span class="visually-hidden"> @course.Title</span>
                                </button>
                            }
                        </div>
                        @if (learners > 0)
                        {
                            <p class="small text-body-secondary mt-2 mb-0" id="@deleteNoteId">
                                @DeleteUnavailableText(course, learners)
                            </p>
                        }
                    </article>
                </li>
            }
        </ul>
    }
</div>

@* Outside the list, so a dialog is never removed while it is open. *@
<Modal @ref="unpublishModal" IsVerticallyCentered="true" ShowCloseButton="false" aria-labelledby="qp-tc-unpublish-title" OnHidden="OnUnpublishHiddenAsync">
    <HeaderTemplate>
        <h2 class="modal-title h5" id="qp-tc-unpublish-title">Unpublish @pending?.Title?</h2>
    </HeaderTemplate>
    <BodyTemplate>
        @if (pending is { } course)
        {
            <p class="mb-2">It leaves the catalog and takes no new enrollments.</p>
            <p class="mb-2">@KeepAccessText(LearnerCount(course.Id))</p>
            <p class="small text-body-secondary mb-0">You can publish it again at any time.</p>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => unpublishModal.HideAsync()">Keep published</Button>
        <Button Color="ButtonColor.Primary" @onclick="ConfirmUnpublishAsync">Unpublish</Button>
    </FooterTemplate>
</Modal>

<Modal @ref="deleteModal" IsVerticallyCentered="true" ShowCloseButton="false" aria-labelledby="qp-tc-delete-title" OnHidden="OnDeleteHiddenAsync">
    <HeaderTemplate>
        <h2 class="modal-title h5" id="qp-tc-delete-title">Delete @pending?.Title?</h2>
    </HeaderTemplate>
    <BodyTemplate>
        @if (pending is { } course)
        {
            <p class="mb-2">@DeleteConsequenceText(course)</p>
            <p class="small text-body-secondary mb-0">This can't be undone.</p>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => deleteModal.HideAsync()">Keep course</Button>
        <Button Color="ButtonColor.Danger" @onclick="ConfirmDeleteAsync">Delete course</Button>
    </FooterTemplate>
</Modal>
