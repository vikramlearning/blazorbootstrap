@inherits LayoutComponentBase

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" />
</HeadContent>

<div class="sc-site sc-marketing">
    <ShowcaseSiteBar Site="@site" />

    <Navbar Class="mk-header"
            Placement="NavbarPlacement.StickyTop"
            Container="NavbarContainer.ExtraLarge"
            AriaLabel="Lumora"
            TogglerAriaLabel="Menu">
        <Brand>
            <NavbarBrand Href="@Base" Class="mk-brand">
                <span class="mk-brand-mark" aria-hidden="true"><Icon Name="IconName.Lightning" /></span>
                <span>@MarketingSeedData.ProductName</span>
            </NavbarBrand>
        </Brand>
        <ChildContent>
            <NavbarNav Class="mx-lg-auto mb-3 mb-lg-0">
                @foreach (var link in links)
                {
                    <NavbarItem Href="@($"{Base}/{link.Path}")">@link.Text</NavbarItem>
                }
            </NavbarNav>
            <div class="mk-actions">
                <a class="btn btn-link mk-signin" href="@($"{Base}/signup")">Sign in</a>
                <a class="btn btn-primary mk-cta" href="@($"{Base}/signup")">Start free trial</a>
            </div>
        </ChildContent>
    </Navbar>

    <main class="sc-main" id="mk-main">
        @Body
    </main>

    <div class="container-xl">
        <CarbonAds Class="sc-ad" />
    </div>

    <footer class="mk-footer">
        <div class="container-xl">
            <div class="row g-4">
                <div class="col-lg-4">
                    <a class="mk-brand mb-3" href="@Base">
                        <span class="mk-brand-mark" aria-hidden="true"><Icon Name="IconName.Lightning" /></span>
                        <span>@MarketingSeedData.ProductName</span>
                    </a>
                    <p class="mk-footer-note">Product analytics that explains itself. A fictitious company created for the Blazor Bootstrap Showcase.</p>
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <h2 class="mk-footer-heading">Product</h2>
                    <ul class="list-unstyled">
                        <li><a href="@($"{Base}/features")">Features</a></li>
                        <li><a href="@($"{Base}/pricing")">Pricing</a></li>
                        <li><a href="@($"{Base}/customers")">Customers</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <h2 class="mk-footer-heading">Support</h2>
                    <ul class="list-unstyled">
                        <li><a href="@($"{Base}/faq")">FAQ</a></li>
                        <li><a href="@($"{Base}/signup")">Start a trial</a></li>
                    </ul>
                </div>
                <div class="col-md-6 col-lg-4">
                    <h2 class="mk-footer-heading">Built with</h2>
                    <p class="mk-footer-note mb-0">Card, Switch, Carousel, Accordion, Collapse, Callout, Badge, and form inputs from Blazor Bootstrap.</p>
                </div>
            </div>
            <p class="mk-footer-legal">© 2026 Lumora Analytics (fictitious). All data on this site is made up.</p>
        </div>
    </footer>
</div>
