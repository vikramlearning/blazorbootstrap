@page "/showcase/marketing/customers"
@layout MarketingLayout
@inject MarketingState State

<PageTitle>Customers · Lumora</PageTitle>

<section class="mk-page-hero">
    <div class="container-xl">
        <span class="sc-eyebrow">Customers</span>
        <h1 class="mk-section-title">Teams that stopped guessing</h1>
        <p>Product, operations, and growth teams use Lumora to find what changed and act on it the same day.</p>
    </div>
</section>

<section class="container-xl pb-5" aria-label="Customer quotes">
    <Card Class="mk-feature-card">
        <Carousel ShowIndicators="true" Autoplay="CarouselAutoPlay.None" Class="mk-carousel">
            @for (var index = 0; index < State.Testimonials.Count; index++)
            {
                var testimonial = State.Testimonials[index];
                <CarouselItem Active="index == 0" Label="@($"Quote from {testimonial.Person}")">
                    <figure class="mk-testimonial mb-0">
                        <div class="mk-stars mb-3" aria-label="@($"{testimonial.Rating} out of 5 stars")">
                            @for (var star = 1; star <= 5; star++)
                            {
                                <Icon Name="@(star <= testimonial.Rating ? IconName.StarFill : IconName.Star)" aria-hidden="true" />
                            }
                        </div>
                        <blockquote class="mk-big-quote">&ldquo;@testimonial.Quote&rdquo;</blockquote>
                        <figcaption class="mt-3">
                            <strong>@testimonial.Person</strong><br />
                            <span class="text-body-secondary">@testimonial.Role, @testimonial.Company</span>
                        </figcaption>
                    </figure>
                </CarouselItem>
            }
        </Carousel>
    </Card>
</section>

<section class="container-xl pb-5" aria-labelledby="mk-stories">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <h2 class="mk-section-title mb-0" id="mk-stories">Customer stories</h2>
        <div class="d-flex flex-wrap gap-2" role="group" aria-label="Filter stories by industry">
            @foreach (var industry in industries)
            {
                <button type="button"
                        class="btn btn-sm rounded-pill px-3 @(industry == selectedIndustry ? "btn-primary" : "btn-outline-secondary")"
                        aria-pressed="@(industry == selectedIndustry ? "true" : "false")"
                        @onclick="() => selectedIndustry = industry">
                    @industry
                </button>
            }
        </div>
    </div>
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var story in VisibleStories)
        {
            <div class="col" @key="story.Company">
                <Card Class="h-100 mk-feature-card sc-card-hover">
                    <CardBody Class="p-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <span class="mk-feature-icon" aria-hidden="true"><Icon Name="@story.IconName" /></span>
                            <div>
                                <h3 class="h5 fw-bold mb-0">@story.Company</h3>
                                <small class="text-body-secondary">@story.Industry</small>
                            </div>
                        </div>
                        <p class="mb-3">@story.Headline.</p>
                        <p class="mb-0"><Badge Color="BadgeColor.Success" Class="rounded-pill fs-6 fw-semibold px-3 py-2">@story.Result</Badge></p>
                    </CardBody>
                </Card>
            </div>
        }
    </div>
</section>

@code {
    private const string All = "All";

    private string selectedIndustry = All;

    private IReadOnlyList<string> industries => new[] { All }.Concat(State.CaseStudies.Select(s => s.Industry)).ToList();

    private IEnumerable<MarketingCaseStudy> VisibleStories => selectedIndustry == All
        ? State.CaseStudies
        : State.CaseStudies.Where(s => s.Industry == selectedIndustry);
}
