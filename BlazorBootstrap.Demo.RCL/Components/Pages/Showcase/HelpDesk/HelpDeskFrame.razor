<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500&display=swap" />
</HeadContent>

@* The frame both Beacon Desk layouts share: the help center (customers) and the agent desk. Its stylesheet styles the
   pages of both through ::deep. *@
<div class="sc-site sc-helpdesk">
    <ShowcaseSiteBar Site="@site" />

    @Header

    <div class="hd-shell">
        @if (Sidebar is not null)
        {
            @Sidebar
        }

        <div class="hd-shell-main">
            @* Pages show customers' names, emails, and messages as text, so the content is masked from session recording. *@
            <main class="sc-main hd-content" id="hd-main" data-clarity-mask="true">
                @ChildContent
            </main>

            <div class="container-fluid px-lg-4">
                <CarbonAds Class="sc-ad" />
            </div>

            <footer class="hd-footer">
                <div class="container-fluid px-lg-4 d-flex flex-wrap justify-content-between gap-2">
                    <span>© 2026 @HelpDeskSeedData.ProductName (fictitious). Customers, companies, and tickets are made up and stay in this browser tab; no email is sent.</span>
                    <span class="d-none d-lg-inline">Built with Grid, Sidebar, Charts, RichTextEditor, Modal, Tabs, Badge, Breadcrumb, and Toasts.</span>
                </div>
            </footer>
        </div>
    </div>

    @* Toasts can name customers, so they are masked from session recording like the page content. *@
    <div data-clarity-mask="true">
        <Toasts class="p-3" AutoHide="true" Delay="5000" Placement="ToastsPlacement.BottomRight" />
    </div>
</div>

@code {
    private readonly ShowcaseSite site = ShowcaseCatalog.Get("help-desk");

    /// <summary>Gets or sets the page content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Gets or sets the header above the page (the help center's Navbar, or the agent desk's top bar).</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    /// <summary>Gets or sets the sidebar beside the page (the agent desk), or <see langword="null" /> for none.</summary>
    [Parameter] public RenderFragment? Sidebar { get; set; }
}
