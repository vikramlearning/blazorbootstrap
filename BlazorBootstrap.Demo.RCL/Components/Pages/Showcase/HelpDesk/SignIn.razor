@page "/showcase/help-desk/sign-in"
@layout HelpDeskLayout

<PageTitle>Sign in · @HelpDeskSeedData.ProductName</PageTitle>

<div class="container-xl">
    <ShowcaseSignIn SiteBase="@HelpDeskLayout.Base" SiteName="@HelpDeskSeedData.ProductName" ReturnUrl="@ReturnUrl"
                    RegisterRoleId="@HelpDeskSeedData.CustomerRole" StartWithRegister="@(Mode == "register")" />
</div>

@code {
    /// <summary>Gets or sets <c>?mode=register</c>, which opens the register form.</summary>
    [SupplyParameterFromQuery(Name = "mode")] public string? Mode { get; set; }

    /// <summary>Gets or sets the page to return to after signing in; only a page inside the site is used.</summary>
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
}
