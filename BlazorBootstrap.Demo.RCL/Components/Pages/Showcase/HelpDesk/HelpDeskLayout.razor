@inherits LayoutComponentBase

@* The help center: public knowledge base, and requests for a signed-in customer. *@
<ShowcaseSessionHost State="State" SiteBase="@Base" SiteName="@HelpDeskSeedData.ProductName">
    <HelpDeskFrame>
        <Header>
            <Navbar Class="hd-header"
                    Placement="NavbarPlacement.StickyTop"
                    Container="NavbarContainer.Fluid"
                    AriaLabel="Beacon Desk help center"
                    TogglerAriaLabel="Menu">
                <Brand>
                    <NavbarBrand Href="@Base" Class="hd-brand">
                        <span class="hd-brand-mark" aria-hidden="true"><Icon Name="IconName.LifePreserver" /></span>
                        <span>@HelpDeskSeedData.ProductName <span class="hd-user-role">Help center</span></span>
                    </NavbarBrand>
                </Brand>
                <ChildContent>
                    <NavbarNav Class="me-auto ms-lg-4 mb-3 mb-lg-0">
                        <NavbarItem Href="@Base" Match="NavLinkMatch.All">Help center</NavbarItem>
                        <NavbarItem Href="@($"{Base}/kb")">Knowledge base</NavbarItem>
                        <NavbarItem Href="@($"{Base}/requests/new")">Submit a request</NavbarItem>
                        @if (State.IsCustomer)
                        {
                            <NavbarItem Href="@($"{Base}/requests")" Match="NavLinkMatch.All">My requests</NavbarItem>
                        }
                    </NavbarNav>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3 mb-lg-0">
                        @if (State.IsAgent)
                        {
                            <a class="btn btn-sm btn-outline-secondary" href="@HelpDeskAgentLayout.Base">Open agent desk</a>
                        }
                        @if (State.Identity.IsSignedIn)
                        {
                            <ShowcaseAccountMenu SiteBase="@Base" SignInPath="@SignInPath"
                                                 NoticeCount="@State.UnreadRequestCount" NoticesPath="@(State.IsCustomer ? $"{Base}/requests" : null)" />
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-secondary" href="@SignInPath">Sign in</a>
                        }
                    </div>
                </ChildContent>
            </Navbar>
        </Header>
        <ChildContent>
            @Body
        </ChildContent>
    </HelpDeskFrame>
</ShowcaseSessionHost>
