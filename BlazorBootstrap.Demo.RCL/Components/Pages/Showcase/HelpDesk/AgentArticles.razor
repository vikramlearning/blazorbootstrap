@page "/showcase/help-desk/agent/kb"
@layout HelpDeskAgentLayout

<PageTitle>Knowledge base articles · @HelpDeskSeedData.ProductName</PageTitle>

@{
    var all = State.AllArticles;
    var rows = Filtered(all);
}

<div class="container-fluid px-lg-4">
    <div class="hd-page-head">
        <div>
            <h1 class="hd-title">Knowledge base articles</h1>
            <p class="hd-lead">Write and update the help center's articles. Drafts stay here until you publish them.</p>
        </div>
        <Button Type="ButtonType.Link" To="@NewArticleUrl" Color="ButtonColor.Primary">
            <Icon Name="IconName.PlusCircle" class="me-2" aria-hidden="true" />New article
        </Button>
    </div>

    <p class="hd-kb-error" role="alert">@pageError</p>
    @* Always rendered and focusable, so a change is announced and focus has somewhere to go when its row is gone. *@
    <p class="hd-kb-status" role="status" tabindex="-1" @ref="statusRegion">@statusMessage</p>

    <Card Class="hd-card">
        <CardBody Class="p-3 p-lg-4">
            <div class="row g-2 align-items-end mb-3" role="search" aria-label="Filter articles">
                <div class="col-md-5">
                    <label class="form-label small fw-semibold" for="hd-kb-search">Search</label>
                    <InputGroup>
                        <InputGroupText><Icon Name="IconName.Search" aria-hidden="true" /></InputGroupText>
                        <input id="hd-kb-search" type="search" class="form-control" value="@search" @oninput="OnSearchInput"
                               placeholder="Title or summary" autocomplete="off" />
                    </InputGroup>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small fw-semibold" for="hd-kb-category">Category</label>
                    <select id="hd-kb-category" class="form-select" value="@categoryId" @onchange="OnCategoryChanged">
                        <option value="">Any</option>
                        @foreach (var category in State.Categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold" for="hd-kb-status-filter">Status</label>
                    <select id="hd-kb-status-filter" class="form-select" value="@statusFilter" @onchange="OnStatusFilterChanged">
                        <option value="@StatusAll">All</option>
                        <option value="@StatusPublished">Published</option>
                        <option value="@StatusDrafts">Drafts</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="ClearFiltersAsync" Disabled="!FiltersActive">Clear filters</Button>
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center column-gap-3 row-gap-1 mb-2">
                <p class="small text-body-secondary mb-0" aria-live="polite" tabindex="-1" @ref="countRegion">@CountText(rows.Count, all.Count)</p>
                @* Back to the saved view's defaults: most recently updated first, 10 a page, every column in its place. *@
                <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ResetViewAsync">Reset view</Button>
            </div>

            <ShowcaseDataState Status="@(viewLoaded ? ShowcaseDataStatus.Ready : ShowcaseDataStatus.Loading)"
                               IsEmpty="@(all.Count == 0)"
                               EmptyIcon="IconName.JournalText"
                               EmptyTitle="No articles yet"
                               EmptyText="Write the first one: it stays a draft until you publish it to the help center."
                               LoadingText="Loading articles…"
                               OnRetry="RefreshGridAsync">
                <EmptyActions>
                    <Button Type="ButtonType.Link" To="@NewArticleUrl" Color="ButtonColor.Primary" Size="ButtonSize.Small">New article</Button>
                </EmptyActions>
                <ChildContent>
                    <div class="hd-kb-grid">
                        <Grid @ref="grid"
                              @key="gridVersion"
                              TItem="HelpDeskArticle"
                              Class="table table-hover sc-grid-row-links"
                              GridContainerClass="hd-grid"
                              DataProvider="ProvideArticlesAsync"
                              SettingsProvider="view.GetSettingsAsync"
                              GridSettingsChanged="SaveSettingsAsync"
                              AllowPaging="true"
                              PageSize="@pageSize"
                              PageSizeSelectorVisible="true"
                              PageSizeSelectorItems="@(new[] { 10, 25, 50 })"
                              PaginationItemsTextFormat="{0}–{1} of {2} articles"
                              AllowSorting="true"
                              AllowColumnChooser="true"
                              AllowExport="true"
                              ExportFileName="help-desk-articles"
                              Responsive="true"
                              EmptyText="No articles match these filters."
                              aria-label="Knowledge base articles">
                            <GridColumns>
                                <GridColumn TItem="HelpDeskArticle" HeaderText="Title" PropertyName="Title" SortString="title" SortKeySelector="article => article.Title"
                                            IsDefaultSortColumn="@view.IsSortColumn("title")" SortDirection="@view.DirectionFor("title")" AlwaysVisible="true" Class="hd-kb-title-cell">
                                    @* The stretched link makes the whole row open the editor; the row's buttons stay above it. *@
                                    <a class="hd-ticket-link stretched-link" href="@HelpDeskDisplay.ArticleEditUrl(context.Id)">@context.Title</a>
                                    <span class="d-block small text-body-secondary hd-kb-summary">@context.Summary</span>
                                </GridColumn>
                                <GridColumn TItem="HelpDeskArticle" HeaderText="Category" PropertyName="CategoryId" SortString="category" SortKeySelector="article => State.FindCategory(article.CategoryId).Name"
                                            IsDefaultSortColumn="@view.IsSortColumn("category")" SortDirection="@view.DirectionFor("category")" TextNoWrap="true">
                                    @State.FindCategory(context.CategoryId).Name
                                </GridColumn>
                                <GridColumn TItem="HelpDeskArticle" HeaderText="Published" PropertyName="IsPublished" SortString="status" SortKeySelector="article => article.IsPublished"
                                            IsDefaultSortColumn="@view.IsSortColumn("status")" SortDirection="@view.DirectionFor("status")" TextNoWrap="true">
                                    <Badge Color="@(context.IsPublished ? BadgeColor.Success : BadgeColor.Secondary)">@(context.IsPublished ? "Published" : "Draft")</Badge>
                                </GridColumn>
                                <GridColumn TItem="HelpDeskArticle" HeaderText="Updated" PropertyName="UpdatedAt" SortString="updated" SortKeySelector="article => article.UpdatedAt"
                                            IsDefaultSortColumn="@view.IsSortColumn("updated")" SortDirection="@view.DirectionFor("updated")" TextNoWrap="true">
                                    <span class="small" title="@HelpDeskDisplay.Stamp(context.UpdatedAt)">@HelpDeskDisplay.Ago(context.UpdatedAt, State.Now)</span>
                                    <span class="d-block small text-body-secondary">by @context.UpdatedBy</span>
                                </GridColumn>
                                <GridColumn TItem="HelpDeskArticle" HeaderText="Views" PropertyName="Views" SortString="views" SortKeySelector="article => article.Views"
                                            IsDefaultSortColumn="@view.IsSortColumn("views")" SortDirection="@view.DirectionFor("views")" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End">
                                    @context.Views.ToString("#,0", CultureInfo.InvariantCulture)
                                </GridColumn>
                                @* Votes live in the state, not on the article, so CSV export leaves them out. *@
                                <GridColumn TItem="HelpDeskArticle" HeaderText="Helpful" SortString="helpful" SortKeySelector="article => State.Votes(article.Id).Helpful"
                                            IsDefaultSortColumn="@view.IsSortColumn("helpful")" SortDirection="@view.DirectionFor("helpful")" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End" TextNoWrap="true">
                                    @{
                                        var (helpful, notHelpful) = State.Votes(context.Id);
                                    }
                                    @helpful.ToString("#,0", CultureInfo.InvariantCulture)<span class="text-body-secondary small"> of @((helpful + notHelpful).ToString("#,0", CultureInfo.InvariantCulture))</span>
                                </GridColumn>
                                <GridColumn TItem="HelpDeskArticle" HeaderText="Actions" Sortable="false" Exportable="false">
                                    <div class="hd-kb-actions">
                                        <Button Type="ButtonType.Link" To="@HelpDeskDisplay.ArticleEditUrl(context.Id)" Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small">
                                            <Icon Name="IconName.PencilSquare" class="me-1" aria-hidden="true" />Edit<span class="visually-hidden">&#32;@context.Title</span>
                                        </Button>
                                        <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="() => TogglePublished(context)">
                                            <Icon Name="@(context.IsPublished ? IconName.EyeSlash : IconName.Globe)" class="me-1" aria-hidden="true" />@(context.IsPublished ? "Unpublish" : "Publish")<span class="visually-hidden">&#32;@context.Title</span>
                                        </Button>
                                        @if (context.IsPublished)
                                        {
                                            <a class="btn btn-sm btn-link px-1" href="@HelpDeskDisplay.ArticleUrl(context.Id)">
                                                View in help center<span class="visually-hidden">: @context.Title</span>
                                            </a>
                                        }
                                        <Button @ref="deleteButtons[context.Id]" Color="ButtonColor.Danger" Outline="true" Size="ButtonSize.Small" @onclick="() => AskDeleteAsync(context)">
                                            <Icon Name="IconName.Trash3" class="me-1" aria-hidden="true" />Delete<span class="visually-hidden">&#32;@context.Title</span>
                                        </Button>
                                    </div>
                                </GridColumn>
                            </GridColumns>
                        </Grid>
                    </div>
                </ChildContent>
            </ShowcaseDataState>
        </CardBody>
    </Card>
</div>

<Modal @ref="deleteModal" IsVerticallyCentered="true" ShowCloseButton="false" aria-labelledby="hd-kb-delete-title" OnHidden="OnDeleteHiddenAsync">
    <HeaderTemplate>
        <h2 class="modal-title h5" id="hd-kb-delete-title">Delete the article "@(deleting?.Title)"?</h2>
    </HeaderTemplate>
    <BodyTemplate>
        <p class="mb-0">@DeleteConsequence(deleting)</p>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => deleteModal.HideAsync()">Keep article</Button>
        <Button Color="ButtonColor.Danger" @onclick="ConfirmDeleteAsync">Delete article</Button>
    </FooterTemplate>
</Modal>
