@page "/showcase/help-desk/agent/admin/agents"
@layout HelpDeskAgentLayout

<PageTitle>Agents &amp; teams · @HelpDeskSeedData.ProductName</PageTitle>

<div class="container-fluid px-lg-4">
    <ShowcaseRoleGuard Roles="@HelpDeskSeedData.AdminRole" SignInPath="@HelpDeskLayout.SignInPath">
        @{
            var openCounts = OpenTicketCounts();
        }

        <div class="hd-page-head">
            <div>
                <h1 class="hd-title">Agents &amp; teams</h1>
                <p class="hd-lead">Who works the queue, which team each agent is on, and which categories each team handles.</p>
            </div>
        </div>

        <section class="mb-5" aria-labelledby="hd-agents-title">
            <div class="hd-admin-head">
                <h2 class="hd-section-title mb-0" id="hd-agents-title">Agents</h2>
                <Button @ref="addAgentButton" Color="ButtonColor.Primary" @onclick="AddAgentAsync">
                    <Icon Name="IconName.PersonPlus" class="me-1" aria-hidden="true" />Add agent
                </Button>
            </div>

            <p class="hd-admin-error" role="alert">@agentError.Text</p>
            @* Always rendered and focusable, so a change is announced and focus has somewhere to go. *@
            <p class="hd-admin-status" role="status" tabindex="-1" @ref="agentStatusRegion">@agentStatus.Text</p>

            <div class="d-flex justify-content-end mb-2">
                @* Back to the saved view's defaults: by name, 10 a page, every column in its place. *@
                <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ResetViewAsync">Reset view</Button>
            </div>
            <Card Class="hd-card">
                <CardBody Class="p-3 p-lg-4">
                    <ShowcaseDataState Status="@(viewLoaded ? ShowcaseDataStatus.Ready : ShowcaseDataStatus.Loading)"
                                       IsEmpty="@(State.Roster.Count == 0)"
                                       EmptyIcon="IconName.People"
                                       EmptyTitle="No agents yet"
                                       EmptyText="Add the first agent, so tickets can be assigned."
                                       LoadingText="Loading agents…"
                                       OnRetry="RefreshGridAsync">
                        <EmptyActions>
                            <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="AddAgentAsync">Add agent</Button>
                        </EmptyActions>
                        <ChildContent>
                            <Grid @ref="grid"
                                  @key="gridVersion"
                                  TItem="HelpDeskAgent"
                                  Class="table table-hover sc-grid-row-links"
                                  GridContainerClass="hd-grid"
                                  DataProvider="ProvideAgentsAsync"
                                  SettingsProvider="view.GetSettingsAsync"
                                  GridSettingsChanged="SaveSettingsAsync"
                                  AllowPaging="true"
                                  PageSize="@pageSize"
                                  PageSizeSelectorVisible="true"
                                  PageSizeSelectorItems="@(new[] { 10, 25, 50 })"
                                  PaginationItemsTextFormat="{0}–{1} of {2} agents"
                                  AllowSorting="true"
                                  AllowColumnChooser="true"
                                  AllowExport="true"
                                  ExportFileName="help-desk-agents"
                                  Responsive="true"
                                  EmptyText="No agents on the roster."
                                  aria-label="Agents">
                                <GridColumns>
                                    <GridColumn TItem="HelpDeskAgent" HeaderText="Name" PropertyName="Name" SortString="name" SortKeySelector="agent => agent.Name"
                                                IsDefaultSortColumn="@view.IsSortColumn("name")" SortDirection="@view.DirectionFor("name")" AlwaysVisible="true">
                                        @* The agent has no page of their own: the name opens the editor, and its stretched area makes the whole row do so. *@
                                        <button type="button" class="btn btn-link p-0 text-start hd-ticket-link stretched-link" @onclick="() => EditAgentAsync(context)">@context.Name</button>
                                        @if (context.Name == State.AgentName)
                                        {
                                            <span class="small text-body-secondary"> (you)</span>
                                        }
                                        @if (context.AccountId is not null)
                                        {
                                            <Badge Color="BadgeColor.Secondary" Class="ms-1">Demo sign-in</Badge>
                                        }
                                    </GridColumn>
                                    <GridColumn TItem="HelpDeskAgent" HeaderText="Email" PropertyName="Email" SortString="email" SortKeySelector="agent => agent.Email"
                                                IsDefaultSortColumn="@view.IsSortColumn("email")" SortDirection="@view.DirectionFor("email")">
                                        @context.Email
                                    </GridColumn>
                                    <GridColumn TItem="HelpDeskAgent" HeaderText="Team" PropertyName="TeamId" SortString="team" SortKeySelector="agent => TeamName(agent.TeamId)"
                                                IsDefaultSortColumn="@view.IsSortColumn("team")" SortDirection="@view.DirectionFor("team")" TextNoWrap="true">
                                        @TeamName(context.TeamId)
                                    </GridColumn>
                                    <GridColumn TItem="HelpDeskAgent" HeaderText="Admin" PropertyName="IsAdmin" SortString="role" SortKeySelector="agent => agent.IsAdmin"
                                                IsDefaultSortColumn="@view.IsSortColumn("role")" SortDirection="@view.DirectionFor("role")">
                                        @(context.IsAdmin ? "Admin" : "Agent")
                                    </GridColumn>
                                    <GridColumn TItem="HelpDeskAgent" HeaderText="Active" PropertyName="IsActive" SortString="status" SortKeySelector="agent => agent.IsActive"
                                                IsDefaultSortColumn="@view.IsSortColumn("status")" SortDirection="@view.DirectionFor("status")">
                                        <Badge Color="@(context.IsActive ? BadgeColor.Success : BadgeColor.Secondary)">@(context.IsActive ? "Active" : "Inactive")</Badge>
                                    </GridColumn>
                                    @* Counted from the tickets, not stored on the agent, so CSV export leaves it out. *@
                                    <GridColumn TItem="HelpDeskAgent" HeaderText="Open tickets" SortString="open" SortKeySelector="agent => openCounts.GetValueOrDefault(agent.Name)"
                                                IsDefaultSortColumn="@view.IsSortColumn("open")" SortDirection="@view.DirectionFor("open")" TextAlignment="Alignment.End" HeaderTextAlignment="Alignment.End">
                                        @openCounts.GetValueOrDefault(context.Name)
                                    </GridColumn>
                                    <GridColumn TItem="HelpDeskAgent" HeaderText="Actions" Sortable="false" Exportable="false">
                                        <div class="hd-admin-actions">
                                            <Button @ref="agentEditButtons[context.Id]" Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="() => EditAgentAsync(context)">
                                                <Icon Name="IconName.PencilSquare" class="me-1" aria-hidden="true" />Edit<span class="visually-hidden">&#32;@context.Name</span>
                                            </Button>
                                            @if (context.AccountId is null)
                                            {
                                                <Button @ref="agentActiveButtons[context.Id]" Color="@(context.IsActive ? ButtonColor.Danger : ButtonColor.Success)" Outline="true" Size="ButtonSize.Small"
                                                        @onclick="() => ToggleActiveAsync(context)">
                                                    @(context.IsActive ? "Deactivate" : "Reactivate")<span class="visually-hidden">&#32;@context.Name</span>
                                                </Button>
                                            }
                                            else
                                            {
                                                <span class="hd-admin-note">Always active: signs in to the demo</span>
                                            }
                                        </div>
                                    </GridColumn>
                                </GridColumns>
                            </Grid>
                        </ChildContent>
                    </ShowcaseDataState>
                </CardBody>
            </Card>
            <p class="small text-body-secondary mt-2 mb-0">
                Open tickets are the agent's assigned tickets that aren't resolved. Deactivating an agent sends them back to the queue, unassigned.
                Agents with a demo sign-in (@string.Join(" and ", State.Roster.Where(agent => agent.AccountId is not null).Select(agent => agent.Name))) always stay active.
            </p>
        </section>

        <section aria-labelledby="hd-teams-title">
            <div class="hd-admin-head">
                <h2 class="hd-section-title mb-0" id="hd-teams-title">Teams</h2>
                <Button @ref="addTeamButton" Color="ButtonColor.Primary" @onclick="AddTeamAsync">
                    <Icon Name="IconName.Plus" class="me-1" aria-hidden="true" />Add team
                </Button>
            </div>

            <p class="hd-admin-error" role="alert">@teamError.Text</p>
            <p class="hd-admin-status" role="status" tabindex="-1" @ref="teamStatusRegion">@teamStatus.Text</p>

            <ul class="list-unstyled row row-cols-1 row-cols-md-2 row-cols-xxl-3 g-3 mb-0" aria-label="Teams">
                @foreach (var team in State.Teams)
                {
                    var titleId = $"hd-team-{team.Id}-title";
                    var routed = CategoriesOf(team.Id);

                    <li class="col" @key="team.Id">
                        <article class="hd-panel h-100 d-flex flex-column" aria-labelledby="@titleId">
                            <h3 class="hd-section-title mb-1 text-break" id="@titleId">@team.Name</h3>
                            <p class="small text-body-secondary text-break">@(string.IsNullOrWhiteSpace(team.Description) ? "No description." : team.Description)</p>
                            <dl class="hd-summary hd-team-facts">
                                <dt>Agents</dt>
                                <dd>@MemberText(team.Id)</dd>
                                <dt>Lead</dt>
                                <dd>@LeadText(team)</dd>
                                <dt>Categories routed here</dt>
                                <dd>@(routed.Count == 0 ? "None" : string.Join(", ", routed.Select(category => category.Name)))</dd>
                            </dl>
                            <div class="hd-admin-actions mt-auto">
                                <Button @ref="teamEditButtons[team.Id]" Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="() => EditTeamAsync(team)">
                                    <Icon Name="IconName.PencilSquare" class="me-1" aria-hidden="true" />Edit<span class="visually-hidden">&#32;@team.Name</span>
                                </Button>
                                <Button @ref="teamDeleteButtons[team.Id]" Color="ButtonColor.Danger" Outline="true" Size="ButtonSize.Small" @onclick="() => AskDeleteTeamAsync(team)">
                                    <Icon Name="IconName.Trash3" class="me-1" aria-hidden="true" />Delete<span class="visually-hidden">&#32;@team.Name</span>
                                </Button>
                            </div>
                        </article>
                    </li>
                }
            </ul>
        </section>

        <Modal @ref="agentModal"
               IsVerticallyCentered="true"
               IsScrollable="true"
               ShowCloseButton="false"
               aria-labelledby="hd-agent-editor-title"
               OnShown="OnAgentShownAsync"
               OnHidden="OnAgentHiddenAsync">
            <HeaderTemplate>
                <h2 class="modal-title h5 text-break" id="hd-agent-editor-title">@(editingAgent is null ? "Add an agent" : $"Edit {editingAgent.Name}")</h2>
            </HeaderTemplate>
            <BodyTemplate>
                <div data-clarity-mask="true">
                    <ShowcaseDemoNotice Class="mb-3" Text="Demo only: the roster stays in this browser tab. Nothing is sent." />
                    <EditForm id="hd-agent-form" EditContext="agentContext" OnSubmit="SaveAgentAsync" FormName="hd-agent" novalidate>
                        <DataAnnotationsValidator />
                        <ShowcaseFormErrors ShowSummary="true" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="hd-agent-name">Name</label>
                            <InputText @ref="agentNameInput" id="hd-agent-name" class="form-control" @bind-Value="agentForm.Name"
                                       maxlength="@ShowcaseIdentity.MaxNameLength" autocomplete="off" aria-describedby="hd-agent-name-help" />
                            <ShowcaseUniqueCheck @ref="agentNameCheck" For="() => agentForm.Name" IsTakenAsync="IsAgentNameTakenAsync"
                                                 TakenMessage="@(value => $"Another agent is already called {value}. Names must be unique, because tickets are assigned by name.")" />
                            <div class="form-text mt-0" id="hd-agent-name-help">
                                Tickets are assigned by name, so each agent's name is unique.
                                @if (editingAgent is not null)
                                {
                                    @($" Tickets assigned to {editingAgent.Name} follow a rename.")
                                }
                            </div>
                            <ValidationMessage For="() => agentForm.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="hd-agent-email">Email</label>
                            <InputText id="hd-agent-email" type="email" inputmode="email" autocapitalize="none" class="form-control" @bind-Value="agentForm.Email"
                                       maxlength="@ShowcaseIdentity.MaxEmailLength" autocomplete="off" spellcheck="false" />
                            <ShowcaseUniqueCheck @ref="agentEmailCheck" For="() => agentForm.Email" IsTakenAsync="IsAgentEmailTakenAsync"
                                                 TakenMessage="@(value => $"Another agent already has the email address {value}.")" />
                            <ValidationMessage For="() => agentForm.Email" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="hd-agent-team">Team</label>
                            <InputSelect id="hd-agent-team" class="form-select" @bind-Value="agentForm.TeamId">
                                @if (State.FindTeam(agentForm.TeamId) is null)
                                {
                                    <option value="">Choose a team</option>
                                }
                                @foreach (var team in State.Teams)
                                {
                                    <option value="@team.Id">@team.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => agentForm.TeamId" />
                        </div>
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" id="hd-agent-admin" @bind-Value="agentForm.IsAdmin" disabled="@IsLinked"
                                           aria-describedby="hd-agent-admin-help" />
                            <label class="form-check-label fw-semibold" for="hd-agent-admin">Admin</label>
                            <div class="form-text mt-0" id="hd-agent-admin-help">
                                @if (IsLinked)
                                {
                                    @($"{editingAgent!.Name}'s role comes from their demo account, so it can't change here.")
                                }
                                else
                                {
                                    @("Admins also manage agents and teams, SLA policies, and categories.")
                                }
                            </div>
                        </div>
                        @if (editingAgent is null)
                        {
                            <p class="small text-body-secondary mt-3 mb-0">
                                New agents appear on the roster and can be assigned tickets, but they can't sign in to the demo.
                            </p>
                        }
                    </EditForm>
                    <p class="hd-field-error mt-3 mb-0" role="alert">@agentFormError.Text</p>
                </div>
            </BodyTemplate>
            <FooterTemplate>
                <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => agentModal.HideAsync()">Cancel</Button>
                <Button Type="ButtonType.Submit" Color="ButtonColor.Primary" form="hd-agent-form">@(editingAgent is null ? "Add agent" : "Save changes")</Button>
            </FooterTemplate>
        </Modal>

        <Modal @ref="deactivateModal" IsVerticallyCentered="true" ShowCloseButton="false" aria-labelledby="hd-deactivate-title" OnHidden="OnDeactivateHiddenAsync">
            <HeaderTemplate>
                <h2 class="modal-title h5 text-break" id="hd-deactivate-title">Deactivate @(deactivating?.Name)?</h2>
            </HeaderTemplate>
            <BodyTemplate>
                @if (deactivating is { } agent)
                {
                    var open = OpenTicketCounts().GetValueOrDefault(agent.Name);

                    <p>@agent.Name stays on the roster, but can no longer be assigned tickets. You can reactivate them later.</p>
                    <p class="mb-0 fw-semibold">
                        @(open switch
                        {
                            0 => "They have no open tickets, so nothing is unassigned.",
                            1 => "Their 1 open ticket becomes unassigned and goes back to the queue of its category's team.",
                            _ => $"Their {open} open tickets become unassigned and go back to the queue, each to its category's team.",
                        })
                    </p>
                }
            </BodyTemplate>
            <FooterTemplate>
                <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => deactivateModal.HideAsync()">Keep active</Button>
                <Button Color="ButtonColor.Danger" @onclick="ConfirmDeactivateAsync">Deactivate<span class="visually-hidden">&#32;@(deactivating?.Name)</span></Button>
            </FooterTemplate>
        </Modal>

        <Modal @ref="teamModal"
               IsVerticallyCentered="true"
               IsScrollable="true"
               ShowCloseButton="false"
               aria-labelledby="hd-team-editor-title"
               OnShown="OnTeamShownAsync"
               OnHidden="OnTeamHiddenAsync">
            <HeaderTemplate>
                <h2 class="modal-title h5 text-break" id="hd-team-editor-title">@(editingTeam is null ? "Add a team" : $"Edit {editingTeam.Name}")</h2>
            </HeaderTemplate>
            <BodyTemplate>
                <div data-clarity-mask="true">
                    <EditForm id="hd-team-form" EditContext="teamContext" OnSubmit="SaveTeamAsync" FormName="hd-team" novalidate>
                        <DataAnnotationsValidator />
                        <ShowcaseFormErrors ShowSummary="true" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="hd-team-name">Name</label>
                            <InputText @ref="teamNameInput" id="hd-team-name" class="form-control" @bind-Value="teamForm.Name"
                                       maxlength="@HelpDeskState.MaxGroupNameLength" autocomplete="off" aria-describedby="hd-team-name-help" />
                            <ShowcaseUniqueCheck @ref="teamNameCheck" For="() => teamForm.Name" IsTakenAsync="IsTeamNameTakenAsync"
                                                 TakenMessage="@(value => $"Another team is already called {value}.")" />
                            <div class="form-text mt-0" id="hd-team-name-help">Up to @HelpDeskState.MaxGroupNameLength characters.</div>
                            <ValidationMessage For="() => teamForm.Name" />
                        </div>
                        <div>
                            <label class="form-label fw-semibold" for="hd-team-description">Description <span class="fw-normal text-body-secondary">(optional)</span></label>
                            <InputTextArea id="hd-team-description" class="form-control" rows="3" @bind-Value="teamForm.Description"
                                           maxlength="@HelpDeskState.MaxTeamDescriptionLength" aria-describedby="hd-team-description-help" />
                            <div class="form-text" id="hd-team-description-help">What the team handles, in up to @HelpDeskState.MaxTeamDescriptionLength characters.</div>
                            <ValidationMessage For="() => teamForm.Description" />
                        </div>
                        @{
                            var leadChoices = LeadChoices(editingTeam?.Id);
                        }
                        <div class="mt-3">
                            <label class="form-label fw-semibold" for="hd-team-lead">Team lead <span class="fw-normal text-body-secondary">(optional)</span></label>
                            <InputSelect id="hd-team-lead" class="form-select" @bind-Value="teamForm.LeadAgentId" aria-describedby="hd-team-lead-help" disabled="@(leadChoices.Count == 0)">
                                <option value="">No lead</option>
                                @foreach (var agent in leadChoices)
                                {
                                    <option value="@agent.Id">@agent.Name</option>
                                }
                            </InputSelect>
                            <div class="form-text" id="hd-team-lead-help">
                                @(leadChoices.Count == 0
                                    ? "Add active agents to the team first; then one of them can lead it."
                                    : "An active agent on the team. The lead is notified when one of the team's tickets is escalated.")
                            </div>
                        </div>
                    </EditForm>
                    <p class="hd-field-error mt-3 mb-0" role="alert">@teamFormError.Text</p>
                </div>
            </BodyTemplate>
            <FooterTemplate>
                <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => teamModal.HideAsync()">Cancel</Button>
                <Button Type="ButtonType.Submit" Color="ButtonColor.Primary" form="hd-team-form">@(editingTeam is null ? "Add team" : "Save changes")</Button>
            </FooterTemplate>
        </Modal>

        <Modal @ref="deleteTeamModal" IsVerticallyCentered="true" ShowCloseButton="false" aria-labelledby="hd-team-delete-title" OnHidden="OnDeleteTeamHiddenAsync">
            <HeaderTemplate>
                <h2 class="modal-title h5 text-break" id="hd-team-delete-title">
                    @if (deletingTeam is { } team)
                    {
                        @(TeamBlocker(team) is null ? $"Delete the team \"{team.Name}\"?" : $"{team.Name} can't be deleted yet")
                    }
                </h2>
            </HeaderTemplate>
            <BodyTemplate>
                @if (deletingTeam is { } team)
                {
                    if (TeamBlocker(team) is { } blocker)
                    {
                        <p class="mb-0">@blocker</p>
                    }
                    else
                    {
                        <p class="mb-0">It has no agents and no categories routed to it. It's removed from the team lists and from the queue's Team filter.</p>
                    }
                }
            </BodyTemplate>
            <FooterTemplate>
                @if (deletingTeam is { } team && TeamBlocker(team) is null)
                {
                    <Button Color="ButtonColor.Secondary" Outline="true" @onclick="() => deleteTeamModal.HideAsync()">Keep team</Button>
                    <Button Color="ButtonColor.Danger" @onclick="ConfirmDeleteTeamAsync">Delete team</Button>
                }
                else
                {
                    <Button Color="ButtonColor.Primary" @onclick="() => deleteTeamModal.HideAsync()">Close</Button>
                }
            </FooterTemplate>
        </Modal>
    </ShowcaseRoleGuard>
</div>
