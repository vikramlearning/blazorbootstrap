@inherits LayoutComponentBase

@* The agent desk (D-031): its own sidebar with the agent's modules, separate from the help center. *@
<ShowcaseSessionHost State="State" SiteBase="@HelpDeskLayout.Base" SiteName="@HelpDeskSeedData.ProductName">
    <HelpDeskFrame>
        <Header>
            <div class="hd-agent-bar">
                <span class="hd-agent-bar-title">@(State.IsAdmin ? "Agent desk · Admin" : "Agent desk")</span>
                <div class="hd-agent-bar-actions">
                    <ShowcaseGlobalSearch Class="hd-global-search" Placeholder="Search tickets, articles, agents" />
                    <a class="btn btn-sm btn-outline-secondary" href="@HelpDeskLayout.Base">
                        <Icon Name="IconName.BoxArrowUpRight" class="me-1" aria-hidden="true" />View help center
                    </a>
                    <ShowcaseNotificationsMenu />
                    <ShowcaseAccountMenu SiteBase="@HelpDeskLayout.Base" SignInPath="@HelpDeskLayout.SignInPath" />
                </div>
            </div>
        </Header>
        <Sidebar>
            @if (State.IsAgent)
            {
                <Sidebar @key="State.Identity.Current?.Id"
                         Class="hd-sidebar"
                         Href="@Base"
                         IconName="IconName.LifePreserver"
                         Title="@HelpDeskSeedData.ProductName"
                         BadgeText="@(State.IsAdmin ? "Admin" : "Agent")"
                         DataProvider="SidebarDataProvider" />
            }
        </Sidebar>
        <ChildContent>
            <ShowcaseRoleGuard Roles="@StaffRoles" SignInPath="@HelpDeskLayout.SignInPath">
                @Body
            </ShowcaseRoleGuard>
        </ChildContent>
    </HelpDeskFrame>
</ShowcaseSessionHost>
