@page "/showcase/help-desk/agent"
@layout HelpDeskAgentLayout

<PageTitle>Ticket queue · @HelpDeskSeedData.ProductName</PageTitle>

@{
    var queueCount = State.Queue().Count;
}

<div class="container-fluid px-lg-4">
    <div class="hd-page-head">
        <div>
            <h1 class="hd-title">Ticket queue</h1>
            <p class="hd-lead">Most urgent first: overdue, then at risk, then by due time.</p>
        </div>
        <Button Type="ButtonType.Link" To="@($"{HelpDeskAgentLayout.Base}/tickets/new")" Color="ButtonColor.Primary">
            <Icon Name="IconName.PlusCircle" class="me-2" aria-hidden="true" />New ticket
        </Button>
    </div>

    <section aria-label="Queue summary" class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3 mb-4">
        @foreach (var (label, value, icon) in Summary)
        {
            <div class="col">
                <Card Class="hd-card h-100">
                    <CardBody Class="d-flex align-items-center gap-3 p-3">
                        <span class="hd-icon" aria-hidden="true"><Icon Name="icon" /></span>
                        <span>
                            <span class="hd-kpi-label">@label</span>
                            <span class="hd-kpi-value">@value</span>
                        </span>
                    </CardBody>
                </Card>
            </div>
        }
    </section>

    <Card Class="hd-card">
        <CardBody Class="p-3 p-lg-4">
            <div class="row g-2 align-items-end mb-3" role="search" aria-label="Filter tickets">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold" for="hd-search">Search</label>
                    <InputGroup>
                        <InputGroupText><Icon Name="IconName.Search" aria-hidden="true" /></InputGroupText>
                        @* The bound value changes only on change; @oninput filters live, and the box keeps its own value so no keystroke is lost. *@
                        <TextInput Id="hd-search" Value="@searchBoxValue" ValueExpression="() => searchBoxValue" ValueChanged="OnSearchChanged"
                                   @oninput="OnSearchInput" Placeholder="Number, subject, or customer" />
                    </InputGroup>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold" for="hd-status">Status</label>
                    <select id="hd-status" class="form-select" value="@State.Filter.Status" @onchange="OnStatusChanged">
                        <option value="@HelpDeskFilter.StatusAllOpen">All unresolved</option>
                        @foreach (var status in Enum.GetValues<HelpDeskStatus>())
                        {
                            <option value="@status">@status</option>
                        }
                        <option value="@HelpDeskFilter.StatusAll">All tickets</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold" for="hd-priority">Priority</label>
                    <select id="hd-priority" class="form-select" value="@State.Filter.Priority" @onchange="OnPriorityChanged">
                        <option value="">Any</option>
                        @foreach (var priority in Enum.GetValues<HelpDeskPriority>().Reverse())
                        {
                            <option value="@priority">@priority</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    @* A ticket's team is its assignee's, or its category's while unassigned. *@
                    <label class="form-label small fw-semibold" for="hd-team">Team</label>
                    <select id="hd-team" class="form-select" value="@State.Filter.TeamId" @onchange="OnTeamChanged">
                        <option value="">Any</option>
                        @foreach (var team in State.Teams)
                        {
                            <option value="@team.Id">@team.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex flex-wrap align-items-center gap-3">
                    @* "Me" is the signed-in agent (State.AgentName). *@
                    <Switch Value="State.Filter.AssignedToMe" ValueExpression="() => State.Filter.AssignedToMe" ValueChanged="OnAssignedToMeChanged" Label="Assigned to me" />
                    <Switch Value="State.Filter.EscalatedOnly" ValueExpression="() => State.Filter.EscalatedOnly" ValueChanged="OnEscalatedOnlyChanged" Label="Escalated" />
                    <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="ClearFiltersAsync" Disabled="!State.Filter.IsActive">Clear filters</Button>
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center column-gap-3 row-gap-1 mb-2">
                <p class="small text-body-secondary mb-0" id="hd-count" aria-live="polite" tabindex="-1" @ref="countRegion">@CountText(queueCount)</p>
                @* Back to the saved view's defaults: urgency order, first page, 10 per page, every column in its place. *@
                <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="ResetViewAsync">Reset view</Button>
            </div>

            @* Always rendered, so a bulk change or a cleared selection is announced, and focus has somewhere to go when the bar closes. *@
            <p class="hd-queue-status" role="status" tabindex="-1" @ref="statusRegion">@statusMessage</p>
            <p class="hd-queue-error" role="alert">@bulkError</p>

            @if (selected.Count > 0)
            {
                <section class="hd-bulk" aria-labelledby="hd-bulk-count">
                    <h2 class="hd-bulk-count" id="hd-bulk-count">@(selected.Count == 1 ? "1 ticket selected" : $"{selected.Count} tickets selected")</h2>
                    <div class="hd-bulk-field">
                        <label class="form-label small fw-semibold" for="hd-bulk-assignee">Assign to</label>
                        <select id="hd-bulk-assignee" class="form-select form-select-sm" value="@bulkAssignee" @onchange="OnBulkAssigneeChanged">
                            <option value="">No change</option>
                            @foreach (var agent in State.Agents)
                            {
                                <option value="@agent">@agent</option>
                            }
                            <option value="@UnassignValue">Unassign</option>
                        </select>
                    </div>
                    <div class="hd-bulk-field">
                        <label class="form-label small fw-semibold" for="hd-bulk-status">Set status</label>
                        <select id="hd-bulk-status" class="form-select form-select-sm" value="@bulkStatus" @onchange="OnBulkStatusChanged">
                            <option value="">No change</option>
                            @foreach (var status in Enum.GetValues<HelpDeskStatus>())
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                    <div class="hd-bulk-field">
                        <label class="form-label small fw-semibold" for="hd-bulk-priority">Set priority</label>
                        <select id="hd-bulk-priority" class="form-select form-select-sm" value="@bulkPriority" @onchange="OnBulkPriorityChanged">
                            <option value="">No change</option>
                            @foreach (var priority in Enum.GetValues<HelpDeskPriority>().Reverse())
                            {
                                <option value="@priority">@priority</option>
                            }
                        </select>
                    </div>
                    <div class="hd-bulk-actions">
                        <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="ApplyBulkAsync">Apply<span class="visually-hidden"> to the selected tickets</span></Button>
                        <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="ClearSelectionAsync">Clear selection</Button>
                    </div>
                </section>
            }

            <ShowcaseDataState Status="@(viewLoaded ? ShowcaseDataStatus.Ready : ShowcaseDataStatus.Loading)"
                               IsEmpty="@(State.Tickets.Count == 0)"
                               EmptyTitle="No tickets yet"
                               EmptyText="New requests from the help center and tickets you open for customers show here."
                               LoadingText="Loading tickets…"
                               OnRetry="RefreshGridAsync">
                <EmptyActions>
                    <Button Type="ButtonType.Link" To="@($"{HelpDeskAgentLayout.Base}/tickets/new")" Color="ButtonColor.Primary" Size="ButtonSize.Small">New ticket</Button>
                </EmptyActions>
                <ChildContent>
                    @* With no column sorted, the rows keep the queue's urgency order. *@
                    <div class="hd-queue-grid">
                        <Grid @ref="grid"
                              @key="gridVersion"
                              TItem="HelpDeskTicket"
                              Class="table table-hover sc-grid-row-links"
                              GridContainerClass="hd-grid"
                              DataProvider="ProvideTicketsAsync"
                              SettingsProvider="view.GetSettingsAsync"
                              GridSettingsChanged="SaveSettingsAsync"
                              AllowPaging="true"
                              PageSize="@pageSize"
                              PageSizeSelectorVisible="true"
                              PageSizeSelectorItems="@(new[] { 10, 25, 50 })"
                              PaginationItemsTextFormat="{0}–{1} of {2} tickets"
                              AllowSorting="true"
                              AllowSelection="true"
                              SelectionMode="GridSelectionMode.Multiple"
                              RowSelectionLabel="@(ticket => FormattableString.Invariant($"Select ticket #{ticket.Id}, {ticket.Subject}"))"
                              SelectAllRowsText="Select all shown tickets"
                              SelectedItemsChanged="OnSelectionChanged"
                              RowClass="RowClass"
                              AllowColumnChooser="true"
                              AllowExport="true"
                              ExportFileName="help-desk-tickets"
                              Responsive="true"
                              EmptyText="No tickets match these filters."
                              aria-label="Tickets">
                            <GridColumns>
                                <GridColumn TItem="HelpDeskTicket" HeaderText="Ticket" PropertyName="Id" SortString="ticket" SortKeySelector="ticket => ticket.Id"
                                            IsDefaultSortColumn="@view.IsSortColumn("ticket")" SortDirection="@view.DirectionFor("ticket")" TextNoWrap="true">
                                    <span class="hd-mono small">#@context.Id</span>
                                </GridColumn>
                                <GridColumn TItem="HelpDeskTicket" HeaderText="Subject" PropertyName="Subject" SortString="subject" SortKeySelector="ticket => ticket.Subject"
                                            IsDefaultSortColumn="@view.IsSortColumn("subject")" SortDirection="@view.DirectionFor("subject")" AlwaysVisible="true">
                                    @* The stretched link makes the whole row open the ticket; the row's checkbox stays above it. *@
                                    <a class="hd-ticket-link stretched-link" href="@HelpDeskDisplay.TicketUrl(context.Id)">@context.Subject</a>
                                    @if (CustomerReplied(context))
                                    {
                                        <Badge Color="BadgeColor.Primary" Class="ms-1"><Icon Name="IconName.Reply" class="me-1" aria-hidden="true" />Customer replied</Badge>
                                    }
                                    <span class="d-block small text-body-secondary">@context.CustomerName@(context.Company is null ? null : $" · {context.Company}")</span>
                                </GridColumn>
                                <GridColumn TItem="HelpDeskTicket" HeaderText="Priority" PropertyName="Priority" SortString="priority" SortKeySelector="ticket => ticket.Priority"
                                            IsDefaultSortColumn="@view.IsSortColumn("priority")" SortDirection="@view.DirectionFor("priority")" TextNoWrap="true">
                                    <Badge Color="@HelpDeskDisplay.PriorityColor(context.Priority)">@context.Priority</Badge>
                                </GridColumn>
                                <GridColumn TItem="HelpDeskTicket" HeaderText="Status" PropertyName="Status" SortString="status" SortKeySelector="ticket => ticket.Status"
                                            IsDefaultSortColumn="@view.IsSortColumn("status")" SortDirection="@view.DirectionFor("status")" TextNoWrap="true">
                                    <Badge Color="@HelpDeskDisplay.StatusColor(context.Status)">@context.Status</Badge>
                                </GridColumn>
                                @* The SLA moves with the site's clock, so it is worked out on every render. It has no property, so CSV export leaves it out. *@
                                @* Escalation rules move a ticket up a tier; an escalated ticket is flagged here (AC-7a). *@
                                <GridColumn TItem="HelpDeskTicket" HeaderText="Tier" PropertyName="Tier" SortString="tier" SortKeySelector="ticket => ticket.Tier"
                                            IsDefaultSortColumn="@view.IsSortColumn("tier")" SortDirection="@view.DirectionFor("tier")" TextNoWrap="true">
                                    @if (context.IsEscalated)
                                    {
                                        <Badge Color="BadgeColor.Danger"><Icon Name="IconName.ArrowUpCircleFill" class="me-1" aria-hidden="true" />Tier @context.Tier<span class="visually-hidden">, escalated</span></Badge>
                                    }
                                    else
                                    {
                                        <span class="small text-body-secondary">Tier 1</span>
                                    }
                                </GridColumn>
                                <GridColumn TItem="HelpDeskTicket" HeaderText="SLA" SortString="sla" SortKeySelector="ticket => State.DueAt(ticket)"
                                            IsDefaultSortColumn="@view.IsSortColumn("sla")" SortDirection="@view.DirectionFor("sla")" TextNoWrap="true">
                                    <Badge Color="@HelpDeskDisplay.SlaColor(State.Sla(context))">@HelpDeskDisplay.SlaText(State, context)</Badge>
                                </GridColumn>
                                <GridColumn TItem="HelpDeskTicket" HeaderText="Assignee" PropertyName="Assignee" SortString="assignee" SortKeySelector="ticket => ticket.Assignee ?? string.Empty"
                                            IsDefaultSortColumn="@view.IsSortColumn("assignee")" SortDirection="@view.DirectionFor("assignee")" TextNoWrap="true">
                                    @(context.Assignee ?? "Unassigned")
                                </GridColumn>
                                <GridColumn TItem="HelpDeskTicket" HeaderText="Category" PropertyName="CategoryId" SortString="category" SortKeySelector="ticket => State.FindCategory(ticket.CategoryId).Name"
                                            IsDefaultSortColumn="@view.IsSortColumn("category")" SortDirection="@view.DirectionFor("category")" TextNoWrap="true">
                                    @State.FindCategory(context.CategoryId).Name
                                </GridColumn>
                                <GridColumn TItem="HelpDeskTicket" HeaderText="Updated" PropertyName="UpdatedAt" SortString="updated" SortKeySelector="ticket => ticket.UpdatedAt"
                                            IsDefaultSortColumn="@view.IsSortColumn("updated")" SortDirection="@view.DirectionFor("updated")" TextNoWrap="true">
                                    <span class="small" title="@HelpDeskDisplay.Stamp(context.UpdatedAt)">@HelpDeskDisplay.Ago(context.UpdatedAt, State.Now)</span>
                                </GridColumn>
                            </GridColumns>
                        </Grid>
                    </div>
                </ChildContent>
            </ShowcaseDataState>
        </CardBody>
    </Card>
</div>
