@page "/showcase/help-desk/agent"
@layout HelpDeskAgentLayout

<PageTitle>Ticket queue · @HelpDeskSeedData.ProductName</PageTitle>

@{
    var rows = SortedTickets();
    var totalPages = TotalPages(rows.Count);
    var page = Math.Clamp(pageNumber, 1, totalPages);
    var pageRows = rows.Skip((page - 1) * PageSize).Take(PageSize).ToList();
    var selected = pageRows.Where(ticket => selectedIds.Contains(ticket.Id)).ToList();
    var selectAllState = selected.Count == 0 ? "false" : selected.Count == pageRows.Count ? "true" : "mixed";
}

<div class="container-fluid px-lg-4">
    <div class="hd-page-head">
        <div>
            <h1 class="hd-title">Ticket queue</h1>
            <p class="hd-lead">Most urgent first: overdue, then at risk, then by due time.</p>
        </div>
        <Button Type="ButtonType.Link" To="@($"{HelpDeskAgentLayout.Base}/tickets/new")" Color="ButtonColor.Primary">
            <Icon Name="IconName.PlusCircle" class="me-2" aria-hidden="true" />New ticket
        </Button>
    </div>

    <section aria-label="Queue summary" class="row row-cols-2 row-cols-lg-4 g-3 mb-4">
        @foreach (var (label, value, icon) in Summary)
        {
            <div class="col">
                <Card Class="hd-card h-100">
                    <CardBody Class="d-flex align-items-center gap-3 p-3">
                        <span class="hd-icon" aria-hidden="true"><Icon Name="icon" /></span>
                        <span>
                            <span class="hd-kpi-label">@label</span>
                            <span class="hd-kpi-value">@value</span>
                        </span>
                    </CardBody>
                </Card>
            </div>
        }
    </section>

    <Card Class="hd-card">
        <CardBody Class="p-3 p-lg-4">
            <div class="row g-2 align-items-end mb-3" role="search" aria-label="Filter tickets">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold" for="hd-search">Search</label>
                    <InputGroup>
                        <InputGroupText><Icon Name="IconName.Search" aria-hidden="true" /></InputGroupText>
                        @* The bound value changes only on change; @oninput filters live, and the box keeps its own value so no keystroke is lost. *@
                        <TextInput Id="hd-search" Value="@searchBoxValue" ValueExpression="() => searchBoxValue" ValueChanged="OnSearchChanged"
                                   @oninput="OnSearchInput" Placeholder="Number, subject, or customer" />
                    </InputGroup>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small fw-semibold" for="hd-status">Status</label>
                    <select id="hd-status" class="form-select" value="@State.Filter.Status" @onchange="OnStatusChanged">
                        <option value="@HelpDeskFilter.StatusAllOpen">All unresolved</option>
                        @foreach (var status in Enum.GetValues<HelpDeskStatus>())
                        {
                            <option value="@status">@status</option>
                        }
                        <option value="@HelpDeskFilter.StatusAll">All tickets</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold" for="hd-priority">Priority</label>
                    <select id="hd-priority" class="form-select" value="@State.Filter.Priority" @onchange="OnPriorityChanged">
                        <option value="">Any</option>
                        @foreach (var priority in Enum.GetValues<HelpDeskPriority>().Reverse())
                        {
                            <option value="@priority">@priority</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex flex-wrap align-items-center gap-3">
                    @* "Me" is the signed-in agent (State.AgentName). *@
                    <Switch Value="State.Filter.AssignedToMe" ValueExpression="() => State.Filter.AssignedToMe" ValueChanged="OnAssignedToMeChanged" Label="Assigned to me" />
                    <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="ClearFiltersAsync" Disabled="!State.Filter.IsActive">Clear filters</Button>
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center column-gap-3 row-gap-1 mb-2">
                <p class="small text-body-secondary mb-0" id="hd-count" aria-live="polite" tabindex="-1" @ref="countRegion">@CountText(rows.Count, page, pageRows.Count)</p>
                @if (sortKey is not null)
                {
                    <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0" @onclick="SortByUrgencyAsync">Sort by urgency again</Button>
                }
            </div>

            @* Always rendered, so a bulk change or a cleared selection is announced, and focus has somewhere to go when the bar closes. *@
            <p class="hd-queue-status" role="status" tabindex="-1" @ref="statusRegion">@statusMessage</p>
            <p class="hd-queue-error" role="alert">@bulkError</p>

            @if (selected.Count > 0)
            {
                <section class="hd-bulk" aria-labelledby="hd-bulk-count">
                    <h2 class="hd-bulk-count" id="hd-bulk-count">@(selected.Count == 1 ? "1 ticket selected" : $"{selected.Count} tickets selected")</h2>
                    <div class="hd-bulk-field">
                        <label class="form-label small fw-semibold" for="hd-bulk-assignee">Assign to</label>
                        <select id="hd-bulk-assignee" class="form-select form-select-sm" value="@bulkAssignee" @onchange="OnBulkAssigneeChanged">
                            <option value="">No change</option>
                            @foreach (var agent in State.Agents)
                            {
                                <option value="@agent">@agent</option>
                            }
                            <option value="@UnassignValue">Unassign</option>
                        </select>
                    </div>
                    <div class="hd-bulk-field">
                        <label class="form-label small fw-semibold" for="hd-bulk-status">Set status</label>
                        <select id="hd-bulk-status" class="form-select form-select-sm" value="@bulkStatus" @onchange="OnBulkStatusChanged">
                            <option value="">No change</option>
                            @foreach (var status in Enum.GetValues<HelpDeskStatus>())
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                    <div class="hd-bulk-field">
                        <label class="form-label small fw-semibold" for="hd-bulk-priority">Set priority</label>
                        <select id="hd-bulk-priority" class="form-select form-select-sm" value="@bulkPriority" @onchange="OnBulkPriorityChanged">
                            <option value="">No change</option>
                            @foreach (var priority in Enum.GetValues<HelpDeskPriority>().Reverse())
                            {
                                <option value="@priority">@priority</option>
                            }
                        </select>
                    </div>
                    <div class="hd-bulk-actions">
                        <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="() => ApplyBulkAsync(selected)">Apply<span class="visually-hidden"> to the selected tickets</span></Button>
                        <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="ClearSelectionAsync">Clear selection</Button>
                    </div>
                </section>
            }

            @* Positioned (hd-grid), so the visually hidden text inside stays in the scroll box at phone width. *@
            <div class="table-responsive hd-grid">
                <table class="table table-hover">
                    <caption class="visually-hidden">Tickets, @SortLabel</caption>
                    <thead>
                        <tr>
                            <th scope="col" class="hd-select-col">
                                @if (pageRows.Count > 0)
                                {
                                    @* A button with the checkbox role carries the mixed state without script; a native checkbox needs JS for it. *@
                                    <button @ref="selectAllButton" type="button" role="checkbox" class="form-check-input hd-check-all" aria-checked="@selectAllState"
                                            @onclick="() => ToggleAllShown(pageRows, selectAllState)">
                                        <span class="visually-hidden">Select all shown tickets</span>
                                    </button>
                                }
                                else
                                {
                                    <span class="visually-hidden">Select</span>
                                }
                            </th>
                            @foreach (var column in columns)
                            {
                                <th scope="col" aria-sort="@AriaSort(column.Key)" @key="column.Key">
                                    <button type="button" class="hd-sort" @onclick="() => SortBy(column.Key)">
                                        @column.Text<Icon Name="@SortIcon(column.Key)" aria-hidden="true" />
                                    </button>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (pageRows.Count == 0)
                        {
                            <tr>
                                <td colspan="@(columns.Length + 1)" class="text-center text-body-secondary py-5">No tickets match these filters.</td>
                            </tr>
                        }
                        @foreach (var ticket in pageRows)
                        {
                            var checkboxId = FormattableString.Invariant($"hd-select-{ticket.Id}");
                            var isSelected = selectedIds.Contains(ticket.Id);

                            <tr @key="ticket.Id" class="@(isSelected ? "hd-row-selected" : null)">
                                <td class="hd-select-col">
                                    <input class="form-check-input" type="checkbox" id="@checkboxId" checked="@isSelected" @onchange="args => ToggleTicket(ticket.Id, args)" />
                                    <label class="visually-hidden" for="@checkboxId">Select ticket #@ticket.Id, @ticket.Subject</label>
                                </td>
                                <td class="text-nowrap"><span class="hd-mono small">#@ticket.Id</span></td>
                                <th scope="row" class="fw-normal">
                                    <a class="hd-ticket-link" href="@HelpDeskDisplay.TicketUrl(ticket.Id)">@ticket.Subject</a>
                                    @if (CustomerReplied(ticket))
                                    {
                                        <Badge Color="BadgeColor.Primary" Class="ms-1"><Icon Name="IconName.Reply" class="me-1" aria-hidden="true" />Customer replied</Badge>
                                    }
                                    <span class="d-block small text-body-secondary">@ticket.CustomerName@(ticket.Company is null ? null : $" · {ticket.Company}")</span>
                                </th>
                                <td class="text-nowrap"><Badge Color="@HelpDeskDisplay.PriorityColor(ticket.Priority)">@ticket.Priority</Badge></td>
                                <td class="text-nowrap"><Badge Color="@HelpDeskDisplay.StatusColor(ticket.Status)">@ticket.Status</Badge></td>
                                @* The SLA moves with the site's clock; it is worked out again on every render. *@
                                <td class="text-nowrap"><Badge Color="@HelpDeskDisplay.SlaColor(State.Sla(ticket))">@HelpDeskDisplay.SlaText(State, ticket)</Badge></td>
                                <td class="text-nowrap">@(ticket.Assignee ?? "Unassigned")</td>
                                <td class="text-nowrap"><span class="small" title="@HelpDeskDisplay.Stamp(ticket.UpdatedAt)">@HelpDeskDisplay.Ago(ticket.UpdatedAt, State.Now)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <nav class="d-flex flex-wrap align-items-center justify-content-end gap-2 mt-3" aria-label="Queue pages">
                    <Button @ref="previousButton" Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" Disabled="@(page <= 1)" @onclick="() => GoToPageAsync(page - 1, totalPages)">
                        <Icon Name="IconName.ChevronLeft" class="me-1" aria-hidden="true" />Previous
                    </Button>
                    <span class="small text-body-secondary text-nowrap">Page @(page) of @totalPages</span>
                    <Button @ref="nextButton" Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" Disabled="@(page >= totalPages)" @onclick="() => GoToPageAsync(page + 1, totalPages)">
                        Next<Icon Name="IconName.ChevronRight" class="ms-1" aria-hidden="true" />
                    </Button>
                </nav>
            }
        </CardBody>
    </Card>
</div>
