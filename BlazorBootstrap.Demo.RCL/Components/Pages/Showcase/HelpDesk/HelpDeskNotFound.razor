@* The site's not-found screen, shown by the catch-all route and for unknown tickets and articles. *@
<PageTitle>Page not found · @HelpDeskSeedData.ProductName</PageTitle>

<section class="hd-not-found">
    <span class="hd-icon fs-4" aria-hidden="true"><Icon Name="IconName.SignpostSplit" /></span>
    <h1 class="hd-title fs-3 mt-3 mb-2">We couldn't find that page</h1>
    <p class="text-body-secondary mb-4">The ticket or article may have been merged or removed.</p>
    <div class="d-flex justify-content-center flex-wrap gap-2">
        <Button Type="ButtonType.Link" To="@HelpDeskLayout.Base" Color="ButtonColor.Primary">Back to the queue</Button>
        <Button Type="ButtonType.Link" To="@($"{HelpDeskLayout.Base}/kb")" Color="ButtonColor.Primary" Outline="true">Knowledge base</Button>
    </div>
</section>
