@page "/showcase"
@layout ShowcaseLayout

<PageTitle>Showcase: example websites built with Blazor Bootstrap</PageTitle>
<PageMetaTags PageUrl="@DemoRouteConstants.Showcase_URL_Prefix" Title="Showcase: sample apps built with Blazor Bootstrap" Description="Eleven sample business apps built with Blazor Bootstrap: banking, store, clinic, help desk, HR, courses, status, projects, SaaS, travel and AI chat." ImageUrl="@(SeoRoutes.DemosSiteUrl + "/_content/BlazorBootstrap.Demo.RCL/images/social-card.png")" IncludePageTitle="false" />

<section class="container-xxl pt-4 pb-5" aria-labelledby="examples-heading">
    <div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-3 mb-3">
        <div>
            <h1 class="h2 fw-bold mb-1" id="examples-heading">Example websites built with Blazor Bootstrap</h1>
            <p class="text-body-secondary mb-0">
                @ShowcaseCatalog.Sites.Count complete, interactive sites with 80+ screens and no backend.
                Open any site and click around &mdash; nothing you do is sent anywhere.
                <a class="text-nowrap" href="@DemoRouteConstants.Showcase_Source_URL_Prefix" target="_blank" rel="noopener">View source</a>
            </p>
        </div>
        <div class="d-flex flex-wrap gap-1 flex-shrink-0" role="group" aria-label="Filter examples by category">
            @foreach (var category in categories)
            {
                <button type="button"
                        class="btn btn-sm @(category == selectedCategory ? "btn-primary" : "btn-outline-secondary")"
                        aria-pressed="@(category == selectedCategory ? "true" : "false")"
                        @onclick="() => SelectCategory(category)">
                    @category
                </button>
            }
        </div>
    </div>

    <p class="visually-hidden" aria-live="polite">@(VisibleSites.Count() == 1 ? "1 example shown" : $"{VisibleSites.Count()} examples shown")</p>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3">
        @foreach (var site in VisibleSites)
        {
            <div class="col" @key="site.Slug">
                @* p-0: the library stylesheet pads every <article> from 641px up. *@
                <article class="card h-100 p-0 overflow-hidden sc-gallery-card sc-card-hover" style="--sc-card-accent: @site.Accent;">
                    <div class="sc-gallery-stage px-3 pt-3 border-bottom">
                        <div class="bg-body border border-bottom-0 rounded-top-2 overflow-hidden">
                            <div class="sc-gallery-bar d-flex align-items-center gap-1 px-2 py-1 border-bottom" aria-hidden="true">
                                <span class="sc-gallery-dot rounded-circle flex-shrink-0"></span>
                                <span class="sc-gallery-dot rounded-circle flex-shrink-0"></span>
                                <span class="sc-gallery-dot rounded-circle flex-shrink-0"></span>
                                <span class="ms-1 text-body-secondary text-truncate">@site.Url</span>
                            </div>
                            <ShowcaseShot Site="site" Class="sc-gallery-shot" />
                        </div>
                    </div>
                    <div class="card-body d-flex flex-column p-3">
                        <p class="sc-gallery-category text-body-secondary fw-semibold mb-1">@site.Category</p>
                        <h2 class="h6 fw-bold card-title mb-1">@site.Name</h2>
                        <p class="card-text small text-body-secondary mb-2">@site.Summary</p>
                        <ul class="list-unstyled d-flex flex-wrap gap-1 mb-2" aria-label="Components used">
                            @foreach (var component in site.Components.Take(VisibleComponentCount))
                            {
                                <li><span class="badge bg-body-tertiary text-body-secondary border fw-medium">@component</span></li>
                            }
                            @if (site.Components.Count > VisibleComponentCount)
                            {
                                <li>
                                    <span class="badge bg-body-tertiary text-body-secondary border fw-medium">
                                        +@(site.Components.Count - VisibleComponentCount)<span class="visually-hidden"> more: @string.Join(", ", site.Components.Skip(VisibleComponentCount))</span>
                                    </span>
                                </li>
                            }
                        </ul>
                        <div class="mt-auto d-flex align-items-center justify-content-between gap-2 small">
                            <a class="stretched-link fw-semibold text-decoration-none py-1" href="@site.Url">
                                Live demo<span class="visually-hidden"> of @site.Name</span> <Icon Name="IconName.ArrowRight" aria-hidden="true" />
                            </a>
                            <a class="text-body-secondary position-relative z-2 py-1" href="@site.DocsUrl" target="_blank" rel="noopener">
                                How it's built<span class="visually-hidden">: @site.Name</span>
                            </a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
</section>
