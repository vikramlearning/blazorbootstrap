@attribute [Route(pageUrl)]
@layout DocsMainLayout

<DocsPageHeadSection PageUrl="@pageUrl"
                     PageTitle="@pageTitle"
                     PageDescription="@pageDescription"
                     MetaTitle="@metaTitle"
                     MetaDescription="@metaDescription"
                     ImageUrl="@imageUrl" />

<DemoLink Href="@DemoRouteConstants.Demos_URL_Table" />

<Section Class="p-0" Size="HeadingSize.H3" Name="Screenshot" PageUrl="@pageUrl" Link="screenshot">
    <img src="@imageUrl" class="img-fluid" alt="@metaTitle" />
</Section>

<Section Class="p-0" Size="HeadingSize.H3" Name="Table Parameters" PageUrl="@pageUrl" Link="table-parameters">
    <DocxTable TItem="Table<object>" DocType="DocType.Parameters" />
</Section>

<Section Class="p-0" Size="HeadingSize.H3" Name="TableColumn Parameters" PageUrl="@pageUrl" Link="table-column-parameters">
    <DocxTable TItem="TableColumn<object>" DocType="DocType.Parameters" />
</Section>

@code {
    private const string pageUrl = DemoRouteConstants.Docs_URL_Table;
    private const string pageTitle = "Table";
    private const string pageDescription = "This documentation provides a comprehensive reference for the <code>Table</code> and <code>TableColumn</code> components, guiding you through their configuration options.";
    private const string metaTitle = "Blazor Table Component";
    private const string metaDescription = "This documentation provides a comprehensive reference for the Table and TableColumn components, guiding you through their configuration options.";
    private const string imageUrl = DemoScreenshotSrcConstants.Demos_URL_Table;
}
