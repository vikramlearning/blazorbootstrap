@namespace BlazorBootstrap.Demo.RCL
@inherits BlazorBootstrapComponentBase

<div>
    @* A plain link: it navigates, so it needs no role="button" (rules.md: native elements first). *@
    <a class="btn btn-info" href="@Href">
        <span>@Text</span>
        <Icon Class="ml-1" Name="IconName.BoxArrowUpRight" aria-hidden="true" />
    </a>
</div>

@code {
    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public string? Text { get; set; } = "API Documentation";
}