@namespace BlazorBootstrap.Demo.RCL
@inherits BlazorBootstrapComponentBase

<a class="me-auto align-self-center" href="/" aria-label="Blazor Bootstrap home">
    <img class="bb-site-brand" src="images/logo/logo.svg" width="32" height="29" alt="" />
</a>

@if (BlazorBootstrap.Demo.RCL.Services.Showcase.ShowcaseCatalog.IsPublished)
{
    <div>
        <a class="nav-link py-2 px-2 d-inline-flex align-items-center gap-1" href="@DemoRouteConstants.Showcase_URL_Prefix">
            <i class="bi bi-grid-1x2-fill" aria-hidden="true"></i>
            <span>Showcase</span>
        </a>
    </div>
}
<div>
    <a class="nav-link py-2 px-2" href="@githubUrl" aria-label="GitHub" target="_blank" rel="noopener">
        <i class="bi bi-github"></i>
    </a>
</div>
<div>
    <a class="nav-link py-2 px-2" href="@twitterUrl" aria-label="Blazor Bootstrap on X" target="_blank" rel="noopener">
        <i class="bi bi-twitter-x"></i>
    </a>
</div>
<div>
    <a class="nav-link py-2 px-2" href="@linkedInUrl" aria-label="LinkedIn" target="_blank" rel="noopener">
        <i class="bi bi-linkedin"></i>
    </a>
</div>
<div>
    <a class="nav-link py-2 px-2 pe-3" href="@openCollectiveUrl" aria-label="Open Collective" target="_blank" rel="noopener">
        <i class="bi bi-opencollective"></i>
    </a>
</div>
<div>
    <div class="vr mt-2"></div>
</div>

<ThemeSwitcher Class="ps-3 ps-lg-2" Position="DropdownMenuPosition.End" OnThemeChanged="@(async(string themeName) => await OnThemeChanged(themeName))" />