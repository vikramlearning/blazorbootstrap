@namespace BlazorBootstrap
@inherits BlazorBootstrapComponentBase

<nav @ref="@Element"
     id="@Id"
     class="@ClassNames"
     style="@StyleNames"
     data-bs-theme="@Theme.ToNavbarThemeAttribute()"
     aria-label="@AriaLabel"
     @attributes="@AdditionalAttributes">
    <div class="@Container.ToNavbarContainerClass()">
        @if (TogglerPosition == NavbarTogglerPosition.Start)
        {
            @RenderToggler()
        }

        @* With external content there is no collapse inside the navbar to hold the brand, so it stays in the bar. *@
        @if (!BrandInCollapse || hasExternalCollapse)
        {
            @Brand
        }

        @if (TogglerPosition == NavbarTogglerPosition.End)
        {
            @RenderToggler()
        }

        @if (hasExternalCollapse)
        {
            @ChildContent
        }
        else if (CollapseMode == NavbarCollapseMode.Offcanvas)
        {
            <div class="@offcanvasClassNames"
                 tabindex="-1"
                 id="@menuId"
                 aria-labelledby="@(hasOffcanvasTitle ? offcanvasTitleId : null)"
                 aria-label="@(hasOffcanvasTitle ? null : AriaLabel)">
                <div class="offcanvas-header">
                    @if (hasOffcanvasTitle)
                    {
                        <h5 class="offcanvas-title" id="@offcanvasTitleId">@OffcanvasTitle</h5>
                    }
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="@OffcanvasCloseButtonAriaLabel"></button>
                </div>
                <div class="offcanvas-body">
                    @if (BrandInCollapse)
                    {
                        @Brand
                    }
                    @ChildContent
                </div>
            </div>
        }
        else if (hasMenu)
        {
            <div class="collapse @BootstrapClass.NavbarCollapse" id="@menuId">
                @if (BrandInCollapse)
                {
                    @Brand
                }
                @ChildContent
            </div>
        }
    </div>
</nav>

@code {
    private RenderFragment RenderToggler() => __builder =>
    {
        @if (hasToggler)
        {
            <button class="@BootstrapClass.NavbarToggler"
                    type="button"
                    data-bs-toggle="@(CollapseMode == NavbarCollapseMode.Offcanvas && !hasExternalCollapse ? "offcanvas" : "collapse")"
                    data-bs-target="@($"#{togglerTargetId}")"
                    aria-controls="@togglerTargetId"
                    aria-expanded="false"
                    aria-label="@TogglerAriaLabel">
                <span class="@BootstrapClass.NavbarTogglerIcon"></span>
            </button>
        }
    };
}
