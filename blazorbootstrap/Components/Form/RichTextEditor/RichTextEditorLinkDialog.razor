@namespace BlazorBootstrap

<dialog id="@($"{EditorId}-link-dialog")" class="bb-rich-text-editor-dialog">
    <form method="dialog">
        <h2 class="h5">Insert link</h2>
        <label class="form-label" for="@($"{EditorId}-link-url")">HTTPS or relative URL</label>
        <input id="@($"{EditorId}-link-url")" class="form-control" data-bb-rte-link-url type="url" />
        <div class="d-flex justify-content-end gap-2 mt-3">
            <button class="btn btn-secondary" value="cancel" type="submit">Cancel</button>
            <button class="btn btn-primary" value="save" type="submit">Insert</button>
        </div>
    </form>
</dialog>

@code {
    [Parameter, EditorRequired] public string EditorId { get; set; } = default!;
}
