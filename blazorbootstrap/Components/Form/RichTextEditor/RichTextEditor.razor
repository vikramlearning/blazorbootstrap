@namespace BlazorBootstrap
@inherits BlazorBootstrapComponentBase

<section id="@Id" class="card shadow-sm" aria-label="@AriaLabel" @attributes="AdditionalAttributes">
    <div class="card-body p-0">
        <div class="border-bottom bg-body-tertiary p-2" role="toolbar" aria-label="Rich text formatting toolbar">
            <div class="d-flex flex-wrap align-items-center gap-1">
                <div class="btn-group btn-group-sm" role="group" aria-label="Document actions">
                    <button type="button" class="btn btn-outline-secondary" data-bb-rte-command="Print" aria-label="Print" title="Print"><i class="bi bi-printer" aria-hidden="true"></i></button>
                    <button type="button" class="btn btn-outline-secondary" data-bb-rte-command="Undo" aria-label="Undo" title="Undo"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button>
                    <button type="button" class="btn btn-outline-secondary" data-bb-rte-command="Redo" aria-label="Redo" title="Redo"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></button>
                </div>

                <div class="btn-group btn-group-sm" role="group" aria-label="Text styles">
                    <div class="dropdown">
                        <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Paragraph</button>
                        <ul class="dropdown-menu">
                            <li><button type="button" class="dropdown-item" data-bb-rte-command="BlockFormat" data-bb-rte-value="p">Paragraph</button></li>
                            <li><button type="button" class="dropdown-item" data-bb-rte-command="BlockFormat" data-bb-rte-value="h1">Heading 1</button></li>
                            <li><button type="button" class="dropdown-item" data-bb-rte-command="BlockFormat" data-bb-rte-value="h2">Heading 2</button></li>
                            <li><button type="button" class="dropdown-item" data-bb-rte-command="BlockFormat" data-bb-rte-value="h3">Heading 3</button></li>
                            <li><button type="button" class="dropdown-item" data-bb-rte-command="BlockFormat" data-bb-rte-value="figcaption">Caption</button></li>
                        </ul>
                    </div>
                    <div class="dropdown">
                        <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Inter</button>
                        <ul class="dropdown-menu">
                            <li><button type="button" class="dropdown-item" data-bb-rte-command="FontFamily" data-bb-rte-value="Inter">Inter</button></li>
                            <li><button type="button" class="dropdown-item" data-bb-rte-command="FontFamily" data-bb-rte-value="Arial">Arial</button></li>
                            <li><button type="button" class="dropdown-item" data-bb-rte-command="FontFamily" data-bb-rte-value="Georgia">Georgia</button></li>
                            <li><button type="button" class="dropdown-item" data-bb-rte-command="FontFamily" data-bb-rte-value="Courier New">Courier New</button></li>
                        </ul>
                    </div>
                    <div class="dropdown">
                        <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">14 px</button>
                        <ul class="dropdown-menu">
                            @foreach (var size in new[] { "12", "14", "16", "18", "24" })
                            {
                                <li><button type="button" class="dropdown-item" data-bb-rte-command="FontSize" data-bb-rte-value="@size">@size px</button></li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="btn-group btn-group-sm" role="group" aria-label="Text emphasis">
                    <button type="button" class="btn btn-outline-secondary fw-bold" data-bb-rte-command="Bold" aria-label="Bold" title="Bold">B</button>
                    <button type="button" class="btn btn-outline-secondary fst-italic" data-bb-rte-command="Italic" aria-label="Italic" title="Italic">I</button>
                    <button type="button" class="btn btn-outline-secondary text-decoration-underline" data-bb-rte-command="Underline" aria-label="Underline" title="Underline">U</button>
                    <button type="button" class="btn btn-outline-secondary text-decoration-line-through" data-bb-rte-command="Strikethrough" aria-label="Strikethrough" title="Strikethrough">S</button>
                </div>

                <div class="btn-group btn-group-sm" role="group" aria-label="Colors">
                    <div class="dropdown">
                        <button type="button" class="btn btn-outline-secondary dropdown-toggle border-bottom border-3 border-dark" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Text color" title="Text color"><i class="bi bi-fonts" aria-hidden="true"></i></button>
                        <ul class="dropdown-menu">
                            <li><button type="button" class="dropdown-item" data-bb-rte-command="TextColor" data-bb-rte-value="">Automatic</button></li>
                            <li><button type="button" class="dropdown-item text-primary" data-bb-rte-command="TextColor" data-bb-rte-value="#0d6efd">Blue</button></li>
                            <li><button type="button" class="dropdown-item text-success" data-bb-rte-command="TextColor" data-bb-rte-value="#198754">Green</button></li>
                            <li><button type="button" class="dropdown-item text-danger" data-bb-rte-command="TextColor" data-bb-rte-value="#dc3545">Red</button></li>
                            <li><button type="button" class="dropdown-item text-warning" data-bb-rte-command="TextColor" data-bb-rte-value="#fd7e14">Orange</button></li>
                        </ul>
                    </div>
                    <div class="dropdown">
                        <button type="button" class="btn btn-outline-secondary dropdown-toggle border-bottom border-3 border-warning" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Highlight color" title="Highlight color"><i class="bi bi-highlighter" aria-hidden="true"></i></button>
                        <ul class="dropdown-menu">
                            <li><button type="button" class="dropdown-item text-warning" data-bb-rte-command="HighlightColor" data-bb-rte-value="#fff3cd">Yellow</button></li>
                            <li><button type="button" class="dropdown-item text-success" data-bb-rte-command="HighlightColor" data-bb-rte-value="#d1e7dd">Green</button></li>
                            <li><button type="button" class="dropdown-item text-primary" data-bb-rte-command="HighlightColor" data-bb-rte-value="#cfe2ff">Blue</button></li>
                            <li><button type="button" class="dropdown-item text-danger" data-bb-rte-command="HighlightColor" data-bb-rte-value="#f8d7da">Pink</button></li>
                        </ul>
                    </div>
                </div>

                <div class="btn-group btn-group-sm" role="group" aria-label="Paragraph alignment">
                    <button type="button" class="btn btn-outline-secondary" data-bb-rte-command="AlignStart" aria-label="Align left" title="Align left"><i class="bi bi-text-left" aria-hidden="true"></i></button>
                    <button type="button" class="btn btn-outline-secondary" data-bb-rte-command="AlignCenter" aria-label="Align center" title="Align center"><i class="bi bi-text-center" aria-hidden="true"></i></button>
                    <button type="button" class="btn btn-outline-secondary" data-bb-rte-command="AlignEnd" aria-label="Align right" title="Align right"><i class="bi bi-text-right" aria-hidden="true"></i></button>
                </div>

                <div class="btn-group btn-group-sm" role="group" aria-label="Lists and indentation">
                    <button type="button" class="btn btn-outline-secondary" data-bb-rte-command="Outdent" aria-label="Decrease indent" title="Decrease indent"><i class="bi bi-text-indent-left" aria-hidden="true"></i></button>
                    <button type="button" class="btn btn-outline-secondary" data-bb-rte-command="Indent" aria-label="Increase indent" title="Increase indent"><i class="bi bi-text-indent-right" aria-hidden="true"></i></button>
                    <button type="button" class="btn btn-outline-secondary" data-bb-rte-command="OrderedList" aria-label="Ordered list" title="Ordered list"><i class="bi bi-list-ol" aria-hidden="true"></i></button>
                    <button type="button" class="btn btn-outline-secondary" data-bb-rte-command="UnorderedList" aria-label="Bulleted list" title="Bulleted list"><i class="bi bi-list-ul" aria-hidden="true"></i></button>
                </div>

                <div class="btn-group btn-group-sm" role="group" aria-label="Insert content">
                    <button type="button" class="btn btn-outline-secondary" data-bb-rte-command="Link" aria-label="Insert or edit link" title="Insert or edit link"><i class="bi bi-link-45deg" aria-hidden="true"></i></button>
                    <button type="button" class="btn btn-outline-secondary" data-bb-rte-command="Image" aria-label="Insert image" title="Insert image"><i class="bi bi-image" aria-hidden="true"></i></button>
                    <button type="button" class="btn btn-outline-secondary" data-bb-rte-command="HorizontalRule" aria-label="Horizontal rule" title="Horizontal rule"><i class="bi bi-dash-lg" aria-hidden="true"></i></button>
                    <button type="button" class="btn btn-outline-secondary" data-bb-rte-command="Table" aria-label="Insert table" title="Insert table"><i class="bi bi-table" aria-hidden="true"></i></button>
                </div>

                <div class="btn-group btn-group-sm" role="group" aria-label="Block tools">
                    <button type="button" class="btn btn-outline-secondary" data-bb-rte-command="Blockquote" aria-label="Block quote" title="Block quote"><i class="bi bi-quote" aria-hidden="true"></i></button>
                    <button type="button" class="btn btn-outline-secondary" data-bb-rte-command="CodeBlock" aria-label="Code block" title="Code block"><i class="bi bi-code-slash" aria-hidden="true"></i></button>
                    <button type="button" class="btn btn-outline-secondary" data-bb-rte-command="ClearFormatting" aria-label="Clear formatting" title="Clear formatting"><i class="bi bi-eraser" aria-hidden="true"></i></button>
                    <button type="button" class="btn btn-outline-secondary" data-bb-rte-command="Fullscreen" aria-label="Toggle fullscreen" title="Toggle fullscreen"><i class="bi bi-arrows-fullscreen" aria-hidden="true"></i></button>
                </div>
            </div>
        </div>

        <div id="@EditorId"
             class="form-control rounded-0 border-0"
             contenteditable="@(!Disabled && !ReadOnly)"
             role="textbox"
             aria-multiline="true"
             aria-label="@AriaLabel"
             aria-disabled="@Disabled"
             data-placeholder="@Placeholder">@((MarkupString)Value)</div>

        <InputFile id="@ImageInputId" class="d-none" accept="@Accept" OnChange="OnImageFileChangedAsync" aria-label="Upload an image" />
    </div>

    <footer class="card-footer bg-body d-flex flex-wrap justify-content-between align-items-center gap-2 small text-body-secondary">
        <div class="d-flex flex-wrap gap-3">
            <span><i class="bi bi-file-earmark-text me-1" aria-hidden="true"></i><span data-bb-rte-context>Paragraph</span></span>
            <span><i class="bi bi-type me-1" aria-hidden="true"></i><span data-bb-rte-font-context>Inter, 14 px</span></span>
            <span><i class="bi bi-text-left me-1" aria-hidden="true"></i><span data-bb-rte-alignment-context>Left aligned</span></span>
        </div>
        <div class="d-flex flex-wrap gap-3">
            <span data-bb-rte-character-count>0 characters</span>
            <span data-bb-rte-word-count>0 words</span>
        </div>
    </footer>
</section>

<div id="@($"{Id}-link-modal")" class="modal fade" tabindex="-1" aria-labelledby="@($"{Id}-link-modal-title")" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 id="@($"{Id}-link-modal-title")" class="modal-title fs-5">Insert or edit link</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><label class="form-label" for="@($"{Id}-link-url")">URL</label><input id="@($"{Id}-link-url")" class="form-control" data-bb-rte-link-url type="url" /><label class="form-label mt-3" for="@($"{Id}-link-text")">Text</label><input id="@($"{Id}-link-text")" class="form-control" data-bb-rte-link-text type="text" /><div class="form-check mt-3"><input id="@($"{Id}-link-new-tab")" class="form-check-input" data-bb-rte-link-new-tab type="checkbox" /><label class="form-check-label" for="@($"{Id}-link-new-tab")">Open in a new tab</label></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" data-bb-rte-save-link>Save link</button></div></div></div>
</div>

<div id="@($"{Id}-image-modal")" class="modal fade" tabindex="-1" aria-labelledby="@($"{Id}-image-modal-title")" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 id="@($"{Id}-image-modal-title")" class="modal-title fs-5">Insert image</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><label class="form-label" for="@($"{Id}-image-url")">HTTPS image URL</label><input id="@($"{Id}-image-url")" class="form-control" data-bb-rte-image-url type="url" /><label class="form-label mt-3" for="@($"{Id}-image-alt")">Alternative text</label><input id="@($"{Id}-image-alt")" class="form-control" data-bb-rte-image-alt type="text" required /></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" data-bb-rte-save-image>Save image</button></div></div></div>
</div>

<div id="@($"{Id}-table-modal")" class="modal fade" tabindex="-1" aria-labelledby="@($"{Id}-table-modal-title")" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 id="@($"{Id}-table-modal-title")" class="modal-title fs-5">Insert table</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="row g-3"><div class="col"><label class="form-label" for="@($"{Id}-table-rows")">Rows</label><input id="@($"{Id}-table-rows")" class="form-control" data-bb-rte-table-rows type="number" min="1" max="20" value="2" /></div><div class="col"><label class="form-label" for="@($"{Id}-table-columns")">Columns</label><input id="@($"{Id}-table-columns")" class="form-control" data-bb-rte-table-columns type="number" min="1" max="10" value="2" /></div></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" data-bb-rte-save-table>Insert table</button></div></div></div>
</div>
