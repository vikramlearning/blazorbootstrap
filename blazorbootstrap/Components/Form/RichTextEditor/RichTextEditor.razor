@namespace BlazorBootstrap
@inherits BlazorBootstrapComponentBase

<div class="container py-3">
    <section class="card shadow-sm" aria-label="Rich text editor">
        <div class="card-body p-0">
            <div class="border-bottom bg-body-tertiary p-2" role="toolbar" aria-label="Rich text formatting toolbar">
                <div class="d-flex flex-wrap align-items-center gap-1">
                    <div class="btn-group btn-group-sm" role="group" aria-label="History">
                        <button type="button" class="btn btn-outline-secondary" aria-label="Print" title="Print"><i class="bi bi-printer" aria-hidden="true"></i></button>
                        <button type="button" class="btn btn-outline-secondary" aria-label="Undo" title="Undo"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button>
                        <button type="button" class="btn btn-outline-secondary" aria-label="Redo" title="Redo"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></button>
                    </div>

                    <div class="dropdown">
                        <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Paragraph</button>
                        <ul class="dropdown-menu">
                            <li><button type="button" class="dropdown-item">Paragraph</button></li>
                            <li><button type="button" class="dropdown-item">Heading 1</button></li>
                            <li><button type="button" class="dropdown-item">Heading 2</button></li>
                            <li><button type="button" class="dropdown-item">Heading 3</button></li>
                            <li><button type="button" class="dropdown-item">Caption</button></li>
                        </ul>
                    </div>
                    <div class="dropdown">
                        <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Inter</button>
                        <ul class="dropdown-menu" style="">
                            <li><button type="button" class="dropdown-item">Inter</button></li>
                            <li><button type="button" class="dropdown-item">Arial</button></li>
                            <li><button type="button" class="dropdown-item">Georgia</button></li>
                            <li><button type="button" class="dropdown-item">Courier New</button></li>
                        </ul>
                    </div>
                    <div class="dropdown">
                        <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">14 px</button>
                        <ul class="dropdown-menu" style="">
                            <li><button type="button" class="dropdown-item">12 px</button></li>
                            <li><button type="button" class="dropdown-item">14 px</button></li>
                            <li><button type="button" class="dropdown-item">16 px</button></li>
                            <li><button type="button" class="dropdown-item">18 px</button></li>
                            <li><button type="button" class="dropdown-item">24 px</button></li>
                        </ul>
                    </div>

                    <div class="btn-group btn-group-sm" role="group" aria-label="Text emphasis">
                        <button type="button" class="btn btn-outline-secondary fw-bold" aria-label="Bold" title="Bold">B</button>
                        <button type="button" class="btn btn-outline-secondary fst-italic" aria-label="Italic" title="Italic">I</button>
                        <button type="button" class="btn btn-outline-secondary text-decoration-underline" aria-label="Underline" title="Underline">U</button>
                        <button type="button" class="btn btn-outline-secondary text-decoration-line-through" aria-label="Strikethrough" title="Strikethrough">S</button>
                    </div>

                    <div class="dropdown">
                        <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Text color" title="Text color"><i class="bi bi-fonts" aria-hidden="true"></i></button>
                        <ul class="dropdown-menu" style="">
                            <li><button type="button" class="dropdown-item"><i class="bi bi-circle-fill text-body me-2" aria-hidden="true"></i>Automatic</button></li>
                            <li><button type="button" class="dropdown-item"><i class="bi bi-circle-fill text-primary me-2" aria-hidden="true"></i>Blue</button></li>
                            <li><button type="button" class="dropdown-item"><i class="bi bi-circle-fill text-success me-2" aria-hidden="true"></i>Green</button></li>
                            <li><button type="button" class="dropdown-item"><i class="bi bi-circle-fill text-danger me-2" aria-hidden="true"></i>Red</button></li>
                            <li><button type="button" class="dropdown-item"><i class="bi bi-circle-fill text-warning me-2" aria-hidden="true"></i>Orange</button></li>
                        </ul>
                    </div>
                    <div class="dropdown">
                        <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Highlight color" title="Highlight color"><i class="bi bi-highlighter" aria-hidden="true"></i></button>
                        <ul class="dropdown-menu" style="">
                            <li><button type="button" class="dropdown-item"><i class="bi bi-square-fill text-warning me-2" aria-hidden="true"></i>Yellow</button></li>
                            <li><button type="button" class="dropdown-item"><i class="bi bi-square-fill text-success me-2" aria-hidden="true"></i>Green</button></li>
                            <li><button type="button" class="dropdown-item"><i class="bi bi-square-fill text-primary me-2" aria-hidden="true"></i>Blue</button></li>
                            <li><button type="button" class="dropdown-item"><i class="bi bi-square-fill text-danger me-2" aria-hidden="true"></i>Pink</button></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><button type="button" class="dropdown-item">No highlight</button></li>
                        </ul>
                    </div>

                    <div class="btn-group btn-group-sm" role="group" aria-label="Alignment">
                        <button type="button" class="btn btn-outline-secondary" aria-label="Align left" title="Align left"><i class="bi bi-text-left" aria-hidden="true"></i></button>
                        <button type="button" class="btn btn-outline-secondary" aria-label="Align center" title="Align center"><i class="bi bi-text-center" aria-hidden="true"></i></button>
                        <button type="button" class="btn btn-outline-secondary" aria-label="Align right" title="Align right"><i class="bi bi-text-right" aria-hidden="true"></i></button>
                        <button type="button" class="btn btn-outline-secondary" aria-label="Justify text" title="Justify text"><i class="bi bi-justify" aria-hidden="true"></i></button>
                    </div>

                    <div class="btn-group btn-group-sm" role="group" aria-label="Lists and indentation">
                        <button type="button" class="btn btn-outline-secondary" aria-label="Decrease indent" title="Decrease indent"><i class="bi bi-text-indent-left" aria-hidden="true"></i></button>
                        <button type="button" class="btn btn-outline-secondary" aria-label="Increase indent" title="Increase indent"><i class="bi bi-text-indent-right" aria-hidden="true"></i></button>
                        <button type="button" class="btn btn-outline-secondary" aria-label="Numbered list" title="Numbered list"><i class="bi bi-list-ol" aria-hidden="true"></i></button>
                        <button type="button" class="btn btn-outline-secondary" aria-label="Bulleted list" title="Bulleted list"><i class="bi bi-list-ul" aria-hidden="true"></i></button>
                    </div>

                    <div class="btn-group btn-group-sm" role="group" aria-label="Insert content">
                        <button type="button" class="btn btn-outline-secondary" aria-label="Insert link" title="Insert link"><i class="bi bi-link-45deg" aria-hidden="true"></i></button>
                        <button type="button" class="btn btn-outline-secondary" aria-label="Insert image" title="Insert image"><i class="bi bi-image" aria-hidden="true"></i></button>
                        <button type="button" class="btn btn-outline-secondary" aria-label="Insert horizontal rule" title="Insert horizontal rule"><i class="bi bi-hr" aria-hidden="true"></i></button>
                    </div>

                    <div class="dropdown">
                        <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Insert table"><i class="bi bi-table" aria-hidden="true"></i></button>
                        <ul class="dropdown-menu" style="">
                            <li><h2 class="dropdown-header">Insert table</h2></li>
                            <li><button type="button" class="dropdown-item">2 × 2 table</button></li>
                            <li><button type="button" class="dropdown-item">3 × 3 table</button></li>
                            <li><button type="button" class="dropdown-item">4 × 4 table</button></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><button type="button" class="dropdown-item">Custom table…</button></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><h2 class="dropdown-header">Table actions</h2></li>
                            <li><button type="button" class="dropdown-item"><i class="bi bi-arrow-right-square me-2" aria-hidden="true"></i>Add column to the right</button></li>
                            <li><button type="button" class="dropdown-item"><i class="bi bi-arrow-left-square me-2" aria-hidden="true"></i>Add column to the left</button></li>
                            <li><button type="button" class="dropdown-item"><i class="bi bi-arrow-down-square me-2" aria-hidden="true"></i>Add row below</button></li>
                            <li><button type="button" class="dropdown-item"><i class="bi bi-arrow-up-square me-2" aria-hidden="true"></i>Add row above</button></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><button type="button" class="dropdown-item">Delete column</button></li>
                            <li><button type="button" class="dropdown-item">Delete row</button></li>
                            <li><button type="button" class="dropdown-item">Delete table</button></li>
                        </ul>
                    </div>

                    <div class="btn-group btn-group-sm" role="group" aria-label="Blocks and view">
                        <button type="button" class="btn btn-outline-secondary" aria-label="Block quote" title="Block quote"><i class="bi bi-quote" aria-hidden="true"></i></button>
                        <button type="button" class="btn btn-outline-secondary" aria-label="Code block" title="Code block"><i class="bi bi-code-square" aria-hidden="true"></i></button>
                        <button type="button" class="btn btn-outline-secondary" aria-label="Clear formatting" title="Clear formatting"><i class="bi bi-eraser" aria-hidden="true"></i></button>
                        <button type="button" class="btn btn-outline-secondary" aria-label="Fullscreen" title="Fullscreen"><i class="bi bi-arrows-fullscreen" aria-hidden="true"></i></button>
                    </div>
                </div>
            </div>

            <article class="bg-white border-bottom p-4" aria-label="Document editing area">
                <p class="text-body-secondary small text-uppercase fw-semibold mb-2">Project brief</p>
                <h2 class="h3 mb-3">Designing a clearer editorial workflow</h2>
                <p>Our next release should make routine publishing feel <strong>faster and more deliberate</strong>. This draft brings writing, structure, and review notes into one focused workspace.</p>
                <p>Use the editor to shape the story first, then refine the details. The team can <a href="#" class="link-primary">review the content guidelines</a> before the final approval pass.</p>

                <h3 class="h5 mt-4">Release goals</h3>
                <ul>
                    <li>Give authors a consistent set of formatting choices.</li>
                    <li>Keep complex documents readable across screen sizes.</li>
                    <li>Make important review notes easy to spot.</li>
                </ul>

                <blockquote class="blockquote border-start border-4 border-primary ps-3 my-4">
                    <p class="mb-0">“Good editing is not about adding more controls; it is about making the right controls easy to find.”</p>
                    <footer class="blockquote-footer mt-2">Content design principle</footer>
                </blockquote>

                <h3 class="h5 mt-4">Implementation note</h3>
                <pre class="bg-body-tertiary border rounded p-3"><code>publish(document, { reviewRequired: true });</code></pre>

                <h3 class="h5 mt-4">Milestones</h3>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th scope="col">Stage</th>
                                <th scope="col">Owner</th>
                                <th scope="col">Target</th>
                                <th scope="col">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Content draft</td>
                                <td>Editorial</td>
                                <td>Aug 20</td>
                                <td><span class="badge text-bg-success">Complete</span></td>
                            </tr>
                            <tr>
                                <td>Review pass</td>
                                <td>Design</td>
                                <td>Aug 22</td>
                                <td><span class="badge text-bg-warning">In progress</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <p class="mb-0"><mark>Review note:</mark> Confirm the accessibility copy before publishing.</p>
            </article>
        </div>

        <footer class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center gap-2 small text-body-secondary">
            <div class="d-flex flex-wrap gap-3">
                <span><i class="bi bi-file-earmark-text me-1" aria-hidden="true"></i>Paragraph</span>
                <span><i class="bi bi-type me-1" aria-hidden="true"></i>Inter, 14 px</span>
                <span><i class="bi bi-text-left me-1" aria-hidden="true"></i>Left aligned</span>
            </div>
            <div class="d-flex flex-wrap gap-3">
                <span><i class="bi bi-check-circle-fill text-success me-1" aria-hidden="true"></i>All changes saved</span>
                <span>1,248 characters</span>
                <span>214 words</span>
                <span>4 min read</span>
                <span>English (US)</span>
            </div>
        </footer>
    </section>
</div>

