@namespace BlazorBootstrap
@inherits BlazorBootstrapComponentBase

<CascadingValue Value="this" Name="RichTextEditor">
    @* @ChildContent *@
    <section id="@Id" class="card shadow-sm" aria-label="@AriaLabel" @attributes="AdditionalAttributes">
        <div class="card-body p-0">
            <div class="border-bottom bg-body-tertiary p-2" role="toolbar" aria-label="Rich text formatting toolbar">
                <div class="d-flex flex-wrap align-items-center gap-1">
                    <div class="btn-group btn-group-sm" role="group" aria-label="History">
                        <RichTextEditorToolbarButton Item="RichTextEditorToolbarItem.Print" Disabled="@Disabled" />
                        <RichTextEditorToolbarButton Item="RichTextEditorToolbarItem.Undo" Disabled="@Disabled" />
                        <RichTextEditorToolbarButton Item="RichTextEditorToolbarItem.Redo" Disabled="@Disabled" />
                    </div>

                    <div class="dropdown">
                        <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Paragraph</button>
                        <ul class="dropdown-menu">
                            <li><button type="button" class="dropdown-item" data-editor-block="p">Paragraph</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-block="h1">Heading 1</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-block="h2">Heading 2</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-block="h3">Heading 3</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-block="small">Caption</button></li>
                        </ul>
                    </div>
                    <div class="dropdown">
                        <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Inter</button>
                        <ul class="dropdown-menu">
                            <li><button type="button" class="dropdown-item" data-editor-font="Inter">Inter</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-font="Arial">Arial</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-font="Georgia">Georgia</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-font="Courier New">Courier New</button></li>
                        </ul>
                    </div>
                    <div class="dropdown">
                        <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">14 px</button>
                        <ul class="dropdown-menu">
                            <li><button type="button" class="dropdown-item" data-editor-size="2">12 px</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-size="3">14 px</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-size="4">16 px</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-size="5">18 px</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-size="6">24 px</button></li>
                        </ul>
                    </div>

                    <div class="btn-group btn-group-sm" role="group" aria-label="Text emphasis">
                        <RichTextEditorToolbarButton Item="RichTextEditorToolbarItem.Bold" Disabled="@Disabled" />
                        <RichTextEditorToolbarButton Item="RichTextEditorToolbarItem.Italic" Disabled="@Disabled" />
                        <RichTextEditorToolbarButton Item="RichTextEditorToolbarItem.Underline" Disabled="@Disabled" />
                        <RichTextEditorToolbarButton Item="RichTextEditorToolbarItem.Strikethrough" Disabled="@Disabled" />
                    </div>

                    <div class="btn-group btn-group-sm" role="group" aria-label="Text color">
                        <button type="button" class="btn btn-outline-secondary position-relative" data-editor-action="apply-text-color" aria-label="Apply text color" title="Apply selected text color"><i class="bi bi-fonts" aria-hidden="true"></i><span id="text-color-indicator" class="position-absolute bottom-0 start-0 end-0 border-bottom border-3 border-dark" aria-hidden="true"></span></button>
                        <button type="button" class="btn btn-outline-secondary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Choose text color" title="Choose text color"><span class="visually-hidden">Choose text color</span></button>
                        <ul class="dropdown-menu">
                            <li><button type="button" class="dropdown-item" data-editor-color="#212529" data-editor-indicator="border-dark"><i class="bi bi-circle-fill text-body me-2" aria-hidden="true"></i>Automatic</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-color="#0d6efd" data-editor-indicator="border-primary"><i class="bi bi-circle-fill text-primary me-2" aria-hidden="true"></i>Blue</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-color="#198754" data-editor-indicator="border-success"><i class="bi bi-circle-fill text-success me-2" aria-hidden="true"></i>Green</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-color="#dc3545" data-editor-indicator="border-danger"><i class="bi bi-circle-fill text-danger me-2" aria-hidden="true"></i>Red</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-color="#fd7e14" data-editor-indicator="border-warning"><i class="bi bi-circle-fill text-warning me-2" aria-hidden="true"></i>Orange</button></li>
                        </ul>
                    </div>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Highlight color">
                        <button type="button" class="btn btn-outline-secondary position-relative" data-editor-action="apply-highlight-color" aria-label="Apply highlight color" title="Apply selected highlight color"><i class="bi bi-highlighter" aria-hidden="true"></i><span id="highlight-color-indicator" class="position-absolute bottom-0 start-0 end-0 border-bottom border-3 border-warning" aria-hidden="true"></span></button>
                        <button type="button" class="btn btn-outline-secondary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Choose highlight color" title="Choose highlight color"><span class="visually-hidden">Choose highlight color</span></button>
                        <ul class="dropdown-menu">
                            <li><button type="button" class="dropdown-item" data-editor-highlight="#ffc107" data-editor-indicator="border-warning"><i class="bi bi-square-fill text-warning me-2" aria-hidden="true"></i>Yellow</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-highlight="#198754" data-editor-indicator="border-success"><i class="bi bi-square-fill text-success me-2" aria-hidden="true"></i>Green</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-highlight="#0d6efd" data-editor-indicator="border-primary"><i class="bi bi-square-fill text-primary me-2" aria-hidden="true"></i>Blue</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-highlight="#d63384" data-editor-indicator="border-danger"><i class="bi bi-square-fill text-danger me-2" aria-hidden="true"></i>Pink</button></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><button type="button" class="dropdown-item" data-editor-highlight="transparent" data-editor-indicator="border-0">No highlight</button></li>
                        </ul>
                    </div>

                    <div class="btn-group btn-group-sm" role="group" aria-label="Alignment">
                        <RichTextEditorToolbarButton Item="RichTextEditorToolbarItem.AlignLeft" Disabled="@Disabled" />
                        <RichTextEditorToolbarButton Item="RichTextEditorToolbarItem.AlignCenter" Disabled="@Disabled" />
                        <RichTextEditorToolbarButton Item="RichTextEditorToolbarItem.AlignRight" Disabled="@Disabled" />
                        <RichTextEditorToolbarButton Item="RichTextEditorToolbarItem.AlignJustify" Disabled="@Disabled" />
                    </div>

                    <div class="btn-group btn-group-sm" role="group" aria-label="Lists and indentation">
                        <RichTextEditorToolbarButton Item="RichTextEditorToolbarItem.Outdent" Disabled="@Disabled" />
                        <RichTextEditorToolbarButton Item="RichTextEditorToolbarItem.Indent" Disabled="@Disabled" />
                        <RichTextEditorToolbarButton Item="RichTextEditorToolbarItem.OrderedList" Disabled="@Disabled" />
                        <RichTextEditorToolbarButton Item="RichTextEditorToolbarItem.UnorderedList" Disabled="@Disabled" />
                    </div>

                    <div class="btn-group btn-group-sm" role="group" aria-label="Insert content">
                        <RichTextEditorToolbarButton Item="RichTextEditorToolbarItem.Link" Disabled="@Disabled" />
                        <RichTextEditorToolbarButton Item="RichTextEditorToolbarItem.Image" Disabled="@Disabled" />
                        <RichTextEditorToolbarButton Item="RichTextEditorToolbarItem.HorizontalRule" Disabled="@Disabled" />
                    </div>

                    <div class="dropdown">
                        <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Insert table"><i class="bi bi-table" aria-hidden="true"></i></button>
                        <ul class="dropdown-menu">
                            <li><h2 class="dropdown-header">Insert table</h2></li>
                            <li><button type="button" class="dropdown-item" data-editor-table="2x2">2 × 2 table</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-table="3x3">3 × 3 table</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-table="4x4">4 × 4 table</button></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><button type="button" class="dropdown-item" data-editor-action="insert-table"><i class="bi bi-grid-3x3-gap me-2" aria-hidden="true"></i>Rows and columns…</button></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><h2 class="dropdown-header">Table actions</h2></li>
                            <li><button type="button" class="dropdown-item" data-editor-table-action="add-column-right"><i class="bi bi-arrow-right-square me-2" aria-hidden="true"></i>Add column to the right</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-table-action="add-column-left"><i class="bi bi-arrow-left-square me-2" aria-hidden="true"></i>Add column to the left</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-table-action="add-row-below"><i class="bi bi-arrow-down-square me-2" aria-hidden="true"></i>Add row below</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-table-action="add-row-above"><i class="bi bi-arrow-up-square me-2" aria-hidden="true"></i>Add row above</button></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><button type="button" class="dropdown-item" data-editor-table-action="delete-column">Delete column</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-table-action="delete-row">Delete row</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-table-action="delete-table">Delete table</button></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><h2 class="dropdown-header">Table appearance</h2></li>
                            <li><button type="button" class="dropdown-item" data-editor-table-style="table-bordered"><i class="bi bi-border-all me-2" aria-hidden="true"></i>Toggle borders</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-table-style="table-striped"><i class="bi bi-distribute-vertical me-2" aria-hidden="true"></i>Toggle striped rows</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-table-style="table-hover"><i class="bi bi-hand-index-thumb me-2" aria-hidden="true"></i>Toggle hover rows</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-table-style="table-sm"><i class="bi bi-arrows-collapse-vertical me-2" aria-hidden="true"></i>Toggle compact spacing</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-table-style="header-row"><i class="bi bi-layout-text-window-reverse me-2" aria-hidden="true"></i>Toggle header row</button></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><h2 class="dropdown-header">Active cell alignment</h2></li>
                            <li><button type="button" class="dropdown-item" data-editor-table-align="text-start"><i class="bi bi-text-left me-2" aria-hidden="true"></i>Align left</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-table-align="text-center"><i class="bi bi-text-center me-2" aria-hidden="true"></i>Align center</button></li>
                            <li><button type="button" class="dropdown-item" data-editor-table-align="text-end"><i class="bi bi-text-right me-2" aria-hidden="true"></i>Align right</button></li>
                        </ul>
                    </div>

                    <div class="btn-group btn-group-sm" role="group" aria-label="Blocks and view">
                        <RichTextEditorToolbarButton Item="RichTextEditorToolbarItem.Blockquote" Disabled="@Disabled" />
                        <RichTextEditorToolbarButton Item="RichTextEditorToolbarItem.CodeBlock" Disabled="@Disabled" />
                        <RichTextEditorToolbarButton Item="RichTextEditorToolbarItem.ClearFormatting" Disabled="@Disabled" />
                        <RichTextEditorToolbarButton Item="RichTextEditorToolbarItem.Fullscreen" Disabled="@Disabled" />
                    </div>
                </div>
            </div>

            <div id="@EditorId"
                 class="form-control rounded-0 border-0"
                 contenteditable="@(!Disabled && !ReadOnly)"
                 role="textbox"
                 aria-multiline="true"
                 aria-label="@AriaLabel"
                 aria-disabled="@Disabled"
                 data-placeholder="@Placeholder">
                @((MarkupString)Value)
            </div>

        </div>

        <footer class="card-footer bg-body-tertiary small text-body-secondary">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <div class="d-flex flex-wrap gap-3">
                    <span id="@($"{Id}-footer-block")"><i class="bi bi-file-earmark-text me-1" aria-hidden="true"></i>Paragraph</span>
                    <span id="@($"{Id}-footer-font")" class="border-start ps-3"><i class="bi bi-type me-1" aria-hidden="true"></i>Inter, 14 px</span>
                    <span id="@($"{Id}-footer-alignment")" class="border-start ps-3"><i class="bi bi-text-left me-1" aria-hidden="true"></i>Left aligned</span>
                </div>
                <div class="d-flex flex-wrap gap-3 ms-md-auto">
                    <span id="@($"{Id}-footer-character-count")"></span>
                    <span id="@($"{Id}-footer-word-count")" class="border-start ps-3"></span>
                </div>
            </div>
        </footer>
    </section>

    <div id="@($"{Id}-link-modal")" class="modal fade" tabindex="-1" aria-labelledby="@($"{Id}-link-modal-title")" aria-hidden="true">
        <div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 id="@($"{Id}-link-modal-title")" class="modal-title fs-5">Insert or edit link</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><label class="form-label" for="@($"{Id}-link-url")">URL</label><input id="@($"{Id}-link-url")" class="form-control" data-bb-rte-link-url type="url" /><label class="form-label mt-3" for="@($"{Id}-link-text")">Text</label><input id="@($"{Id}-link-text")" class="form-control" data-bb-rte-link-text type="text" /><div class="form-check mt-3"><input id="@($"{Id}-link-new-tab")" class="form-check-input" data-bb-rte-link-new-tab type="checkbox" /><label class="form-check-label" for="@($"{Id}-link-new-tab")">Open in a new tab</label></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" data-bb-rte-save-link>Save link</button></div></div></div>
    </div>

    <div id="@($"{Id}-image-modal")" class="modal fade" tabindex="-1" aria-labelledby="@($"{Id}-image-modal-title")" aria-hidden="true">
        <div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 id="@($"{Id}-image-modal-title")" class="modal-title fs-5">Insert image</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><label class="form-label" for="@($"{Id}-image-url")">HTTPS image URL</label><input id="@($"{Id}-image-url")" class="form-control" data-bb-rte-image-url type="url" /><label class="form-label mt-3" for="@($"{Id}-image-alt")">Alternative text</label><input id="@($"{Id}-image-alt")" class="form-control" data-bb-rte-image-alt type="text" required /></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" data-bb-rte-save-image>Save image</button></div></div></div>
    </div>

    <div id="@($"{Id}-table-modal")" class="modal fade" tabindex="-1" aria-labelledby="@($"{Id}-table-modal-title")" aria-hidden="true">
        <div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 id="@($"{Id}-table-modal-title")" class="modal-title fs-5">Insert table</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="row g-3"><div class="col"><label class="form-label" for="@($"{Id}-table-rows")">Rows</label><input id="@($"{Id}-table-rows")" class="form-control" data-bb-rte-table-rows type="number" min="1" max="20" value="2" /></div><div class="col"><label class="form-label" for="@($"{Id}-table-columns")">Columns</label><input id="@($"{Id}-table-columns")" class="form-control" data-bb-rte-table-columns type="number" min="1" max="10" value="2" /></div></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" data-bb-rte-save-table>Insert table</button></div></div></div>
    </div>

</CascadingValue>