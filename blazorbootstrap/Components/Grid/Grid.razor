@namespace BlazorBootstrap
@inherits BlazorBootstrapComponentBase
@typeparam TItem

<CascadingValue Value="@(this)" Name="Parent" IsFixed="true">
    @ChildContent
</CascadingValue>

@if (columns.Any())
{   
    var displayColumns = GetDisplayColumns();
    var columnCount = displayColumns.Count;
    if (AllowSelection) columnCount += 1;
    if (AllowDetailView) columnCount += 1;
    
    @if (AllowColumnChooser || AllowExport)
    {
        var chooserColumns = GetChooserColumns();
        var search = columnChooserSearch.Trim();
        var matchingColumns = search.Length == 0
                                ? chooserColumns
                                : chooserColumns.Where(c => GetColumnLabel(c).Contains(search, StringComparison.CurrentCultureIgnoreCase)).ToList();
        var lockedNoteId = $"{Id}-columns-locked";

        <div class="d-flex flex-wrap justify-content-end align-items-center gap-2 mb-2">
            @if (AllowExport)
            {
                <span class="small text-body-secondary" role="status">@exportStatus</span>
                <Button Size="ButtonSize.Small" Color="ButtonColor.Secondary" @onclick="ExportToCsvAsync">
                    <Icon Name="IconName.Download" class="me-1" aria-hidden="true" />@ExportButtonText
                </Button>
            }
            @if (AllowColumnChooser)
            {
            <Dropdown AutoCloseBehavior="DropdownAutoCloseBehavior.Outside" Size="DropdownSize.Small" Color="DropdownColor.Secondary">
                <DropdownToggleButton>
                    <Icon Name="IconName.LayoutThreeColumns" class="me-1" aria-hidden="true" />@ColumnChooserButtonText
                </DropdownToggleButton>
                <DropdownMenu Class="p-2 bb-grid-column-chooser">
                    <li>
                        <input type="search"
                               class="form-control form-control-sm mb-2"
                               placeholder="@ColumnChooserSearchPlaceholderText"
                               aria-label="@ColumnChooserSearchPlaceholderText"
                               autocomplete="off"
                               value="@columnChooserSearch"
                               @oninput="args => columnChooserSearch = args.Value?.ToString() ?? string.Empty" />
                    </li>
                    <li>
                        @if (matchingColumns.Count == 0)
                        {
                            <p class="small text-body-secondary mb-2">@ColumnChooserNoMatchText</p>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-2 overflow-auto bb-grid-column-chooser-list" aria-label="@ColumnChooserButtonText">
                                @foreach (var column in matchingColumns)
                                {
                                    var label = GetColumnLabel(column);
                                    var checkboxId = $"{Id}-column-{chooserColumns.IndexOf(column)}";
                                    var position = chooserColumns.IndexOf(column);
                                    var isLocked = IsColumnLocked(column);
                                    var isLastShown = isLocked && !column.AlwaysVisible;

                                    var isFirst = position == 0;
                                    var isLast = position == chooserColumns.Count - 1;

                                    <li @key="column"
                                        class="d-flex align-items-center gap-1 py-1 @(draggedColumn == column ? "opacity-50" : "")"
                                        draggable="true"
                                        @ondragstart="() => draggedColumn = column"
                                        @ondragend="() => draggedColumn = null"
                                        @ondragover:preventDefault="true"
                                        @ondrop="() => OnColumnDroppedAsync(column)">
                                        <span class="bb-grid-column-chooser-handle text-body-secondary px-1" aria-hidden="true">
                                            <Icon Name="IconName.GripVertical" />
                                        </span>
                                        <div class="form-check mb-0 flex-grow-1">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   id="@checkboxId"
                                                   checked="@(!IsHiddenByUser(column))"
                                                   disabled="@isLocked"
                                                   aria-describedby="@(isLastShown ? lockedNoteId : null)"
                                                   @onchange="args => SetColumnHiddenAsync(column, !(args.Value is bool shown && shown))" />
                                            <label class="form-check-label text-nowrap" for="@checkboxId">@label</label>
                                        </div>
                                        @* aria-disabled, not disabled: a button that becomes disabled while focused (after moving a column to
                                           the top or the end) would drop keyboard focus. MoveColumnAsync ignores a move past either end. *@
                                        <button type="button"
                                                class="btn btn-sm btn-link p-1 text-body-secondary @(isFirst ? "disabled" : "")"
                                                aria-label="@string.Format(ColumnChooserMoveUpText, label)"
                                                title="@string.Format(ColumnChooserMoveUpText, label)"
                                                aria-disabled="@(isFirst ? "true" : null)"
                                                @onclick="() => MoveColumnAsync(column, -1)">
                                            <Icon Name="IconName.ArrowUp" aria-hidden="true" />
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-link p-1 text-body-secondary @(isLast ? "disabled" : "")"
                                                aria-label="@string.Format(ColumnChooserMoveDownText, label)"
                                                title="@string.Format(ColumnChooserMoveDownText, label)"
                                                aria-disabled="@(isLast ? "true" : null)"
                                                @onclick="() => MoveColumnAsync(column, 1)">
                                            <Icon Name="IconName.ArrowDown" aria-hidden="true" />
                                        </button>
                                    </li>
                                }
                            </ul>
                        }
                        @if (chooserColumns.Any(c => !c.AlwaysVisible && IsColumnLocked(c)))
                        {
                            <p id="@lockedNoteId" class="small text-body-secondary mb-2">@ColumnChooserLastColumnText</p>
                        }
                    </li>
                    <li class="border-top pt-2">
                        <button type="button" class="btn btn-sm btn-link px-0" @onclick="ResetColumnsAsync">@ColumnChooserResetText</button>
                        <span class="visually-hidden" role="status">@columnChooserStatus</span>
                    </li>
                </DropdownMenu>
            </Dropdown>
            }
        </div>
    }

    <div class="@GridContainerClassNames" style="@GridContainerStyleNames" onscroll="@OnScroll">
        <table @ref="@Element" id="@Id" class="@ClassNames" style="@StyleNames" @attributes="@AdditionalAttributes">
            <thead class="@THeadCssClass">
                <tr class="@(FixedHeader ? BootstrapClass.TextNoWrap : "") @HeaderRowCssClass">
                    @if (AllowDetailView)
                    {
                        <th></th>
                    }
                    @if (AllowSelection)
                    {
                        @HeaderSelectionTemplate
                    }
                    @foreach (var column in displayColumns)
                    {
                        @column.HeaderTemplate
                    }
                </tr>
                @if (AllowFiltering)
                {
                    <tr class="@FiltersRowCssClass">
                        @if (AllowDetailView)
                        {
                            <th></th>
                        }
                        @if (AllowSelection)
                        {
                            <th></th>
                        }
                        @foreach (var column in displayColumns)
                        {
                            var columnClassList = new HashSet<string>();
                            var columnStyleList = new List<string>();

                            columnClassList.Add(column.Class!);
                            if (column.Freeze)
                            {
                                columnClassList.Add("freeze-column");

                                if (column.FreezeDirection == FreezeDirection.Left)
                                    columnStyleList.Add($"left:{column.FreezeLeftPosition.ToString(CultureInfo.InvariantCulture)}{Unit.ToCssString()}");
                                else
                                {
                                    columnStyleList.Add($"right:{column.FreezeRightPosition.ToString(CultureInfo.InvariantCulture)}{Unit.ToCssString()}");
                                    columnClassList.Add("freeze-column-right");
                                }
                            }

                            <th class="@string.Join(" ", columnClassList)" style="@string.Join(";", columnStyleList)">

                                @if (isColumnsLoading)
                                {
                                    <PlaceholderContainer Animation="PlaceholderAnimation.Glow">
                                        <Placeholder Width="PlaceholderWidth.Col12" />
                                    </PlaceholderContainer>
                                }
                                else
                                {
                                    @if (column.Filterable)
                                    {
                                        <GridColumnFilter EnumFilterSelectText="@EnumFilterSelectText"
                                        FilterButtonColor="@column.FilterButtonColor"
                                        FilterButtonCSSClass="@column.FilterButtonCSSClass"
                                        FilterOperator="@column.FilterOperator"
                                        FilterValue="@column.FilterValue"
                                        FilterWidth="@column.FilterTextboxWidth"
                                        FiltersTranslationProvider="GridFiltersTranslationProviderAsync!"
                                        FixedHeader="@FixedHeader"
                                        GridColumnFilterChanged="async args => await column.OnFilterChangedAsync(args, column)"
                                        PropertyType="@column.GetPropertyType()"
                                        PropertyTypeName="@column.GetPropertyTypeName()"
                                        Unit="@column.FilterTextboxWidthUnit" />
                                    }
                                }                                
                            </th>
                        }
                    </tr>
                }
            </thead>
            <tbody>
                @if (requestInProgress) //|| totalCount is null
                {
                    @if (loadingTemplate is null)
                    {
                        var placeholderRowCount = AllowPaging ? pageSize : (totalCount < 10 ? totalCount : 10);

                        // show placeholders
                        @for (var i = 0; i < placeholderRowCount; i++)
                        {
                            <tr>
                                @for (var j = 0; j < columnCount; j++)
                                {
                                    <td class="placeholder-glow">
                                        <span class="placeholder col-12"></span>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <div class="my-3">
                            @loadingTemplate.Template
                        </div>
                    }
                }
                else if (totalCount == 0)
                {
                    // show empty
                    <tr>
                        <td colspan="@columnCount">
                            @if (emptyDataTemplate is null)
                            {
                                <div class="text-center text-secondary my-5">
                                    <div class="fs-3">
                                        <Icon Name="IconName.Inbox" />
                                    </div>
                                    <div>@EmptyText</div>
                                </div>
                            }
                            else
                            {
                                <div class="my-3">
                                    @emptyDataTemplate?.Template
                                </div>
                            }
                        </td>
                    </tr>
                }
                else if (totalCount > 0)
                {
                    if (items is not null)
                    {
                        var rowIndex = 0;
                        foreach (var item in items)
                        {
                            var rowClass = RowClass?.Invoke(item) ?? "";
                            var detailViewRowId = IdUtility.GetNextId();
                            <tr @key="RowKeySelector?.Invoke(item) ?? item?.GetHashCode()" class="@rowClass" @onclick="args => RowClick(item, args)" @ondblclick="args => RowDoubleClick(item, args)" role="@(AllowRowClick ? "button" : "")">
                                @if (AllowDetailView)
                                {
                                    <td class="text-center">
                                        <span class="bb-detail-view-icon collapsed" data-bs-toggle="collapse" data-bs-target="@($"#collape-{detailViewRowId}")" aria-expanded="false" aria-controls="@($"collape-{detailViewRowId}")" role="button">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                                <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708" />
                                            </svg>
                                        </span>
                                    </td>
                                }
                                @if (AllowSelection)
                                {
                                    @ChildSelectionTemplate(rowIndex, item)
                                }

                                @foreach (var column in displayColumns)
                                {
                                    @column.CellTemplate(item)
                                }
                            </tr>
                            @if (AllowDetailView)
                            {
                                <tr class="collapse" id="@($"collape-{detailViewRowId}")">
                                    <td></td>
                                    @if (AllowSelection)
                                    {
                                        <td></td>
                                    }
                                    <td colspan="@(columnCount - (AllowSelection ? 2 : 1))">
                                        @detailView?.GetTemplate(item)
                                    </td>
                                </tr>
                            }
                            rowIndex++;
                        }
                    }
                }
            </tbody>
            @if (AllowSummary)
            {
                <tfoot>
                    <tr>
                        @if (totalCount > 0)
                        {
                            @if (AllowDetailView)
                            {
                                <td></td>
                            }
                            @if (AllowSelection)
                            {
                                <td></td>
                            }
                            foreach (var column in displayColumns)
                            {
                                @if (column.SummaryType == GridSummaryColumnType.None)
                                {
                                    <td></td>
                                }
                                else if (column.SummaryType != GridSummaryColumnType.None)
                                {
                                    <td class="@column.TextAlignment.ToTextAlignmentClass()">@GetColumnSummaryValue(column.SummaryType, column.PropertyName, column.SummaryValueDisplayFormat, column.SummaryValuePrefix)</td>
                                }
                            }
                        }
                    </tr>
                </tfoot>
            }
        </table>
    </div>

    @if (AllowPaging && totalCount.HasValue && totalCount.Value > 0 && (!AutoHidePaging || (AutoHidePaging && totalCount.Value > pageSize)))
    {
        <div class="d-flex justify-content-between align-middle flex-wrap mt-2">
            <Pagination ActivePageNumber="@gridCurrentState.PageIndex"
                        TotalPages="@totalPages"
                        PageChanged="OnPageChangedAsync"
                        FirstLinkIcon="IconName.ChevronDoubleLeft"
                        PreviousLinkIcon="IconName.ChevronLeft"
                        NextLinkIcon="IconName.ChevronRight"
                        LastLinkIcon="IconName.ChevronDoubleRight"
                        Alignment="Alignment.Start" />

            @if (PageSizeSelectorVisible && PageSizeSelectorItems is not null && PageSizeSelectorItems.Any())
            {
                <div>
                    <div class="d-flex justify-content-center align-middle">
                        <div>
                            <InputSelect class="form-select" aria-label="@ItemsPerPageText" TValue="int" Value="@pageSize" ValueExpression="() => pageSize" ValueChanged="async (value) => await OnPageSizeChangedAsync(value)">
                                @foreach (var i in PageSizeSelectorItems)
                                {
                                    <option value="@i">@i</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="bb-grid-pagination-text">@ItemsPerPageText</div>
                    </div>
                </div>
            }

            <div class="bb-grid-pagination-text">
                @paginationItemsText
            </div>
        </div>
    }
}
